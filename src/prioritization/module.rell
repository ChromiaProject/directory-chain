module;

import lib.transaction_prioritization.*;
import lib.transaction_prioritization.extendable.*;
import model.*;
import common.*;
import common.init;

/**
 * If this function throws, the transaction will be rejected.
 *
 * @param tx_body             the transaction
 * @param tx_size             size of the transaction in bytes
 * @param tx_enter_timestamp  when the transaction entered the queue
 * @param current_timestamp   the current timestamp
 * @param compound_ops        List of compound operations (subset of tx_body.operations), is null if postchain calls v1.
 */
@extend(priority_check)
function dc_priority_check(
    tx_body: gtx_transaction_body,
    tx_size: integer,
    tx_enter_timestamp: timestamp,
    current_timestamp: timestamp,
    compound_ops: set<text>?
): priority_state_v1 {
    val ignored_ops = compound_ops ?: set([
            "nop",
            "timeb", // StandardOpsGTXModule
            "iccf_proof", // IccfGTXModule
        ]);
    val regular_operations = list<gtx_operation>();
    for (op in tx_body.operations) {
        if (op.name == rell.meta(init.init).mount_name) {
            require(not(is_initialized()), "Network has already been initialized");
            return no_account_priority_state(1.0);
        } else if (op.name in ignored_ops) {
            // ignore
        } else if (op.args.size() > 0) {
            regular_operations.add(op);
        } else {
            require(false, "Unrecognized no-args operation: %s".format(op.name));
        }
    }

    require_not_empty(regular_operations, "Transaction contains no regular operation");
    val op = regular_operations[0];

    val provider = require_provider(byte_array.from_gtv(op.args[0]));
    if (op.name.ends_with("_iccf")) {
        val tx_to_prove = gtx_transaction.from_gtv(op.args[1]);
        val op_index = integer.from_gtv(op.args[2]);
        require_provider_iccf_auth_from_operations(tx_body.operations, tx_to_prove, op_index, op.name, 0, provider, should_update_state = false);
    } else {
        require(empty(provider_auth_blockchain @* { provider }),
            "Blockchain authentication is enabled for provider %s".format(provider.pubkey));
        require(provider_is_signer_of_signers(provider.pubkey, tx_body.signers @* {} (byte_array.from_gtv($))),
            "Operation must be signed by provider key(s)");
    }
    require(provider.active, "Provider is not enabled");
    val (current_points, max_points, _) = current_provider_rate_limit(provider, current_timestamp);

    val priority = current_points.to_decimal() / max_points;

    return priority_state_v1(
        account_id = provider.pubkey,
        account_points = current_points,
        tx_cost_points = regular_operations.size(),
        priority = priority
    );
}
