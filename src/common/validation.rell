val invalid_entity_message = "Entity name can only contain letters, numerals, underscores and must start with either a letter or numeral. Maximum allowed length is 64 characters.";

function validate_entity_name(name: text) {
    require(not name.empty(), "Entity name cannot be empty");
    // we cannot allow dashes since container names are used in Postgres schema names (which does not allow dashes)
    require(
        name.matches("^[a-zA-Z0-9][a-zA-Z0-9_]{0,63}$"),
            invalid_entity_message
    );
}

function validate_metadata_text(parameter_name: text, value: text) {
    require(
        value.size() <= 1000,
        "%s must not exceed 1000 characters".format(parameter_name)
    );
    require(value.matches("^\\P{IsNoncharacter_Code_Point}*$"), "Illegal character in %s".format(parameter_name));
}

function validate_url(url: text) {
    require(url.size() <= 1000, "URL must not exceed 1000 characters");
    require(url.matches("^\\P{IsNoncharacter_Code_Point}*$"), "Illegal character in URL");
}

function validate_node_url(url: text) {
    validate_url(url);
    require(url.ends_with("/") == false, "URL must not end with /");
}

function validate_host(host: text) {
    require(host.size() <= 255, "Host must not exceed 255 characters");
    require(host.matches("^\\P{IsNoncharacter_Code_Point}*$"), "Illegal character in host");
}

function validate_territory_code(territory: text) = require(
    territory.empty() or territory.matches("^[a-zA-Z]{2}$"),
    "Territory code must be two characters or empty"
);

function validate_list_of_classes(parameter_name: text, value: text) {
    require(
        value.size() <= 1000,
        "%s must not exceed 1000 characters".format(parameter_name)
    );
    require(value.matches("^\\P{IsNoncharacter_Code_Point}*$"), "Illegal character in %s".format(parameter_name));
}
