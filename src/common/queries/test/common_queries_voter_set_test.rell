function test_get_voter_set_members_with_members() {
    setup_module();
    
    // Create additional providers
    rell.test.tx().op(create_test_provider("bob", rell.test.pubkeys.bob, provider_tier.DAPP_PROVIDER)).run();
    rell.test.tx().op(create_test_provider("charlie", rell.test.pubkeys.charlie, provider_tier.DAPP_PROVIDER)).run();
    
    val add_providers = [rell.test.pubkeys.bob, rell.test.pubkeys.charlie];
    
    // Create voter set with members
    rell.test.tx().op(
        create_voter_set(initial_provider().pubkey, test_voter_set_name, 2, add_providers, voter_sets.system_p)
    ).sign(rell.test.keypairs.alice).run();
    
    val result = get_voter_set_members(test_voter_set_name);
    
    assert_equals(result.size(), 2);
    assert_true(result.contains(rell.test.pubkeys.bob));
    assert_true(result.contains(rell.test.pubkeys.charlie));
}

function test_get_voter_set_members_nonexistent() {
    setup_module();
    
    assert_fails("", _query_in_fun__get_voter_set_members("NONEXISTENT", *));
}

function test_get_voter_sets() {
    setup_module();
    
    // Create additional voter sets
    rell.test.tx().op(
        create_voter_set(initial_provider().pubkey, test_voter_set_name, 1, null, voter_sets.system_p)
    ).sign(rell.test.keypairs.alice).run();
    
    rell.test.tx().op(
        create_voter_set(initial_provider().pubkey, test_voter_set_name_2, 2, null, voter_sets.system_p)
    ).sign(rell.test.keypairs.alice).run();
    
    val result = get_voter_sets();
    
    assert_true(result.size() >= 3); // system_p + 2 test sets
    
    // Check all expected sets are present
    var system_p_found = false;
    var test_set_1_found = false;
    var test_set_2_found = false;
    
    for (vs in result) {
        if (vs.name == voter_sets.system_p) {
            assert_equals(vs.name, voter_sets.system_p);
            assert_equals(vs.threshold, 0);
            assert_equals(vs.gorvernor, voter_sets.system_p); // Note: typo in original query
            system_p_found = true;
        } else if (vs.name == test_voter_set_name) {
            assert_equals(vs.name, test_voter_set_name);
            assert_equals(vs.threshold, 1);
            assert_equals(vs.gorvernor, voter_sets.system_p);
            test_set_1_found = true;
        } else if (vs.name == test_voter_set_name_2) {
            assert_equals(vs.name, test_voter_set_name_2);
            assert_equals(vs.threshold, 2);
            assert_equals(vs.gorvernor, voter_sets.system_p);
            test_set_2_found = true;
        }
    }
    
    assert_true(system_p_found);
    assert_true(test_set_1_found);
    assert_true(test_set_2_found);
}

function test_get_voter_sets_empty() {
    setup_module();
    
    val result = get_voter_sets();
    
    assert_true(result.size() >= 1);
    
    var system_p_found = false;
    for (vs in result) {
        if (vs.name == voter_sets.system_p) {
            system_p_found = true;
        }
    }
    assert_true(system_p_found);
}

function test_threshold_values() {
    setup_module();
    
    // Test different threshold values
    val super_majority_threshold = 0;
    val simple_majority_threshold = -1;
    val specific_threshold = 5;
    
    // Create voter sets with different thresholds
    rell.test.tx().op(
        create_voter_set(initial_provider().pubkey, "SUPER_MAJORITY", super_majority_threshold, null, voter_sets.system_p)
    ).sign(rell.test.keypairs.alice).run();
    
    rell.test.tx().op(
        create_voter_set(initial_provider().pubkey, "SIMPLE_MAJORITY", simple_majority_threshold, null, voter_sets.system_p)
    ).sign(rell.test.keypairs.alice).run();
    
    rell.test.tx().op(
        create_voter_set(initial_provider().pubkey, "SPECIFIC_COUNT", specific_threshold, null, voter_sets.system_p)
    ).sign(rell.test.keypairs.alice).run();
    
    // Verify thresholds are correctly stored and returned
    assert_equals(get_voter_set_info("SUPER_MAJORITY").threshold, super_majority_threshold);
    assert_equals(get_voter_set_info("SIMPLE_MAJORITY").threshold, simple_majority_threshold);
    assert_equals(get_voter_set_info("SPECIFIC_COUNT").threshold, specific_threshold);
}