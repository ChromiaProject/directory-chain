function require_is_signer(pubkey) {
    require(op_context.is_signer(pubkey), "Operation must be signed by " + pubkey);
}

function require_provider(pubkey) = require(provider @? { pubkey }, "Unknown provider " + pubkey);
function require_cluster(name) = require(cluster @? { name }, "Cluster %s not found".format(name));
function require_clusters(names: list<text>): list<cluster> {
    val clusters = cluster @* { .name in names };
    if (clusters.size() != names.size()) {
        val missing_clusters = list<text>();
        for (name in names) {
            val cl = clusters @? { name };
            if (cl == null) missing_clusters.add(name);
        }
        require(missing_clusters.empty(), "Clusters %s not found".format(missing_clusters.to_text()));
    }
    return clusters;
}
function require_node(pubkey, include_disabled: boolean = true) = require(node @? { pubkey, include_disabled or .active },
    "Node not found" + (if(include_disabled) "" else " or disabled") + ": " + pubkey);
function require_container(name) = require(container @? { name }, "Container %s not found".format(name));
function require_running_container(name) = require(container @? { name, .state == container_state.RUNNING }, "Container %s not found or is not running".format(name));
function require_voter_set(name) = require(voter_set @? { name }, "Voter set %s does not exist".format(name));


/** Blockchain state requirements */

function require_active_blockchain(blockchain_rid: byte_array) =
    require(maybe_active_blockchain(blockchain_rid), "Unknown blockchain " + blockchain_rid);

function maybe_active_blockchain(blockchain_rid: byte_array): blockchain? = _maybe_blockchain(
    blockchain_rid,
    allowed_states = [
        blockchain_state.RUNNING,
        blockchain_state.PAUSED,
        blockchain_state.IMPORTING,
        blockchain_state.UNARCHIVING,
    ]
);

function require_blockchain(
    blockchain_rid: byte_array,
    allowed_states: list<blockchain_state>? = null
) = require(_maybe_blockchain(blockchain_rid, allowed_states), "Unknown blockchain " + blockchain_rid);

function _maybe_blockchain(
    blockchain_rid: byte_array,
    allowed_states: list<blockchain_state>? = null,
): blockchain? = blockchain @? {
    blockchain_rid,
    allowed_states == null or allowed_states.size() == 0 or .state in allowed_states
};

function require_blockchain_states(
    blockchain_rid: byte_array,
    allowed_states: list<blockchain_state>,
    message_prefix: text = ""
) {

    val blockchain = require(
        blockchain @? { .rid == blockchain_rid }, 
        "%sUnknown blockchain %s".format(message_prefix, blockchain_rid)
    );

    require(
        blockchain.state in allowed_states, 
        "%sBlockchain %s state is %s. Must be one of: %s".format(message_prefix, blockchain_rid, blockchain.state, allowed_states)
    );

    return blockchain;
}


/** Provider requirements */

function require_is_system_provider(pubkey) {
    val p = require_provider(pubkey);
    require_system_access(p);
    return p;
}

function require_system_p_member(provider) {
    require_voter_set_member(system_p_voter_set(), provider);
}

function require_cluster_governor(cluster, provider) {
    require_voter_set_member(cluster.governance, provider);
}

function require_voter_set_governor(voter_set, provider) {
    val governor = voter_set_governance @ { voter_set } .governor;
    require_voter_set_member(governor, provider);
}

function require_container_deployer(container, provider) {
    require(roles.has_deploy_access(provider, container), "Provider %s is not a deployer of container %s".format(provider.pubkey, container.name));
}

function require_voter_set_member(voter_set, provider) {
    require(exists(voter_set_member @* { voter_set, provider}), "Provider is not a member of voter set " + voter_set.name);
}

/**
 * Requires given pubkey is a provider, is signing transaction, is active and not exceeds limit.
 *
 * @param pubkey The provider pubkey that must sign this transaction.
 * @param provider_key_roles The type of auth keys to use for this authentication. Main is default.
 * @param cost The number of points this operation costs.
 */
function require_is_provider_with_rate_limit(
    pubkey,
    provider_key_roles: list<provider_key_role> = [provider_key_role.main],
    cost: integer = 1
) {
    val provider = require_provider(pubkey);
    require_provider_auth_with_rate_limit(provider, provider_key_roles, cost);
    return provider;
}

/**
 * Requires given provider is signing transaction, is active and not exceeds limit.
 *
 * @param provider The provider that must sign this transaction.
 * @param provider_key_roles The type of auth keys to use for this authentication. Main is default.
 * @param cost The number of points this operation costs.
 */
function require_provider_auth_with_rate_limit(
    provider,
    provider_key_roles: list<provider_key_role> = [provider_key_role.main],
    cost: integer = 1
) {
    require_provider_auth(provider, provider_key_roles = provider_key_roles);
    provider_rate_limit(provider, cost);
    return provider;
}

/**
 * Requires given provider to authenticate this transaction, is active and not exceeds limit.
 *
 * @param tx_to_prove  the transaction from other chain to use for authentication
 * @param op_index     index of the relevant operation in tx_to_prove
 * @param op_name      expected operation name
 * @param op_arg_count expected operation argument count
 * @param provider     the provider
 * @param cost         the number of points this operation costs.
 */
function require_provider_iccf_auth_with_rate_limit(tx_to_prove: gtx_transaction, op_index: integer,
        op_name: text, op_arg_count: integer, provider, cost: integer = 1): list<gtv> {
    val args = require_provider_iccf_auth(tx_to_prove, op_index, op_name, op_arg_count, provider);
    provider_rate_limit(provider, cost);
    return args;
}

/**
 * Requires given provider to authenticate using ICCF.
 *
 * @param tx_to_prove  the transaction from other chain to use for authentication
 * @param op_index     index of the relevant operation in tx_to_prove
 * @param op_name      expected operation name
 * @param op_arg_count expected operation argument count
 * @param provider     the provider
 */
function require_provider_iccf_auth(tx_to_prove: gtx_transaction, op_index: integer,
        op_name: text, op_arg_count: integer, provider): list<gtv> =
    require_provider_iccf_auth_from_operations(
        op_context.get_all_operations(),
        tx_to_prove,
        op_index,
        op_name,
        op_arg_count,
        provider,
        should_update_state = true);

/**
 * Requires given provider to authenticate using ICCF.
 *
 * @param all_operations all operations in the current transaction
 * @param tx_to_prove  the transaction from other chain to use for authentication
 * @param op_index     index of the relevant operation in tx_to_prove
 * @param op_name      expected operation name
 * @param op_arg_count expected operation argument count
 * @param provider     the provider
 * @param should_update_state if state should be updated (set to false if this is done without op_context, e.g. in a query)
 */
function require_provider_iccf_auth_from_operations(
        all_operations: list<gtx_operation>,
        tx_to_prove: gtx_transaction, op_index: integer,
        op_name: text, op_arg_count: integer, provider,
        should_update_state: boolean): list<gtv> {
    val provider_auth_blockchain = require(provider_auth_blockchain @? { provider, provider_auth_type.iccf },
        "ICCF blockchain authentication is not enabled for provider %s".format(provider.pubkey));
    val proof = iccf.require_and_return_valid_proof_from_operations_and_signers(
        all_operations,
        [],
        tx_to_prove,
        require_anchored_proof=true,
        verify_signers=false,
        valid_source_blockchain_rids=set([provider_auth_blockchain.blockchain.rid]),
    );

    val block_header = iccf.block_header.from_gtv(gtv.from_bytes(proof.blockHeader));
    val height = block_header.height;
    val tx_index = proof.txIndex;
    require(height != provider_auth_blockchain.latest_height or tx_index != provider_auth_blockchain.latest_tx_index,
        "Transaction has already been processed");
    require(height > provider_auth_blockchain.latest_height
            or (height == provider_auth_blockchain.latest_height and tx_index > provider_auth_blockchain.latest_tx_index),
        "Transaction is older than previous, confirmed in block %d transaction %d".format(
            provider_auth_blockchain.latest_height, provider_auth_blockchain.latest_tx_index));
    if (should_update_state) {
        provider_auth_blockchain.latest_height = height;
        provider_auth_blockchain.latest_tx_index = tx_index;
    }

    require(op_index in range(tx_to_prove.body.operations.size()),
        "op_index out of range: %d > %d".format(op_index, tx_to_prove.body.operations.size() - 1));
    val op = tx_to_prove.body.operations[op_index];
    require(op.name == op_name, "Wrong operation name <%s>, expected <%s>".format(op.name, op_name));
    require(op.args.size() >= op_arg_count, "Wrong number of operation arguments <%s>, expected <%s>".format(op.args.size(), op_arg_count));
    require(provider.active, "Provider is not enabled");
    return op.args;
}

/**
 * Requires given pubkey is an active provider which is signing the transaction.
 *
 * @param provider The provider that must sign this transaction.
 * @param tx_signers The signers of the transaction
 * @param provider_key_roles The type of auth keys to use for this authentication. Main is default.
 */
function require_provider_auth(provider, tx_signers: list<pubkey> = op_context.get_signers(), provider_key_roles: list<provider_key_role> = [provider_key_role.main]) {
    require(empty(provider_auth_blockchain @* { provider }), "Blockchain authentication is enabled for provider %s".format(provider.pubkey));
    require(provider_is_signer_of_signers(provider.pubkey, tx_signers, provider_key_roles),
        "Operation must be signed by provider key(s)");
    require(provider.active, "Provider is not enabled");
    return provider;
}

function require_pubkey(pubkey) {
    require(
            pubkey.size() == 33 // ECDSA
            or pubkey.size() == 1336, // Dilithium
        "Wrong size of public key: %d".format(pubkey.size()));
}


/** Extension requirements */

function require_subnode_image(name) = require(subnode_image @? { name }, "Subnode image %s not found".format(name));

function require_subnode_jar_extension(name) = require(subnode_jar_extension @? { name }, "Subnode JAR extension %s not found".format(name));

function require_cluster_compatible_subnode_jar_extension(name, cluster): subnode_jar_extension {
    val subnode_jar_extension = require_subnode_jar_extension(name);
    require(subnode_jar_extension.active, "Subnode JAR extension %s is not active".format(name));
    require(subnode_jar_extension.subnode_jar_extension_type == subnode_jar_extension_type.COMMON or not empty(cluster_subnode_jar_extension @? { cluster, subnode_jar_extension }),
        "Subnode JAR extension %s is not compatible with cluster %s".format(name, cluster.name));
    return subnode_jar_extension;
}
