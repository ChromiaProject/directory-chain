
function last_proposal(state: proposal_state? = proposal_state.PENDING, type: proposal_type? = null): proposal {
    return proposal @ {
        state == null or .state == state,
        type == null or .proposal_type == type
    } ( @omit @sort_desc .rowid, $) limit 1;
}

function vote_for_last_proposal(approver: rell.test.keypair, vote: boolean = true, type: proposal_type? = null) {
    val proposal_id = last_proposal(type = type).rowid.to_integer();
    rell.test.tx().op(
        make_vote(approver.pub, proposal_id, vote)
    ).sign(approver.priv).run();
}
