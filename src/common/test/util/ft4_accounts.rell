@test module;

namespace ft4 {
    import lib.ft4.external.accounts.strategies;
    import test_accounts: lib.ft4.test.core.accounts;
}

/**
 * Registers an account using the keypair `rell.test.keypairs.alice` using ft signing.
 *
 * @param flags                 list of strings, representing permissions that this auth descriptor will get. Defaults to `["A", "T"]`
 * @param register_account_op   the operation that will be used to create the account, defaults to `strategies.register_account()`
 */
function register_alice(
    flags: list<text> = ["A", "T"],
    register_account_op: rell.test.op = ft4.strategies.register_account()
) {
    return ft4.test_accounts.register_account_open(rell.test.keypairs.alice, flags, register_account_op);
}

