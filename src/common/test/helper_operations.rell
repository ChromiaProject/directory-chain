module;

import ^^.*;

operation create_blockchain(
    rid: byte_array,
    name: text,
    system: boolean = false,
    state: blockchain_state = blockchain_state.RUNNING
) {
    create blockchain(rid, name, system, state);
}

operation create_subnode_image(name, url: text, digest: text, subnode_image_type, provider_pubkey: pubkey, active: boolean) {
    create subnode_image(name, url, digest, subnode_image_type, require_provider(provider_pubkey), description = "", active);
}

operation set_latest_blockchain_configuration_values_op(blockchain, config_map: map<text, gtv>) {
    set_latest_blockchain_configuration_values(blockchain, config_map);
}

operation require_provider_auth_with_rate_limit_op(provider, provider_key_role: list<provider_key_role> = [provider_key_role.main]) {
    require_provider_auth_with_rate_limit(provider, provider_key_role);
}

operation require_provider_auth_op(pubkey, provider_key_role: list<provider_key_role> = [provider_key_role.main]) {
    require_provider_auth(pubkey, provider_key_role);
}
