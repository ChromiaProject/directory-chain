module;

import ^^.*;
import ^^.blockchain_config_delay.*;

operation set_blockchain_config_delay_op(blockchain, delay: integer) {
    var conf: map<text, gtv> = map();
    conf[DIRECTORY_CHAIN_CONFIG_KEY] = [DIRECTORY_CHAIN_CONFIG_DELAY_CONFIG_KEY: (delay).to_gtv()].to_gtv();
    set_latest_blockchain_configuration_values(blockchain, conf);
}

operation create_blockchain(
    rid: byte_array,
    name: text,
    system: boolean = false,
    state: blockchain_state = blockchain_state.RUNNING
) {
    create blockchain(rid, name, system, state);
}

operation update_blockchain_state(
    rid: byte_array,
    state: blockchain_state,
) {
    update blockchain @ { rid } (.state = state);
}

operation add_blockchain_to_container(
    rid: byte_array,
    container_name: text,
) {
    create container_blockchain(container @ { .name == container_name }, blockchain @ { rid });
}

operation create_subnode_image(name, url: text, digest: text, subnode_image_type, provider_pubkey: pubkey,
        active: boolean, base_compute_requests: integer = 0) {
    create subnode_image(name, url, digest, subnode_image_type, require_provider(provider_pubkey), description = "",
        active, base_compute_requests);
}

operation create_subnode_jar_extension(name, jar: byte_array, subnode_jar_extension_type, provider_pubkey: pubkey,
        active: boolean, base_compute_requests: integer = 0) {
    create subnode_jar_extension(name, jar = jar, hash = crypto.sha256(jar), subnode_jar_extension_type, require_provider(provider_pubkey), description = "",
        active);
}

operation set_latest_blockchain_configuration_values_op(blockchain, config_map: map<text, gtv>) {
    set_latest_blockchain_configuration_values(blockchain, config_map);
}

operation provider_rate_limit_op(provider, cost: integer = 1) {
    provider_rate_limit(provider, cost);
}

operation create_blockchain_and_add_to_container_op(container, blockchain_name: text, blockchain_rid: pubkey) {
    val blockchain = create blockchain(
        blockchain_rid,
        blockchain_name,
        false
    );

    create container_blockchain(container, blockchain);
}

operation create_cluster_impl_op(me: provider, name, governor: voter_set, providers: list<pubkey>, cluster_creation_data) {
    create_cluster_impl(me, name, governor, providers, cluster_creation_data);
}


operation _create_blockchain_replica_node_op(blockchain_rid: byte_array, node_pub: pubkey) {
    create blockchain_replica_node(blockchain @ { .rid == blockchain_rid }, node @ { node_pub });
}

operation _create_blockchain_configuration_signers_op(blockchain_rid: byte_array, height: integer, signers: list<pubkey>) {
    create blockchain_configuration_signers(blockchain @ { .rid == blockchain_rid }, height, signers.to_gtv().to_bytes());
}

operation _create_compressed_configuration_part_op(hash: byte_array, data: byte_array) {
    create compressed_blockchain_configuration_part(hash, data);
}

operation _create_importing_foreign_blockchain_op(blockchain_rid: byte_array, pubkey: pubkey, host: text, port: integer, api_url: text, chain0_rid: byte_array, final_height: integer = -1) {
    create importing_foreign_blockchain(blockchain_rid, pubkey, host, port, api_url, chain0_rid, final_height);
}

operation _create_moving_blockchain_op(blockchain_rid: byte_array, source_container: text, destination_container: text, final_height: integer) {
    create moving_blockchain(
        blockchain = blockchain @ { .rid == blockchain_rid },
        source = container @ { .name == source_container },
        destination = container @ { .name == destination_container },
        final_height = final_height
    );
}

operation _create_unarchiving_blockchain_op(blockchain_rid: byte_array, source_container: text, destination_container: text, final_height: integer) {
    create unarchiving_blockchain(
        blockchain = blockchain @ { .rid == blockchain_rid },
        source = container @ { .name == source_container },
        destination = container @ { .name == destination_container },
        final_height = final_height
    );
}

operation add_blockchain_op(
    base_configuration: byte_array,
    signers: list<pubkey>,
    name: text,
    container,
    system: boolean = false,
    state: blockchain_state = blockchain_state.RUNNING
) {
    add_blockchain(base_configuration, signers, name, container, system, state);
}

operation create_test_voter_set_with_provider_member(name: text, provider) {
    val voter_set = create_voter_set_internal(name, 0);
    create voter_set_member(voter_set, provider);
}
