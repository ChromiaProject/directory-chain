module;

struct module_args {
    node_image: image_data;
    default_subnode_image: image_data;
}

struct image_data {
    url: text;
    tag: text;
    digest: text;
}

query get_node_image(): image_data = node_image();

function node_image(): image_data = chain_context.args.node_image;

query get_default_subnode_image(): image_data = default_subnode_image();

function default_subnode_image(): image_data = chain_context.args.default_subnode_image;
