@test module;

import ^^.*;

function test_node_version() {
    assert_equals(get_node_image(), image_data(
        url="registry.gitlab.com/chromaway/postchain-chromia/chromaway/chromia-server",
        tag="0.0.0",
        digest="sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    ));
}

function test_subnode_version() {
    assert_equals(get_default_subnode_image(), image_data(
        url="registry.gitlab.com/chromaway/postchain-chromia/chromaway/chromia-subnode",
        tag="0.0.0",
        digest="sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    ));
}
