function test_blockchain_move_within_a_node_fail_due_to_nonidentical_deployers() {
    // setup
    setup_module(provider_quota_max_containers = 2, cluster_anchoring_config = ["any": "value".to_gtv()]);
    var conf = apply_required_configuration_properties();

    rell.test.tx().op(
        create_cluster(initial_provider.pub, "s1", voter_sets.system_p, [initial_provider.pub]),
        create_container(initial_provider.pub, "c1a", "s1", 0, [initial_provider.pub]),
        create_container(initial_provider.pub, "c1b", "s1", 0, [initial_provider.pub]),
        update_node_with_units(initial_provider.pub, test_node.pubkey, cluster_units = 3),
        add_node_to_cluster(initial_provider.pub, test_node.pubkey, "s1"),
        propose_blockchain(initial_provider.pub, conf.to_gtv().to_bytes(), "foo_chain", "c1a")
    ).sign(initial_provider).run();
    val foo_chain = blockchain @ { "foo_chain" };

    // 1. start blockchain move
    rell.test.tx().op(
        propose_blockchain_move(initial_provider.pub, foo_chain.rid, "c1b")
    ).sign(initial_provider).run();

    // 2. change source container deployer by adding Bob
    rell.test.tx().op(
        create_test_provider("bob", rell.test.pubkeys.bob, provider_tier.NODE_PROVIDER),
        add_container_deployer(initial_provider.pub, "c1a", rell.test.pubkeys.bob)
    ).sign(initial_provider).run();

    // 3. try to finish blockchain move, must fail
    rell.test.tx().op(
        propose_blockchain_move_finish(initial_provider.pub, foo_chain.rid, 123)
    ).sign(initial_provider).run_must_fail("Deployers of source and destination container must be identical");
}

function test_blockchain_move_within_a_node() {
    // setup
    setup_module(provider_quota_max_containers = 2, cluster_anchoring_config = ["any": "value".to_gtv()]);
    val ip = provider @ { initial_provider.pub };
    var conf = apply_required_configuration_properties();

    rell.test.tx().op(
        // s1 / c1
        create_cluster(initial_provider.pub, "s1", voter_sets.system_p, [initial_provider.pub]),
        create_container(initial_provider.pub, "c1a", "s1", 0, [initial_provider.pub]),
        create_container(initial_provider.pub, "c1b", "s1", 0, [initial_provider.pub]),
        update_node_with_units(initial_provider.pub, test_node.pubkey, cluster_units = 3),
        add_node_to_cluster(initial_provider.pub, test_node.pubkey, "s1"),
        // proposing blockchain to the c1a
        propose_blockchain(initial_provider.pub, conf.to_gtv().to_bytes(), "foo_chain", "c1a")
    ).sign(initial_provider).run();
    val foo_chain = blockchain @ { "foo_chain" };

    // 1. start blockchain move
    rell.test.tx().op(
        propose_blockchain_move(initial_provider.pub, foo_chain.rid, "c1b")
    ).sign(initial_provider).run();
    // asserting moving_blockchain
    val mv_bc = moving_blockchain @? { foo_chain,
        .source.name == "c1a", .destination.name == "c1b",
        .final_height == -1, .remove_on_nodes == x"", .keep_src_as_replica == true
    };
    assert_not_null(mv_bc);
    // same-cluster move: no replicas needed (node already syncing as signer)
    assert_true(empty(blockchain_replica_node @* { foo_chain }));
    // blockchain still belongs to c1a (src)
    assert_equals(container_blockchain @ { foo_chain } ( .container.name ), "c1a");
    // test_node runs the blockchain
    assert_node_runs_blockchain(test_node.pubkey, foo_chain.rid);

    // 2. finish blockchain moving
    rell.test.tx().op(
        propose_blockchain_move_finish(initial_provider.pub, foo_chain.rid, 123)
    ).sign(initial_provider).run();
    // asserting migrating_blockchain_info through NM API
    /// for node0
    val info = nm_get_migrating_blockchain_node_info(test_node.pubkey, foo_chain.rid);
    assert_true(exists(info));
    assert_equals(info!!.source_container, "c1a");
    assert_equals(info.destination_container, "c1b");
    assert_equals(info.is_source_node, true);
    assert_equals(info.is_destination_node, true);
    assert_equals(info.final_height, 123);
    // new config
    assert_not_null(blockchain_configuration @? { foo_chain, 124 });
    // new signers config
    val new_signers = blockchain_configuration_signers @? { foo_chain, 124 } .signers;
    assert_true(exists(new_signers));
    assert_equals(list<pubkey>.from_gtv(gtv.from_bytes(new_signers!!)), [test_node.pubkey]);
    // test_node temporarily added as replica at finish time (until configuration_updated)
    assert_equals(blockchain_replica_node @* { foo_chain } ( .node.pubkey ), [test_node.pubkey]);
    // blockchain moved to c1b at finish time
    assert_equals(container_blockchain @ { foo_chain } ( .container.name ), "c1b");
    // test_node runs the blockchain
    assert_node_runs_blockchain(test_node.pubkey, foo_chain.rid);

    // simulate ICMF message receiving
    _build_block_after_moving("s1", foo_chain.rid, 124);

    // within-node move: src == dst cluster, so no replicas remain after finalization
    assert_true(empty(blockchain_replica_node @* { foo_chain }));
    // no moving state for foo_chain
    assert_true(empty(moving_blockchain @? { foo_chain }));
    // blockchain remains in c1b after finalization
    assert_equals(container_blockchain @ { foo_chain } ( .container.name ), "c1b");
    // asserting migrating_blockchain_info through NM API
    assert_null(nm_get_migrating_blockchain_node_info(test_node.pubkey, foo_chain.rid));
    // bc state didn't change (RUNNING)
    assert_equals(foo_chain.state, blockchain_state.RUNNING);
    // test_node still runs the blockchain
    assert_node_runs_blockchain(test_node.pubkey, foo_chain.rid);

    // Moving blockchain back to "c1a"
    rell.test.tx().op(
        propose_blockchain_move(initial_provider.pub, foo_chain.rid, "c1a"),
        propose_blockchain_move_finish(initial_provider.pub, foo_chain.rid, 456)
    ).sign(initial_provider).run();
    val info2 = nm_get_migrating_blockchain_node_info(test_node.pubkey, foo_chain.rid);
    assert_true(exists(info2));
    assert_equals(info2!!.source_container, "c1b");
    assert_equals(info2.destination_container, "c1a");
    assert_equals(info2.is_source_node, true);
    assert_equals(info2.is_destination_node, true);
    assert_equals(info2.final_height, 456);
    assert_node_runs_blockchain(test_node.pubkey, foo_chain.rid);
    _build_block_after_moving("s1", foo_chain.rid, 457);
    assert_null(nm_get_migrating_blockchain_node_info(test_node.pubkey, foo_chain.rid));
    assert_equals(container_blockchain @ { foo_chain } ( .container.name ), "c1a");
    assert_node_runs_blockchain(test_node.pubkey, foo_chain.rid);
}

function test_blockchain_move_within_node_with_removing_src_and_dst_containers() {
    // setup
    setup_module(provider_quota_max_containers = 2, cluster_anchoring_config = ["any": "value".to_gtv()]);
    val ip = provider @ { initial_provider.pub };
    var conf = apply_required_configuration_properties();

    rell.test.tx().op(
        // s1 / c1
        create_cluster(initial_provider.pub, "s1", voter_sets.system_p, [initial_provider.pub]),
        create_container(initial_provider.pub, "c1", "s1", 0, [initial_provider.pub]),
        create_container(initial_provider.pub, "c2", "s1", 0, [initial_provider.pub]),
        update_node_with_units(initial_provider.pub, test_node.pubkey, cluster_units = 3),
        add_node_to_cluster(initial_provider.pub, test_node.pubkey, "s1"),
        // proposing blockchain to the c1
        propose_blockchain(initial_provider.pub, conf.to_gtv().to_bytes(), "foo_chain", "c1")
    ).sign(initial_provider).run();
    val foo_chain = blockchain @ { "foo_chain" };

    // 1. start blockchain move
    rell.test.tx().op(
        propose_blockchain_move(initial_provider.pub, foo_chain.rid, "c2")
    ).sign(initial_provider).run();
    // asserting moving_blockchain
    val mv_bc = moving_blockchain @? { foo_chain,
        .source.name == "c1", .destination.name == "c2",
        .final_height == -1, .remove_on_nodes == x"", .keep_src_as_replica == true
    };
    assert_not_null(mv_bc);
    // test_node runs the blockchain
    assert_node_runs_blockchain(test_node.pubkey, foo_chain.rid);

    // Trying to remove container c1 and c2
    assert_false(empty(get_container_blockchain("c1")));  // c1 still has foo_chain
    rell.test.tx().op(
        remove_container(initial_provider.pub, "c1")
    ).sign(initial_provider).run_must_fail("Container c1 is currently a source in a moving blockchain process and can't be deleted");
    assert_true(empty(get_container_blockchain("c2")));  // c2 has no blockchains yet
    rell.test.tx().op(
        remove_container(initial_provider.pub, "c2")
    ).sign(initial_provider).run_must_fail("Container c2 is currently a destination in a moving blockchain process and can't be deleted");

    // 2. finish blockchain move
    rell.test.tx().op(
        propose_blockchain_move_finish(initial_provider.pub, foo_chain.rid, 123)
    ).sign(initial_provider).run();

    // The move is not fully finalized yet (configuration_updated ICMF message not received).
    // Container has been switched at finish time: c1 is now empty, c2 has foo_chain.
    // Trying to remove container c1 and c2 still fails because `moving_blockchain` still exists.
    assert_true(empty(get_container_blockchain("c1")));   // c1 no longer has foo_chain
    rell.test.tx().op(
        remove_container(initial_provider.pub, "c1")
    ).sign(initial_provider).run_must_fail("Container c1 is currently a source in a moving blockchain process and can't be deleted");
    assert_false(empty(get_container_blockchain("c2")));  // c2 now has foo_chain
    rell.test.tx().op(
        remove_container(initial_provider.pub, "c2")
    ).sign(initial_provider).run_must_fail("Container c2 is currently a destination in a moving blockchain process and can't be deleted");
    // test_node runs the blockchain
    assert_node_runs_blockchain(test_node.pubkey, foo_chain.rid);

    // simulate ICMF message receiving
    _build_block_after_moving("s1", foo_chain.rid, 124);
    // test_node still runs the blockchain after finalization
    assert_node_runs_blockchain(test_node.pubkey, foo_chain.rid);

    // remove src container "c1" succeeds
    assert_true(empty(get_container_blockchain("c1")));
    rell.test.tx().op(
        remove_container(initial_provider.pub, "c1")
    ).sign(initial_provider).run();

    // remove dst container "c2" succeeds
    assert_true(exists(get_container_blockchain("c2")));
    rell.test.tx().op(
        remove_container(initial_provider.pub, "c2")
    ).sign(initial_provider).run();
}

function test_cancel_blockchain_move_within_node() {
    // setup
    setup_module(provider_quota_max_containers = 2, cluster_anchoring_config = ["any": "value".to_gtv()]);
    val ip = provider @ { initial_provider.pub };
    var conf = apply_required_configuration_properties();

    rell.test.tx().op(
        // s1 / c1
        create_cluster(initial_provider.pub, "s1", voter_sets.system_p, [initial_provider.pub]),
        create_container(initial_provider.pub, "c1a", "s1", 0, [initial_provider.pub]),
        create_container(initial_provider.pub, "c1b", "s1", 0, [initial_provider.pub]),
        update_node_with_units(initial_provider.pub, test_node.pubkey, cluster_units = 3),
        add_node_to_cluster(initial_provider.pub, test_node.pubkey, "s1"),
        // proposing blockchain to the c1a
        propose_blockchain(initial_provider.pub, conf.to_gtv().to_bytes(), "foo_chain", "c1a")
    ).sign(initial_provider).run();
    val foo_chain = blockchain @ { "foo_chain" };

    // 1. try to cancel the blockchain move for a blockchain that is not being moved
    rell.test.tx().op(
        propose_blockchain_move_cancel(initial_provider.pub, foo_chain.rid)
    ).sign(initial_provider)
        .run_must_fail("Blockchain %s is not being moved".format(foo_chain.rid));

    // 2. start blockchain move
    rell.test.tx().op(
        propose_blockchain_move(initial_provider.pub, foo_chain.rid, "c1b")
    ).sign(initial_provider).run();
    assert_not_null(moving_blockchain @? { foo_chain });
    // blockchain stays in c1a during move
    assert_not_null(container_blockchain @? { foo_chain, .container.name == "c1a" });
    assert_null(container_blockchain @? { foo_chain, .container.name == "c1b" });
    // test_node runs the blockchain
    assert_node_runs_blockchain(test_node.pubkey, foo_chain.rid);

    // 3. cancel the blockchain move
    rell.test.tx().op(
        propose_blockchain_move_cancel(initial_provider.pub, foo_chain.rid)
    ).sign(initial_provider).run();
    assert_null(moving_blockchain @? { foo_chain });
    assert_not_null(container_blockchain @? { foo_chain, .container.name == "c1a" });
    assert_null(container_blockchain @? { foo_chain, .container.name == "c1b" });
    // test_node still runs the blockchain after cancel
    assert_node_runs_blockchain(test_node.pubkey, foo_chain.rid);

    // 4. move blockchain again and try to cancel after finalization
    rell.test.tx().op(
        propose_blockchain_move(initial_provider.pub, foo_chain.rid, "c1b"),
        propose_blockchain_move_finish(initial_provider.pub, foo_chain.rid, 123)
    ).sign(initial_provider).run();
    assert_not_null(moving_blockchain @? { foo_chain, .final_height == 123 });
    // blockchain moved to c1b at finish time
    assert_null(container_blockchain @? { foo_chain, .container.name == "c1a" });
    assert_not_null(container_blockchain @? { foo_chain, .container.name == "c1b" });
    // test_node runs the blockchain
    assert_node_runs_blockchain(test_node.pubkey, foo_chain.rid);
    rell.test.tx().op(
        propose_blockchain_move_cancel(initial_provider.pub, foo_chain.rid)
    ).nop().sign(initial_provider)
        .run_must_fail("Cannot cancel an already finalized blockchain move for blockchain %s".format(foo_chain.rid));
}
