function test_blockchain_move_invalid_src_and_dst_deployer_voter_set() {

    setup_module(provider_quota_max_containers = 2, cluster_anchoring_config = ["any": "value".to_gtv()]);
    var conf = apply_required_configuration_properties();

    // src: initial_provider & bob, dst: initial_provider
    rell.test.tx().op(
        create_test_provider("bob", rell.test.pubkeys.bob, provider_tier.NODE_PROVIDER),
        create_cluster(initial_provider.pub, "s1", voter_sets.system_p, [initial_provider.pub]),
        create_container(initial_provider.pub, "c1a", "s1", 0, [rell.test.pubkeys.bob,initial_provider.pub]),
        create_container(initial_provider.pub, "c1b", "s1", 0, [initial_provider.pub]),
        update_node_with_units(initial_provider.pub, test_node.pubkey, cluster_units = 3),
        add_node_to_cluster(initial_provider.pub, test_node.pubkey, "s1"),
        propose_blockchain(initial_provider.pub, conf.to_gtv().to_bytes(), "foo_chain", "c1a")
    ).sign(initial_provider).run();

    vote_for_last_proposal(rell.test.keypairs.bob);

    rell.test.tx().op(
        propose_blockchain_move(initial_provider.pub, blockchain @ { "foo_chain" } ( .rid ), "c1b")
    ).sign(initial_provider).run_must_fail("Deployers of source and destination container must be identical");
}
