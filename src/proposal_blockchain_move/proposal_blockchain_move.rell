import common.*;

entity pending_blockchain_move {
    key proposal;
    blockchain;
    destination: container;
    keep_src_as_replica: boolean = false;
}

/**
 * Propose a blockchain move
 * 
 * Permission: container deployer
 * 
 * Rate limit: actions
 * 
 * @param my_pubkey pubkey of provider
 */
operation propose_blockchain_move(my_pubkey: pubkey, @size(32) blockchain_rid: byte_array, destination_container: text, description: text = "", keep_src_as_replica: boolean = true) {
    val me = require_is_provider_with_rate_limit(my_pubkey, cost = chain_context.args.provider_quota_move_cost);

    val dst_container = validate_blockchain_move_proposal(blockchain_rid, me, destination_container);
    val blockchain = blockchain @ { blockchain_rid };

    val prop = create_proposal(proposal_type.blockchain_move_start, me, dst_container.deployer, description);
    val pending_blockchain_move = create pending_blockchain_move(prop, blockchain, dst_container, keep_src_as_replica);
    internal_vote(me, prop, true);
}

/**
 * Returns a proposal object for moving a blockchain.
 */
query get_blockchain_move_proposal(rowid?):
        (blockchain_rid: byte_array, blockchain_name: text, container: text, cluster: text)? {
    val proposal = get_latest_proposal(rowid, proposal_type.blockchain_import);
    if (proposal == null) return null;
    return pending_blockchain_move @ { proposal } (
        blockchain_rid = .blockchain.rid,
        blockchain_name = .blockchain.name,
        container = .destination.name,
        cluster = .destination.cluster.name
    );
}

@extend(apply_voting_result_handlers) function() = [proposal_type.blockchain_move_start.name: apply_blockchain_move(*)];
@extend(delete_proposal_handlers) function(): map<text, (proposal) -> unit> = [proposal_type.blockchain_move_start.name: delete_pending_blockchain_move(*)];
@extend(proposal_delay_time_handlers) function() = [proposal_type.blockchain_move_start.name: blockchain_move_proposal_delay_time_handler(*)];
@extend(proposal_delay_ids_handlers) function() = [proposal_type.blockchain_move_start.name: blockchain_move_proposal_delay_ids_handler(*)];

function blockchain_move_proposal_delay_time_handler(proposal): (blockchain: blockchain?, delay: integer) {
    return blockchain_config_delay_time_handler(pending_blockchain_move @? { proposal } ( .blockchain ));
}

function blockchain_move_proposal_delay_ids_handler(blockchain): list<rowid> {
    return pending_blockchain_move @* { blockchain } ( .proposal.rowid );
}

function apply_blockchain_move(proposal) {
    val pbm = pending_blockchain_move @ { proposal } ($.to_struct());
    validate_blockchain_move_proposal(pbm.blockchain.rid, pbm.proposal.proposed_by, pbm.destination.name);

    val src_container = container_blockchain @ { pbm.blockchain } (.container);

    // add dst cluster nodes as replicas so they can sync the blockchain before becoming signers;
    // skip nodes already in the src cluster (they are already syncing as signers)
    // and nodes already marked as replicas
    val dst_nodes_to_replicate_on = cluster_node @* {
        pbm.destination.cluster,
        .node not in cluster_node @* { src_container.cluster } (.node),
        .node not in blockchain_replica_node @* { pbm.blockchain } (.node)
    } (struct<blockchain_replica_node>(pbm.blockchain, .node));
    create blockchain_replica_node(dst_nodes_to_replicate_on);

    // blockchain stays in the src container; the container switch happens at the finish step
    // record which nodes were added so cancel can remove only those (not pre-existing manual replicas)
    create moving_blockchain(
        blockchain = pbm.blockchain,
        source = src_container,
        destination = pbm.destination,
        keep_src_as_replica = pbm.keep_src_as_replica,
        added_replica_nodes = (dst_nodes_to_replicate_on @* {} (.node)).to_gtv().to_bytes()
    );
}

function delete_pending_blockchain_move(proposal) {
    delete pending_blockchain_move @? { proposal };
}

function validate_blockchain_move_proposal(@size(32) blockchain_rid: byte_array, proposed_by: provider, destination_container: text) : container {

    // require blockchain state
    val blockchain = require_blockchain_states(blockchain_rid, [blockchain_state.RUNNING, blockchain_state.PAUSED]);
    require(not(blockchain.system), "Moving of system chains is not allowed: " + blockchain_rid);

    // require blockchain is not being moved right now
    require(empty(moving_blockchain @? { blockchain }), "Blockchain %s is being moved".format(blockchain.rid));
    require_no_pending_blockchain_action(blockchain);

    // containers
    val src_container = container_blockchain @ { blockchain } .container;
    val dst_container = require_container(destination_container);
    require(src_container != dst_container, "Source and destination containers must be different");
    // container deployers
    require_container_deployer(src_container, proposed_by);
    require_container_deployer(dst_container, proposed_by);
    require_container_deployers_identical(src_container, dst_container);
    // container limits
    require_container_is_not_full(dst_container);

    return dst_container;
}
