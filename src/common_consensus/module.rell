/**
 * This module contains shared logic to evaluate consensus for voting and provider auth modules.
 */

module;

enum common_consensus_result {
    pending,
    approved,
    rejected
}

namespace consensus_threshold {
    val majority = -1;
    val super_majority = 0;
}

function _compute_common_consensus_result(
    yes: integer,
    no: integer,
    max: integer,
    threshold: integer
): common_consensus_result {
    require(
        threshold >= -1 and threshold <= max,
        "Invalid threshold, must be in range [%d, %d] but was: %d"
            .format(
                -1,
                max,
                threshold
            )
    );
    require(yes + no <= max, "Too many votes");
    when (threshold) {
        -1 -> return _compute_common_consensus_result_majority(yes, no, max);
        0 -> return _compute_common_consensus_result_super_majority(yes, no, max);
        else -> return _compute_common_consensus_result_custom(yes, no, max, threshold);
    }
}

function _compute_common_consensus_result_custom(
    yes: integer,
    no: integer,
    max: integer,
    threshold: integer
): common_consensus_result {
    return _common_consensus_result(yes, no, max, threshold);
}

function _compute_common_consensus_result_majority(yes: integer, no: integer, max: integer): common_consensus_result {
    val required = max / 2 + 1;
    return _common_consensus_result(yes, no, max, required);
}

function _compute_common_consensus_result_super_majority(
    yes: integer,
    no: integer,
    max: integer
): common_consensus_result {
    val required = max - (max - 1) / 3;
    return _common_consensus_result(yes, no, max, required);
}

function _common_consensus_result(yes: integer, no: integer, max: integer, required: integer): common_consensus_result {
    log("Votes - positive: %d, negative: %d, required: %d, maximum: %d".format(yes, no, required, max));
    return when {
        yes >= required -> common_consensus_result.approved;
        no > max - required -> common_consensus_result.rejected;
        else -> common_consensus_result.pending;
    };
}

function is_valid_consensus_threshold(threshold: integer) {
    return
        threshold == consensus_threshold.majority or
        threshold == consensus_threshold.super_majority or
        threshold > 0;
}
