@test module;

import ^^.*;
import ^^^.economy_chain.test.helper_functions.*;
import ^^^.economy_chain.test.helper_operations.*;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.assets;
    import lib.ft4.auth;
    import test_utils: lib.ft4.test.utils;
}
import lib.auth;

struct module_args {
    auth_privkey: byte_array;
}

val auth_privkey = chain_context.args.auth_privkey;
val cluster_name = "Bob's cluster";

function test_remove_container_success() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(
        alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init, cluster_name = cluster_name, container_units = 2);

    val lease = lease @ { container_name };

    assert_equals(get_leases_by_account(alice.id).size(), 1);
    require(get_lease_by_container_name(container_name));

    do_remove_container(
        rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init + 4, current_lease = lease);

    assert_equals(get_leases_by_account(alice.id).size(), 0);
    assert_true(empty(get_lease_by_container_name(container_name)));
}

function test_remove_container_failure_not_owner() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val bob = require(do_create_account(rell.test.keypairs.bob, auth_privkey));
    val container_name = do_create_container(
        alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init + 7, cluster_name = cluster_name, container_units = 2);

    val lease = lease @ { container_name };

    assert_equals(get_leases_by_account(alice.id).size(), 1);
    require(get_lease_by_container_name(container_name));

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.privkeys.bob, remove_container(container_name))
    ).op(
        remove_container(container_name)
    ).run_must_fail("Lease for container container name was not created by you");
}

function test_remove_container_failure() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(
        alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init, cluster_name = cluster_name, container_units = 2);

    val lease = lease @ { container_name };

    assert_equals(get_leases_by_account(alice.id).size(), 1);
    require(get_lease_by_container_name(container_name));

    do_remove_container(
        rell.test.keypairs.alice, success = false, ticket_id = ticket_id_after_init + 4, current_lease = lease);

    assert_equals(get_leases_by_account(alice.id).size(), 1);
    require(get_lease_by_container_name(container_name));
}

function test_force_remove_container_success() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(
        alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init, cluster_name = cluster_name, container_units = 2);

    val lease = lease @ { container_name };

    assert_equals(get_leases_by_account(alice.id).size(), 1);
    require(get_lease_by_container_name(container_name));

    add_provider(rell.test.pubkeys.bob, system = true);

    rell.test.tx().op(
        force_remove_container(container_name)
    ).sign(rell.test.keypairs.bob).run();

    assert_events(("icmf_message", (
        topic = remove_container_topic,
        body = remove_container_message(ticket_id = null, container_name = container_name).to_gtv()
    ).to_gtv_pretty()));

    assert_equals(get_leases_by_account(alice.id).size(), 0);
    assert_true(empty(get_lease_by_container_name(container_name)));
}

function test_force_remove_container_failure_not_system_provider() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(
        alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init, cluster_name = cluster_name, container_units = 2);

    val lease = lease @ { container_name };

    assert_equals(get_leases_by_account(alice.id).size(), 1);
    require(get_lease_by_container_name(container_name));

    add_provider(rell.test.pubkeys.bob, system = false);

    rell.test.tx().op(
        force_remove_container(container_name)
    ).sign(rell.test.keypairs.bob).run_must_fail("Expected system provider signature");
}

function do_remove_container(
    keypair: rell.test.keypair,
    success: boolean,
    ticket_id: integer,
    current_lease: lease,
) {
    val container_name = current_lease.container_name;

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(keypair.priv, remove_container(container_name))
    ).op(
        remove_container(container_name)
    ).run();
    val tx_rid = transaction @ {} (@sort_desc @omit .rowid, .tx_rid) limit 1;

    assert_events(("icmf_message", (
        topic = remove_container_topic,
        body = remove_container_message(ticket_id = ticket_id, container_name = container_name).to_gtv()
    ).to_gtv_pretty()));

    val pending_ticket = container_ticket_data(ticket_id, ticket_type.REMOVE_CONTAINER, ticket_state.PENDING, error_message = "", container_name = container_name);
    assert_equals(require(get_remove_container_ticket_by_id(ticket_id)), pending_ticket);
    assert_equals(require(get_remove_container_ticket_by_transaction(tx_rid)), pending_ticket);

    rell.test.tx().op(
        icmf_message_op(x"", ticket_container_result_topic, ticket_container_result_message(ticket_id = ticket_id, error_message = if (success) null else "error").to_gtv())
    ).run();
    val done_ticket = container_ticket_data(
        ticket_id = ticket_id,
        type = ticket_type.REMOVE_CONTAINER,
        state = if (success) ticket_state.SUCCESS else ticket_state.FAILURE,
        error_message = if (success) "" else "error",
        container_name = container_name
    );
    assert_equals(require(get_remove_container_ticket_by_id(ticket_id)), done_ticket);
    assert_equals(require(get_remove_container_ticket_by_transaction(tx_rid)), done_ticket);
}
