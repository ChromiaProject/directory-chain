/**
 * The purpose of this module is to migrate data in the same way we do in EC.
 */

module;

import common.*;
import publish_directory_chain.*;

/**
 * Migration statuses to only run a migration once.
 */
object migration_completed {
    mutable provider_multi_key: boolean = false;
    mutable send_container_blockchain_messages: boolean = false;
}

@extend(before_begin_block)
function begin_block_migration(height: integer) {

    if (not migration_completed.provider_multi_key) {
        migration_completed.provider_multi_key = true;
        migrate_provider_keys();
    }

    if (not migration_completed.send_container_blockchain_messages) {
        migration_completed.send_container_blockchain_messages = true;
        send_container_blockchain_messages();
    }
}

/**
  * Called once to create a provider key entities to support multi key for provider authentication.
  */
function migrate_provider_keys() {

    log("Migrate and create provider multi key entities...");

    for (provider in provider @* {}) {

        log("Migrating provider %s to multi key".format(provider.pubkey));

        _add_provider_key(provider.pubkey, provider.pubkey, provider_key_role.main);
    }
}


/**
  * Called once to publish DC container_blockchain entities to L_container_blockchain_update topic.
  */
function send_container_blockchain_messages() {

    log("Publish all container_blockchains entities to %s topic".format(container_blockchain_update_topic));

    for (container_blockchain_entity in container_blockchain @* {}) {

        log("Send container_blockchain message for: %S".format(container_blockchain_entity));

        send_container_blockchain_message(container_blockchain_entity.container, container_blockchain_entity.blockchain, false);
    }
}