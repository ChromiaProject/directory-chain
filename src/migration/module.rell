/**
 * The purpose of this module is to migrate data in the same way we do in EC.
 */

module;

import common.*;
import publish_directory_chain.*;
import economy_chain_in_directory_chain.*;

struct module_args {
    should_migrate_subnode_jar_from_timestamp: timestamp = -1;
}

/**
 * Migration statuses to only run a migration once.
 */
object migration_completed {
    mutable provider_multi_key: boolean = false;
    mutable send_container_blockchain_messages: boolean = false;
    mutable remove_system_voter_set: boolean = false;
    mutable sync_provider_name_and_url_to_ec: boolean = false;
    mutable pcu_cleanup_excluded_signers_for_removed_chains: boolean = false;
    mutable migrate_subnode_jar_proposals: boolean = false;
}

@extend(on_begin_block)
function begin_block_migration(height: integer) {

    if (not migration_completed.send_container_blockchain_messages) {
        migration_completed.send_container_blockchain_messages = true;
        send_container_blockchain_messages();
    }

    if (not migration_completed.remove_system_voter_set) {
        if (not try_call(remove_system_voter_set(*))) {
            log("Failed to remove system voter set");
        }
    }

    if (not migration_completed.sync_provider_name_and_url_to_ec) {
        if (not try_call(sync_provider_name_and_url_to_ec(*))) {
            log("Failed to sync provider name and url to EC");
        }
    }

    if (not migration_completed.pcu_cleanup_excluded_signers_for_removed_chains) {
        if (not try_call(pcu_cleanup_excluded_signers_for_removed_chains(*))) {
            log("Failed to cleanup excluded signers for removed chains");
        }
    }

    if (chain_context.args.should_migrate_subnode_jar_from_timestamp != -1 and not migration_completed.migrate_subnode_jar_proposals) {
        if (not try_call(migrate_subnode_jar_proposals(chain_context.args.should_migrate_subnode_jar_from_timestamp, *))) {
            log("Failed to migrate subnode JAR proposals");
        }
    }
}

/**
  * Called once to publish DC container_blockchain entities to L_container_blockchain_update topic.
  */
function send_container_blockchain_messages() {

    log("Publish all container_blockchains entities to %s topic".format(container_blockchain_update_topic));

    for (container_blockchain_entity in container_blockchain @* {}) {

        log("Send container_blockchain message for: %S".format(container_blockchain_entity));

        send_container_blockchain_message(container_blockchain_entity.container, container_blockchain_entity.blockchain, false);
    }
}

function remove_system_voter_set() {
    val system_vs = voter_set @? { "SYSTEM" };
    if (exists(system_vs)) {
        update voter_set_governance @* { .governor == system_vs } ( .governor = system_p_voter_set() );
        delete voter_set_governance @* { .voter_set == system_vs };
        delete system_vs;
    }
    migration_completed.remove_system_voter_set = true;
}

function sync_provider_name_and_url_to_ec() {
    log("Sending provider name and url to economy chain...");

    for (p in provider @* {}) {
        send_provider_update_message(p);
    }

    migration_completed.sync_provider_name_and_url_to_ec = true;
}

function pcu_cleanup_excluded_signers_for_removed_chains() {
    log("Cleaning up excluded signers for removed chains...");

    delete signer_excluded_from_pending_configuration @* { .blockchain.state == blockchain_state.REMOVED };
    
    migration_completed.pcu_cleanup_excluded_signers_for_removed_chains = true;
}

function migrate_subnode_jar_proposals(bad_timestamp: timestamp) {
    log("Migrating subnode JAR proposals...");

    val wrong_types = [
    	proposal_type.container_action,
    	proposal_type.container_configuration,
    	proposal_type.subnode_jar_extension,
    	proposal_type.subnode_jar_extension_state,
    ];

    update proposal @* {
    	.proposal_type in wrong_types,
    	.timestamp >= bad_timestamp
    } (
    	.proposal_type = when (.proposal_type) {
    	    proposal_type.container_action -> proposal_type.subnode_jar_extension;
    	    proposal_type.container_configuration -> proposal_type.subnode_jar_extension_state;
    	    proposal_type.subnode_jar_extension -> proposal_type.container_action;
    	    proposal_type.subnode_jar_extension_state -> proposal_type.container_configuration;
    	    else -> .proposal_type; // Should never happen but won't compile otherwise
    	}
    );

    migration_completed.migrate_subnode_jar_proposals = true;
}
