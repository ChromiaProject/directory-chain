@test module;

import ^^.*;
import ^.helper_operations.*;
import common.*;
import common.test.setup.*;
import common.test.util.*;
import roles.test.ops.*;
import common.test.helper_operations.*;
import publish_directory_chain.test.helpers.*;
import housekeeping.test.helper_operations.*;

function test_send_container_blockchain_messages() {
    val BLOCKCHAIN_RID_1 = byte_array.from_hex("F435688B2F74933C71F8AA1952E1CFBCDAA421EF378A441EFF4EC5900896F1FA");
    val BLOCKCHAIN_RID_2 = byte_array.from_hex("2222688B2F74933C71F8AA1952E1CFBCDAA421EF378A441EFF4EC5900896F1FA");

    val pubkey1 = rell.test.pubkeys.charlie;
    val pubkey2 = rell.test.pubkeys.bob;

    rell.test.block().run();
    rell.test.tx().op(
        create_container_from_container_name_op("container1", pubkey1),
        create_container_from_container_name_op("container2", pubkey2),
        create_blockchain_op(BLOCKCHAIN_RID_1,"blockchain1"),
        create_blockchain_op(BLOCKCHAIN_RID_2,"blockchain2"),
    ).run();

    val container1 = container @ { "container1" };
    val blockchain1 = blockchain @ { BLOCKCHAIN_RID_1};
    val container2 = container @ { "container2" };
    val blockchain2 = blockchain @ { BLOCKCHAIN_RID_2};

    rell.test.tx().op(
        create_container_blockchain_op(container1, blockchain1),
        create_container_blockchain_op(container2, blockchain2),
        set_send_container_blockchain_messages_false()
    ).run();

    rell.test.tx().op(
        begin_block_migration_op()
    ).run();

    assert_events(
        ("icmf_message", (
            topic = container_blockchain_update_topic,
            body = container_blockchain_update_message(
            container_name = "container1",
            blockchain_rid = BLOCKCHAIN_RID_1,
            deleted = false).to_gtv()).to_gtv_pretty()
        ),
        ("icmf_message", (
            topic = container_blockchain_update_topic,
            body = container_blockchain_update_message(
            container_name = "container2",
            blockchain_rid = BLOCKCHAIN_RID_2,
            deleted = false).to_gtv()).to_gtv_pretty()
        )
    );

    assert_true(migration_completed.send_container_blockchain_messages);

    rell.test.tx().op(
        begin_block_migration_op()
    ).nop().run();

    assert_events();

}

function test_begin_block_migration_remove_system_voter_set() {

    rell.test.tx().op(
        set_remove_system_voter_set_false(),
        create_voter_set_internal_op("SYSTEM", 1),
        create_voter_set_internal_op("SYSTEM_P", 1)
    ).nop().run();

    assert_true(exists(voter_set @? { "SYSTEM" }));
    assert_true(exists(voter_set_governance @? { .voter_set.name == "SYSTEM" }));
    assert_false(migration_completed.remove_system_voter_set);

    rell.test.block().run();

    assert_true(empty(voter_set @? { "SYSTEM" }));
    assert_true(empty(voter_set_governance @? { .voter_set.name == "SYSTEM" }));
    assert_true(migration_completed.remove_system_voter_set);
}

function test_pcu_cleanup_excluded_signers_for_removed_chains() {
    val BLOCKCHAIN_RID_1 = byte_array.from_hex("1111111111111111111111111111111111111111111111111111111111111111");
    val BLOCKCHAIN_RID_2 = byte_array.from_hex("2222222222222222222222222222222222222222222222222222222222222222");
    val pubkey1 = rell.test.pubkeys.alice;
    val node0 = rell.test.pubkeys.bob;
    val node1 = rell.test.pubkeys.charlie;

    // Setup environment
    rell.test.block().run();
    rell.test.tx().op(
        create_container_from_container_name_op("container1", pubkey1),
        set_container_latest_deleted_bc_time_op("container1"),
        create_blockchain_op(BLOCKCHAIN_RID_1,"blockchain1"),
        create_blockchain_op(BLOCKCHAIN_RID_2,"blockchain2"),
    ).run();

    val container1 = container @ { "container1" };
    val blockchain1 = blockchain @ { BLOCKCHAIN_RID_1};
    val blockchain2 = blockchain @ { BLOCKCHAIN_RID_2};

    rell.test.tx().op(
        create_container_blockchain_op(container1, blockchain1),
        create_container_blockchain_op(container1, blockchain2),
    ).run();
    
    // Setup test case data
    rell.test.tx().op(
        set_pcu_cleanup_excluded_signers_for_removed_chains_false(),
        setup_signer_excluded_from_pending_configuration_op(blockchain1, x"00", node0),
        setup_signer_excluded_from_pending_configuration_op(blockchain2, x"01", node1),
        // Remove blockchain1
        set_blockchain_state_op(blockchain1, blockchain_state.REMOVED),
    ).nop().run();

    // Verify test case data
    assert_false(migration_completed.pcu_cleanup_excluded_signers_for_removed_chains);
    assert_true(exists(signer_excluded_from_pending_configuration @? { .blockchain == blockchain1, .pubkey == node0 }));
    assert_true(exists(signer_excluded_from_pending_configuration @? { .blockchain == blockchain2, .pubkey == node1 }));

    // Run migration
    rell.test.block().run();

    // Verify migration result
    assert_true(migration_completed.pcu_cleanup_excluded_signers_for_removed_chains);
    assert_false(exists(signer_excluded_from_pending_configuration @? { .blockchain == blockchain1, .pubkey == node0 }));
    assert_true(exists(signer_excluded_from_pending_configuration @? { .blockchain == blockchain2, .pubkey == node1 }));
}

function test_migrating_proposals() {
    setup_module();

    val provider = initial_provider;
    val vs = system_p_voter_set();

    rell.test.tx().op(
        create_proposal_with_type(provider.pub, vs, proposal_type.container_action)
    ).sign(provider).run();
    val old_container_action_proposal = last_proposal();

    rell.test.tx().op(
        create_proposal_with_type(provider.pub, vs, proposal_type.container_configuration)
    ).sign(provider).run();
    val old_container_configuration_proposal = last_proposal();

    // Simulate bad config
    val bad_config_apply_timestamp = rell.test.last_block_time - 1;

    rell.test.tx().op(
        create_proposal_with_type(provider.pub, vs, proposal_type.subnode_jar_extension)
    ).sign(provider).run();
    val bad_container_action_proposal = last_proposal();

    rell.test.tx().op(
        create_proposal_with_type(provider.pub, vs, proposal_type.subnode_jar_extension_state)
    ).sign(provider).run();
    val bad_container_configuration_proposal = last_proposal();

    rell.test.tx().op(
        create_proposal_with_type(provider.pub, vs, proposal_type.container_action)
    ).sign(provider).nop().run();
    val bad_subnode_jar_extension_proposal = last_proposal();

    rell.test.tx().op(
        create_proposal_with_type(provider.pub, vs, proposal_type.container_configuration)
    ).sign(provider).nop().run();
    val bad_subnode_jar_extension_state_proposal = last_proposal();

    rell.test.tx().op(
        do_subnode_jar_migration(bad_config_apply_timestamp)
    ).run();

    assert_equals(old_container_action_proposal.proposal_type, proposal_type.container_action);
    assert_equals(old_container_configuration_proposal.proposal_type, proposal_type.container_configuration);
    assert_equals(bad_container_action_proposal.proposal_type, proposal_type.container_action);
    assert_equals(bad_container_configuration_proposal.proposal_type, proposal_type.container_configuration);
    assert_equals(bad_subnode_jar_extension_proposal.proposal_type, proposal_type.subnode_jar_extension);
    assert_equals(bad_subnode_jar_extension_state_proposal.proposal_type, proposal_type.subnode_jar_extension_state);
}
