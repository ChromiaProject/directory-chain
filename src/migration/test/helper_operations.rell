module;

import ^^.*;

operation set_send_container_blockchain_messages_false() {
    migration_completed.send_container_blockchain_messages = false;
}

operation set_remove_system_voter_set_false() {
    migration_completed.remove_system_voter_set = false;
}

operation begin_block_migration_op() {
    begin_block_migration(0);
}

operation create_voter_set_internal_op(name, threshold: integer = 0, governor: voter_set? = null) {
    create_voter_set_internal(name, threshold);
}

// -----------------------------------------------------------------------------
// Helper operations for `pcu_cleanup_excluded_signers_for_removed_chains`
// -----------------------------------------------------------------------------

operation set_pcu_cleanup_excluded_signers_for_removed_chains_false() {
    migration_completed.pcu_cleanup_excluded_signers_for_removed_chains = false;
}

operation setup_signer_excluded_from_pending_configuration_op(blockchain, config_hash: byte_array, node_pubkey: byte_array) {
    create signer_excluded_from_pending_configuration(blockchain, config_hash, pubkey = node_pubkey);
}

operation set_blockchain_state_op(blockchain, state: blockchain_state) {
    blockchain.state = state;
}
