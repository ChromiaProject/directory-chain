
struct dapp_details_blockchain {
    name: text;
    brid: byte_array;
    role: text;
}

struct dapp_media {
    name: text;
    url: text;
    type: dapp_content_type;
}

enum dapp_content_type {
    landscape,
    portrait,
    promotional,
    video,
    icon
}

struct vault_dapp_details_data {
    name: text;
    description: text;
    icon_media_url: text;
    other_media_url: text;
}

@extendable function vault_dapp_details(): vault_dapp_details_data? { return null; }

query find_dapp_details(dapp_rowid: rowid, requested_content_types: list<dapp_content_type>? = null) {
    val details = require(vault_dapp_details(), "No values available");
    return (
        rowid = dapp_rowid,
        name = details.name,
        description = details.description,
        launch_url = null,
        genre = "System Chain",
        chain_list = [dapp_details_blockchain(
            name = details.name,
            brid = chain_context.blockchain_rid,
            role = ""
        )],
        content = get_dapp_media(details, requested_content_types),
    ).to_gtv_pretty();
}

function get_dapp_media(details: vault_dapp_details_data, requested_content_types: list<dapp_content_type>? = null): list<dapp_media>? {

    val ec_media: map<dapp_content_type, dapp_media> = [
        dapp_content_type.icon: dapp_media(name = "icon1", url = details.icon_media_url, dapp_content_type.icon),
        dapp_content_type.landscape: dapp_media(name = "landscape1", url = details.other_media_url, dapp_content_type.landscape),
        dapp_content_type.portrait: dapp_media(name = "portrait1", url = details.other_media_url, dapp_content_type.portrait),
        dapp_content_type.promotional: dapp_media(name = "promotional1", url = details.other_media_url, dapp_content_type.promotional),
    ];

    if (not empty(requested_content_types)) {

        val media = list<dapp_media>();

        for (type_requested in requested_content_types) {
            if (ec_media.contains(type_requested)) {
                media.add(ec_media[type_requested]);
            }
        }

        return if (media.size() > 0) media else null;
    }

    return null;
}
