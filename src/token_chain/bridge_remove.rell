
struct network_bridge {
    network_id: integer;
    bridge_contract: byte_array;
}

@extend(ft4.auth.auth_handler)
function () = ft4.auth.add_auth_handler(
    scope = rell.meta(remove_token_bridge).mount_name,
    flags = ["T"],
);

/**
 * Token owner can remove bridge(s). It will automatically remove the bridge contract from the token chain EVM event receiver.
 *
 * @param asset_id FT4 asset id of the token
 * @param bridges List of bridge with network.
 */
operation remove_token_bridge(asset_id: byte_array, bridges: list<network_bridge>) {
    val account = ft4.auth.authenticate();
    val asset = ft4.assets.Asset(asset_id);
    val token = require_token(asset);

    require(account == token.owner, "Only token owner can remove bridges");
    require(exists(bridges), "No bridge(s) specified");

    val remove_eif_contracts = list<eif.dynamic_config.network_contract_address>();
    for (bridge in bridges) {
        val existing_bridges = eif.hbridge_erc20.get_bridge_contracts(bridge.network_id);
        require(exists(existing_bridges @* { .contract_address == bridge.bridge_contract }),
            "Bridge %s on network %s does not exist".format(bridge.bridge_contract, bridge.network_id));
        eif.hbridge_core.unregister_bridge(
                    bridge.network_id,
                    bridge.bridge_contract,
                );
        remove_eif_contracts.add(eif.dynamic_config.network_contract_address(
            bridge.network_id, bridge.bridge_contract));
    }
    send_message(eif.dynamic_config.eif_event_receiver_dynamic_remove_topic,
        eif.dynamic_config.eif_event_receiver_dynamic_remove_message(remove_eif_contracts).to_gtv());
}
