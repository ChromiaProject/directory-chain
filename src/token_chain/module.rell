//
//Token name
//
//Token symbol
//
//Token decimals
//
//Token icon
//
//Minting policies (see “Minting policy”)
//
//Account creation strategy details (see “Account creation strategy” section below)

entity pending_token_proposal {
    name: text;
    key symbol: text;
    decimals: integer;
    icon: text;
    account_creation_brids: text;
}

entity pending_token_proposal_minting_policy {
    pending_token_proposal;
    account: ft4.accounts.account;
    key pending_token_proposal, account;
    initial_amount: integer;
}

operation propose_token(
    name: text,
    symbol: text,
    decimals: integer,
    icon: text,
    minting_policy: list<minting_policy>,
    account_creation_brids: list<pubkey>,
) {
    val account = ft4.auth.authenticate();

    val governance_account = ft4.accounts.account_by_id(get_token_chain_governance_account_id());
    ft4.assets.Unsafe.transfer(account, governance_account, get_asset(),
        chain_context.args.listing_fee);

    val pending_token_proposal = create pending_token_proposal(
        name, symbol, decimals, icon, join_pubkey_list(account_creation_brids)
    );
    for (pm in minting_policy) {
        create pending_token_proposal_minting_policy(pending_token_proposal, pm.account, pm.initial_amount);
    }

    // TODO pubkey
    create common_proposal(op_context.last_block_time, common_proposal_type.tc_propose_token, pubkey,
        require_common_voter_set(token_chain_governance_voter_set));
}

function join_pubkey_list(brids: list<pubkey>) {
    if (brids.empty()) {
        return "";
    }
    var result = brids[0].to_hex();
    if (brids.size() > 1) {
        for (i in range(1, brids.size())) {
            result = result + "," + brids[i].to_hex();
        }
    }
    return result;
}

function get_token_chain_governance_account_id() = (
        token_chain_governance_account_type + chain_context
            .blockchain_rid
    )
    .hash();

function create_token_chain_governance_account() =
    ft4
    .accounts
    .create_account_without_auth(
        get_token_chain_governance_account_id(),
        token_chain_governance_account_type
    );

function get_asset(): ft4.assets.asset {
    val asset_id = (chain_context.args.asset_name, chain_context.args.economy_chain_blockchain_rid).hash();
    return ft4.assets.asset @ { .id == asset_id };
}
