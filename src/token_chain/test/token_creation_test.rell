@test module;

import ^^.*;
import ^.helper_functions.*;
import common_proposal.test.helper_functions.*;

namespace ft4 {
    import lib.ft4.accounts;
    import test_utils: lib.ft4.test.core;
}

struct module_args {
    auth_privkey: byte_array = x"B563C2BCC29FD0E014FBFC4AF3A69CB6C513C1943DB9A91093886DE18DCBE6C6";
}

function test_creating_token_success() {
    val proposer = setup(chain_context.args.auth_privkey, token_chain_constants.listing_fee);
    assert_equals(get_account_balance(proposer), 0);

    val pool_account = get_pool_account();
    assert_equals(get_account_balance(pool_account), token_chain_constants.listing_fee);

    vote_yes_on_latest_proposal(rell.test.keypairs.alice);

    val token = token @ {};
    assert_equals(token.owner, proposer);
    assert_equals(token.asset.name, "Test");

    assert_equals(get_account_balance(pool_account), 0);
    assert_equals(get_account_balance(get_token_chain_governance_account()), token_chain_constants.listing_fee);

    assert_false(exists(pending_token_proposal @* {}));
    assert_false(exists(pending_token_proposal_minting_policy @* {}));
}

function test_creating_token_refund() {
    val proposer = setup(chain_context.args.auth_privkey, token_chain_constants.listing_fee);

    val pool_account = get_pool_account();
    assert_equals(get_account_balance(pool_account), token_chain_constants.listing_fee);

    vote_no_on_latest_proposal(rell.test.keypairs.alice);

    assert_true(empty(token @* {}));

    assert_equals(get_account_balance(pool_account), 0);
    assert_equals(get_account_balance(get_token_chain_governance_account()), 0);

    assert_equals(get_account_balance(proposer), token_chain_constants.listing_fee);

    assert_false(exists(pending_token_proposal @* {}));
    assert_false(exists(pending_token_proposal_minting_policy @* {}));
}

function test_creating_token_revoke() {
    val proposer = setup(chain_context.args.auth_privkey, token_chain_constants.listing_fee);

    val pool_account = get_pool_account();
    assert_equals(get_account_balance(pool_account), token_chain_constants.listing_fee);

    val proposal_id = get_latest_common_proposal_id();
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, revoke_token_proposal(proposal_id))
    ).op(
        revoke_token_proposal(proposal_id)
    ).run_must_fail("Can not revoke proposal until 1 day(s) has passed since creation");

    rell.test.set_next_block_time_delta(millis_per_day);
    rell.test.block().run();
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, revoke_token_proposal(proposal_id))
    ).op(
        revoke_token_proposal(proposal_id)
    ).run();

    assert_true(empty(token @* {}));

    assert_equals(get_account_balance(pool_account), 0);
    assert_equals(get_account_balance(get_token_chain_governance_account()), 0);

    assert_equals(get_account_balance(proposer), token_chain_constants.listing_fee);

    assert_false(exists(pending_token_proposal @* {}));
    assert_false(exists(pending_token_proposal_minting_policy @* {}));
}

function test_propose_token_validation() {

    maybe_init_token_chain();
    val proposer = do_create_account(rell.test.keypairs.bob, chain_context.args.auth_privkey, 2 * token_chain_constants.listing_fee);

    // Fail due to invalid decimals
    var propose_op = create_propose_token(decimals = 80);
    rell.test.tx().op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op)).op(propose_op)
        .run_must_fail("INVALID DECIMALS: Decimals must be between 0 and 78 (included)");

    // Fail due to invalid name
    propose_op = create_propose_token(name = "a".repeat(1025));
    rell.test.tx().op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op)).op(propose_op)
        .run_must_fail("INVALID TEXT: Asset name cannot be longer than 1024 characters");

    // Fail due to invalid symbol
    propose_op = create_propose_token(symbol = "a".repeat(1025));
    rell.test.tx().op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op)).op(propose_op)
        .run_must_fail("INVALID TEXT: Asset symbol cannot be longer than 1024 characters");

    // Fail due to invalid icon
    propose_op = create_propose_token(icon = "a:b");
    rell.test.tx().op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op)).op(propose_op)
        .run_must_fail("INVALID ASSET URL: Invalid URL for icon");
    
    // Success
    propose_op = create_propose_token();
    rell.test.tx().op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op)).op(propose_op).run();
    vote_yes_on_latest_proposal(rell.test.keypairs.alice);

    // Fail due to token with name already exists
    propose_op = create_propose_token(name = "Test");
    rell.test.tx().op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op)).op(propose_op)
        .run_must_fail("Token with name %s already exists".format("Test"));

    // Fail due to token with symbol already exists
    propose_op = create_propose_token(name = "Test2", symbol = "TST");
    rell.test.tx().op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op)).op(propose_op)
        .run_must_fail("Token with symbol %s already exists".format("TST"));

    // Fail due to empty minting policy accounts
    propose_op = create_propose_token(
        name = "Test2", symbol = "TST2",
        minting_policy = [minting_policy(
            set<byte_array>(),
            max_supply = 0,
            minting_interval_ms = -1,
            minting_amount = -1,
            accumulating_amount = false,
        )]);
    rell.test.tx().op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op)).op(propose_op)
        .run_must_fail("Must provide at least one minter account");

    // Fail due to non positive minting policy max supply
    propose_op = create_propose_token(
        name = "Test2", symbol = "TST2",
        minting_policy = [minting_policy(
        set([proposer.id]),
        max_supply = -1,
        minting_interval_ms = 1,
        minting_amount = 1,
        accumulating_amount = false,
    )]);
    rell.test.tx().op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op)).op(propose_op)
        .run_must_fail("Max supply must be a non-negative value");

    // Fail due to non positive minting policy interval
    propose_op = create_propose_token(
        name = "Test2", symbol = "TST2",
        minting_policy = [minting_policy(
        set([proposer.id]),
        max_supply = 0,
        minting_interval_ms = -1,
        minting_amount = -1,
        accumulating_amount = false,
    )]);
    rell.test.tx().op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op)).op(propose_op)
        .run_must_fail("Minting interval must be a positive value");

    // Fail due to non positive minting policy amount
    propose_op = create_propose_token(
        name = "Test2", symbol = "TST2",
        minting_policy = [minting_policy(
        set([proposer.id]),
        max_supply = 0,
        minting_interval_ms = 1,
        minting_amount = -1,
        accumulating_amount = false,
    )]);
    rell.test.tx().op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op)).op(propose_op)
        .run_must_fail("Minting amount must be a positive value");
}

function test_apply_token_create_validation() {

    maybe_init_token_chain();
    val proposer = do_create_account(rell.test.keypairs.bob, chain_context.args.auth_privkey, 3 * token_chain_constants.listing_fee);

    // Success
    var propose_op = create_propose_token();
    rell.test.tx().op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op)).op(propose_op).run();
    val token_proposal = get_latest_common_proposal_id();

    // Propose token with the same name
    propose_op = create_propose_token(name = "Test", symbol = "TST2");
    rell.test.tx().op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op)).op(propose_op).run();
    val name_proposal_id = get_latest_common_proposal_id();

    // Propose token with the same symbol
    propose_op = create_propose_token(name = "Test2", symbol = "TST");
    rell.test.tx().op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op)).op(propose_op).run();
    val symbol_proposal_id = get_latest_common_proposal_id();

    // Vote yes on the token proposal
    vote_yes(rell.test.keypairs.alice, token_proposal);
    assert_equals(get_common_proposal(token_proposal)?.state, common_proposal_state.APPROVED);

    // Vote yes on the name proposal, must fail
    vote_yes(rell.test.keypairs.alice, name_proposal_id);
    assert_equals(get_common_proposal(name_proposal_id)?.state, common_proposal_state.FAILED);

    // Vote yes on the symbol proposal, must fail
    vote_yes(rell.test.keypairs.alice, symbol_proposal_id);
    assert_equals(get_common_proposal(symbol_proposal_id)?.state, common_proposal_state.FAILED);
}

function test_get_token_proposal() {

    val minting_policy_account1 = do_create_account(rell.test.keypairs.dave, chain_context.args.auth_privkey, token_chain_constants.listing_fee);
    val minting_policy_account2 = do_create_account(rell.test.keypairs.eve, chain_context.args.auth_privkey, token_chain_constants.listing_fee);
    val minting_policy_account3 = do_create_account(rell.test.keypairs.frank, chain_context.args.auth_privkey, token_chain_constants.listing_fee);
    val account_creation_brid1 = x"B0";

    val minting_policies = [
        minting_policy(
            minters = set([minting_policy_account1.id, minting_policy_account2.id]),
            max_supply = 500,
            minting_interval_ms = 1000,
            minting_amount = 10,
            accumulating_amount = true),
        minting_policy(
            minters = set([minting_policy_account3.id]),
            max_supply = 0,
            minting_interval_ms = 1000,
            minting_amount = 10,
            accumulating_amount = false),
    ];

    val bob = setup(
        chain_context.args.auth_privkey,
        token_chain_constants.listing_fee,
        minting_policies = minting_policies,
        account_creation_brids = [account_creation_brid1]
    );

    // Verify the token proposal query result
    assert_equals(
        get_latest_common_proposal(bob.id).description, 
        "Propose token with name 'Test', symbol 'TST', and decimals 6. See get_token_proposal(id) for more details."
    );
    assert_equals(get_token_proposal(get_latest_common_proposal_id()),
        token_proposal_data(
            name = "Test",
            symbol = "TST",
            decimals = 6,
            icon = "http://test.com",
            minting_policy = minting_policies,
            account_creation_brids = [account_creation_brid1]
        )
    );
}