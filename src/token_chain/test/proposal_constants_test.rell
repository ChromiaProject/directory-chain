@test module;

import ^^.*;
import ^.helper_functions.*;
import common_proposal.test.helper_functions.*;
import common_proposal.test.helper_operations.*;

function test_propose_constants() {

    val init_listing_fee = token_chain_constants.listing_fee;
    val init_bridge_fee = token_chain_constants.bridge_fee;

    rell.test.tx().op(
        test_init_token_chain()
    ).sign(rell.test.keypairs.alice).run();

    // First some validations
    rell.test.tx().op(
        propose_constants(-3, null)
    ).sign(rell.test.keypairs.alice)
        .run_must_fail("Listing fee must be null, zero or positive");

    rell.test.tx().op(
        propose_constants(0, -2)
    ).sign(rell.test.keypairs.alice)
        .run_must_fail("Bridge fee must be null, zero or positive");

    rell.test.tx().op(
        propose_constants(null, null)
    ).sign(rell.test.keypairs.alice)
        .run_must_fail("At least one of listing fee or bridge fee must be set");

    // Successful
    rell.test.tx().op(
        propose_constants(init_listing_fee + 1, init_bridge_fee + 1)
    ).sign(rell.test.keypairs.alice)
        .run();

    assert_equals(token_chain_constants.listing_fee, init_listing_fee + 1);
    assert_equals(token_chain_constants.bridge_fee, init_bridge_fee + 1);
    assert_equals(pending_tc_constants @* {}, list<pending_tc_constants>());
}

function test_get_constants_proposal() {
    // Bridge fee, no listing fee
    rell.test.tx().op(
        test_init_token_chain(),
        create_voter_set_name_member_op(token_chain_governance_voter_set, rell.test.pubkeys.bob),
        propose_constants(null, 1)
    ).sign(rell.test.keypairs.alice).run();
    assert_equals(
        get_latest_common_proposal(rell.test.pubkeys.alice).description, 
        "Propose token chain constants: bridge fee 1. See get_constants_proposal(id) for pending proposals."
    );
    val proposal_id = get_latest_common_proposal_id();
    val listing_proposal = get_constants_proposal(proposal_id);
    assert_null(listing_proposal.listing_fee);
    assert_equals(listing_proposal.bridge_fee, 1);
    // Approve proposal
    vote_yes_on_latest_proposal(rell.test.keypairs.bob);
    assert_fails("Proposal %d is APPROVED. Details can only be retrieved for pending proposals".format(proposal_id), get_constants_proposal(proposal_id, *));
    // Another type of proposal
    rell.test.tx().op(
        propose_update_voter_set(rell.test.keypairs.alice.pub, token_chain_governance_voter_set, 1, [], [])
    ).sign(rell.test.keypairs.alice).run();
    val wrong_proposal_id = get_latest_common_proposal_id();
    assert_fails("Proposal %d is not a token chain constants proposal".format(wrong_proposal_id), get_constants_proposal(wrong_proposal_id, *));

    // Listing fee, no bridge fee
    rell.test.tx().op(
        propose_constants(1, null)
    ).sign(rell.test.keypairs.alice).run();
    assert_equals(
        get_latest_common_proposal(rell.test.pubkeys.alice).description, 
        "Propose token chain constants: listing fee 1. See get_constants_proposal(id) for pending proposals."
    );
    val bridge_proposal = get_constants_proposal(get_latest_common_proposal_id());
    assert_equals(bridge_proposal.listing_fee, 1);
    assert_null(bridge_proposal.bridge_fee);

    // Listing fee, bridge fee
    rell.test.tx().op(
        propose_constants(123, 456)
    ).sign(rell.test.keypairs.alice).run();
    assert_equals(
        get_latest_common_proposal(rell.test.pubkeys.alice).description, 
        "Propose token chain constants: listing fee 123, bridge fee 456. See get_constants_proposal(id) for pending proposals."
    );
    val both_proposal = get_constants_proposal(get_latest_common_proposal_id());
    assert_equals(both_proposal.listing_fee, 123);
    assert_equals(both_proposal.bridge_fee, 456);
}
