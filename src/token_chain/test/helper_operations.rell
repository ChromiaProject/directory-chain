module;

import ^^.*;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.assets;
}

struct module_args {
    asset_name: text;
    asset_symbol: text;
    asset_icon: text;
    asset_decimals: integer;
}

operation mint_to(account: ft4.accounts.account, amount: big_integer) {
    ft4.assets.Unsafe.mint(account, get_asset(), amount);
}

operation test_init_token_chain() {
    state.initialized = true;

    create_pool_account();
    register_test_assets();

    create_token_chain_governance_account();
    create_governance_voter_set();
}

// tCHR lives on token chain in tests so we can mint it
function register_test_assets() {
    return ft4.assets.Unsafe.register_asset(
        chain_context.args.asset_name,
        chain_context.args.asset_symbol,
        chain_context.args.asset_decimals,
        chain_context.blockchain_rid,
        chain_context.args.asset_icon
    );
}

operation require_is_governor_op() {
    require_is_governor();
}

operation evm_block_with_deposit_event_op(
    network_id: integer,
    event: eif.hbridge.deposited_erc20_event
) {
    eif.hbridge.process_deposit_erc20_event(network_id, event);
}

operation remove_token_op(token: token) {
    delete token_account_creation_brid @* { token };
    delete token_account_minting_policy @* { token };
    delete token;
}

operation create_system_provider_op(pubkey) {
    val p = create provider(
        pubkey = pubkey,
        system = true,
        tier = provider_tier.NODE_PROVIDER,
        active = true,
        name = "System Provider",
        url = "http://example.com"
    );
    create provider_auth_key(
        provider_pubkey = pubkey,
        provider_key_role = provider_key_role.main,
        pubkey = pubkey,
        active = true
    );
    _set_provider_key_threshold(pubkey, provider_key_role.main, consensus_threshold.super_majority);

    update_system_p_vote_set(p);
}
