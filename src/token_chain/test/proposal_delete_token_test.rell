@test module;

import ^^.*;
import ^.helper_functions.*;
import common_proposal.test.helper_functions.*;

namespace ft4 {
    import lib.ft4.accounts;
    import test_utils: lib.ft4.test.core;
    import lib.ft4.assets;
}

struct module_args {
    auth_privkey: byte_array = x"B563C2BCC29FD0E014FBFC4AF3A69CB6C513C1943DB9A91093886DE18DCBE6C6";
}

function test_delete_token_success() {
    val proposer = setup(chain_context.args.auth_privkey, token_chain_constants.listing_fee);
    vote_yes_on_latest_proposal(rell.test.keypairs.alice);

    val token = token @ {};
    assert_equals(token.owner, proposer);
    assert_equals(token.asset.name, "Test");

    val propose_op = propose_delete_token(token.asset.id);
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op),
        propose_op
    ).run();

    vote_yes_on_latest_proposal(rell.test.keypairs.alice);

    assert_null(token @? {});
}

function test_delete_token_fail_due_to_transfer_history() {
    val minter_account_id = crypto.eth_privkey_to_address(rell.test.keypairs.bob.priv).hash();
    val proposer = setup(chain_context.args.auth_privkey, token_chain_constants.listing_fee, [minting_policy(
        minters = set([minter_account_id]),
        max_supply = 25,
        minting_interval_ms = millis_per_day,
        minting_amount = 10,
        accumulating_amount = false
    )]);
    vote_yes_on_latest_proposal(rell.test.keypairs.alice);

    val token = token @ {};
    assert_equals(token.owner, proposer);
    assert_equals(token.asset.name, "Test");

    val minting_op = mint_token(token.asset.id, 10);
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, minting_op)
    ).op(
        minting_op
    ).run();

    val propose_op = propose_delete_token(token.asset.id);
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op),
        propose_op
    ).run_must_fail("The token has a transfer history and can't be deleted");

    assert_not_null(token @? {});
}

function test_delete_token_fail_due_to_transfer_history_before_apply() {
    val minter_account_id = crypto.eth_privkey_to_address(rell.test.keypairs.bob.priv).hash();
    val proposer = setup(chain_context.args.auth_privkey, token_chain_constants.listing_fee, [minting_policy(
        minters = set([minter_account_id]),
        max_supply = 25,
        minting_interval_ms = millis_per_day,
        minting_amount = 10,
        accumulating_amount = false
    )]);
    vote_yes_on_latest_proposal(rell.test.keypairs.alice);

    val token = token @ {};
    assert_equals(token.owner, proposer);
    assert_equals(token.asset.name, "Test");

    val propose_op = propose_delete_token(token.asset.id);
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op),
        propose_op
    ).run();

    val minting_op = mint_token(token.asset.id, 10);
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, minting_op)
    ).op(
        minting_op
    ).run();

    // This won't fail due to try_call in voting module
    vote_yes_on_latest_proposal(rell.test.keypairs.alice);

    // But the token is still there
    assert_not_null(token @? {});
}

function test_delete_token_fail_due_to_bridge() {
    val minter_account_id = crypto.eth_privkey_to_address(rell.test.keypairs.bob.priv).hash();
    val proposer = setup(chain_context.args.auth_privkey, 100000000000, [minting_policy(
        minters = set([minter_account_id]),
        max_supply = 25,
        minting_interval_ms = millis_per_day,
        minting_amount = 10,
        accumulating_amount = false
    )]);
    vote_yes_on_latest_proposal(rell.test.keypairs.alice);

    val token = token @ {};
    assert_equals(token.owner, proposer);
    assert_equals(token.asset.name, "Test");

    // Add a bridge
    val propose_bridge_op = propose_token_bridge(
        token.asset.id,
        [bridge_configuration(
            network_id = 97,
            bridge_contract = x"01".repeat(20),
            token_contract = x"01".repeat(20),
            eif.hbridge.bridge_mode.foreign,
            true,
            skip_to_height = 0
        )]
    );

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_bridge_op)
    ).op(
        propose_bridge_op
    ).run();

    assert_not_null(pending_bridge_proposal @? { token });

    vote_yes_on_latest_proposal(rell.test.keypairs.alice);

    val propose_op = propose_delete_token(token.asset.id);
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op),
        propose_op
    ).run_must_fail("A bridge exists for asset id");

    assert_not_null(token @? {});
}

function test_get_delete_token_proposal() {
    val proposer = setup(chain_context.args.auth_privkey, token_chain_constants.listing_fee);
    vote_yes_on_latest_proposal(rell.test.keypairs.alice);

    val token = token @ {};
    assert_equals(token.owner, proposer);
    assert_equals(token.asset.name, "Test");

    val propose_op = propose_delete_token(token.asset.id);
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_op),
        propose_op
    ).run();

    // Verify the delete token proposal query result
    assert_equals(
        get_latest_common_proposal(proposer.id).description, 
        "Propose deleting token with name '%s' and asset id '%s'. See get_delete_token_proposal(id) for pending proposals.".format(token.asset.name, token.asset.id)
    );

    // Verify pending proposal details
    val proposal_id = get_latest_common_proposal_id();
    assert_equals(get_delete_token_proposal(proposal_id), delete_token_proposal_data(token.asset.id));

    // Approve proposal
    vote_yes_on_latest_proposal(rell.test.keypairs.alice);

    // Can't get pending proposal details after approval
    assert_fails("Proposal %d is APPROVED. Details can only be retrieved for pending proposals".format(proposal_id), get_delete_token_proposal(proposal_id, *));

    // Proposal is not a delete token proposal
    val wrong_proposal_id = common_proposal @ {} (.rowid) limit 1;
    assert_fails("Proposal %d is not a delete token proposal".format(wrong_proposal_id), get_delete_token_proposal(wrong_proposal_id, *));
}
