@test module;

import ^^.*;
import ^.helper_functions.*;

namespace eif {
    import dynamic_config: lib.eif.dynamic_config_common;
    import lib.hbridge;
}

namespace ft4 {
    import test_utils: lib.ft4.test.core;
}

struct module_args {
    auth_privkey: byte_array = x"B563C2BCC29FD0E014FBFC4AF3A69CB6C513C1943DB9A91093886DE18DCBE6C6";
}

val bridge_contract = x"00".repeat(20);
val token_contract = x"01".repeat(20);

function test_bridge_creation_success() {
    val proposer = setup(chain_context.args.auth_privkey,
        token_chain_constants.listing_fee + // For token
        token_chain_constants.bridge_fee // for bridge
    );

    // Funds moved from user to pool
    assert_equals(get_account_balance(get_pool_account()), token_chain_constants.listing_fee);
    assert_equals(get_account_balance(get_token_chain_governance_account()), 0);
    assert_equals(get_account_balance(proposer), token_chain_constants.bridge_fee);

    vote_yes_on_latest_proposal(rell.test.keypairs.alice);
    val test_token = token @ { };

    // Token funds moved to governance account
    assert_equals(get_account_balance(get_pool_account()), 0);
    assert_equals(get_account_balance(get_token_chain_governance_account()), token_chain_constants.listing_fee);
    assert_equals(get_account_balance(proposer), token_chain_constants.bridge_fee);

    val propose_bridge_op = propose_token_bridge(
        test_token.asset.id,
        [bridge_configuration(
            97,
            bridge_contract = bridge_contract,
            token_contract = token_contract,
            eif.hbridge.bridge_mode.foreign,
            true
        )]
    );

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_bridge_op)
    ).op(
        propose_bridge_op
    ).run();

    assert_not_null(pending_bridge_proposal @? { test_token });
    assert_not_null(pending_bridge_proposal_configuration @? {
        .network_id == 97, .bridge_contract == bridge_contract, .token_contract == token_contract, .bridge_mode == eif.hbridge.bridge_mode.foreign, .use_snapshots
    });

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_bridge_op)
    ).op(
        propose_bridge_op
    ).nop().run_must_fail("Token already has a pending bridge proposal");

    assert_equals(get_account_balance(get_pool_account()), token_chain_constants.bridge_fee);

    vote_yes_on_latest_proposal(rell.test.keypairs.alice);
    assert_null(pending_bridge_proposal @? { test_token });
    assert_null(pending_bridge_proposal_configuration @? {
        .network_id == 97, .bridge_contract == bridge_contract, .token_contract == token_contract, .bridge_mode == eif.hbridge.bridge_mode.foreign, .use_snapshots
    });

    // User has payed for token and bridge
    assert_equals(get_account_balance(get_pool_account()), 0);
    assert_equals(get_account_balance(get_token_chain_governance_account()), token_chain_constants.listing_fee + token_chain_constants.bridge_fee);
    assert_equals(get_account_balance(proposer), 0);

    val registered_bridges = eif.hbridge.get_bridge_contracts(97);
    assert_equals(registered_bridges.size(), 1);
    val registered_bridge = registered_bridges[0];
    assert_equals(registered_bridge.contract_address, bridge_contract);

    val registered_bridge_assets = registered_bridge.erc20_assets;
    assert_equals(registered_bridge_assets.size(), 1);
    val bridge_asset = registered_bridge_assets[0];
    assert_equals(bridge_asset.token_address, token_contract);

    assert_events(("icmf_message", (
        topic = eif.dynamic_config.eif_event_receiver_dynamic_config_topic,
        body = [97: eif.dynamic_config.eif_event_receiver_dynamic_config_message(
            contracts = [bridge_contract],
            events = list<eif.dynamic_config.event_def>()
        )
    ].to_gtv()
    ).to_gtv_pretty()));
}

function test_bridge_can_only_be_added_by_token_owner() {
    val proposer = setup(chain_context.args.auth_privkey, token_chain_constants.listing_fee);
    vote_yes_on_latest_proposal(rell.test.keypairs.alice);
    val test_token = token @ { };

    val propose_bridge_op = propose_token_bridge(
        test_token.asset.id,
        [bridge_configuration(
            97,
            bridge_contract = bridge_contract,
            token_contract = token_contract,
            eif.hbridge.bridge_mode.foreign,
            true
        )]
    );

    do_create_account(rell.test.keypairs.charlie, chain_context.args.auth_privkey, 1);
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.charlie.priv, propose_bridge_op)
    ).op(
        propose_bridge_op
    ).run_must_fail("Only token owner can propose a bridge");
}

function test_bridge_can_only_be_added_with_enough_funds() {
    // Enough funds for register token and 1 bridge
    val proposer = setup(chain_context.args.auth_privkey, token_chain_constants.listing_fee + token_chain_constants.bridge_fee);
    vote_yes_on_latest_proposal(rell.test.keypairs.alice);
    val test_token = token @ { };

    val bridge1 = bridge_configuration(
        97,
        bridge_contract = bridge_contract,
        token_contract = token_contract,
        eif.hbridge.bridge_mode.foreign,
        true
    );
    val bridge2 = bridge_configuration(
        56,
        bridge_contract = bridge_contract,
        token_contract = token_contract,
        eif.hbridge.bridge_mode.foreign,
        true
    );

    val propose_bridge_fail_op = propose_token_bridge(
        test_token.asset.id,
        [bridge1, bridge2]
    );

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_bridge_fail_op)
    ).op(
        propose_bridge_fail_op
    ).run_must_fail("Balance is too low");

    rell.test.tx().op(
        mint_to(proposer, token_chain_constants.bridge_fee)
    ).run();

    val propose_bridge_success_op = propose_token_bridge(
        test_token.asset.id,
        [bridge1]
    );

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_bridge_success_op)
    ).op(
        propose_bridge_success_op
    ).run();
}

function test_bridge_refunded_on_reject() {
    // Enough funds for register token and 1 bridge
    val proposer = setup(chain_context.args.auth_privkey, token_chain_constants.listing_fee + token_chain_constants.bridge_fee);
    vote_yes_on_latest_proposal(rell.test.keypairs.alice);
    val test_token = token @ { };

    val propose_bridge_fail_op = propose_token_bridge(
        test_token.asset.id,
        [bridge_configuration(
            97,
            bridge_contract = bridge_contract,
            token_contract = token_contract,
            eif.hbridge.bridge_mode.foreign,
            true
        )]
    );

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_bridge_fail_op)
    ).op(
        propose_bridge_fail_op
    ).run();

    // Funds locked in pool
    assert_equals(get_account_balance(get_pool_account()), token_chain_constants.bridge_fee);
    assert_equals(get_account_balance(get_token_chain_governance_account()), token_chain_constants.listing_fee);
    assert_equals(get_account_balance(proposer), 0);

    vote_no_on_latest_proposal(rell.test.keypairs.alice);

    // Bridge money refunded
    assert_equals(get_account_balance(get_pool_account()), 0);
    assert_equals(get_account_balance(get_token_chain_governance_account()), token_chain_constants.listing_fee);
    assert_equals(get_account_balance(proposer), token_chain_constants.bridge_fee);
}

function test_bridge_proposal_revoke() {
    val proposer = setup(chain_context.args.auth_privkey,
        token_chain_constants.listing_fee + // For token
        token_chain_constants.bridge_fee // for bridge
    );
    vote_yes_on_latest_proposal(rell.test.keypairs.alice);
    val test_token = token @ { };

    val propose_bridge_op = propose_token_bridge(
        test_token.asset.id,
        [bridge_configuration(
            97,
            bridge_contract = bridge_contract,
            token_contract = token_contract,
            eif.hbridge.bridge_mode.foreign,
            true
        )]
    );

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_bridge_op)
    ).op(
        propose_bridge_op
    ).run();

    // Funds locked in pool
    assert_equals(get_account_balance(get_pool_account()), token_chain_constants.bridge_fee);
    assert_equals(get_account_balance(get_token_chain_governance_account()), token_chain_constants.listing_fee);
    assert_equals(get_account_balance(proposer), 0);

    val proposal_id = get_latest_common_proposal_id();
    val revoke_bridge_op = revoke_token_bridge_proposal(proposal_id);
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, revoke_bridge_op)
    ).op(
        revoke_bridge_op
    ).run_must_fail("Can not revoke proposal until 1 day(s) has passed since creation");

    rell.test.set_next_block_time_delta(millis_per_day);
    rell.test.block().run();
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, revoke_bridge_op)
    ).op(
        revoke_bridge_op
    ).run();

    assert_null(pending_bridge_proposal @? { test_token });

    // Bridge money refunded
    assert_equals(get_account_balance(get_pool_account()), 0);
    assert_equals(get_account_balance(get_token_chain_governance_account()), token_chain_constants.listing_fee);
    assert_equals(get_account_balance(proposer), token_chain_constants.bridge_fee);
}
