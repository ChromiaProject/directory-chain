@test module;

import ^^.*;
import ^.helper_functions.*;

namespace eif {
    import lib.hbridge;
}

namespace ft4 {
    import test_utils: lib.ft4.test.utils;
}

struct module_args {
    auth_privkey: byte_array = x"B563C2BCC29FD0E014FBFC4AF3A69CB6C513C1943DB9A91093886DE18DCBE6C6";
    listing_fee: integer = 100;
}

function test_bridge_creation_success() {
    val proposer = setup(chain_context.args.auth_privkey, chain_context.args.listing_fee);
    vote_yes_on_latest_proposal(rell.test.keypairs.alice);
    val test_token = token @ { };

    val propose_bridge_op = propose_token_bridge(
        test_token.asset.id,
        [bridge_configuration(
            97,
            bridge_contract = x"00",
            token_contract = x"01",
            eif.hbridge.bridge_mode.foreign,
            true
        )]
    );

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_bridge_op)
    ).op(
        propose_bridge_op
    ).run();

    assert_not_null(pending_bridge_proposal @? { test_token });
    assert_not_null(pending_bridge_proposal_configuration @? {
        .network_id == 97, .bridge_contract == x"00", .token_contract == x"01", .bridge_mode == eif.hbridge.bridge_mode.foreign, .use_snapshots
    });

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_bridge_op)
    ).op(
        propose_bridge_op
    ).nop().run_must_fail("Token already has a pending bridge proposal");

    vote_yes_on_latest_proposal(rell.test.keypairs.alice);
    assert_null(pending_bridge_proposal @? { test_token });
    assert_null(pending_bridge_proposal_configuration @? {
        .network_id == 97, .bridge_contract == x"00", .token_contract == x"01", .bridge_mode == eif.hbridge.bridge_mode.foreign, .use_snapshots
    });

    val registered_bridges = eif.hbridge.get_bridge_contracts(97);
    assert_equals(registered_bridges.size(), 1);
    val registered_bridge = registered_bridges[0];
    assert_equals(registered_bridge.contract_address, x"00");

    val registered_bridge_assets = registered_bridge.erc20_assets;
    assert_equals(registered_bridge_assets.size(), 1);
    val bridge_asset = registered_bridge_assets[0];
    assert_equals(bridge_asset.token_address, x"01");
}

function test_bridge_can_only_be_added_by_token_owner() {
    val proposer = setup(chain_context.args.auth_privkey, chain_context.args.listing_fee);
    vote_yes_on_latest_proposal(rell.test.keypairs.alice);
    val test_token = token @ { };

    val propose_bridge_op = propose_token_bridge(
        test_token.asset.id,
        [bridge_configuration(
            97,
            bridge_contract = x"00",
            token_contract = x"01",
            eif.hbridge.bridge_mode.foreign,
            true
        )]
    );

    val charlie_account = do_create_account(rell.test.keypairs.charlie, chain_context.args.auth_privkey, 1);
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.charlie.priv, propose_bridge_op)
    ).op(
        propose_bridge_op
    ).run_must_fail("Only token owner can propose a bridge");
}

function test_bridge_proposal_revoke() {
    val proposer = setup(chain_context.args.auth_privkey, chain_context.args.listing_fee);
    vote_yes_on_latest_proposal(rell.test.keypairs.alice);
    val test_token = token @ { };

    val propose_bridge_op = propose_token_bridge(
        test_token.asset.id,
        [bridge_configuration(
            97,
            bridge_contract = x"00",
            token_contract = x"01",
            eif.hbridge.bridge_mode.foreign,
            true
        )]
    );

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, propose_bridge_op)
    ).op(
        propose_bridge_op
    ).run();

    val proposal_id = get_latest_common_proposal_id();
    val revoke_bridge_op = revoke_token_bridge_proposal(proposal_id);
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, revoke_bridge_op)
    ).op(
        revoke_bridge_op
    ).run_must_fail("Can not revoke proposal until 1 day(s) has passed since creation");

    rell.test.set_next_block_time_delta(millis_per_day);
    rell.test.block().run();
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.bob.priv, revoke_bridge_op)
    ).op(
        revoke_bridge_op
    ).run();

    assert_null(pending_bridge_proposal @? { test_token });
}
