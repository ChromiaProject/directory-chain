@test module;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.assets;
    import lib.ft4.auth;
    import lib.ft4.accounts.strategies;
    import test_utils: lib.ft4.test.core;
    import test_operations: lib.ft4.test.operations;
}

import ^.helper_operations.*;
import common_proposal.test.helper_functions.*;

val account_creation_chain_one = "foo".hash();

function setup(
    initial_mint: big_integer,
    minting_policy: list<minting_policy> = [],
    account_creation_brids: list<byte_array> = [account_creation_chain_one, "bar".hash()],
    keypair: rell.test.keypair = rell.test.keypairs.bob,
): ft4.accounts.account {

    maybe_init_token_chain();

    val proposer = do_create_account(keypair, initial_mint);

    propose_test_token(
        minting_policy = minting_policy,
        account_creation_brids = account_creation_brids,
        keypair = keypair
    );

    return proposer;
}

function do_create_account(keypair: rell.test.keypair, initial_mint: big_integer, link_evm_account: boolean = false): ft4.accounts.account {

    maybe_init_token_chain();

    val eth_address = crypto.eth_privkey_to_address(keypair.priv);
    val auth_descriptor = ft4.accounts.single_sig_auth_descriptor(eth_address, set(["A", "T"]));
    val account_id = eth_address.hash();

    // Register account
    rell.test.tx().op(
        ft4.test_operations.register_account(auth_descriptor)
    ).nop().run();
    val account = ft4.accounts.account_by_id(account_id);

    // Link EVM address to FT account
    if (link_evm_account) {
        link_eoa_account(keypair, keypair, account_id, auth_descriptor.hash());
    }

    if (initial_mint > 0L) {
        rell.test.tx().op(
            mint_to(account, initial_mint)
        ).run();
    }

    return account;
}

function link_eoa_account(
    evm_keypair: rell.test.keypair,
    ft_keypair: rell.test.keypair,
    account_id: byte_array,
    auth_descriptor_id: byte_array
) {
    val evm_address = crypto.eth_pubkey_to_address(evm_keypair.pub);
    val op = eif.hbridge_core.link_evm_eoa_account(evm_address);
    val message = ft4.test_utils.create_evm_auth_message(op)
        .replace(ft4.auth.ACCOUNT_ID_PLACEHOLDER, account_id.to_hex().upper_case())
        .replace(ft4.auth.AUTH_DESCRIPTOR_ID_PLACEHOLDER, auth_descriptor_id.to_hex().upper_case());
    val signature = ft4.test_utils.evm_sign(message, evm_keypair.priv);
    rell.test.tx()
        .op(ft4.auth.evm_signatures([evm_address], [signature]))
        .op(ft4.auth.external.evm_auth(account_id, auth_descriptor_id, [signature]))
        .op(op)
        .nop()
        .sign(ft_keypair).run();
    assert_not_null(eif.hbridge_core.evm_eoa_account_link @? { .address == evm_address });

    assert_equals(eif.hbridge_core.get_account_for_eoa_address(evm_address), account_id);
    assert_equals(eif.hbridge_core.get_eoa_addresses_for_account(account_id), [evm_address]);
}

function maybe_init_token_chain() {
    if (not exists(ft4.assets.asset @? { .id == get_asset_id() })) {
        rell.test.tx().op(
            test_init_token_chain()
        ).nop().sign(rell.test.keypairs.alice).run();
    }
}

function get_account_balance(ft4.accounts.account): big_integer =
        (ft4.assets.balance @? { account, get_asset() }.amount) ?: 0L;

function create_propose_token(
    name: text = "Test",
    symbol: text = "TST",
    decimals: integer = 6,
    icon: text = "http://test.com",
    minting_policy: list<minting_policy> = [],
    account_creation_brids: list<byte_array> = [],
) {
    return propose_token(name, symbol, decimals, icon, minting_policy, account_creation_brids);
}

function propose_test_token(
    name: text = "Test",
    symbol: text = "TST",
    decimals: integer = 6,
    icon: text = "http://test.com",
    minting_policy: list<minting_policy> = [],
    account_creation_brids: list<byte_array> = [],
    keypair: rell.test.keypair = rell.test.keypairs.bob,
) {
    val propose_op = create_propose_token(
        minting_policy = minting_policy,
        account_creation_brids = account_creation_brids
    );
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(keypair.priv, propose_op),
        propose_op
    ).run();
}

function get_latest_common_proposal(proposer: pubkey)
    = get_proposals_by_proposer(proposer) @ {} (@omit @sort_desc .id, $) limit 1;

function propose_bridge(
    token: token, 
    bridge_address: byte_array, 
    token_address: byte_array, 
    network_id: integer, 
    keypair: rell.test.keypair = rell.test.keypairs.bob,
) {

    val propose_bridge_op = propose_token_bridge(
        token.asset.id,
        [bridge_configuration(
            network_id = network_id,
            bridge_contract = bridge_address,
            token_contract = token_address,
            eif.hbridge.bridge_mode.foreign,
            use_snapshots = false,
            skip_to_height = 0
        )]
    );

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(keypair.priv, propose_bridge_op)
    ).op(
        propose_bridge_op
    ).run();
}
