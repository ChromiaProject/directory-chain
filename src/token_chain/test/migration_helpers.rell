module;

namespace eif {
    import lib.hbridge;
    import lib.eif.messaging.*;
    import lib.eif_event_receiver.*;
}

operation evm_block_op(
    network_id: integer,
    evm_block_height: integer,
    evm_block_hash: byte_array,
    events: list<eif.event_data>
) {
    eif._evm_block(network_id, evm_block_height, evm_block_hash, events);
}
