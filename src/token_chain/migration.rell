
object migration_completed {
    mutable remove_alice_bsc_snapshots: boolean = false;
}

@extend(on_begin_block) function (height: integer) {
    if (not migration_completed.remove_alice_bsc_snapshots) {
        if (not try_call(remove_alice_bsc_snapshots(*))) {
            log("Failed to remove alice bsc snapshots");
        }
    }
}

function remove_alice_bsc_snapshots() {
    log("State slot migration started...");

    /**
     * We can remove all state slots for all assets (both types `erc20` and `erc20_withdrawal`).
     * There's no need to emit any state events with a 0 balance,
     * since it's unlikely that a mass exit will be triggered in the next three days.
     * 
     * If snapshot-enabled assets are added in the future, new state slots may reuse IDs of deleted ones. 
     * Emitted state events will then overwrite existing entries in the event Merkle tree.
     */

    // Delete all state slots
    val slots = eif.hbridge.state_slot @* {} ($.to_struct());
    log("Deleting state slots: %s".format(slots));
    delete eif.hbridge.local_erc20_state_slot_binding @* {};
    delete eif.hbridge.state_slot @* {};

    // Disable snapshots for all current assets
    val assets = eif.hbridge.erc20_asset_snapshots_enabled @* {} ($.erc20_asset.to_struct());
    log("Disabling snapshots for assets: %s".format(assets));
    delete eif.hbridge.erc20_asset_snapshots_enabled @* {};

    migration_completed.remove_alice_bsc_snapshots = true;
    log("State slot migration completed");
}
