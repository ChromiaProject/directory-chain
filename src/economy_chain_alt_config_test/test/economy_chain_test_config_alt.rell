@test module;

import ^^.*;

namespace ft4 {
    import lib.ft4.accounts;
}

import economy_chain.test.helper_functions.*;
import economy_chain.test.helper_operations.*;

val provider_key = rell.test.keypairs.bob;
val provider_pubkey = provider_key.pub;
val node_pubkey = rell.test.pubkeys.charlie;
val cluster_name = "Bob's cluster";

struct module_args {
	account_creator_privkey: byte_array;
}

function test_reward_start_time_is_set() {
    assert_equals(START_OF_2050, staking_get_rewards_start());
}

function test_rewards_are_disabled_before_2050() {
    rell.test.tx().op(init()).run();

    // Put the date to 2030
    rell.test.set_next_block_time(START_OF_2030);
    rell.test.block().run();

    // Set up a delegated state
    val alice_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);
    do_evm_stake_update_bsc(alice_evm_address, 10 * units_per_asset);
    val test_account_alice = require(do_create_account_using_ras_staking(rell.test.keypairs.alice));
    val test_account_bob = require(do_create_account(rell.test.keypairs.bob, chain_context.args.account_creator_privkey));

    val an_amount = 20 * units_per_asset;

    rell.test.tx()
        .op(mint_to(test_account_alice, an_amount))
        .op(mint_to(get_pool_account(), an_amount))
    .sign(admin_privkey).run();

    add_provider(rell.test.keypairs.bob.pub);

    // Add some delegation
    do_staking_deposit_native(rell.test.keypairs.alice, an_amount);
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.bob.pub);

    // Advance 10 periods
    rell.test.set_next_block_time_delta(10 * staking_delegation_delay_ms);
    rell.test.block().run();

    // See there is no reward
    assert_equals(staking_rewards_claimable_for(test_account_alice.id), 0);

    // Advance time to 2050
    rell.test.set_next_block_time(START_OF_2050);
    rell.test.block().run();
    
    // No reward at this point
    assert_equals(staking_rewards_claimable_for(test_account_alice.id), 0);

    // Advance 10 periods
    rell.test.set_next_block_time(START_OF_2050 + 10 * staking_delegation_delay_ms);
    rell.test.block().run();

    // Try to break this with a shared reward
    val pa = run_pay_rewards(888, true);
    quick_pay_shared_rewards(8888, pa.account);

    // There is a reward
    val first_reward = staking_rewards_claimable_for(test_account_alice.id);
    assert_true(first_reward > 0);
    assert_equals(staking_payment @ {.account == test_account_alice} (@sum 1), 1);

    // Pending rewards are there
    assert_equals(pending_shared_payment @ {.account == test_account_alice} (@sum 1), 2);

    // Advance 10 periods
    rell.test.set_next_block_time(START_OF_2050 + 20 * staking_delegation_delay_ms);
    rell.test.block().run();

    // There is more reward
    val second_reward = staking_rewards_claimable_for(test_account_alice.id);
    assert_true(0 < second_reward);

    // Try to break this with a shared reward
    quick_pay_shared_rewards(8888, pa.account);
    quick_pay_shared_rewards(8888, pa.account);
    quick_pay_shared_rewards(8888, pa.account);

    // Pending rewards are queued
    assert_equals(pending_shared_payment @ {.account == test_account_alice} (@sum 1), 3);

    // Advance 11 periods
    rell.test.set_next_block_time_delta(11 * staking_delegation_delay_ms);
    rell.test.block().run();
    rell.test.block().run();

    // A payout has happened
    assert_true(staking_get_rewards_paid(test_account_alice.id) > 0);
    val how_many_payouts = staking_payment @ {.account == test_account_alice} (@sum 1);
    assert_equals(how_many_payouts, 3);
    assert_equals(pending_shared_payment @ {.account == test_account_alice} (@sum 1), 0);

    // Pending payouts cleared
    rell.test.set_next_block_time_delta(1);
    rell.test.block().run();
    assert_equals(pending_shared_payment @ {.account == test_account_alice} (@sum 1), 0);

    rell.test.set_next_block_time_delta(staking_delegation_delay_ms / 2);
    rell.test.block().run();

    // Another payout hasn't happened
    assert_equals(staking_payment @ {.account == test_account_alice} (@sum 1), how_many_payouts);

    // Pending rewards have been cleared
    assert_equals(pending_shared_payment @ {.account == test_account_alice} (@sum 1), 0);
}

function test_fee_share_are_disabled_before_2050() {
    rell.test.tx().op(init()).run();

    val test_account_dave = require(do_create_account(rell.test.keypairs.dave, chain_context.args.account_creator_privkey));
    val test_account_bob = require(do_create_account(rell.test.keypairs.bob, chain_context.args.account_creator_privkey));
    val test_account_charlie = require(do_create_account(rell.test.keypairs.charlie, chain_context.args.account_creator_privkey));

    rell.test.tx()
        .op(mint_to_pool(8888888888))
        .op(mint_to(test_account_dave, 9999999))
        .op(mint_to(test_account_bob, 9999999))
    .sign(admin_privkey).run();

    add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER);

    do_staking_deposit_native(rell.test.keypairs.dave, 9999999);
    do_staking_delegate(rell.test.keypairs.dave, provider_pubkey);

    assert_equals(get_account_balance(test_account_dave), 1000000000);

    // FFWD
    rell.test.set_next_block_time_delta(staking_delegation_delay_ms);
    rell.test.block().run(); rell.test.block().run();

    assert_equals(staking_get_current_delegate(test_account_dave.id), provider_pubkey);

    run_pay_rewards(33090909, true);

    // Nothing paid out
    assert_equals(get_account_balance(test_account_dave), 1000000000);
}

function run_pay_rewards(pool_assets: big_integer = 0, calculate_system_reward: boolean, reward_debt: big_integer = 0) {

    if (not state.initialized) rell.test.tx().op(init()).run();

    val system_cluster = ensure_system_cluster();
    val cluster = ensure_cluster(cluster_name, false, false, 1, 1024);
    val provider = add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER);
    val node = ensure_node(provider_pubkey, node_pubkey, true, "SE", 1, 1024, false);
    val node_availability_report = node_availability_report(start_time = 0, end_time = 0, [node_pubkey: 1.0]);

    val calculate_cluster = if (calculate_system_reward) system_cluster else cluster;
    add_cluster_node(calculate_cluster.name, node_pubkey, false);

    rell.test.tx().op(
        set_pool_details_last_refill_millis_last_block_time_op()
    ).run();

    if (pool_assets != 0) {
        add_assets_to_pool(pool_assets);
    }

    rell.test.tx().op(
        register_provider_account_op(provider),
        set_reward_debt_op(provider_pubkey, reward_debt),
        pay_rewards_op(calculate_cluster, node_availability_report)
    ).sign(provider_key).run();

    val pa = provider_account @ { provider @ { provider_pubkey } };
    return pa;
}

function quick_pay_shared_rewards(amount: integer, provider: ft4.accounts.account) {
    rell.test.set_next_block_time_delta(1);
    rell.test.tx().op(
        pay_reward_op(get_pool_account(), provider, 0,  amount, "", 0.1)
    ).nop().run();
}