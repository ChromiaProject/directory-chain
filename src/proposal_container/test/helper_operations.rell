module;

import ^^.*;

operation create_container_without_extra_compute(my_pubkey: pubkey, cluster_name: text, name, deployer_name: text) {
    val provider = require_provider(my_pubkey);
    val cluster = require_cluster(cluster_name);
    val deployer = require_voter_set(deployer_name);
    val container = create_container_with_limits(
        provider,
        name,
        cluster,
        deployer,
        standard_container_defaults.container_units,
        standard_container_defaults.max_blockchains,
        standard_container_defaults.extra_storage,
        standard_container_defaults.extra_compute_requests,
    );
    delete container_resource_limit @ { container, container_resource_limit_type.extra_compute_requests };
}
