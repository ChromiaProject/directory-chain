module;

import ^.*;
import ^^.model.*;

entity pending_container_configuration {
    key proposal;
    key container;
    slow_db_statement_log_ms: integer;
}

struct container_configuration_data {
    slow_db_statement_log_ms: integer?;
}

struct module_args {
    min_slow_db_statement_log_ms: integer = 0;
}

@extend(is_container_available_for_removal) function(container) = 
if (exists(pending_container_configuration @* { container }))
    "Container %s has pending proposals and can't be deleted. Resolve proposals first".format(container.name) 
else null;

@extend(apply_voting_result_handlers) function() = [proposal_type.container_configuration.name: apply_container_configuration(*)];

function apply_container_configuration(proposal) {
    val pcc = pending_container_configuration @? { proposal };
    if (pcc == null) return;
    validate_container_configuration_proposal(pcc);
    val container_config = container_configuration @? { pcc.container };
    if (exists(container_config)) {
        container_config.slow_db_statement_log_ms = pcc.slow_db_statement_log_ms;
    } else {
        create container_configuration(pcc.container, pcc.slow_db_statement_log_ms);
    }
}

@extend(delete_proposal_handlers) function(): map<text, (proposal) -> unit> = [proposal_type.container_configuration.name: delete_pending_container_configuration(*)];

function delete_pending_container_configuration(proposal) {
    delete pending_container_configuration @? { proposal };
}

/**
 * Propose update container configuration.
 * 
 * Permission: container deployer
 * 
 * Rate limit: 20 actions (since this triggers container restarts)
 * 
 * @param my_pubkey pubkey of provider
 */
operation propose_container_configuration(my_pubkey: pubkey, container_name: text, container_configuration_data, description: text = "") {
    // OK, now it is silly but this is for any future additional configs
    if (container_configuration_data.slow_db_statement_log_ms == null) {
        log("Proposal must contain at least one configuration change");
    }

    val me = require_is_provider_with_rate_limit(my_pubkey, cost = 20);
    val container = require_container(container_name);
    require_container_deployer(container, me);
    require(empty(pending_container_configuration @? { container }), "Only one container configuration proposal at a time is allowed");

    val prop = create_proposal(proposal_type.container_configuration, me, container.deployer, description);
    val current_config = container_configuration @? { container };
    val pcc = create pending_container_configuration(
        prop,
        container,
        slow_db_statement_log_ms = container_configuration_data.slow_db_statement_log_ms ?: current_config?.slow_db_statement_log_ms ?: -1,
    );
    validate_container_configuration_proposal(pcc);
    internal_vote(me, prop, true);
}

/**
 * Returns container configuration proposal.
 */
query get_container_configuraiton_proposal(rowid) {
    val proposal = get_latest_proposal(rowid, proposal_type.container_configuration);
    if (proposal == null) return null;
    val pcc = pending_container_configuration @ { proposal };
    return (
        container = pcc.container.name,
        slow_db_statement_log_ms = pcc.slow_db_statement_log_ms
    );
}

@extend(before_remove_container) function remove_all_container_proposals(container) {
    val pcc = pending_container_configuration @? { container };
    pcc?.proposal?.state = proposal_state.REVOKED;
    delete pcc;
}

function validate_container_configuration_proposal(proposal_details: pending_container_configuration) {
    require(
        proposal_details.slow_db_statement_log_ms == -1 or
         proposal_details.slow_db_statement_log_ms >= chain_context.args.min_slow_db_statement_log_ms,
         "Slow query log ms must be above or equal to minimum allowed value %d".format(chain_context.args.min_slow_db_statement_log_ms)
    );
}
