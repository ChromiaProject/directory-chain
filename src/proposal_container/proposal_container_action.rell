enum container_action {
    pause,
}

entity pending_container_action {
    key proposal;
    key container;
    action: container_action; 
}

@extend(is_container_available_for_removal) function(container) = 
if (exists(pending_container_action @* { container })) 
    "Container %s has pending proposals and can't be deleted. Resolve proposals first".format(container.name) 
else null;

@extend(apply_voting_result_handlers) function() = [proposal_type.container_action.name: apply_container_action(*)];

function apply_container_action(proposal) {
    val pca = pending_container_action @? { proposal };
    if (pca == null) return;
    validate_container_action_proposal(pca);
    when (pca.action) {
        pause -> pca.container.state = container_state.PAUSED;
    }
}

@extend(delete_proposal_handlers) function(): map<text, (proposal) -> unit> = [proposal_type.container_action.name: delete_pending_container_action(*)];

function delete_pending_container_action(proposal) {
    delete pending_container_action @? { proposal };
}

/**
 * Propose container action.
 * 
 * Permission: container deployer
 * 
 * Rate limit: 20 actions
 * 
 * @param my_pubkey pubkey of provider
 */
operation propose_container_action(my_pubkey: pubkey, container_name: text, action: container_action, description: text = "") {
    val me = require_is_provider_with_rate_limit(my_pubkey, cost = 20);
    val container = require_container(container_name);
    require_container_deployer(container, me);

    val proposal = create_proposal(proposal_type.container_action, me, container.deployer, description);
    val pca = create pending_container_action(
        proposal,
        container,
        action,
    );
    validate_container_action_proposal(pca);
    internal_vote(me, proposal, true);
}

/**
 * Returns container limits proposal.
 */
query get_container_action_proposal(rowid) {
    val proposal = get_latest_proposal(rowid, proposal_type.container_action);
    if (proposal == null) return null;
    val pca = pending_container_action @ { proposal };
    return (
        container = pca.container.name,
        action = pca.action,
    );
}

@extend(before_remove_container) function(container) {
    val pcas = pending_container_action @* { container };
    for (pca in pcas) {
        pca.proposal.state = proposal_state.REVOKED;
        delete pca;
    }
}

function validate_container_action_proposal(pca: pending_container_action) {
    when (pca.action) {
        pause -> require(pca.container.state == container_state.RUNNING, "Can only pause a running container");
    }
}

/**
 * Resume a paused container.
 *
 * Permission: container deployer, no voting
 *
 * Rate limit: actions
 *
 * @param my_pubkey pubkey of provider
 */
operation resume_container(my_pubkey: pubkey, container_name: text) {
    val me = require_is_provider_with_rate_limit(my_pubkey);
    val container = require_container(container_name);
    require_container_deployer(container, me);

    require(container.state == container_state.PAUSED, "Can only resume a paused container");

    container.state = container_state.RUNNING;
}
