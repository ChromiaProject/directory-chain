module;

import economy_chain.*;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.assets;
}

struct module_args {
    amount_to_mint: big_integer;
}

@extend(after_ras_staking) function after_ras_staking_do_mint(ft4.accounts.account) {

    ft4.assets.Unsafe.mint(account, get_asset(), chain_context.args.amount_to_mint);
}
