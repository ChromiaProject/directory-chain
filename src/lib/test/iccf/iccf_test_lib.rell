@test module;

import lib.iccf.*;

function iccf_proof_for(blockchain_rid: byte_array, gtx_transaction, height: integer = 0, tx_index: integer = 0, timestamp = 0) {
    val tx_hash = gtx_transaction.to_gtv().hash();

    return rell.test.op(iccf_op_name, [
        blockchain_rid.to_gtv(),
        tx_hash.to_gtv(),
        make_confirmation_proof(blockchain_rid, tx_hash, height, tx_index, timestamp).to_gtv(),
        x"".to_gtv(),
        (0).to_gtv(),
        x"".to_gtv()
    ]);
}

function make_confirmation_proof(blockchain_rid: byte_array, tx_hash: byte_array, height: integer, tx_index: integer, timestamp) =
    confirmation_proof(
        hash = tx_hash,
        blockHeader = block_header(
            blockchain_rid = blockchain_rid,
            previous_block_rid = blockchain_rid,
            merkle_root_hash = x"",
            timestamp = timestamp,
            height = height,
            dependencies = null.to_gtv(),
            extra = ["merkle_hash_version": (2).to_gtv()],
        ).to_gtv().to_bytes(),
        witness = x"",
        merkleProofTree = list<gtv>(),
        txIndex = tx_index,
    ).to_gtv_pretty().to_bytes();
