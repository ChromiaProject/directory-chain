@test module;

import ^^.iccf.*;
import ^.helper_operations.*;

function iccf_proof_for(blockchain_rid: byte_array, gtx_transaction, timestamp) {
    val tx_hash = gtx_transaction.to_gtv().hash();
    return iccf_proof(blockchain_rid, tx_hash, make_confirmation_proof(blockchain_rid, tx_hash, timestamp), x"", 0, x"");
}

function make_confirmation_proof(blockchain_rid: byte_array, tx_hash: byte_array, timestamp) = confirmation_proof(
        hash = tx_hash,
        blockHeader = block_header(
            blockchain_rid = blockchain_rid,
            previous_block_rid = blockchain_rid,
            merkle_root_hash = x"",
            timestamp = timestamp,
            height = 0,
            dependencies = null.to_gtv(),
            extra = map<text, gtv>()
        ).to_gtv().to_bytes(),
        witness = x"",
        merkleProofTree = list<gtv>(),
        txIndex = 0
    ).to_gtv_pretty().to_bytes();
