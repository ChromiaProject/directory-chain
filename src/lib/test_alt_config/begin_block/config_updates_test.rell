@test module;

import lib.begin_block.*;
import ^^^.test.begin_block.helper_operations.*;

function test_is_blockchain_configuration_changed__disabled() {

    rell.test.block().run();

    // Activate and fake another previous config hash
    rell.test.tx().op(
        set_config_hash(x"AABBCC")
    ).run();
    rell.test.block().run();

    assert_true(empty(captured_configuration_updates @* {}));
}
