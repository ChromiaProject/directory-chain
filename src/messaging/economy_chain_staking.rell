module;

import lib.icmf.constants.*;

/** Topic for staking balance updates */
val economy_chain_staking_balance_update_topic = ICMF_TOPIC_GLOBAL_PREFIX + "staking_balance_update";

/**
 * Keeps the updated staking balance for a specific FT4 account id.
 */
struct economy_chain_staking_balance_update {

    /** Staking FT4 account id */
    staking_account_id: pubkey;

    /** Total staked amount in minor units */
    balance: integer;
}
