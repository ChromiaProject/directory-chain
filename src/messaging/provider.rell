module;

import lib.icmf.constants.*;
import provider_auth.model.*;

val provider_update_topic = ICMF_TOPIC_LOCAL_PREFIX + "provider_update";
val provider_auth_update_topic = ICMF_TOPIC_LOCAL_PREFIX + "provider_auth_update";

struct provider_update_message_v1 {
    pubkey;
    system: boolean;
    tier: text;
    active: boolean;
}

struct provider_update_message {
    pubkey;
    system: boolean;
    tier: text;
    active: boolean;
    name: text = "";
    url: text = "";
}

/**
 * The message sent from DC to a receiving chain for each provider key update.
 * Each message will contain all provider keys to let the receiving chain wipe and add.
 */
struct provider_auth_update_message {
    provider_pubkey: pubkey;
    key_roles: list<provider_auth_update_role>;
}

/**
 * Belongs to the provider_auth_update_message message to store all keys and threshold for a specific key role.
 */
struct provider_auth_update_role {
    role: provider_key_role;
    threshold: integer;
    keys: list<(pubkey: pubkey, active: boolean)>;
}

function decode_provider_update_message(gtv): provider_update_message {
    when (list<gtv>.from_gtv(gtv).size()) {
        4 -> {
            val v1 = provider_update_message_v1.from_gtv(gtv);
            return provider_update_message(
                pubkey = v1.pubkey,
                system = v1.system,
                tier = v1.tier,
                active = v1.active,
                name = "",
                url = "",
            );
        }
        6 -> {
            return provider_update_message.from_gtv(gtv);
        }
        else -> {
            rell.error("Unable to decode provider_update_message");
        }
    }
}
