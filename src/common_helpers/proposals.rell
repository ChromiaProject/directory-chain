module;

/**
 * The purpose of this modules it to contain functions related to manage proposals.
 */

function get_optional_proposal_int(value: integer): integer? {
    if (value == -1) {
        return null;
    }
    return value;
}

function get_optional_proposal_decimal(value: decimal): decimal? {
    if (value == -1) {
        return null;
    }
    return value;
}
