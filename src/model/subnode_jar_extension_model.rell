enum subnode_jar_extension_type {
    COMMON, SPECIAL
}

entity subnode_jar_extension {
    key name;
    mutable jar: byte_array;
    mutable hash: byte_array;
    subnode_jar_extension_type;
    owner: provider;
    mutable description: text;
    /** GTX modules exposed by this subnode JAR extension (comma separated list of FQCNs) */
    mutable gtx_modules: text = "";
    /** Synchronization infrastructure extensions exposed by this subnode JAR extension (comma separated list of FQCNs) */
    mutable sync_exts: text = "";
    mutable active: boolean = true;
}

entity cluster_subnode_jar_extension {
    key cluster, subnode_jar_extension;
}

entity container_subnode_jar_extension {
    key container, subnode_jar_extension;
}
