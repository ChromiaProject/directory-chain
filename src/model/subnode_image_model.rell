enum subnode_image_type {
    COMMON, SPECIAL
}

entity subnode_image {
    key name;
    mutable url: text;
    mutable digest: text;
    subnode_image_type;
    owner: provider;
    mutable description: text;
    /** GTX modules exposed by this subnode image (comma separated list of FQCNs) */
    mutable gtx_modules: text = "";
    /** Synchronization infrastructure extensions exposed by this subnode image (comma separated list of FQCNs) */
    mutable sync_exts: text = "";
    mutable active: boolean = true;
    /** How many compute requests per week a container gets by default. */
    mutable base_compute_requests: integer = 0;
}

entity cluster_subnode_image {
    key cluster, subnode_image;
}

entity container_subnode_image {
    key container;
    subnode_image;
}
