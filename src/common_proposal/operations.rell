/**
 * Make common vote.
 *
 * Permission: common voter set member
 *
 * Rate limit: no
 */
operation make_common_vote(my_pubkey: pubkey, proposal_id: rowid, vote: boolean) {
    val prop = require_common_proposal(proposal_id);
    require(prop.state == common_proposal_state.PENDING, "The proposal is already %s".format(prop.state));
    require_common_voter_set_member_and_signer(prop.voter_set, my_pubkey);
    require(empty(common_vote @? {prop, my_pubkey}), "Only one vote per pubkey is allowed");
    internal_common_vote(my_pubkey, prop, vote);
}


/**
 * Delete vote for proposal.
 *
 * Permission: common voter set member
 *
 * Rate limit: no
 */
operation retract_common_vote(my_pubkey: pubkey, proposal_id: rowid) {
    val prop = require_common_proposal(proposal_id);
    require(prop.state == common_proposal_state.PENDING, "The proposal is already %s".format(prop.state));
    require_common_voter_set_member_and_signer(prop.voter_set, my_pubkey);

    val vote = common_vote @? { prop, my_pubkey };
    if (exists(vote)) {
        delete common_vote_transaction @? { vote };
        delete vote;
        log("vote for proposal retracted:", proposal_str(prop));
        try_to_apply_proposal(prop);
    } else {
        log("no vote for proposal to retract:", proposal_str(prop));
    }
}

/**
 * Revoke common proposal.
 *
 * Permission: proposal owner
 *
 * Rate limit: no
 */
operation revoke_common_proposal(my_pubkey: pubkey, proposal_id: rowid) {
    val prop = require_common_proposal(proposal_id);
    require(prop.proposed_by == my_pubkey, "It is only allowed to revoke own proposals");
    require_common_voter_set_member_and_signer(prop.voter_set, my_pubkey);
    revoke_common_proposal_unsafe(prop);
}

function revoke_common_proposal_unsafe(prop: common_proposal) {
    require(prop.state == common_proposal_state.PENDING or prop.state == common_proposal_state.DELAYED, "The proposal is already %s".format(prop.state));
    prop.state = common_proposal_state.REVOKED;
    delete_common_proposal(prop);
}
