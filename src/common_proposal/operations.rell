/**
 * Make common vote.
 *
 * @deprecated use make_common_vote_v65()
 *
 * Permission: common voter set member
 *
 * Rate limit: no
 */
operation make_common_vote(pubkey, proposal_id: rowid, vote: boolean) {
    make_common_vote_internal(proposal_id, vote);
}

/**
 * Make common vote without providing voter set member key. This will be derived from the signer list.
 *
 * @param pubkey If voter set type is VOTER_SET_MEMBER_KEY then this is the key used to vote. If the type is
 * PROVIDER_AUTH then this is the provider key.
 *
 * Permission: common voter set member
 *
 * Rate limit: no
 */
operation make_common_vote_v65(proposal_id: rowid, vote: boolean) {
    make_common_vote_internal(proposal_id, vote);
}

function make_common_vote_internal(proposal_id: rowid, vote: boolean) {
    val prop = require_common_proposal(proposal_id);
    require(prop.state == common_proposal_state.PENDING, "The proposal is already %s".format(prop.state));
    val voter_set_member = require_voter_set_member_pubkey(prop.voter_set);
    require_common_voter_set_member_and_signer(prop.voter_set, voter_set_member);
    require(empty(common_vote @? {prop, voter_set_member}), "Only one vote per pubkey is allowed");
    internal_common_vote(voter_set_member, prop, vote);
}


/**
 * Delete vote for proposal.
 *
 * Permission: common voter set member
 *
 * Rate limit: no
 */
operation retract_common_vote(proposal_id: rowid) {
    retract_common_vote_internal(proposal_id);
}

function retract_common_vote_internal(proposal_id: rowid) {
    val prop = require_common_proposal(proposal_id);
    require(prop.state == common_proposal_state.PENDING, "The proposal is already %s".format(prop.state));
    val voter_set_member = require_voter_set_member_pubkey(prop.voter_set);
    require_common_voter_set_member_and_signer(prop.voter_set, voter_set_member);

    val vote = common_vote @? { prop, voter_set_member };
    if (exists(vote)) {
        delete common_vote_transaction @? { vote };
        delete vote;
        log("vote for proposal retracted:", proposal_str(prop));
        try_to_apply_proposal(prop);
    } else {
        log("no vote for proposal to retract:", proposal_str(prop));
    }
}

/**
 * Revoke common proposal.
 *
 * @deprecated use revoke_common_proposal_v65()
 *
 * Permission: proposal owner
 *
 * Rate limit: no
 */
operation revoke_common_proposal(pubkey, proposal_id: rowid) {
    revoke_common_proposal_internal(proposal_id);
}

/**
 * Revoke common proposal providing voter set member key. This will be derived from the signer list.
 *
 * Permission: proposal owner
 *
 * Rate limit: no
 */
operation revoke_common_proposal_v65(proposal_id: rowid) {
    revoke_common_proposal_internal(proposal_id);
}

function revoke_common_proposal_internal(proposal_id: rowid) {
    val prop = require_common_proposal(proposal_id);
    val voter_set_member = require_voter_set_member_pubkey(prop.voter_set);
    require(prop.proposed_by == voter_set_member, "It is only allowed to revoke own proposals");
    require_common_voter_set_member_and_signer(prop.voter_set, voter_set_member);
    revoke_common_proposal_unsafe(prop);
}

function revoke_common_proposal_unsafe(prop: common_proposal) {
    require(prop.state == common_proposal_state.PENDING, "The proposal is already %s".format(prop.state));
    prop.state = common_proposal_state.REVOKED;
    delete_common_proposal(prop);
}
