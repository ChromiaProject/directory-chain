@test module;

import ^^.*;
import ^.helper_functions.*;
import provider_auth.test.helper_operations.*;

val alice = rell.test.keypairs.alice;
val bob = rell.test.keypairs.bob;

function test_make_common_vote_v65__voter_set_member_key() {

    rell.test.tx().op(
        create_test_common_proposal(common_proposal_type.ec_cluster_create, alice.pub, "voter_set_name")
    ).sign(alice).run();

    rell.test.tx().op(
        make_common_vote_v65(get_latest_common_proposal_id(), true)
    ).sign(alice).run();
}

function test_make_common_vote_v65__provider_auth() {

    // Create proposal
    rell.test.tx().op(
        create_test_common_proposal(common_proposal_type.ec_cluster_create, alice.pub, "voter_set_name", common_proposal_vote_type.PROVIDER_AUTH),
    ).sign(alice).run();

    // Invalid - provider has no keys
    rell.test.tx().op(
        make_common_vote_v65(get_latest_common_proposal_id(), true)
    ).sign(alice).run_must_fail("Operation must be signed by provider key(s)");

    // Add key for a new provider
    rell.test.tx().op(
        add_provider_key_op(rell.test.keypairs.dave.pub, rell.test.keypairs.dave.pub)
    ).sign(rell.test.keypairs.dave).run();

    // Invalid - Dave is not member of voter set
    rell.test.tx().op(
        make_common_vote_v65(get_latest_common_proposal_id(), true)
    ).sign(rell.test.keypairs.dave).run_must_fail("Signer is no member of voter set");

    // Add key
    rell.test.tx().op(
        add_provider_key_op(alice.pub, bob.pub)
    ).sign(alice).run();

    // Valid
    rell.test.tx().op(
        make_common_vote_v65(get_latest_common_proposal_id(), true)
    ).sign(bob).run();
}

function test_make_common_vote_v65_fail_due_to_not_member_of_voter_set() {

    rell.test.tx().op(
        create_test_common_proposal(common_proposal_type.ec_cluster_create, alice.pub, "voter_set_name")
    ).sign(alice).run();

    rell.test.tx().op(
        make_common_vote_v65(get_latest_common_proposal_id(), true)
    ).sign(bob).run_must_fail("Operation must be signed by member of voter set");
}

function test_revoke_pending_proposal() {

    rell.test.tx().op(
        create_test_common_proposal(common_proposal_type.ec_cluster_create, alice.pub, "voter_set_name")
    ).sign(alice).run();

    val proposal_id = get_latest_common_proposal_id();
    assert_equals(common_proposal @ { .rowid == proposal_id } ( .state ), common_proposal_state.PENDING);

    rell.test.tx().op(
        revoke_common_proposal_v65(get_latest_common_proposal_id()))
        .sign(alice)
        .run();

    assert_equals(common_proposal @ { .rowid == proposal_id } ( .state ), common_proposal_state.REVOKED);
}

function test_revoke_delayed_proposal() {

    rell.test.tx().op(
        create_test_common_proposal(common_proposal_type.ec_cluster_create, alice.pub, "voter_set_name",scheduled_at = timestamp.MAX_VALUE)
    ).sign(alice).run();

    vote_yes_on_latest_proposal(alice);

    val proposal_id = get_latest_common_proposal_id();
    assert_equals(common_proposal @ { .rowid == proposal_id } ( .state ), common_proposal_state.DELAYED);

    rell.test.tx().op(
        revoke_common_proposal_v65(get_latest_common_proposal_id()))
        .sign(alice)
        .run();

    assert_equals(common_proposal @ { .rowid == proposal_id } ( .state ), common_proposal_state.REVOKED);
}

function test_revoke_proposal__provider_auth() {

    rell.test.tx().op(
        create_test_common_proposal(common_proposal_type.ec_cluster_create, alice.pub, "voter_set_name", common_proposal_vote_type.PROVIDER_AUTH)
    ).sign(alice).run();

    // Invalid - provider has no keys
    rell.test.tx().op(
        revoke_common_proposal_v65(get_latest_common_proposal_id())
    ).sign(alice).run_must_fail("Operation must be signed by provider key(s)");

    // Add key
    rell.test.tx().op(
        add_provider_key_op(alice.pub, alice.pub)
    ).sign(alice).run();

    // Valid
    rell.test.tx().op(
        revoke_common_proposal_v65(get_latest_common_proposal_id()))
        .sign(alice)
        .run();

    val proposal = common_proposal @ { .proposed_by == alice.pub };
    assert_equals(proposal.state, common_proposal_state.REVOKED);
}

function test_revoke_proposal_fail_due_to_not_existing() {

    rell.test.tx().op(
        revoke_common_proposal_v65(rowid(0)))
        .sign(bob)
        .run_must_fail("Proposal 0 not found");
}

function test_revoke_proposal_fail_due_to_not_my_proposal() {

    rell.test.tx().op(
        create_test_common_proposal(common_proposal_type.ec_cluster_create, alice.pub, "voter_set_name")
    ).sign(alice).run();

    val voter_set = common_voter_set @ {};


    rell.test.tx().op(
        create_common_voter_set_member_op(voter_set, bob.pub)
    ).run();

    rell.test.tx().op(
        revoke_common_proposal_v65(get_latest_common_proposal_id()))
        .sign(bob)
        .run_must_fail("It is only allowed to revoke own proposals");
}

function test_revoke_proposal_fail_due_to_already_approved() {

    rell.test.tx().op(
        create_test_common_proposal(common_proposal_type.ec_cluster_create, alice.pub, "voter_set_name")
    ).sign(alice).run();

    rell.test.tx().op(
        make_common_vote_v65(get_latest_common_proposal_id(), true)
    ).sign(alice).run();

    rell.test.tx().op(
        revoke_common_proposal_v65(get_latest_common_proposal_id())
    ).sign(alice).run_must_fail("The proposal is already APPROVED");
}

function test_revoke_proposal_fail_due_to_already_rejected() {

    rell.test.tx().op(
        create_test_common_proposal(common_proposal_type.ec_cluster_create, alice.pub, "voter_set_name")
    ).sign(alice).run();

    rell.test.tx().op(
        make_common_vote_v65(get_latest_common_proposal_id(), false)
    ).sign(alice).run();

    rell.test.tx().op(
        revoke_common_proposal_v65(get_latest_common_proposal_id())
    ).sign(alice).run_must_fail("The proposal is already REJECTED");
}

function test_revoke_proposal_fail_due_to_already_rejected__provider_auth() {

    // Create proposal
    rell.test.tx().op(
        create_test_common_proposal(common_proposal_type.ec_cluster_create, alice.pub, "voter_set_name", common_proposal_vote_type.PROVIDER_AUTH),
    ).sign(alice).run();

    // Invalid - provider has no keys
    rell.test.tx().op(
        revoke_common_proposal_v65(get_latest_common_proposal_id())
    ).sign(alice).run_must_fail("Operation must be signed by provider key(s)");

    // Add keys
    rell.test.tx().op(
        add_provider_key_op(alice.pub, alice.pub),
        add_provider_key_op(alice.pub, bob.pub),
        set_provider_key_threshold_op(alice.pub, provider_key_role.main, consensus_threshold.super_majority),
    ).sign(alice).run();

    // Invalid - must be signed by both keys
    rell.test.tx().op(
        revoke_common_proposal_v65(get_latest_common_proposal_id())
    ).sign(alice).run_must_fail("Operation must be signed by provider key(s)");
    rell.test.tx().op(
        revoke_common_proposal_v65(get_latest_common_proposal_id())
    ).sign(bob).run_must_fail("Operation must be signed by provider key(s)");

    // Valid when signed by both keys
    rell.test.tx().op(
        revoke_common_proposal_v65(get_latest_common_proposal_id())
    ).sign(alice, bob).run();
}

function test_approved_proposal() {
    rell.test.tx().op(
        create_test_common_proposal(common_proposal_type.ec_cluster_create, alice.pub, "voter_set_name")
    ).sign(alice).run();

    rell.test.tx().op(
        make_common_vote_v65(get_latest_common_proposal_id(), true)
    ).sign(alice).run();

    val common_proposal = common_proposal @ {.proposal_type == common_proposal_type.ec_cluster_create};
    assert_equals(common_proposal.state, common_proposal_state.APPROVED);
}

function test_retract_common_vote() {

    rell.test.tx().op(
        create_test_common_proposal(common_proposal_type.ec_cluster_create, alice.pub, "voter_set_name")
    ).sign(alice).run();
    val voter_set = common_voter_set @ {};
    val proposal_id = get_latest_common_proposal_id();

    assert_equals(get_common_proposal_voter_info(proposal_id).size(), 0);

    // Bob can't revoke a vote since he isn't a member
    rell.test.tx().op(
        retract_common_vote(proposal_id)
    ).sign(bob)
        .run_must_fail("Operation must be signed by member of voter set");

    rell.test.tx().op(
        create_common_voter_set_member_op(voter_set, bob.pub),
        make_common_vote_v65(proposal_id, true),
    ).sign(bob).run();

    assert_equals(get_common_proposal_voter_info(proposal_id).size(), 1);

    rell.test.tx().op(
        retract_common_vote(proposal_id)
    ).sign(bob).run();

    assert_equals(get_common_proposal_voter_info(proposal_id).size(), 0);
}
