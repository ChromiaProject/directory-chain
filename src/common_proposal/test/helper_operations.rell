module;

import ^^.*;

operation create_test_common_proposal(
    proposal_type: common_proposal_type,
    pubkey,
    voter_set_name: text,
    type: common_proposal_vote_type = common_proposal_vote_type.VOTER_SET_MEMBER_KEY,
    scheduled_at: timestamp? = null
) {
    val voter_set = create_or_return_voter_set(voter_set_name, type);
    create_voter_set_member(voter_set, pubkey);
    val proposal = create common_proposal(op_context.last_block_time, proposal_type, pubkey, voter_set);
    if (scheduled_at != null) {
        add_scheduled_event(delay_type.PROPOSAL, proposal.rowid.to_integer(), scheduled_at);
    }
}

function create_or_return_voter_set(
    voter_set_name: text,
    type: common_proposal_vote_type = common_proposal_vote_type.VOTER_SET_MEMBER_KEY
) {
    var voter_set = common_voter_set @? { voter_set_name };
    if (voter_set == null) {
        voter_set = create common_voter_set(voter_set_name, type);
    }
    return voter_set;
}

operation create_voter_set_op(name: text) {
    create_or_return_voter_set(name);
}

operation create_voter_set_name_member_op(voter_set_name: text, pubkey) {
    create_voter_set_member(require_common_voter_set(voter_set_name), pubkey);
}

operation create_voter_set_member_op(common_voter_set, pubkey) {
    create_voter_set_member(common_voter_set, pubkey);
}

function create_voter_set_member(common_voter_set, pubkey) {
    if (not(exists(common_voter_set_member @? { common_voter_set, pubkey }))) {
        create common_voter_set_member(common_voter_set, pubkey);
    }
}

operation create_common_voter_set_member_op(common_voter_set, pubkey) {
    create common_voter_set_member(common_voter_set, pubkey);
}

operation remove_common_vote_transaction_op(proposal_id: rowid, pubkey) {
    delete common_vote_transaction @ { .vote.proposal.rowid == proposal_id, .vote.pubkey == pubkey };
}


operation create_test_voter_set_with_member(name: text, pubkey) {

    val voter_set = create common_voter_set(name, 0);
    create common_voter_set_member(voter_set, pubkey);
    create common_voter_set_governance(voter_set = voter_set, governor = voter_set);
}

operation create_test_voter_set_with_members(name: text, members: list<pubkey>, threshold: integer = 0) {

    val voter_set = create common_voter_set(name, threshold);
    for (m in members) {
        create common_voter_set_member(voter_set, m);
    }
    create common_voter_set_governance(voter_set = voter_set, governor = voter_set);
}

