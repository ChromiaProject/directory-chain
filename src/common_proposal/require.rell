function require_common_proposal(rowid) = require(common_proposal @? { rowid }, "Proposal " + rowid + " not found");

function require_common_voter_set(name) = require(common_voter_set @? { name }, "Voter set %s does not exist".format(name));

function require_common_voter_set_member_and_signer(common_voter_set, pubkey) {
    when (common_voter_set.member_key_type) {
        common_proposal_vote_type.VOTER_SET_MEMBER_KEY -> {
            require_is_signer(pubkey);
            require(exists(common_voter_set_member @* { common_voter_set, pubkey}), "%s is not part of voter set %s".format(pubkey, common_voter_set.name));
        }
        common_proposal_vote_type.PROVIDER_AUTH -> {
            require(provider_is_signer(pubkey), "Operation must be signed by provider key(s)");
            require(exists((pak: provider_auth_key, cvsm: common_voter_set_member) @* {
                pak.provider_pubkey == pubkey,
                pak.provider_key_role == provider_key_role.main,
                pak.provider_pubkey == cvsm.pubkey,
                pak.active,
                cvsm.voter_set == common_voter_set,
            }), "%s is not part of any provider in voter set %s".format(pubkey, common_voter_set.name));
        }
    }
}

function require_common_voter_set_governor(common_voter_set, pubkey) {
    val governor = common_voter_set_governance @ { .voter_set == common_voter_set } .governor;
    require_common_voter_set_member_and_signer(governor, pubkey);
}

function require_is_signer(pubkey) {
    require(op_context.is_signer(pubkey), "Operation must be signed by " + pubkey);
}

function require_only_pending_proposal_of_type(proposal: common_proposal) {
    require(empty(common_proposal @* {
        proposal.proposal_type,
        .rowid != proposal.rowid,
        .state == common_proposal_state.PENDING
    }), "A pending proposal of type %s already exists".format(proposal.proposal_type));
}

/**
 * This makes sure a valid voter set member is signer of transaction. It can either be a single key, or a provider
 * key set.
 */
function require_voter_set_member_pubkey(voter_set: common_voter_set): pubkey {
    when (voter_set.member_key_type) {
        common_proposal_vote_type.VOTER_SET_MEMBER_KEY -> {
            val signer_key_members = common_voter_set_member @* { voter_set, .pubkey in op_context.get_signers() } ( .pubkey );
            require(signer_key_members.size() != 0, "Operation must be signed by member of voter set");
            require(signer_key_members.size() == 1, "Operation can't be signed by multiple keys in voter set");
            return signer_key_members[0];
        }
        common_proposal_vote_type.PROVIDER_AUTH -> {
            val provider_signer = require(get_provider_signer(), "Operation must be signed by provider key(s)");
            require(common_voter_set_member @ { voter_set, provider_signer } ( @sum 1 ) == 1, "Signer is no member of voter set");
            return provider_signer;
        }
    }
}
