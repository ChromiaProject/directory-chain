
enum common_proposal_type {

    // Economy chain
    ec_cluster_create,
    ec_cluster_change_tag,
    ec_tag_create,
    ec_tag_update,
    ec_tag_remove,
    ec_constants_update,
    ec_system_provider_constants_update,
    ec_staking_requirement_constants_update,
    ec_voter_set_update,
    ec_mint,
    ec_transfer_chromia_foundation_funds,
    ec_price_oracle_rate,

    tc_propose_token,
    tc_propose_token_bridge
}

enum common_proposal_state {
    PENDING, APPROVED, REJECTED, REVOKED
}

/**
 * Defined what keys to permit voting by voter set members.
 */
enum common_proposal_vote_type {
    /**
     * common_voter_set_member.pubkey will be both member identifier and the key allowed to vote.
     */
    VOTER_SET_MEMBER_KEY,

    /**
     * common_voter_set_member.pubkey will be the identifier (provider pubkey) only and permits only provider_auth
     * keys to vote with respect of threshold
     */
    PROVIDER_AUTH,
}

entity common_proposal {
    index timestamp, proposal_type: common_proposal_type;
    proposed_by: pubkey;
    index voter_set: common_voter_set;
    description: text = "";
    transaction = op_context.transaction;
    mutable state: common_proposal_state = common_proposal_state.PENDING;
}

entity common_voter_set {
    key name;

    /** VOTER_SET_MEMBER_KEY will be default for all voter_sets until the point multi keys are enabled. */
    mutable member_key_type: common_proposal_vote_type = common_proposal_vote_type.VOTER_SET_MEMBER_KEY;
    mutable threshold: integer = 0;
}

entity common_voter_set_governance {
    key voter_set: common_voter_set;
    mutable governor: common_voter_set;
}

entity common_voter_set_member {
    key voter_set: common_voter_set, pubkey;
}

entity common_vote {
    key proposal: common_proposal, pubkey;
    vote: boolean;
}

/** To track the transaction of each vote */
entity common_vote_transaction {
    key vote: common_vote;
    transaction;
    op_index: integer;
}
