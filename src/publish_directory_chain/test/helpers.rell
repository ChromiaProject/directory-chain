module;

import ^^.*;

operation create_container_from_container_name_op(container_name: text, provider_pubkey: byte_array) {
    val voter_set = create voter_set(container_name);
    val cluster = create cluster(container_name, voter_set);
    val provider = create provider(provider_pubkey);
    create container(container_name, cluster, voter_set, provider @ { provider_pubkey });
}

operation create_blockchain_op(blockchain_rid: byte_array, bc_name: text) {
    create blockchain(blockchain_rid, bc_name);
}

operation create_container_blockchain_op(container, blockchain) {
    create_container_blockchain(container, blockchain);
}

operation delete_container_blockchain_op(container_blockchain){
    delete_container_blockchain(container_blockchain);
}

operation delete_container_blockchain_by_blockchain_op(blockchain){
    delete_container_blockchain_by_blockchain(blockchain);
}