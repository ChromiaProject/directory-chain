@extendable function on_resource_usage_statistics_update(node_pubkey: pubkey, container_name: text, mesurement_time: timestamp, resource_type: resource_type, metric_value: decimal, previous_value: resource_usage_statistics?) {}

operation __resource_usage_statistics(node_pubkey: pubkey, container_name: text, mesurement_time: timestamp, resource_type: resource_type, metric_value: decimal) {
    handle_resource_usage_statistics(node_pubkey, container_name, mesurement_time, resource_type, metric_value);
}

function handle_resource_usage_statistics(node_pubkey: pubkey, container_name: text, mesurement_time: timestamp, resource_type: resource_type, metric_value: decimal) {
    val resource_usage_statistic = resource_usage_statistics @? { node_pubkey, resource_type, container_name };

    on_resource_usage_statistics_update(node_pubkey, container_name, mesurement_time, resource_type, metric_value, resource_usage_statistic);

    if (resource_usage_statistic != null) {
        resource_usage_statistic.mesurement_time = mesurement_time;
        resource_usage_statistic.metric_value = metric_value;
    } else {
        create resource_usage_statistics(node_pubkey, container_name, mesurement_time, resource_type, metric_value);
    }
}

@extend(on_resource_usage_statistics_update)
function send_resource_usage_statistics_update(
    node_pubkey: pubkey,
    container_name: text,
    mesurement_time: timestamp,
    type: resource_type,
    metric_value: decimal,
    previous_value: resource_usage_statistics? = null
) {
    if (type == resource_type.space_usage_mib) {
        send_message(
            resource_usage_statistics_topic,
            resource_usage_statistics_message(
                node_pubkey,
                container_name,
                mesurement_time,
                type = type.name,
                metric_value,
            ).to_gtv()
        );
    }
}

/**
 * Resource usage value and its associated measurement time by node for each container.
 */
entity resource_usage_statistics {
    node_pubkey: pubkey;
    container_name: text;
    mutable mesurement_time: timestamp;
    resource_type: resource_type;
    mutable metric_value: decimal;
}

/**
 * Represents the measured value of a specific resource for a container on a specific node.
 */
struct container_resource_usage_statistics {
    node_pubkey: pubkey;
    mesurement_time: timestamp;
    resource_type: resource_type;
    metric_value: decimal;
}

/**
 * Retrieves last measured resource usage statistics across nodes, for a given container optionally filtered by resource type and node.
 */
query get_latest_resource_usage_statistics(container_name: text, resource_type: resource_type?, node_pubkey: pubkey?) {
    return resource_usage_statistics @* { container_name, resource_type == null or .resource_type == resource_type, node_pubkey == null or .node_pubkey == node_pubkey } ( container_resource_usage_statistics(.node_pubkey, .mesurement_time, .resource_type, .metric_value ));
}

@extend(receive_icmf_message) function receive_container_blockchain_update(sender: byte_array, topic: text, body: gtv) {
    if (topic != container_blockchain_update_topic) return;
    receive_container_blockchain_update_impl(body);
}

function receive_container_blockchain_update_impl(body: gtv){
    val message = container_blockchain_update_message.from_gtv(body);
    if (message.deleted) {
        delete container_blockchain @* { message.container_name, message.blockchain_rid };
    } else {
        create container_blockchain(message.container_name, message.blockchain_rid);
    }
}

//////////////////////////////////
// directory-chain synced entities
entity container_blockchain {
    container_name: text;
    blockchain_rid: byte_array;
}

function get_excluded_blockchains() {
    val excluded_containers = list<text>();
    val space_usage_percentage_by_container = resource_usage_statistics @* { .resource_type == resource_type.space_usage_percentage} ( @group .container_name, @list .metric_value ) @ {} ( @map $ );
    for (container in space_usage_percentage_by_container.keys()) {
        val space_usage_percentage = space_usage_percentage_by_container[container];
        val number_of_nodes_measuring = space_usage_percentage.size();
        val number_of_nodes_exceeding_threshold = space_usage_percentage @* { $ > chain_context.args.space_usage_percentage_threshold };
        if (number_of_nodes_exceeding_threshold.size() >= (number_of_nodes_measuring - (number_of_nodes_measuring - 1) / 3 )) {
            excluded_containers.add(container);
        }
    }
    val result = container_blockchain @* { .container_name in excluded_containers } ( .blockchain_rid );
    if (not result.empty()) {
        log("This blockchains are excluded from availability calculation due to low free storage space: %s".format(result));
    }
    return result;
}
