module;

import ^^.*;

operation create_anchor_block(
    blockchain_rid: byte_array,
    block_height: integer,
    timestamp: integer,
    block_rid: byte_array,
    block_header: byte_array,
    witness: byte_array,
    anchoring_tx_op_index: integer
) {
    create anchor_block(
        blockchain_rid = blockchain_rid,
        block_height = block_height,
        timestamp = timestamp,
        block_rid = block_rid,
        block_header = block_header,
        witness = witness,
        anchoring_tx_op_index = anchoring_tx_op_index
    );
}

operation create_icmf_messages_height(topic: text, sender: byte_array, sender_height: integer, anchor_height: integer) {
    create icmf_messages_height(
        topic = topic,
        sender = sender,
        sender_height = sender_height,
        anchor_height = anchor_height
    );
}

operation fetch_blocks_and_calculate_and_store_node_availability_op(start_time: integer, end_time: integer, block_range_size: integer) {
    fetch_blocks_and_calculate_and_store_node_availability(start_time, end_time, block_range_size);
}

operation handle_resource_usage_statistics_op(node_pubkey: pubkey, container_name: text, timestamp, resource_type: resource_type, metric_value: decimal) {
    handle_resource_usage_statistics(node_pubkey, container_name, timestamp, resource_type, metric_value);
}

operation create_container_blockchain_op(container_name: text, blockchain_rid: pubkey) {
    create container_blockchain(container_name, blockchain_rid);
}

operation receive_container_blockchain_update_op(sender: byte_array, topic: text, body: gtv) {
    receive_container_blockchain_update(sender, topic, body);
}
