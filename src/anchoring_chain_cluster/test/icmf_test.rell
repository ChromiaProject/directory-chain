@test module;

import ^.helpers.*;
import ^^.*;

val BLOCKCHAIN_RID = byte_array.from_hex("F435688B2F74933C71F8AA1952E1CFBCDAA421EF378A441EFF4EC5900896F1FA");
val TOPIC = "L_test";

function test_headers_with_messages_query_limit() {
    // Setup:
    // 2 anchored blocks per anchor block with messages in all of them
    // Total: 3 anchor blocks -> 6 anchored blocks
    rell.test.tx().op(
        __anchor_block_header(
            block_rid = x"00",
            header = block_header(
                blockchain_rid = BLOCKCHAIN_RID,
                previous_block_rid = x"",
                merkle_root_hash = x"",
                timestamp = 0,
                height = 0,
                dependencies = null.to_gtv(),
                extra = map(),
            ).to_gtv(),
            witness = x"00"
        ),
        create_icmf_messages_height(
            topic = TOPIC,
            sender = BLOCKCHAIN_RID,
            sender_height = 0,
            anchor_height = 0
        ),
        __anchor_block_header(
            block_rid = x"01",
            header = block_header(
                blockchain_rid = BLOCKCHAIN_RID,
                previous_block_rid = x"00",
                merkle_root_hash = x"",
                timestamp = 1,
                height = 1,
                dependencies = null.to_gtv(),
                extra = map(),
            ).to_gtv(),
            witness = x"01"
        ),
        create_icmf_messages_height(
            topic = TOPIC,
            sender = BLOCKCHAIN_RID,
            sender_height = 1,
            anchor_height = 0
        ),
    ).run();
    rell.test.tx().op(
        __anchor_block_header(
            block_rid = x"02",
            header = block_header(
                blockchain_rid = BLOCKCHAIN_RID,
                previous_block_rid = x"01",
                merkle_root_hash = x"",
                timestamp = 0,
                height = 2,
                dependencies = null.to_gtv(),
                extra = map(),
            ).to_gtv(),
            witness = x"02"
        ),
        create_icmf_messages_height(
            topic = TOPIC,
            sender = BLOCKCHAIN_RID,
            sender_height = 2,
            anchor_height = 1
        ),
        __anchor_block_header(
            block_rid = x"03",
            header = block_header(
                blockchain_rid = BLOCKCHAIN_RID,
                previous_block_rid = x"02",
                merkle_root_hash = x"",
                timestamp = 0,
                height = 3,
                dependencies = null.to_gtv(),
                extra = map(),
            ).to_gtv(),
            witness = x"03"
        ),
        create_icmf_messages_height(
            topic = TOPIC,
            sender = BLOCKCHAIN_RID,
            sender_height = 3,
            anchor_height = 1
        ),
    ).run();
    rell.test.tx().op(
        __anchor_block_header(
            block_rid = x"04",
            header = block_header(
                blockchain_rid = BLOCKCHAIN_RID,
                previous_block_rid = x"03",
                merkle_root_hash = x"",
                timestamp = 0,
                height = 4,
                dependencies = null.to_gtv(),
                extra = map(),
            ).to_gtv(),
            witness = x"04"
        ),
        create_icmf_messages_height(
            topic = TOPIC,
            sender = BLOCKCHAIN_RID,
            sender_height = 4,
            anchor_height = 2
        ),
        __anchor_block_header(
            block_rid = x"05",
            header = block_header(
                blockchain_rid = BLOCKCHAIN_RID,
                previous_block_rid = x"04",
                merkle_root_hash = x"",
                timestamp = 0,
                height = 5,
                dependencies = null.to_gtv(),
                extra = map(),
            ).to_gtv(),
            witness = x"05"
        ),
        create_icmf_messages_height(
            topic = TOPIC,
            sender = BLOCKCHAIN_RID,
            sender_height = 5,
            anchor_height = 2
        ),
    ).run();

    // Limit is 3 -> return 4, since we should not cut off in the middle of a height
    assert_equals(icmf_get_headers_with_messages_after_height(TOPIC, -1).size(), 4);
}
