@test module;

import ^.helpers.*;
import ^^.*;

// Extracted example from devnet
val BLOCKCHAIN_RID_1 = byte_array.from_hex("F435688B2F74933C71F8AA1952E1CFBCDAA421EF378A441EFF4EC5900896F1FA");
val BLOCKCHAIN_RID_2 = byte_array.from_hex("2222688B2F74933C71F8AA1952E1CFBCDAA421EF378A441EFF4EC5900896F1FA");
val BLOCK_RID_1 = byte_array.from_hex("1E06C063CD1451690352F956DBD68B3DFF3B893840B6E668707D0AA01C0ACC36");
val BLOCK_RID_2 = byte_array.from_hex("0C04CB8E710A08C57927011FB9E810C8E5097A0FEA6DF73367287F6E1BAFF00D");
val WITNESS_COUNT_3 = byte_array.from_hex("");
val WITNESS_COUNT_4 = byte_array.from_hex("");
val DAY_MS = 1000 * 60 * 60 * 24; // 1 day;

// assumes one signer set by default in test so block range will be 1
function test_send_node_availability_report() {
    rell.test.set_next_block_time(1);
    rell.test.block().run();

    val time = DAY_MS + 100;
    rell.test.set_next_block_time(time);
    rell.test.tx().op(
        __anchor_block_header(BLOCK_RID_1, block_header(
            blockchain_rid = BLOCKCHAIN_RID_1,
            previous_block_rid = x"",
            merkle_root_hash = x"",
            timestamp = DAY_MS,
            height = 0,
            dependencies = null.to_gtv(),
            extra = ["config_hash":x"552942BF9C8CB791D58627809A677F691D1F7B00990571366289DD327AC19245".to_gtv()],
        ).to_gtv(), WITNESS_COUNT_4),
        __anchor_block_header(BLOCK_RID_2, block_header(
            blockchain_rid = BLOCKCHAIN_RID_1,
            previous_block_rid = x"",
            merkle_root_hash = x"",
            timestamp = DAY_MS + 1,
            height = 1,
            dependencies = null.to_gtv(),
            extra = ["config_hash":x"552942BF9C8CB791D58627809A677F691D1F7B00990571366289DD327AC19245".to_gtv()],
        ).to_gtv(), WITNESS_COUNT_3),
    ).run();

    rell.test.block().run(); // Runs send_node_availability_report

    val expected = node_availability_report(start_time = 1, end_time = time, [
        byte_array.from_hex('0350FE40766BC0CE8D08B3F5B810E49A8352FDD458606BD5FAFE5ACDCDC8FF3F57'): 1.0,
        byte_array.from_hex('03F811D3E806E6D093A4BCCE49C145BA78F9A4B2FBD167753ECAB2A13530B081F8'): 0.5, // Slightly shifted order - #1 vs #2
        byte_array.from_hex('03EF3F5BE98D499B048BA28B247036B611A1CED7FCF87C17C8B5CA3B3CE1EE23A4'): 1.0,
        byte_array.from_hex('035676109C54B9A16D271ABEB4954316A40A32BCCE023AC14C8E26E958AA68FBA9'): 1.0
    ]);

    assert_events((
                "icmf_message",
                (topic = node_availability_report_topic, body = expected.to_gtv())
                    .to_gtv_pretty())
    );
}

function test_fetch_blocks_and_calculate_node_availability_given_one_blockchain_and_four_nodes() {
    rell.test.tx().op(
        __anchor_block_header(BLOCK_RID_1, block_header(
            blockchain_rid = BLOCKCHAIN_RID_1,
            previous_block_rid = x"",
            merkle_root_hash = x"",
            timestamp = 10,
            height = 0,
            dependencies = null.to_gtv(),
            extra = ["config_hash":x"552942BF9C8CB791D58627809A677F691D1F7B00990571366289DD327AC19245".to_gtv()],
        ).to_gtv(), WITNESS_COUNT_4),
        __anchor_block_header(BLOCK_RID_2, block_header(
            blockchain_rid = BLOCKCHAIN_RID_1,
            previous_block_rid = x"",
            merkle_root_hash = x"",
            timestamp = 11,
            height = 1,
            dependencies = null.to_gtv(),
            extra = ["config_hash":x"552942BF9C8CB791D58627809A677F691D1F7B00990571366289DD327AC19245".to_gtv()],
        ).to_gtv(), WITNESS_COUNT_3),
    ).run();

    val expected_node_availability = [
            byte_array.from_hex('03F811D3E806E6D093A4BCCE49C145BA78F9A4B2FBD167753ECAB2A13530B081F8'): 0.5,
            byte_array.from_hex('0350FE40766BC0CE8D08B3F5B810E49A8352FDD458606BD5FAFE5ACDCDC8FF3F57'): 1.0,
            byte_array.from_hex('03EF3F5BE98D499B048BA28B247036B611A1CED7FCF87C17C8B5CA3B3CE1EE23A4'): 1.0,
            byte_array.from_hex('035676109C54B9A16D271ABEB4954316A40A32BCCE023AC14C8E26E958AA68FBA9'): 1.0
        ];

    val node_availability = fetch_blocks_and_calculate_node_availability(9, 12, 1);

    assert_equals(node_availability, expected_node_availability);
}

function test_fetch_blocks_and_calculate_node_availability_given_excluded_blockchains() {
    val node_pubkey1 = rell.test.pubkeys.charlie;
    val node_pubkey2 = rell.test.pubkeys.bob;
    val node_pubkey3 = rell.test.pubkeys.alice;
    val node_pubkey4 = rell.test.pubkeys.trudy;
    val BLOCKCHAIN_RID_1 = byte_array.from_hex("F435688B2F74933C71F8AA1952E1CFBCDAA421EF378A441EFF4EC5900896F1FA");
    rell.test.tx().op(
        handle_resource_usage_statistics_op(
            node_pubkey1,
            "container1",
            1,
            resource_type.space_usage_percentage,
            91
        ),
        handle_resource_usage_statistics_op(
            node_pubkey2,
            "container1",
            1,
            resource_type.space_usage_percentage,
            91
        ),
        handle_resource_usage_statistics_op(
            node_pubkey3,
            "container1",
            1,
            resource_type.space_usage_percentage,
            91
        ),
        handle_resource_usage_statistics_op(
            node_pubkey4,
            "container1",
            1,
            resource_type.space_usage_percentage,
            91
        ),
        create_container_blockchain_op("container1", BLOCKCHAIN_RID_1)
    ).run();
    rell.test.tx().op(
        __anchor_block_header(BLOCK_RID_1, block_header(
            blockchain_rid = BLOCKCHAIN_RID_1,
            previous_block_rid = x"",
            merkle_root_hash = x"",
            timestamp = 10,
            height = 0,
            dependencies = null.to_gtv(),
            extra = ["config_hash":x"552942BF9C8CB791D58627809A677F691D1F7B00990571366289DD327AC19245".to_gtv()],
        ).to_gtv(), WITNESS_COUNT_4),
    ).run();

    val node_availability = fetch_blocks_and_calculate_node_availability(9, 12, 1);

    assert_equals(node_availability, map<byte_array, decimal>());
}

function test_fetch_and_aggregate_node_availability_given_two_blockchains_and_four_nodes() {
    rell.test.tx().op(
        __anchor_block_header(BLOCK_RID_1, block_header(
            blockchain_rid = BLOCKCHAIN_RID_1,
            previous_block_rid = x"",
            merkle_root_hash = x"",
            timestamp = 10,
            height = 0,
            dependencies = null.to_gtv(),
            extra = ["config_hash":x"552942BF9C8CB791D58627809A677F691D1F7B00990571366289DD327AC19245".to_gtv()],
        ).to_gtv(), WITNESS_COUNT_4),
        __anchor_block_header(BLOCK_RID_2, block_header(
            blockchain_rid = BLOCKCHAIN_RID_2,
            previous_block_rid = x"",
            merkle_root_hash = x"",
            timestamp = 11,
            height = 0,
            dependencies = null.to_gtv(),
            extra = ["config_hash":x"552942BF9C8CB791D58627809A677F691D1F7B00990571366289DD327AC19245".to_gtv()],
        ).to_gtv(), WITNESS_COUNT_4),
        __anchor_block_header(BLOCK_RID_1, block_header(
            blockchain_rid = BLOCKCHAIN_RID_1,
            previous_block_rid = x"",
            merkle_root_hash = x"",
            timestamp = 12,
            height = 1,
            dependencies = null.to_gtv(),
            extra = ["config_hash":x"552942BF9C8CB791D58627809A677F691D1F7B00990571366289DD327AC19245".to_gtv()],
        ).to_gtv(), WITNESS_COUNT_3),
        __anchor_block_header(BLOCK_RID_2, block_header(
            blockchain_rid = BLOCKCHAIN_RID_2,
            previous_block_rid = x"",
            merkle_root_hash = x"",
            timestamp = 13,
            height = 1,
            dependencies = null.to_gtv(),
            extra = ["config_hash":x"552942BF9C8CB791D58627809A677F691D1F7B00990571366289DD327AC19245".to_gtv()],
        ).to_gtv(), WITNESS_COUNT_3),
    ).run();

    // Extracted example from devnet
    val expected_node_availability = [
            byte_array.from_hex('03F811D3E806E6D093A4BCCE49C145BA78F9A4B2FBD167753ECAB2A13530B081F8'): 0.5,
            byte_array.from_hex('0350FE40766BC0CE8D08B3F5B810E49A8352FDD458606BD5FAFE5ACDCDC8FF3F57'): 1.0,
            byte_array.from_hex('03EF3F5BE98D499B048BA28B247036B611A1CED7FCF87C17C8B5CA3B3CE1EE23A4'): 1.0,
            byte_array.from_hex('035676109C54B9A16D271ABEB4954316A40A32BCCE023AC14C8E26E958AA68FBA9'): 1.0
        ];

    rell.test.tx().op(
        fetch_blocks_and_calculate_and_store_node_availability_op(9, 12, 1)
    ).run();
    rell.test.tx().op(
        fetch_blocks_and_calculate_and_store_node_availability_op(12, 14, 1)
    ).run();
    val node_availability = fetch_aggregated_node_availability(0, 0);

    assert_equals(node_availability, expected_node_availability);
}

