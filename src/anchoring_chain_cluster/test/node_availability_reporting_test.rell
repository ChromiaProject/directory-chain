}

function test_calculate_node_availability_with_many_blocks() {
    val anchored_blocks = list<(blockchain_rid: byte_array, signers: list<byte_array>, primary_extra_header: gtv?)>();

    for (i in range(350000 / 24)) {
        anchored_blocks.add((
            blockchain_rid = if (i % 2 == 0) BLOCKCHAIN_RID_1 else BLOCKCHAIN_RID_2,
            signers = extract_signers_from_witness(if (i % 2 == 0) WITNESS_COUNT_4 else WITNESS_COUNT_3),
            primary_extra_header = null,
        ));
    }

    val expected_node_availability = [
            byte_array.from_hex('03F811D3E806E6D093A4BCCE49C145BA78F9A4B2FBD167753ECAB2A13530B081F8'): 0.5,
            byte_array.from_hex('0350FE40766BC0CE8D08B3F5B810E49A8352FDD458606BD5FAFE5ACDCDC8FF3F57'): 1.0,
            byte_array.from_hex('03EF3F5BE98D499B048BA28B247036B611A1CED7FCF87C17C8B5CA3B3CE1EE23A4'): 1.0,
            byte_array.from_hex('035676109C54B9A16D271ABEB4954316A40A32BCCE023AC14C8E26E958AA68FBA9'): 1.0
        ];

    val node_availability = calculate_node_availability(anchored_blocks, 1);

    assert_equals(node_availability, expected_node_availability);
}

function test_node_availability_from_primary_header_field() {
    val anchored_blocks: list<(blockchain_rid: byte_array, signers: list<byte_array>, primary_extra_header: gtv?)> = [
        (
            blockchain_rid = BLOCKCHAIN_RID_1,
            signers = extract_signers_from_witness(WITNESS_COUNT_3),
            primary_extra_header = byte_array.from_hex('03F811D3E806E6D093A4BCCE49C145BA78F9A4B2FBD167753ECAB2A13530B081F8').to_gtv(),
        ),
    ];

    val expected_node_availability = [
        byte_array.from_hex('03F811D3E806E6D093A4BCCE49C145BA78F9A4B2FBD167753ECAB2A13530B081F8'): 1.0, // 1 even though not in witness
        byte_array.from_hex('0350FE40766BC0CE8D08B3F5B810E49A8352FDD458606BD5FAFE5ACDCDC8FF3F57'): 1.0,
        byte_array.from_hex('03EF3F5BE98D499B048BA28B247036B611A1CED7FCF87C17C8B5CA3B3CE1EE23A4'): 1.0,
        byte_array.from_hex('035676109C54B9A16D271ABEB4954316A40A32BCCE023AC14C8E26E958AA68FBA9'): 1.0
    ];

    val node_availability = calculate_node_availability(anchored_blocks, 1);

    assert_equals(node_availability, expected_node_availability);
}

function test_extract_signers() {
    // Extracted example from devnet. Expecting signers:
    val expected_signers = set([
        byte_array.from_hex("0350FE40766BC0CE8D08B3F5B810E49A8352FDD458606BD5FAFE5ACDCDC8FF3F57"),
        byte_array.from_hex("03F811D3E806E6D093A4BCCE49C145BA78F9A4B2FBD167753ECAB2A13530B081F8"),
        byte_array.from_hex("03EF3F5BE98D499B048BA28B247036B611A1CED7FCF87C17C8B5CA3B3CE1EE23A4"),
        byte_array.from_hex("035676109C54B9A16D271ABEB4954316A40A32BCCE023AC14C8E26E958AA68FBA9")
    ]);

    val signers = extract_signers_from_witness(WITNESS_COUNT_4);

    assert_equals(set(signers), expected_signers);
}

function test_parse_integer() {
    assert_equals(parse_integer(x"00000000", 0), 0);
    assert_equals(parse_integer(x"00000001", 0), 1);
    assert_equals(parse_integer(x"01000000", 0), 0x1000000);
    assert_equals(parse_integer(x"01010101", 0), 0x1000000 + 0x10000 + 0x100 + 1);
    assert_equals(parse_integer(x"0001010101", 1), 0x1000000 + 0x10000 + 0x100 + 1);
}
