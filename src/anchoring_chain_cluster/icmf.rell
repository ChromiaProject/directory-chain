
entity icmf_messages_height {
    key topic: text,
        sender: byte_array,
        sender_height: integer;
    anchor_height: integer;
    index topic, anchor_height;
}

struct signed_block_header_with_anchor_height {
    block_header: byte_array;
    witness: byte_array;
    anchor_height: integer;
}

val query_limit = if (chain_context.args.imcf_headers_with_messages_query_limit > 0)
    chain_context.args.imcf_headers_with_messages_query_limit else DEFAULT_HEADERS_WITH_MESSAGES_QUERY_LIMIT;

@extend(after_anchoring_block) function process_icmf(block_rid: byte_array, header: block_header) {
    if (not header.extra.contains("icmf_send")) return;

    val icmf_data = map<text,gtv>.from_gtv_pretty(header.extra["icmf_send"]);
    for (topic in icmf_data.keys()) {
        if (not(topic.starts_with(ICMF_TOPIC_GLOBAL_PREFIX))) continue;
        val previous_anchor_height = icmf_messages_height @? { topic, .anchor_height < op_context.block_height } (@max .anchor_height) ?: -1;
        op_context.emit_event("icmf_header", (block_rid = block_rid, topic = topic, previous_anchor_height = previous_anchor_height).to_gtv_pretty());

        create icmf_messages_height(
            topic = topic,
            sender = header.blockchain_rid,
            sender_height = header.height,
            anchor_height = op_context.block_height
        );
    }
}

query icmf_get_headers_with_messages_after_height(topic: text, from_anchor_height: integer): list<signed_block_header_with_anchor_height> {
    val headers_with_messages_after_height = (m: icmf_messages_height, a: anchor_block) @*
        { a.blockchain_rid == m.sender, a.block_height == m.sender_height, topic, .anchor_height > from_anchor_height }
        (build_signed_block_header_with_anchor_height(a.transaction, a.anchoring_tx_op_index,m.anchor_height),
            @sort m.rowid)
        limit query_limit;

    // For ICMF to work this query must return everything for each anchoring height so we need to add anything that
    // was cut off by the limit above
    if (headers_with_messages_after_height.size() == query_limit) {
        val (last_retrieved_header_with_message, last_retreived_rowid) = headers_with_messages_after_height[query_limit - 1];
        headers_with_messages_after_height.add_all(
            (m: icmf_messages_height, a: anchor_block) @*
            { a.blockchain_rid == m.sender, a.block_height == m.sender_height, topic, .anchor_height == last_retrieved_header_with_message.anchor_height, m.rowid > last_retreived_rowid }
            (build_signed_block_header_with_anchor_height(a.transaction, a.anchoring_tx_op_index, m.anchor_height),
                @sort m.rowid)
        );
    }

    return headers_with_messages_after_height @* { }($[0]);
}

function build_signed_block_header_with_anchor_height(transaction, tx_index: integer, anchor_height: integer): signed_block_header_with_anchor_height {
    val anchored_block = extract_anchored_block(transaction, tx_index);
    return signed_block_header_with_anchor_height(
        block_header = anchored_block.block_header.to_bytes(),
        witness = anchored_block.witness,
        anchor_height = anchor_height,
    );
}
