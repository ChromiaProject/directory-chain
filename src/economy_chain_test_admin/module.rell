module;

import economy_chain.*;

struct module_args {
    admin_pubkey: byte_array;
}

function require_admin() = require(op_context.is_signer(chain_context.args.admin_pubkey), "Expected admin signature");

/**
/* Manually claim user rewards
**/
operation staking_claim_rewards() {
    require_admin();
    _staking_distribute_rewards();
}

operation update_chr_per_usd(
    chr_per_usd: decimal?
) {
    require_admin();
    economy_constants.chr_per_usd = chr_per_usd ?: economy_constants.chr_per_usd;
}

