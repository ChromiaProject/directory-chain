val CONFIG_HASH_HEADER_KEY = "config_hash";

@extend(after_anchoring_block) function process_configuration_updated(block_rid: byte_array, header: block_header) {
    if (not header.extra.contains(CONFIG_HASH_HEADER_KEY)) return;
    val current_config_hash = byte_array.from_gtv(header.extra[CONFIG_HASH_HEADER_KEY]);
    val blockchain_rid = header.blockchain_rid;

    val prev_block_info = anchor_block @? { blockchain_rid, .block_height < header.height } (
        @omit @sort_desc .block_height, $
    ) limit 1;

    if (prev_block_info != null) {
        val prev_block_header = extract_anchored_block(prev_block_info.transaction, prev_block_info.anchoring_tx_op_index).block_header;
        val prev_config_hash = if (prev_block_header.extra.contains(CONFIG_HASH_HEADER_KEY)) byte_array.from_gtv(prev_block_header.extra.get(CONFIG_HASH_HEADER_KEY)) else null;

        if (prev_config_hash != null and current_config_hash != prev_config_hash) {
            log("Anchoring chain %s detected updated configuration for chain %s at height %d from %s to %s".format(
                chain_context.blockchain_rid, blockchain_rid, header.height, prev_config_hash, current_config_hash));
            send_message(
                configuration_updated_topic,
                configuration_updated(blockchain_rid, header.height, config_hash = current_config_hash).to_gtv()
            );
        }
    }
}
