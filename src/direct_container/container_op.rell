/**
 * Creates container.
 * 
 * Permission: cluster governor
 * 
 * Rate limit: actions
 *
 * @param consensus_threshold  majority (-1), super majority (0) or custom (1, ...)
 */
operation create_container(my_pubkey: pubkey, name, cluster_name: text, consensus_threshold: integer, deployers: list<pubkey>) {
    create_container_with_resource_limits_impl(my_pubkey, name, cluster_name, consensus_threshold, deployers, empty_container_resource_limits(), [], "");
}

/**
 * Creates container with resource limits.
 * 
 * Permission: cluster governor
 * 
 * Rate limit: actions
 */
operation create_container_with_resource_limits(my_pubkey: pubkey, name, cluster_name: text, consensus_threshold: integer,
        deployers: list<pubkey>, resource_limits: map<container_resource_limit_type, integer>) {
    create_container_with_resource_limits_impl(my_pubkey, name, cluster_name, consensus_threshold, deployers, resource_limits, [], "");
}

/**
 * Creates container with resource limits and subnode image.
 *
 * Permission: cluster governor
 *
 * Rate limit: actions
 *
 * @param subnode_image subnode image name, or "" to not assign subnode image
 */
operation create_container_with_resource_limits_and_subnode_image(my_pubkey: pubkey, name, cluster_name: text, consensus_threshold: integer,
        deployers: list<pubkey>, resource_limits: map<container_resource_limit_type, integer>, subnode_image: text) {
    create_container_with_resource_limits_impl(my_pubkey, name, cluster_name, consensus_threshold, deployers, resource_limits, [], subnode_image);
}

/**
 * Creates container with resource limits and JAR extensions.
 *
 * Permission: cluster governor
 *
 * Rate limit: actions
 *
 * @param jar_extensions subnode JAR extension names, or empty to not add any subnode JAR extensions
 * @param subnode_image subnode image name, or null to not assign subnode image
 */
operation create_container_with_resource_limits_and_jar_extensions(my_pubkey: pubkey, name, cluster_name: text, consensus_threshold: integer,
        deployers: list<pubkey>, resource_limits: map<container_resource_limit_type, integer>, jar_extensions: list<text>, subnode_image: text? = null) {
    create_container_with_resource_limits_impl(my_pubkey, name, cluster_name, consensus_threshold, deployers, resource_limits, jar_extensions, subnode_image ?: "");
}

/**
 * Creates container with voters set.
 * 
 * Permission: cluster governor
 * 
 * Rate limit: actions
 * 
 * @param  consensus_threshold  majority (-1), super majority (0) or custom (1, ...)
 */
operation create_container_from(my_pubkey: pubkey, name, cluster_name: text, consensus_threshold: integer, voter_set_name: text) {
    create_container_from_with_resource_limits_impl(my_pubkey, name, cluster_name, consensus_threshold, voter_set_name, empty_container_resource_limits(), [],  "");
}

/**
 * Creates container with voters set and resource limits.
 * 
 * Permission: cluster governor
 * 
 * Rate limit: actions
 */
operation create_container_from_with_resource_limits(my_pubkey: pubkey, name, cluster_name: text, consensus_threshold: integer,
        voter_set_name: text, resource_limits: map<container_resource_limit_type, integer>) {
    create_container_from_with_resource_limits_impl(my_pubkey, name, cluster_name, consensus_threshold, voter_set_name, resource_limits, [],  "");
}

/**
 * Creates container with voters set, resource limits and subnode image.
 *
 * Permission: cluster governor
 *
 * Rate limit: actions
 *
 * @param subnode_image subnode image name, or "" to not assign subnode image
 */
operation create_container_from_with_resource_limits_and_subnode_image(my_pubkey: pubkey, name, cluster_name: text, consensus_threshold: integer,
        voter_set_name: text, resource_limits: map<container_resource_limit_type, integer>, subnode_image: text) {
    create_container_from_with_resource_limits_impl(my_pubkey, name, cluster_name, consensus_threshold, voter_set_name, resource_limits, [], subnode_image);
}

/**
 * Creates container with voters set, resource limits and JAR extensions.
 *
 * Permission: cluster governor
 *
 * Rate limit: actions
 *
 * @param jar_extensions subnode JAR extension names, or empty to not add any subnode JAR extensions
 * @param subnode_image subnode image name, or null to not assign subnode image
 */
operation create_container_from_with_resource_limits_and_jar_extensions(my_pubkey: pubkey, name, cluster_name: text, consensus_threshold: integer,
        voter_set_name: text, resource_limits: map<container_resource_limit_type, integer>, jar_extensions: list<text>, subnode_image: text? = null) {
    create_container_from_with_resource_limits_impl(my_pubkey, name, cluster_name, consensus_threshold, voter_set_name, resource_limits, jar_extensions, subnode_image ?: "");
}

/**
 * Creates container deployer.
 * 
 * Permission: cluster governor
 * 
 * Rate limit: actions
 */
operation add_container_deployer(my_pubkey: pubkey, container_name: text, deployer_pubkey: pubkey) {
    val provider = require_is_provider_with_rate_limit(my_pubkey);
    val container = require_container(container_name);
    require_cluster_governor(container.cluster, provider);
    val deployer = require_provider(deployer_pubkey);
    create voter_set_member(container.deployer, deployer);
}

/**
 * Remove container deployer.
 * 
 * Permission: cluster governor
 * 
 * Rate limit: actions
 */
operation remove_container_deployer(my_pubkey: pubkey, container_name: text, deployer_pubkey: pubkey) {
    val provider = require_is_provider_with_rate_limit(my_pubkey);
    val container = require_container(container_name);
    require_cluster_governor(container.cluster, provider);
    val deployer = require_provider(deployer_pubkey);
    delete voter_set_member @? { container.deployer, deployer };
}

function create_container_with_resource_limits_impl(me: pubkey, name, cluster_name: text, consensus_threshold: integer,
        deployers: list<pubkey>, resource_limits: map<container_resource_limit_type, integer>, jar_extension_names: list<text>, subnode_image_name: text) {
    val provider = require_is_provider_with_rate_limit(me);
    val cluster = require_cluster(cluster_name);
    require_cluster_governor(cluster, provider);
    require_provider_quota(provider, provider_quota_type.max_containers);
    val (container_units, max_blockchains, extra_storage, extra_compute_requests) = get_resource_limits_or_defaults(resource_limits);
    require_cluster_quotas(cluster, container_units, extra_storage);
    val container = create_container_impl(provider, name, cluster, consensus_threshold, deployers, container_units,
        max_blockchains, extra_storage, extra_compute_requests = extra_compute_requests);
    assign_subnode_image(container, subnode_image_name);
    assign_jar_extensions(container, jar_extension_names);
}

function create_container_from_with_resource_limits_impl(me: pubkey, name, cluster_name: text, consensus_threshold: integer,
        voter_set_name: text, resource_limits: map<container_resource_limit_type, integer>, jar_extension_names: list<text>, subnode_image_name: text) {
    val provider = require_is_provider_with_rate_limit(me);
    val cluster = require_cluster(cluster_name);
    require_cluster_governor(cluster, provider);
    require_provider_quota(provider, provider_quota_type.max_containers);
    val (container_units, max_blockchains, extra_storage, extra_compute_requests) = get_resource_limits_or_defaults(resource_limits);
    require_cluster_quotas(cluster, container_units, extra_storage);
    val vs = require_voter_set(voter_set_name);
    val container = create_container_with_limits(provider, name, cluster, vs, container_units, max_blockchains,
        extra_storage, extra_compute_requests = extra_compute_requests);
    assign_subnode_image(container, subnode_image_name);
    assign_jar_extensions(container, jar_extension_names);
}

function get_resource_limits_or_defaults(resource_limits: map<container_resource_limit_type, integer>) = (
    resource_limits.get_or_default(container_resource_limit_type.container_units, standard_container_defaults.container_units),
    resource_limits.get_or_default(container_resource_limit_type.max_blockchains, standard_container_defaults.max_blockchains),
    resource_limits.get_or_default(container_resource_limit_type.extra_storage, standard_container_defaults.extra_storage),
    resource_limits.get_or_default(container_resource_limit_type.extra_compute_requests, standard_container_defaults.extra_compute_requests)
);

function assign_subnode_image(container, subnode_image_name: text) {
    if (not subnode_image_name.empty()) {
        val subnode_image = require_subnode_image(subnode_image_name);
        require(subnode_image.active, "Subnode image %s is not active".format(subnode_image_name));
        require(subnode_image.subnode_image_type == subnode_image_type.COMMON
                or not empty(cluster_subnode_image @? { container.cluster, subnode_image }),
            "Subnode image %s is not compatible with cluster %s".format(subnode_image_name, container.cluster.name));
        create container_subnode_image(container, subnode_image);
    }
}

function assign_jar_extensions(container, jar_extensions: list<text>) {
    for (jar_extension_name in jar_extensions) {
        val jar_extension = require_cluster_compatible_subnode_jar_extension(jar_extension_name, container.cluster);
        create container_subnode_jar_extension(container, jar_extension);
    }
}

/**
 * Remove container.
 * 
 * Permission: cluster provider governor
 * 
 * Rate limit: actions
 */
operation remove_container(my_pubkey: pubkey, container_name: text) {
    val provider = require_is_provider_with_rate_limit(my_pubkey);
    val container = require_container(container_name);
    require_cluster_governor(container.cluster, provider);
    require_container_available_for_removal(container);
    remove_container_and_voter_set(container);
}
