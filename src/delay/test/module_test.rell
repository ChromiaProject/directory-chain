@test module;

import ^^.*;
import ^.helper_operations.*;
import common.test.helper_operations.*;
import common.test.ops.*;
import common.test.setup.*;
import proposal.voting.test.ops.*;
import direct_container.*;
import proposal_blockchain.test.utils.*;

function test_add_and_delete_delay_event() {

    rell.test.tx().op(
        add_delayed_event_op(delay_type.PROPOSAL, 100, 1)
    ).run();

    assert_true(exists(delayed_event @? { .type == delay_type.PROPOSAL, .ref_id == 1}));

    rell.test.tx().op(
        delete_delayed_event_op(delay_type.PROPOSAL, 1)
    ).run();

    assert_true(empty(delayed_event @? { .type == delay_type.PROPOSAL, .ref_id == 1}));
}

function test_add_and_run_delay_event() {

    rell.test.set_next_block_time(1);
    rell.test.tx().op(
        add_delayed_event_op(delay_type.PROPOSAL, 100, 1)
    ).run();

    // Trigger time will be 99 due to first "last block time" is -1
    assert_true(exists(delayed_event @? { .type == delay_type.PROPOSAL, .time == 99, .ref_id == 1}));

    rell.test.set_next_block_time_delta(50);
    rell.test.block().run();

    // Still not executed and removed
    assert_true(exists(delayed_event @? { .type == delay_type.PROPOSAL, .ref_id == 1}));

    rell.test.set_next_block_time_delta(50);
    rell.test.tx().op(
        delete_delayed_event_op(delay_type.PROPOSAL, 1)
    ).run();

    assert_true(empty(delayed_event @? { .type == delay_type.PROPOSAL, .ref_id == 1}));
}

function test_pause_and_unpause_delayed_event() {

    val init_time = 5000000;

    // Set time and delta for each block built
    rell.test.set_next_block_time(init_time);
    rell.test.block().run();

    // Add delayed event
    rell.test.set_next_block_time_delta(5);
    rell.test.tx().op(
        add_delayed_event_op(delay_type.PROPOSAL, 100, 1)
    ).run();

    // Trigger time will be 99 due to first "last block time" is -1
    assert_true(exists(delayed_event @? { .type == delay_type.PROPOSAL, .time == init_time + 100, .ref_id == 1}));

    // Lets pause
    rell.test.set_next_block_time_delta(5);
    rell.test.tx().op(
        set_delayed_event_state_op(delay_type.PROPOSAL, 1, false)
    ).run();

    // Trigger time should not be set to the time left, not the actual execution time. Time left should be 95ms
    assert_true(exists(delayed_event @? { .type == delay_type.PROPOSAL, .time == 95, .ref_id == 1}));

    // Pausing for some time now
    rell.test.set_next_block_time_delta(4000000);
    rell.test.block().run();

    // Since event is still paused, nothing has changed
    assert_true(exists(delayed_event @? { .type == delay_type.PROPOSAL, .time == 95, .ref_id == 1}));

    // Lets unpause
    rell.test.set_next_block_time_delta(5);
    rell.test.tx().op(
        set_delayed_event_state_op(delay_type.PROPOSAL, 1, true)
    ).run();

    // Now the delayed event should have the actual time set for when to be triggered

    assert_true(exists(delayed_event @? { .type == delay_type.PROPOSAL,
        .time == init_time + 4000000 + 100 + 5, .ref_id == 1}));

    // Wait 90ms - no trigger - should be 5ms left
    rell.test.set_next_block_time_delta(90);
    rell.test.block().run();
    assert_true(exists(delayed_event @? { .type == delay_type.PROPOSAL,
        .time == init_time + 4000000 + 100 + 5, .ref_id == 1}));

    // Wait 5ms - the delayed event should have been waiting a total of 100ms now and be triggered
    rell.test.set_next_block_time_delta(5);
    rell.test.block().run();
    assert_false(exists(delayed_event @? { .type == delay_type.PROPOSAL, .ref_id == 1}));
}

function test_list_delayed_blockchain_configs() {

    // Create a container, blockchain
    rell.test.set_next_block_time(1000);
    setup_module();
    rell.test.tx().op(create_test_provider("bob", rell.test.pubkeys.bob)).run();

    val cl = system_cluster();
    val container = "container";
    val alice = provider @ { rell.test.pubkeys.alice };
    val bob = provider @ { rell.test.pubkeys.bob };
    rell.test.tx().op(add_test_member(system_p_voter_set(), bob)).run();

    var conf = apply_required_configuration_properties();
    // Proposing blockchain to a non-system container
    rell.test.tx().op(
        create_container(alice.pubkey, container, clusters.system, 0, [alice.pubkey, bob.pubkey]),
        propose_blockchain(alice.pubkey, conf.to_gtv().to_bytes(), "foo_chain", container)
    ).sign(rell.test.keypairs.alice).run();
    bob_votes();

    val bc = blockchain @ { .name == "foo_chain" };
    assert_equals(bc.state, blockchain_state.RUNNING);

    // No proposals yet
    assert_equals(list_delayed_blockchain_configs(bc.rid), list<delayed_blockchain_proposal_data>());

    val bc_delay = 1000 * 60 * 60 * 5;
    val half_hour_delay = 1000 * 60 * 30;

    // Set blockchain delay and propose a config update
    rell.test.tx().op(
        set_blockchain_config_delay_op(bc, bc_delay)
    ).sign(rell.test.keypairs.alice).run();

    // Pause chain
    rell.test.set_next_block_time_delta(half_hour_delay);
    rell.test.tx().op(
        propose_blockchain_action(rell.test.pubkeys.alice, bc.rid, blockchain_action.pause)
    ).sign(rell.test.keypairs.alice).run();
    rell.test.set_next_block_time_delta(bc_delay);
    bob_votes();
    rell.test.block().run();
    assert_equals(bc.state, blockchain_state.PAUSED);

    rell.test.tx().op(
        propose_configuration(rell.test.pubkeys.alice, bc.rid, conf.to_gtv().to_bytes())
    ).sign(rell.test.keypairs.alice).run();
    rell.test.set_next_block_time_delta(half_hour_delay);
    bob_votes();

    val proposal1_id = proposal @ { proposal_type.configuration } ( @sort_desc .rowid ) limit 1;
    val result1 = list_delayed_blockchain_configs(bc.rid);

    // Assert one paused proposal
    assert_equals(result1, list<delayed_blockchain_proposal_data>([
        delayed_blockchain_proposal_data(proposal1_id, proposal_type.configuration, proposal_state.APPROVED, delay=bc_delay, apply_at=null)
    ]));

    // Resume chain and propose a new config
    rell.test.set_next_block_time_delta(half_hour_delay);
    rell.test.tx().op(
        propose_configuration(rell.test.pubkeys.alice, bc.rid, conf.to_gtv().to_bytes()),
        propose_blockchain_action(rell.test.pubkeys.alice, bc.rid, blockchain_action.resume)
    ).sign(rell.test.keypairs.alice).run();
    rell.test.set_next_block_time_delta(half_hour_delay);
    bob_votes();

    val proposal2_id = proposal @ { proposal_type.configuration } ( @sort_desc .rowid ) limit 1;
    val result2 = list_delayed_blockchain_configs(bc.rid);

    // Assert a resumed config proposal and a new not yet approved proposal
    assert_equals(result2, list<delayed_blockchain_proposal_data>([
        delayed_blockchain_proposal_data(proposal1_id, proposal_type.configuration, proposal_state.APPROVED, delay=null, apply_at=rell.test.last_block_time + bc_delay - half_hour_delay),
        delayed_blockchain_proposal_data(proposal2_id, proposal_type.configuration, proposal_state.PENDING, delay=bc_delay, apply_at=null)
    ]));

    rell.test.set_next_block_time_delta(bc_delay * 2);
    rell.test.block().run();
    rell.test.block().run();

    val result3 = list_delayed_blockchain_configs(bc.rid);

    // Assert first proposal is applied and second still pending
    assert_equals(result3, list<delayed_blockchain_proposal_data>([
        delayed_blockchain_proposal_data(proposal2_id, proposal_type.configuration, proposal_state.PENDING, delay=bc_delay, apply_at=null)
    ]));
}
