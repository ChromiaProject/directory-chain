@test module;

import ^^.*;
import ^.helper_operations.*;
import model.*;
import common.test.helper_operations.*;

function test_blockchain_config_delay() {

    assert_equals(is_blockchain_config_delayed(x"01"), false);
    assert_equals(get_blockchain_config_delay(x"01"), 0);

    rell.test.tx().op(
        create_blockchain(x"02", "")
    ).run();
    val blockchain = blockchain @ {};

    // Set 100 delay
    rell.test.tx().op(
        set_blockchain_config_delay_op(blockchain, 100)
    ).run();
    assert_equals(is_blockchain_config_delayed(x"02"), true);
    assert_equals(get_blockchain_config_delay(x"02"), 100);

    // Update to 200 delay
    rell.test.tx().op(
        set_blockchain_config_delay_op(blockchain, 200)
    ).run();
    assert_equals(is_blockchain_config_delayed(x"02"), true);
    assert_equals(get_blockchain_config_delay(x"02"), 200);

    // Disable
    rell.test.tx().op(
        set_blockchain_config_delay_op(blockchain, 0)
    ).run();
    assert_equals(is_blockchain_config_delayed(x"02"), false);
    assert_equals(get_blockchain_config_delay(x"02"), 0);
}

