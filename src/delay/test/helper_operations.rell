module;

import ^^.*;

operation delete_delayed_event_op(type: delay_type, ref_id: integer) {
    delete_delayed_event(type, ref_id);
}

operation add_delayed_event_op(type: delay_type, delay_ms: integer, ref_id: integer) {
    add_delayed_event(type, delay_ms, ref_id);
}

operation set_blockchain_config_delay_op(blockchain, delay: integer) {
    var conf: map<text, gtv> = map();
    conf[DIRECTORY_CHAIN_CONFIG_KEY] = [DIRECTORY_CHAIN_CONFIG_DELAY_CONFIG_KEY: (delay).to_gtv()].to_gtv();
    set_latest_blockchain_configuration_values(blockchain, conf);
}

operation set_delayed_event_state_op(type: delay_type, ref_id: integer, active: boolean) {
    set_delayed_event_state(type, ref_id, active);
}

