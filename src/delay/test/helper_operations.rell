module;

import ^^.*;
import ^^.blockchain_config_delay.*;

operation set_blockchain_config_delay_op(blockchain, delay: integer) {
    var conf: map<text, gtv> = map();
    conf[DIRECTORY_CHAIN_CONFIG_KEY] = [DIRECTORY_CHAIN_CONFIG_DELAY_CONFIG_KEY: (delay).to_gtv()].to_gtv();
    set_latest_blockchain_configuration_values(blockchain, conf);
}

operation add_scheduled_at_op(delay_type, ref_id: integer, scheduled_at: timestamp) {
    add_scheduled_event(delay_type, ref_id, scheduled_at);
}

operation delete_scheduled_at_op(delay_type, ref_id: integer) {
    delete_scheduled_event(delay_type, ref_id);
}

operation add_legacy_delayed_event(type: delay_type, ref_id: integer, time: integer, active: boolean) {
    create delayed_event(type, ref_id, time, active);
}
