entity proposed_forced_configuration {
    key proposal;
    key blockchain;
    height: integer;
    config_data: byte_array;
    resume_chain: boolean = false;
}

entity proposed_forced_configuration_stage2 {
    key blockchain;
    height: integer;
    config_data: byte_array;
    resume_chain: boolean = false;
}

entity forced_configuration {
    index blockchain;
    height: integer;
    config_hash: byte_array;
}

@extend(apply_voting_result_handlers) function() = [proposal_type.force_configuration.name: apply_proposed_forced_configuration(*)];
@extend(delete_proposal_handlers) function(): map<text, (proposal) -> unit> = [proposal_type.force_configuration.name: delete_proposed_forced_configuration(*)];

/**
 * Propose forcing a new configuration for a PAUSED blockchain at height.
 *
 * Permission: container deployer
 *
 * Rate limit: actions
 *
 * @param my_pubkey pubkey of provider
 */
operation propose_forced_configuration(my_pubkey: pubkey, blockchain_rid: byte_array, config_data: byte_array,
        height: integer, description: text = "", resume_chain: boolean = false) {
    val provider = require_is_provider_with_rate_limit(my_pubkey);
    val proposal = create_forced_configuration_proposal(provider, blockchain_rid, config_data, height, resume_chain, description);
    internal_vote(provider, proposal, true);
}

/**
 * Propose forcing a new configuration for a PAUSED blockchain at height.
 * The transaction needs to include ICCF proof of `tx_to_prove`.
 *
 * Permission: container deployer
 *
 * Rate limit: actions
 *
 * @param my_pubkey    pubkey of provider
 * @param tx_to_prove  the transaction from other chain to use for authentication
 * @param op_index     index of the relevant operation in tx_to_prove
 */
operation propose_forced_configuration_iccf(my_pubkey: pubkey, tx_to_prove: gtx_transaction, op_index: integer) {
    val provider = require_provider(my_pubkey);
    val args = require_provider_with_iccf_proof_and_rate_limit(tx_to_prove, op_index,
        op_context.get_current_operation().name, 3, provider);
    val blockchain_rid = byte_array.from_gtv(args[0]);
    val config_data = byte_array.from_gtv(args[1]);
    val height = integer.from_gtv(args[2]);
    val resume_chain = if (args.size() > 3) boolean.from_gtv(args[3]) else false;

    val proposal = create_forced_configuration_proposal(provider, blockchain_rid, config_data, height, resume_chain, iccf_description);
    apply_iccf_proposal(proposal);
}

function create_forced_configuration_proposal(provider, blockchain_rid: byte_array, config_data: byte_array,
        height: integer, resume_chain: boolean, description: text): proposal {
    val blockchain = validate_proposed_forced_configuration(blockchain_rid);

    require(not exists(proposed_forced_configuration @? { blockchain }),
        "Forced configuration proposal already exists for this blockchain");

    require(not exists(proposed_forced_configuration_stage2 @? { blockchain }),
        "Forced configuration proposal already pending for this blockchain");

    val container = container_blockchain @ { blockchain }.container;
    require_container_deployer(container, provider);

    val is_chain0 = blockchain.rid == chain_context.blockchain_rid;
    require(not is_chain0, "Forcing configuration disallowed for directory chain: " + blockchain_rid);

    validate_blockchain_configuration(blockchain, container, config_data, true, header_hash = true, system_chain = blockchain.system);

    val prop = create_proposal(proposal_type.force_configuration, provider, container.deployer, description);
    create proposed_forced_configuration(prop, blockchain, height, config_data, resume_chain);
    return prop;
}

function apply_proposed_forced_configuration(proposal) {
    val pfc = proposed_forced_configuration @? { proposal };
    if (pfc == null) return;

    val blockchain = validate_proposed_forced_configuration(pfc.blockchain.rid);

    if (pfc.proposal.voter_set == system_p_voter_set()) {
        val cluster = container_blockchain @ { blockchain } ( .container ) .cluster;
        val cluster_nodes = cluster_node @* { cluster } (.node);

        apply_forced_configuration(blockchain, cluster_nodes, pfc.config_data, pfc.height, pfc.resume_chain);
    } else {
        log("Force_configuration proposal %d for blockchain %s approved, waiting to get additional approval from a node provider"
            .format(proposal.rowid, blockchain.rid));
        create proposed_forced_configuration_stage2(blockchain, pfc.height, pfc.config_data, pfc.resume_chain);
    }
}

/**
 * Approves a pending forced configuration update.
 *
 * Permission: node provider
 *
 * Rate limit: actions
 *
 * @param my_pubkey pubkey of provider
 * @param blockchain_rid Blockchain RID
 */
operation approve_proposed_forced_configuration(my_pubkey: pubkey, blockchain_rid: byte_array) {
    val provider = require_is_provider_with_rate_limit(my_pubkey);
    require(provider.tier == provider_tier.NODE_PROVIDER,
        "Transaction must be signed by node provider");

    val blockchain = require_active_blockchain(blockchain_rid);

    val pfc = require(proposed_forced_configuration_stage2 @? { blockchain },
        "No pending forced configuration update proposal for blockchain %s".format(blockchain_rid));

    validate_proposed_forced_configuration(pfc.blockchain.rid);

    val cluster = container_blockchain @ { blockchain } ( .container ) .cluster;
    val cluster_nodes = cluster_node @* { cluster } (.node);

    require(exists(cluster_nodes @* { provider }),
        "Transaction must be signed by node provider running this blockchain");

    apply_forced_configuration(blockchain, cluster_nodes, pfc.config_data, pfc.height, pfc.resume_chain);

    delete pfc;
}

function apply_forced_configuration(blockchain, cluster_nodes: list<node>, config_data: byte_array, height: integer, resume_chain: boolean) {
    log("Applying forced configuration for blockchain %s".format(blockchain.rid));

    val cluster_signers = cluster_nodes @* {} (@sort .pubkey);
    val signers = cluster_signers.to_gtv().to_bytes();

    val unique_config_data = make_config_unique(config_data);
    compress_and_store_configuration(blockchain, height, unique_config_data, true);

    val blockchain_configuration_signers = blockchain_configuration_signers @? { blockchain, height};
    if (blockchain_configuration_signers == null) {
        create blockchain_configuration_signers(blockchain, height, signers);
    } else {
        blockchain_configuration_signers.signers = signers;
    }
    create forced_configuration(blockchain, height, calculate_configuration_hash(unique_config_data, cluster_signers));
    delete pending_blockchain_configuration @* {blockchain};
    delete signer_excluded_from_pending_configuration @* {blockchain};

    add_dependencies(unique_config_data, blockchain.rid, height);

    if (resume_chain) {
        blockchain.state = blockchain_state.RUNNING;
    }
}

function validate_proposed_forced_configuration(blockchain_rid: byte_array): blockchain {
    val blockchain = require_active_blockchain(blockchain_rid);
    require(blockchain.state == blockchain_state.PAUSED,
        "Forcing configuration only allowed on PAUSED blockchains. Blockchain rid: %s, state: %s".format(blockchain.rid, blockchain.state));
    require(not is_blockchain_config_delayed(blockchain.rid),
        "Forced configuration only allowed on chain with configuration delay disabled");
    return blockchain;
}

function delete_proposed_forced_configuration(proposal) {
    delete proposed_forced_configuration @? { proposal };
}

struct proposed_forced_configuration_data {
    proposal;
    blockchain;
    height: integer;
    config_data: byte_array;
    resume_chain: boolean = false;
}

struct forced_configuration_data {
    blockchain_rid: byte_array;
    height: integer;
    config_hash: byte_array;
}

/**
 * Returns forced blockchain configuration proposal.
 *
 * @deprecated use get_forced_configuration_proposal_v64 instead
 */
query get_proposed_forced_configuration(rowid?): (
    current_conf: blockchain_configuration_data,
    forced_conf: proposed_forced_configuration_data
)? {
    val proposal = get_latest_proposal(rowid, proposal_type.force_configuration);
    if (proposal == null) return null;
    val config = proposed_forced_configuration @? { require_proposal(proposal.rowid) }
        (proposed_forced_configuration_data(.proposal, .blockchain, .height, decompress_configuration(.config_data), .resume_chain));
    if (config == null) return null;

    val current = get_latest_blockchain_configuration_data(config.blockchain);

    return (
        current_conf = blockchain_configuration_data(current.height, config.blockchain, current.config),
        forced_conf = config
    );
}

struct forced_configuration_proposal_data {
    blockchain_rid: byte_array;
    current_height: integer;
    current_configuration: byte_array;
    proposed_height: integer;
    proposed_configuration: byte_array;
}

/**
 * Returns forced blockchain configuration proposal.
 */
query get_forced_configuration_proposal_v64(rowid?): forced_configuration_proposal_data? {
    val proposal = get_latest_proposal(rowid, proposal_type.force_configuration);
    if (proposal == null) return null;
    val proposal_details = proposed_forced_configuration @? { require_proposal(proposal.rowid) }
        (.blockchain, .height, config = decompress_configuration(.config_data));
    if (proposal_details == null) return null;

    val current = get_latest_blockchain_configuration_data(proposal_details.blockchain);

    return forced_configuration_proposal_data(
        blockchain_rid = proposal_details.blockchain.rid,
        current_height = current.height,
        current_configuration = current.config,
        proposed_height = proposal_details.height,
        proposed_configuration = proposal_details.config,
    );
}

/**
 * Returns forced blockchain configuration proposal stage 2.
 */
query get_forced_configuration_stage2_proposal(blockchain_rid: byte_array): forced_configuration_proposal_data? {
    val blockchain = require_active_blockchain(blockchain_rid);

    val pfc = proposed_forced_configuration_stage2 @? { blockchain };
    if (pfc == null) return null;

    val current = get_latest_blockchain_configuration_data(pfc.blockchain);

    return forced_configuration_proposal_data(
        blockchain_rid = pfc.blockchain.rid,
        current_height = current.height,
        current_configuration = current.config,
        proposed_height = pfc.height,
        proposed_configuration = decompress_configuration(pfc.config_data),
    );
}

/**
 * Returns forced blockchain configurations by blockchain rid.
 */
query get_forced_configurations(blockchain_rid: byte_array): list<forced_configuration_data> {
    val blockchain = require_blockchain(blockchain_rid);
    return forced_configuration @* { blockchain } (
        forced_configuration_data(
            blockchain_rid = .blockchain.rid,
            height = .height,
            config_hash = .config_hash
        )
    );
}
