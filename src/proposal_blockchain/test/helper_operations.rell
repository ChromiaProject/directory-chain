module;

import ^^.*;

// Make sure the forced configuration exists, but is not the one in blockchain_configuration*
operation stage_partly_applied_forced_config(blockchain, height: integer, hash: byte_array) {
    create blockchain_configuration(blockchain, height, data = ["dummy": "value"].to_gtv().to_bytes());
    create blockchain_configuration_signers(blockchain, height, signers = [x"BB"].to_gtv().to_bytes());
    create forced_configuration(blockchain, height, hash);
}
