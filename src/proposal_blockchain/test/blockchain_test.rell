@test module;

import ^^.*;
import common.test.ops.*;
import common.test.setup.*;
import common.test.util.*;
import proposal.voting.test.ops.*;
import proposal_container.*;
import proposal_subnode_image.*;
import direct_container.*;
import ^.utils.*;
import delay.test.helper_operations.*;

function setup() {
    setup_module();
    rell.test.tx().op(create_test_provider("bob", rell.test.pubkeys.bob)).run();
}

function test_propose_blockchain() {
    setup();

    val cl = system_cluster();
    val container = "container";
    val alice = provider @ { rell.test.pubkeys.alice };
    val bob = provider @ { rell.test.pubkeys.bob };
    rell.test.tx().op(add_test_member(system_p_voter_set(), bob)).run();

    var conf = apply_required_configuration_properties();
    // proposing blockchain to a system container will fail
    rell.test.tx().op(
        propose_blockchain(alice.pubkey, conf.to_gtv().to_bytes(), "foo_chain", system_container_name(clusters.system))
    ).sign(rell.test.keypairs.alice).run_must_fail("Proposing blockchain to a system container is not allowed");

    rell.test.tx().op(
        create_container(alice.pubkey, container, clusters.system, 0, [alice.pubkey, bob.pubkey])
    ).sign(rell.test.keypairs.alice).run();
    // proposing blockchain with invalid name will fail
    rell.test.tx().op(
        propose_blockchain(alice.pubkey, conf.to_gtv().to_bytes(), "foo@chain", container)
    ).sign(rell.test.keypairs.alice).run_must_fail(invalid_entity_message);
    // proposing blockchain to a non-system container
    rell.test.tx().op(
        propose_blockchain(alice.pubkey, conf.to_gtv().to_bytes(), "foo_chain", container)
    ).sign(rell.test.keypairs.alice).run();
    val tx_rid = transaction @ {} (@sort_desc @omit .rowid, .tx_rid) limit 1;

    // Proposal is pending
    val prop = last_proposal();
    val config_proposal = get_blockchain_proposal(prop.rowid);
    assert_not_null(config_proposal);
    assert_equals(config_proposal.container, "container");
    assert_null(find_blockchain_rid(tx_rid));

    rell.test.tx().op(
        create_test_node(alice, rell.test.pubkeys.alice, cl)
    ).sign(rell.test.keypairs.alice).run_must_fail();

    // Bob votes
    bob_votes();

    // Asserting blockchain is running
    val bc = blockchain @ { .name == "foo_chain" };
    assert_equals(bc.state, blockchain_state.RUNNING);
    assert_equals(find_blockchain_rid(tx_rid), bc.rid);
}

function test_blockchain_configuration_validation() {
    setup();
    val cl = system_cluster();
    val container = "container";
    val alice = provider @ { rell.test.pubkeys.alice };
    val bob = provider @ { rell.test.pubkeys.bob };
    rell.test.tx().op(add_test_member(system_p_voter_set(), bob)).run();

    rell.test.tx().op(
        propose_subnode_image(alice.pubkey, "subnode_image1", "url", "digest", subnode_image_type.COMMON,
        "one", "some.gtx.module,other.gtx.module", "")
    ).sign(rell.test.keypairs.alice).run();
    rell.test.tx().op(
        make_vote_v65(last_proposal().rowid.to_integer(), true)
    ).sign(rell.test.keypairs.bob).run();

    rell.test.tx().op(
        propose_container_with_subnode_image(alice.pubkey, clusters.system, container, voter_sets.system_p, "subnode_image1"),
    ).sign(rell.test.keypairs.alice).run();
    rell.test.tx().op(
        make_vote_v65(last_proposal().rowid.to_integer(), true)
    ).sign(rell.test.keypairs.bob).run();

    var conf0 = apply_required_configuration_properties();
    conf0["gtx"] = ["modules": ["some.gtx.module"]].to_gtv();
    rell.test.tx().op(
        propose_blockchain(alice.pubkey, conf0.to_gtv().to_bytes(), "foo_chain", container)
    ).sign(rell.test.keypairs.alice)
        .run();

    var conf1 = apply_required_configuration_properties();
    conf1["gtx"] = ["modules": ["invalid.gtx.module"]].to_gtv();
    rell.test.tx().op(
        propose_blockchain(alice.pubkey, conf1.to_gtv().to_bytes(), "foo_chain", container)
    ).sign(rell.test.keypairs.alice)
        .run_must_fail("Some of the configured GTX modules are not in the allowed set");

    var conf2 = apply_required_configuration_properties();
    conf2["sync_ext"] = ["invalid.sync.ext"].to_gtv();
    rell.test.tx().op(
        propose_blockchain(alice.pubkey, conf2.to_gtv().to_bytes(), "foo_chain", container)
    ).sign(rell.test.keypairs.alice)
        .run_must_fail("Some of the configured synchronization infrastructure extensions are not in the allowed set");
}

function test_propose_configuration() {
    setup();
    val bob = provider @ { rell.test.pubkeys.bob };
    rell.test.tx().op(add_test_member(system_p_voter_set(), bob)).run();

    var conf = apply_required_configuration_properties();
    rell.test.tx().op(
        create_container(initial_provider.pub, "container", clusters.system, 0, [initial_provider.pub])
    ).sign(initial_provider).run();

    // NB: Proposing config at a specific chain for non-chain0 can not be tested due to limitations of Rell Test Framework
    val directory_chain = blockchain @ { blockchains.directory_chain };

    conf["nonce"] = (17).to_gtv();
    rell.test.tx().op(
        propose_configuration(initial_provider.pub, directory_chain.rid, conf.to_gtv().to_bytes())
    ).sign(initial_provider).run();
    val cp = get_configuration_proposal_v64(null)!!;
    assert_equals(cp.blockchain_rid, directory_chain.rid);
    assert_equals(cp.current_height, 0);
    assert_equals(cp.current_configuration,
        decompress_configuration(blockchain_configuration @? { directory_chain, 0 } (.data)!!));
    assert_equals(cp.proposed_configuration, conf.to_gtv().to_bytes());

    val proposal_id = last_proposal().rowid;
    rell.test.tx().op(
        make_vote_v65(proposal_id.to_integer(), true)
    ).sign(rell.test.keypairs.bob).run();
    val attempt = get_blockchain_configuration_update_attempt_state_by_proposal(proposal_id)!!;
    assert_equals(attempt.state, blockchain_configuration_update_state.PENDING);
    assert_equals(attempt.applied_at_height, -1);
    assert_equals(attempt.blockchain_rid, directory_chain.rid);

    val actual_config_bytes = pending_blockchain_configuration @ { directory_chain, 1 } (.base_config);
    val actual_config = map<text, gtv>.from_gtv(gtv.from_bytes(actual_config_bytes));
    assert_equals(actual_config["nonce"], (17).to_gtv());
}

function test_propose_configuration_at() {
    setup();
    val bob = provider @ { rell.test.pubkeys.bob };
    rell.test.tx().op(add_test_member(system_p_voter_set(), bob)).run();

    var conf = apply_required_configuration_properties();
    rell.test.tx().op(
        create_container(initial_provider.pub, "container", clusters.system, 0, [initial_provider.pub])
    ).sign(initial_provider).run();

    // NB: Proposing config at a specific chain for non-chain0 can not be tested due to limitations of Rell Test Framework
    val directory_chain = blockchain @ { blockchains.directory_chain };

    // 1. force == false
    // 1.1. at height 10
    conf["nonce"] = (10).to_gtv();
    propose_config_at(directory_chain.rid, conf, 10, false).run();
    val cpa = get_configuration_proposal_at_v64(null)!!;
    assert_equals(cpa.blockchain_rid, directory_chain.rid);
    assert_equals(cpa.current_height, 0);
    assert_equals(cpa.proposed_height, 10);
    assert_equals(cpa.proposed_force, false);
    assert_equals(cpa.current_configuration,
        decompress_configuration(blockchain_configuration @? { directory_chain, 0 } (.data)!!));
    assert_equals(cpa.proposed_configuration, conf.to_gtv().to_bytes());

    bob_votes();
    assert_not_null(blockchain_configuration @? { directory_chain, 10 });
    // 1.2. before 10
    conf["nonce"] = (8).to_gtv();
    propose_config_at(directory_chain.rid, conf, 8, false).run();
    bob_votes();
    assert_not_null(blockchain_configuration @? { directory_chain, 8 });

    // assert unique configurations
    assert_not_equals(
        blockchain_configuration @? { directory_chain, 10 } (.data),
        blockchain_configuration @? { directory_chain, 8 } (.data)
    );

    // 1.3. again 10
    propose_config_at(directory_chain.rid, conf, 10, false).run_must_fail();
    // 1.4. height is null
    propose_config_at(directory_chain.rid, conf, -1, false).run_must_fail();
    // 1.5. height is -2, to be less than last_height (-1)
    propose_config_at(directory_chain.rid, conf, -2, false).run_must_fail();

    // 2. force == true
    var conf2 = apply_required_configuration_properties();
    conf2["name"] = "conf2".to_gtv();
    propose_config_at(directory_chain.rid, conf2, 8, true).run();
    bob_votes();
    val actual_config_bytes = blockchain_configuration @ { directory_chain, 8 } (.data);
    val actual_config = map<text, gtv>.from_gtv(gtv.from_bytes(actual_config_bytes));
    assert_equals(actual_config["name"], "conf2".to_gtv());
    // NB: we can't test `height = -1` case
    // propose_config_at(directory_chain.rid, conf, -1, false).run();
    // See kotlin test
}

function propose_config_at(brid: byte_array, conf: map<text, gtv>, height: integer, force: boolean) {
    return rell.test.tx().op(
        propose_configuration_at(initial_provider.pub, brid, conf.to_gtv().to_bytes(), height, force)
    ).sign(initial_provider);
}

function test_forced_configuration() {
    setup();

    val cl = system_cluster();
    val container = "container";
    val alice = provider @ { rell.test.pubkeys.alice };
    val bob = provider @ { rell.test.pubkeys.bob };
    rell.test.tx().op(add_test_member(system_p_voter_set(), bob)).run();

    var conf = apply_required_configuration_properties();
    val initial_configuration = conf.to_gtv().to_bytes();
    // Proposing blockchain to a non-system container
    rell.test.tx().op(
        create_container(alice.pubkey, container, clusters.system, 0, [alice.pubkey, bob.pubkey]),
        propose_blockchain(alice.pubkey, initial_configuration, "foo_chain", container)
    ).sign(rell.test.keypairs.alice).run();
    bob_votes();

    val bc = blockchain @ { .name == "foo_chain" };
    assert_equals(bc.state, blockchain_state.RUNNING);

    conf["nonce"] = (10).to_gtv();
    conf["name"] = "testConf".to_gtv();
    force_config(bc.rid, conf, 10).run_must_fail("Forcing configuration only allowed on PAUSED blockchains.");

    alice_proposes_action(bc, blockchain_action.pause);
    bob_votes();
    assert_equals(bc.state, blockchain_state.PAUSED);

    force_config(bc.rid, conf, 10).run();
    val fcp = get_forced_configuration_proposal_v64(null)!!;
    assert_equals(fcp.blockchain_rid, bc.rid);
    assert_equals(fcp.current_height, 0);
    assert_equals(fcp.proposed_height, 10);
    assert_equals(fcp.current_configuration, initial_configuration);
    assert_equals(fcp.proposed_configuration, conf.to_gtv().to_bytes());
    bob_votes();

    val actual_config_bytes = blockchain_configuration @ { bc, 10 } (.data);
    val actual_config = map<text, gtv>.from_gtv(gtv.from_bytes(actual_config_bytes));
    assert_equals(actual_config["name"], "testConf".to_gtv());
    assert_false(actual_config.contains("signers"));
    val blockchain_configuration_signers = blockchain_configuration_signers @ { bc, 10 } (.signers);
    assert_equals(blockchain_configuration_signers, [initial_signer.pub].to_gtv().to_bytes());
    val forced_configuration_data = get_forced_configurations(bc.rid);
    assert_equals(forced_configuration_data.size(), 1);
    assert_equals(
        forced_configuration_data[0],
        forced_configuration_data(blockchain_rid = bc.rid, 10, config_hash = actual_config_bytes.hash())
    );
}

function test_forced_configuration_delay() {
    setup();

    val cl = system_cluster();
    val container = "container";
    val alice = provider @ { rell.test.pubkeys.alice };
    val bob = provider @ { rell.test.pubkeys.bob };
    rell.test.tx().op(add_test_member(system_p_voter_set(), bob)).run();

    var conf = apply_required_configuration_properties();
    // Proposing blockchain to a non-system container
    rell.test.tx().op(
        create_container(alice.pubkey, container, clusters.system, 0, [alice.pubkey, bob.pubkey]),
        propose_blockchain(alice.pubkey, conf.to_gtv().to_bytes(), "foo_chain", container)
    ).sign(rell.test.keypairs.alice).run();
    bob_votes();

    val bc = blockchain @ { .name == "foo_chain" };
    assert_equals(bc.state, blockchain_state.RUNNING);

    rell.test.tx().op(
        set_blockchain_config_delay_op(bc, 100)
    ).run();

    alice_proposes_action(bc, blockchain_action.pause);
    rell.test.set_next_block_time_delta(100);
    bob_votes();
    rell.test.block().run();
    assert_equals(bc.state, blockchain_state.PAUSED);

    conf["nonce"] = (10).to_gtv();
    conf["name"] = "testConf".to_gtv();
    force_config(bc.rid, conf, 10).run_must_fail("only allowed on chain with configuration delay disabled");
}

function force_config(brid: byte_array, conf: map<text, gtv>, height: integer) {
    return rell.test.tx().op(
        propose_forced_configuration(initial_provider.pub, brid, conf.to_gtv().to_bytes(), height)
    ).sign(initial_provider);
}

function alice_proposes_action(bc: blockchain, action: blockchain_action) {
    rell.test.tx().op(
        propose_blockchain_action(rell.test.pubkeys.alice, bc.rid, action)
    ).sign(rell.test.keypairs.alice).run();
}
