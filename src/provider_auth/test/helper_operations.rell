module;

import ^^.*;

operation provider_is_signer_op(provider_pubkey: pubkey, provider_key_roles: list<provider_key_role>) {
    require(provider_is_signer(provider_pubkey, provider_key_roles), "auth failed");
}

operation force_remove_provider_key(provider_pubkey: pubkey, role: provider_key_role? = null) {
    delete provider_auth_key @* { .provider_pubkey == provider_pubkey, role == null or .provider_key_role == role };
}

operation add_provider_key_op(provider_pubkey: pubkey, pubkey, provider_key_role = provider_key_role.main) {
    _add_provider_key(provider_pubkey, pubkey, provider_key_role);
}

operation remove_provider_key_op(provider_pubkey: pubkey, role: provider_key_role, pubkey) {
    _remove_provider_key(provider_pubkey, role, pubkey);
}

operation set_provider_key_threshold_op(provider_pubkey: pubkey, provider_key_role, threshold: integer) {
    _set_provider_key_threshold(provider_pubkey, provider_key_role, threshold);
}

operation get_provider_signer_op(expected_provider: pubkey?) {
    val provider = get_provider_signer();
    require(provider == expected_provider, "Unexpected provider");
}

