module;

import ^^.*;

operation provider_is_signer_op(provider_pubkey: pubkey, provider_key_types: list<provider_key_type>) {
    require(provider_is_signer(provider_pubkey, provider_key_types), "auth failed");
}

operation force_remove_provider_key(provider_pubkey: pubkey, type: provider_key_type? = null) {
    delete provider_auth_key @* { .provider_pubkey == provider_pubkey, type == null or .provider_key_type == type };
}

operation add_provider_key_op(provider_pubkey: pubkey, pubkey, provider_key_type = provider_key_type.main) {
    _add_provider_key(provider_pubkey, pubkey, provider_key_type);
}

operation remove_provider_key_op(provider_pubkey: pubkey, type: provider_key_type, pubkey) {
    _remove_provider_key(provider_pubkey, type, pubkey);
}

operation set_provider_key_threshold_op(provider_pubkey: pubkey, provider_key_type, threshold: integer) {
    _set_provider_key_threshold(provider_pubkey, provider_key_type, threshold);
}

operation get_provider_signer_op(expected_provider: pubkey?) {
    val provider = get_provider_signer();
    require(provider == expected_provider, "Unexpected provider");
}

