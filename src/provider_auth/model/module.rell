module;

/**
 * Provider auth supports different types of authorization scopes defined as types.
 */
enum provider_key_type {
/** normal key - delegate signature checks to gtx */
main,

/** This type is not in use but used for tests */
configuration_proposal,
}

/**
 * Keeps the threshold (same as for votes consensus) for each provider and key type.
 */
entity provider_auth_threshold {
    key provider_pubkey: pubkey, provider_key_type;
    mutable threshold: integer;
}

/**
 * Keeps all provider keys and their types.
 */
entity provider_auth_key {
    key provider_pubkey: pubkey, provider_key_type, pubkey;
}
