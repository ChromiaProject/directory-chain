entity pending_remove_cluster_subnode_image {
    key proposal;
    key cluster, subnode_image;
}

@extend(apply_voting_result_handlers) function() = [proposal_type.remove_cluster_subnode_image.name: apply_remove_cluster_subnode_image(*)];
function apply_remove_cluster_subnode_image(proposal) {
    val prcsi = pending_remove_cluster_subnode_image @? { proposal };
    if (prcsi == null) return;
    val cluster_subnode_image = validate_remove_cluster_subnode_image_proposal(prcsi);
    delete cluster_subnode_image;
    after_cluster_subnode_image_removed(prcsi.cluster, prcsi.subnode_image);
}

@extend(delete_proposal_handlers) function(): map<text, (proposal) -> unit> = [proposal_type.remove_cluster_subnode_image.name: delete_pending_remove_cluster_subnode_image(*)];
function delete_pending_remove_cluster_subnode_image(proposal) {
    delete pending_remove_cluster_subnode_image @? { proposal };
}

@extend(scheduled_proposal_delay_time_handlers) function() = [proposal_type.remove_cluster_subnode_image.name: scheduled_proposals_delay_time_handler(*)];

/**
 * Propose remove subnode image from cluster.
 * 
 * Permission: cluster governor
 * 
 * Rate limit: actions
 * 
 * @param my_pubkey pubkey of provider
 * @param scheduled_at The time to apply this proposal when approved. If the proposal is approved after the time has passed the proposal is applied right away.
 */
operation propose_remove_cluster_subnode_image(my_pubkey: pubkey, cluster_name: text, subnode_image_name: text, description: text = "", scheduled_at: timestamp? = null) {
    // check that provider authority and that it is a cluster governor
    val me = require_is_provider_with_rate_limit(my_pubkey);
    val cluster = require_cluster(cluster_name);
    require_cluster_governor(cluster, me);
    val subnode_image = require_subnode_image(subnode_image_name);
    val prop = create_proposal(proposal_type.remove_cluster_subnode_image, me, cluster.governance, description);
    if (scheduled_at != null) {
        add_scheduled_event(delay_type.PROPOSAL, prop.rowid.to_integer(), scheduled_at);
    }
    val prcsi = create pending_remove_cluster_subnode_image(
        prop,
        cluster,
        subnode_image,
    );
    validate_remove_cluster_subnode_image_proposal(prcsi);
    internal_vote(me, prop, true);
}

/**
 * Returns remove subnode image from cluster proposal.
 */
query get_remove_cluster_subnode_image_proposal(rowid) {
    val proposal = get_latest_proposal(rowid, proposal_type.remove_cluster_subnode_image);
    if (proposal == null) return null;
    val prcsi = pending_remove_cluster_subnode_image @ { proposal };
    return (
        cluster = prcsi.cluster.name,
        subnode_image = prcsi.subnode_image.name,
    );
}

function validate_remove_cluster_subnode_image_proposal(prcsi: pending_remove_cluster_subnode_image): cluster_subnode_image = require(
    cluster_subnode_image @? { prcsi.cluster, prcsi.subnode_image },
    "Subnode image %s is not allowed by cluster %s".format(prcsi.subnode_image.name, prcsi.cluster.name)
);
