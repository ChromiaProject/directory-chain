entity pending_subnode_image_state {
    key proposal;
    key name;
    active: boolean;
}

@extend(apply_voting_result_handlers) function() = [proposal_type.subnode_image_state.name: apply_subnode_image_state(*)];
function apply_subnode_image_state(proposal) {
    val psis = pending_subnode_image_state @? { proposal };
    if (psis == null) return;
    val subnode_image = subnode_image @ { .name == psis.name };
    subnode_image.active = psis.active;
    after_subnode_image_updated(subnode_image);
}

@extend(delete_proposal_handlers) function(): map<text, (proposal) -> unit> = [proposal_type.subnode_image_state.name: delete_pending_subnode_image_state(*)];
function delete_pending_subnode_image_state(proposal) {
    delete pending_subnode_image_state @? { proposal };
}

@extend(scheduled_proposal_delay_time_handlers) function() = [proposal_type.subnode_image_state.name: scheduled_subnode_image_state_delay_time_handler(*)];
function scheduled_subnode_image_state_delay_time_handler(proposal): (blockchain: blockchain?, delay: integer) {
    val scheduled_at_delay = get_scheduled_event_delay(delay_type.PROPOSAL, proposal.rowid.to_integer());
    if (scheduled_at_delay != null) {
        return (blockchain = null, delay = scheduled_at_delay);
    }
    return (blockchain = null, delay = 0);
}

/**
 * Propose enable or disable subnode image.
 * 
 * Permission: system provider
 * 
 * Rate limit: actions
 * 
 * @param my_pubkey pubkey of provider
 * @param scheduled_at The time to apply this proposal when approved. If the proposal is approved after the time has passed the proposal is applied right away.
 */
operation propose_subnode_image_state(my_pubkey: pubkey, name, active: boolean, description: text = "", scheduled_at: timestamp? = null) {
    val me = require_is_provider_with_rate_limit(my_pubkey);
    require_system_access(me);

    val prop = create_proposal(proposal_type.subnode_image_state, me, system_p_voter_set(), description);
    if (scheduled_at != null) {
        add_scheduled_event(delay_type.PROPOSAL, prop.rowid.to_integer(), scheduled_at);
    }
    val pending_subnode_image_state = create pending_subnode_image_state (
        prop,
        name,
        active,
    );
    validate_subnode_image_state_proposal(pending_subnode_image_state);
    internal_vote(me, prop, true);
}

/**
 * Returns enable/disable subnode image proposal.
 */
query get_subnode_image_state_proposal(rowid) {
    val proposal = get_latest_proposal(rowid, proposal_type.subnode_image);
    if (proposal == null) return null;
    val psis = pending_subnode_image_state @ { proposal };
    return (
        name = psis.name,
        active = psis.active,
    );
}

function validate_subnode_image_state_proposal(pending_subnode_image_state) {
    val subnode_image = require(
        subnode_image @? { .name == pending_subnode_image_state.name },
        "Subnode image %s not found".format(pending_subnode_image_state.name)
    );
    require(subnode_image.active != pending_subnode_image_state.active,
        "Subnode image %s already ".format(pending_subnode_image_state.name) + if (pending_subnode_image_state.active) "active" else "inactive"
    );
}
