entity pending_subnode_image {
    key proposal;
    key name;
    url: text;
    digest: text;
    subnode_image_type;
    description: text;
    /** GTX modules exposed by this subnode image (comma separated list of FQCNs) */
    gtx_modules: text;
    /** Synchronization infrastructure extensions exposed by this subnode image (comma separated list of FQCNs) */
    sync_exts: text;
    /** How many compute requests per week a container gets by default. */
    base_compute_requests: integer = 0;
}

struct pending_subnode_image_data {
    name;
    url: text;
    digest: text;
    subnode_image_type;
    description: text;
    /** GTX modules exposed by this subnode image (comma separated list of FQCNs) */
    gtx_modules: text;
    /** Synchronization infrastructure extensions exposed by this subnode image (comma separated list of FQCNs) */
    sync_exts: text;
    /** How many compute requests per week a container gets by default. */
    base_compute_requests: integer;
}

@extend(apply_voting_result_handlers) function() = [proposal_type.subnode_image.name: apply_subnode_image(*)];
function apply_subnode_image(proposal) {
    val psi = pending_subnode_image @? { proposal };
    if (psi == null) return;
    validate_subnode_image_proposal(psi);
    val subnode_image = create subnode_image(
        name = psi.name,
        url = psi.url,
        digest = psi.digest,
        psi.subnode_image_type,
        proposal.proposed_by,
        description = psi.description,
        gtx_modules = psi.gtx_modules,
        sync_exts = psi.sync_exts,
        base_compute_requests = psi.base_compute_requests,
    );
    after_subnode_image_creation(subnode_image);
}

@extend(delete_proposal_handlers) function(): map<text, (proposal) -> unit> = [proposal_type.subnode_image.name: delete_pending_subnode_image(*)];
function delete_pending_subnode_image(proposal) {
    delete pending_subnode_image @? { proposal };
}

@extend(scheduled_proposal_delay_time_handlers) function() = [proposal_type.subnode_image.name: scheduled_subnode_image_proposal_delay_time_handler(*)];
function scheduled_subnode_image_proposal_delay_time_handler(proposal): (blockchain: blockchain?, delay: integer) {
    val scheduled_at_delay = get_scheduled_event_delay(delay_type.PROPOSAL, proposal.rowid.to_integer());
    if (scheduled_at_delay != null) {
        return (blockchain = null, delay = scheduled_at_delay);
    }
    return (blockchain = null, delay = 0);
}

/**
 * Propose new subnode image.
 * 
 * Permission: system provider
 * 
 * Rate limit: actions
 * 
 * @param my_pubkey Pubkey of the provider creating this proposal
 * @param gtx_modules GTX modules exposed by this subnode image (comma separated list of FQCNs)
 * @param sync_exts Synchronization infrastructure extensions exposed by this subnode image (comma separated list of FQCNs)
 * @param scheduled_at The time to apply this proposal when approved. If the proposal is approved after the time has passed the proposal is applied right away.
 * @param base_compute_requests How many compute requests per week a container gets by default.
 */
operation propose_subnode_image(my_pubkey: pubkey, name, url: text, digest: text, subnode_image_type,
        image_description: text, gtx_modules: text, sync_exts: text, proposal_description: text = "",
        scheduled_at: timestamp? = null, base_compute_requests: integer = 0) {
    val me = require_is_provider_with_rate_limit(my_pubkey);
    require_system_access(me);

    validate_entity_name(name);
    validate_url(url);
    validate_digest(digest);
    validate_metadata_text("image_description", image_description);
    validate_list_of_classes("gtx_modules", gtx_modules);
    validate_list_of_classes("sync_exts", sync_exts);
    require(base_compute_requests >= 0, "base_compute_requests must not be negative");

    val prop = create_proposal(proposal_type.subnode_image, me, system_p_voter_set(), proposal_description);
    if (scheduled_at != null) {
        add_scheduled_event(delay_type.PROPOSAL, prop.rowid.to_integer(), scheduled_at);
    }
    val pending_subnode_image = create pending_subnode_image (
        prop,
        name,
        url,
        digest,
        subnode_image_type,
        gtx_modules,
        sync_exts,
        description = image_description,
        base_compute_requests = base_compute_requests,
    );
    validate_subnode_image_proposal(pending_subnode_image);
    internal_vote(me, prop, true);
}

/**
 * Returns new subnode image proposal.
 */
query get_subnode_image_proposal(rowid): pending_subnode_image_data? {
    val proposal = get_latest_proposal(rowid, proposal_type.subnode_image);
    if (proposal == null) return null;
    val psi = pending_subnode_image @ { proposal };
    return pending_subnode_image_data(
        name = psi.name,
        url = psi.url,
        digest = psi.digest,
        subnode_image_type = psi.subnode_image_type,
        description = psi.description,
        gtx_modules = psi.gtx_modules,
        sync_exts = psi.sync_exts,
        base_compute_requests = psi.base_compute_requests,
    );
}

function validate_subnode_image_proposal(pending_subnode_image) {
    require(
        empty(subnode_image @? { .name == pending_subnode_image.name }),
        "Subnode image %s already exists".format(pending_subnode_image.name)
    );
}
