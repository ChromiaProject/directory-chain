entity pending_update_subnode_image {
    key proposal;
    key subnode_image;
    url: text;
    digest: text;
}

@extend(apply_voting_result_handlers) function() = [proposal_type.update_subnode_image.name: apply_update_subnode_image(*)];
function apply_update_subnode_image(proposal) {
    val pusi = pending_update_subnode_image @? { proposal };
    if (pusi == null) return;
    validate_update_subnode_image_proposal(pusi);
    pusi.subnode_image.url = pusi.url;
    pusi.subnode_image.digest = pusi.digest;
    after_subnode_image_updated(pusi.subnode_image);
}

@extend(delete_proposal_handlers) function(): map<text, (proposal) -> unit> = [proposal_type.update_subnode_image.name: delete_pending_update_subnode_image(*)];
function delete_pending_update_subnode_image(proposal) {
    delete pending_update_subnode_image @? { proposal };
}

@extend(scheduled_proposal_delay_time_handlers) function() = [proposal_type.update_subnode_image.name: scheduled_update_subnode_image_proposal_delay_time_handler(*)];
function scheduled_update_subnode_image_proposal_delay_time_handler(proposal): (blockchain: blockchain?, delay: integer) {
    val scheduled_at_delay = get_scheduled_event_delay(delay_type.PROPOSAL, proposal.rowid.to_integer());
    if (scheduled_at_delay != null) {
        return (blockchain = null, delay = scheduled_at_delay);
    }
    return (blockchain = null, delay = 0);
}

/**
 * Propose update subnode image.
 * 
 * Permission: system provider
 * 
 * Rate limit: actions
 * 
 * @param my_pubkey pubkey of provider
 * @param scheduled_at The time to apply this proposal when approved. If the proposal is approved after the time has passed the proposal is applied right away.
 */
operation propose_update_subnode_image(my_pubkey: pubkey, name, url: text, digest: text, description: text = "", scheduled_at: timestamp? = null) {
    val me = require_is_provider_with_rate_limit(my_pubkey);
    require_system_access(me);

    val subnode_image = require_subnode_image(name);
    validate_url(url);
    validate_digest(digest);

    val prop = create_proposal(proposal_type.update_subnode_image, me, system_p_voter_set(), description);
    if (scheduled_at != null) {
        add_scheduled_event(delay_type.PROPOSAL, prop.rowid.to_integer(), scheduled_at);
    }
    val pusi = create pending_update_subnode_image (
        prop,
        subnode_image,
        url,
        digest,
    );
    validate_update_subnode_image_proposal(pusi);
    internal_vote(me, prop, true);
}

/**
 * Returns update subnode image proposal.
 */
query get_update_subnode_image_proposal(rowid) {
    val proposal = get_latest_proposal(rowid, proposal_type.update_subnode_image);
    if (proposal == null) return null;
    val pusi = pending_update_subnode_image @ { proposal };
    return (
        name = pusi.subnode_image.name,
        url = pusi.url,
        digest = pusi.digest,
    );
}

function validate_update_subnode_image_proposal(pusi: pending_update_subnode_image) {
    require(
        pusi.url != pusi.subnode_image.url or pusi.digest != pusi.subnode_image.digest,
        "Subnode image %s already up-to-date".format(pusi.subnode_image.name)
    );
}
