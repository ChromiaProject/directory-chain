entity pending_update_subnode_image {
    key proposal;
    key subnode_image;
    url: text;
    digest: text;
}

@extend(apply_voting_result_handlers)
function() = [proposal_type.update_subnode_image.name: apply_update_subnode_image(*)];

function apply_update_subnode_image(proposal) {
    val pusi = pending_update_subnode_image @? { proposal };
    if (pusi == null) return;
    validate_update_subnode_image_proposal(pusi);
    pusi.subnode_image.url = pusi.url;
    pusi.subnode_image.digest = pusi.digest;
    after_subnode_image_updated(pusi.subnode_image);
}

@extend(delete_proposal_handlers)
function(): map<text, (proposal) -> unit> = [proposal_type.update_subnode_image.name: delete_pending_update_subnode_image(*)];

function delete_pending_update_subnode_image(proposal) {
    delete pending_update_subnode_image @? { proposal };
}

operation propose_update_subnode_image(my_pubkey: pubkey, name, url: text, digest: text, description: text = "") {
    val me = require_provider(my_pubkey);
    require_provider_auth_with_rate_limit(me);
    require_system_access(me);

    val subnode_image = require_subnode_image(name);
    validate_url(url);
    validate_digest(digest);

    val prop = create_proposal(proposal_type.update_subnode_image, me, system_p_voter_set(), description);
    val pusi = create pending_update_subnode_image (
        prop,
        subnode_image,
        url,
        digest,
    );
    validate_update_subnode_image_proposal(pusi);
    internal_vote(me, prop, true);
}

query get_update_subnode_image_proposal(rowid) {
    val proposal = get_latest_proposal(rowid, proposal_type.update_subnode_image);
    if (proposal == null) return null;
    val pusi = pending_update_subnode_image @ { proposal };
    return (
        name = pusi.subnode_image.name,
        url = pusi.url,
        digest = pusi.url,
    );
}

function validate_update_subnode_image_proposal(pusi: pending_update_subnode_image) {
    require(
        pusi.url != pusi.subnode_image.url or pusi.digest != pusi.subnode_image.digest,
        "Subnode image %s already up-to-date".format(pusi.subnode_image.name)
    );
}
