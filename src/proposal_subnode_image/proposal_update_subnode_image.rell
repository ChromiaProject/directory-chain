entity pending_update_subnode_image {
    key proposal;
    key subnode_image;
    url: text;
    digest: text;
    description: text = "";
    /** GTX modules exposed by this subnode image (comma separated list of FQCNs) */
    gtx_modules: text = "";
    gtx_modules_provided: boolean = false;
    /** Synchronization infrastructure extensions exposed by this subnode image (comma separated list of FQCNs) */
    sync_exts: text = "";
    sync_exts_provided: boolean = false;
    /** How many compute requests per week a container gets by default. */
    base_compute_requests: integer = 0;
}

struct pending_subnode_image_update_data {
    name;
    url: text? = null;
    digest: text? = null;
    description: text? = null;
    /** GTX modules exposed by this subnode image (comma separated list of FQCNs) */
    mutable gtx_modules: text? = null;
    /** Synchronization infrastructure extensions exposed by this subnode image (comma separated list of FQCNs) */
    mutable sync_exts: text? = null;
    /** How many compute requests per week a container gets by default. */
    base_compute_requests: integer? = null;
}

@extend(apply_voting_result_handlers) function() = [proposal_type.update_subnode_image.name: apply_update_subnode_image(*)];
function apply_update_subnode_image(proposal) {
    val pusi = pending_update_subnode_image @? { proposal };
    if (pusi == null) return;
    validate_update_subnode_image_proposal(pusi);
    if (not pusi.url.empty()) {
        pusi.subnode_image.url = pusi.url;
    }
    if (not pusi.digest.empty()) {
        pusi.subnode_image.digest = pusi.digest;
    }
    if (not pusi.description.empty()) {
        pusi.subnode_image.description = pusi.description;
    }
    if (pusi.gtx_modules_provided) {
        pusi.subnode_image.gtx_modules = pusi.gtx_modules;
    }
    if (pusi.sync_exts_provided) {
        pusi.subnode_image.sync_exts = pusi.sync_exts;
    }
    if (pusi.base_compute_requests >= 0) {
        pusi.subnode_image.base_compute_requests = pusi.base_compute_requests;
    }
    after_subnode_image_updated(pusi.subnode_image);
}

@extend(delete_proposal_handlers) function(): map<text, (proposal) -> unit> = [proposal_type.update_subnode_image.name: delete_pending_update_subnode_image(*)];
function delete_pending_update_subnode_image(proposal) {
    delete pending_update_subnode_image @? { proposal };
}

@extend(scheduled_proposal_delay_time_handlers) function() = [proposal_type.update_subnode_image.name: scheduled_proposals_delay_time_handler(*)];

/**
 * Propose update subnode image.
 * 
 * Permission: system provider
 * 
 * Rate limit: actions
 * 
 * @param my_pubkey Pubkey of the provider creating this proposal
 * @param gtx_modules GTX modules exposed by this subnode image (comma separated list of FQCNs)
 * @param sync_exts Synchronization infrastructure extensions exposed by this subnode image (comma separated list of FQCNs)
 * @param scheduled_at The time to apply this proposal when approved. If the proposal is approved after the time has passed the proposal is applied right away.
 * @param base_compute_requests How many compute requests per week a container gets by default.
 */
operation propose_update_subnode_image(my_pubkey: pubkey, name, url: text? = null, digest: text? = null,
    image_description: text? = null, gtx_modules: text? = null, sync_exts: text? = null, proposal_description: text = "",
    scheduled_at: timestamp? = null, base_compute_requests: integer? = null)
{
    val me = require_is_provider_with_rate_limit(my_pubkey);
    require_system_access(me);

    val subnode_image = require_subnode_image(name);
    if (url != null) {
        validate_url(url);
    }
    if (digest != null) {
        validate_digest(digest);
    }
    if (image_description != null) {
        validate_metadata_text("image_description", image_description);
    }
    if (gtx_modules != null) {
        validate_list_of_classes("gtx_modules", gtx_modules);
    }
    if (sync_exts != null) {
        validate_list_of_classes("sync_exts", sync_exts);
    }
    if (base_compute_requests != null) {
        require(base_compute_requests >= 0, "base_compute_requests must not be negative");
    }

    val prop = create_proposal(proposal_type.update_subnode_image, me, system_p_voter_set(), proposal_description);
    if (scheduled_at != null) {
        add_scheduled_event(delay_type.PROPOSAL, prop.rowid.to_integer(), scheduled_at);
    }
    val pusi = create pending_update_subnode_image (
        prop,
        subnode_image,
        url = url ?: "",
        digest = digest ?: "",
        description = image_description ?: "",
        gtx_modules_provided = gtx_modules != null,
        gtx_modules = gtx_modules ?: "",
        sync_exts_provided = sync_exts != null,
        sync_exts = sync_exts ?: "",
        base_compute_requests ?: -1,
    );
    validate_update_subnode_image_proposal(pusi);
    internal_vote(me, prop, true);
}

/**
 * Returns update subnode image proposal.
 */
query get_update_subnode_image_proposal(rowid) {
    val proposal = get_latest_proposal(rowid, proposal_type.update_subnode_image);
    if (proposal == null) return null;
    val pusi = pending_update_subnode_image @ { proposal };
    return pending_subnode_image_update_data(
        name = pusi.subnode_image.name,
        url = if (not pusi.url.empty()) pusi.url else null,
        digest = if (not pusi.digest.empty()) pusi.digest else null,
        description = if (not pusi.description.empty()) pusi.description else null,
        gtx_modules = if (pusi.gtx_modules_provided) pusi.gtx_modules else null,
        sync_exts = if (pusi.sync_exts_provided) pusi.sync_exts else null,
        base_compute_requests = if (pusi.base_compute_requests >= 0) pusi.base_compute_requests else null,
    );
}

function validate_update_subnode_image_proposal(pusi: pending_update_subnode_image) {
    require(
        pusi.url != pusi.subnode_image.url or pusi.digest != pusi.subnode_image.digest,
        "Subnode image %s already up-to-date".format(pusi.subnode_image.name)
    );
}
