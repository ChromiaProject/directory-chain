@extend(receive_icmf_message) function receive_remove_container(sender: byte_array, topic: text, body: gtv) {
    if (topic != remove_container_topic) return;

    if (sender != economy_chain.rid) {
        log("Sender %s is not the economy chain, ignoring".format(sender));
        return;
    }

    receive_remove_container_impl(body);
}

function receive_remove_container_impl(body: gtv) {
    val message = remove_container_message.from_gtv(body);
    val container = container @? { .name == message.container_name };

    val error_message = if (not exists(container))
        "Unable to remove non-existing container %s".format(message.container_name)
    else if (not try_call(remove_container_impl(container, *)))
        "Unable to remove container %s".format(message.container_name)
    else null;

    if (error_message != null) {
        log(error_message);
    }

    if (message.ticket_id != null) {
        send_message(ticket_container_result_topic, ticket_container_result_message(
            ticket_id = message.ticket_id!!,
            error_message = error_message,
        ).to_gtv());
    }
}
