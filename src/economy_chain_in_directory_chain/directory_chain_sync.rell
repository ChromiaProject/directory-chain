@extend(after_provider_registered) function(provider, cluster: cluster?) {
    send_provider_update_message(provider);
}

@extend(after_provider_updated) function(provider) {
    send_provider_update_message(provider);
}

function send_provider_update_message(provider) {
    send_message(provider_update_topic, provider_update_message(
        pubkey = provider.pubkey,
        system = provider.system,
        tier = provider.tier.name,
        active = provider.active,
        name = provider.name,
        url = provider.url,
    ).to_gtv());
}

@extend(after_provider_auth_updated) function(provider_pubkey: pubkey) {
    send_provider_auth_update_message(provider_pubkey);
}

function send_provider_auth_update_message(provider_pubkey: pubkey) {
    val message = provider_auth_update_message(
        provider_pubkey = provider_pubkey,
        list<provider_auth_update_role>()
    );

    for (pat in provider_auth_threshold @* { .provider_pubkey == provider_pubkey } ( .provider_key_role, .threshold )) {
        val all_keys = provider_auth_key @* { .provider_pubkey == provider_pubkey, pat.provider_key_role } ( .pubkey, .active );
        if (all_keys.size() > 0) {
            message.key_roles.add(provider_auth_update_role(pat.provider_key_role, pat.threshold, all_keys));
        }
    }

    send_message(provider_auth_update_topic, message.to_gtv());
}

@extend(after_cluster_creation) function (provider, cluster) {
    update_cluster(cluster);
}

@extend(after_cluster_updated) function(cluster) {
    update_cluster(cluster);
}

function update_cluster(cluster) {
    send_message(cluster_update_topic, cluster_update_message(
        name = cluster.name,
        deleted = false,
        operational = cluster.operational,
        cluster_units = cluster.cluster_units,
        extra_storage = cluster.extra_storage,
        anchoring_chain = cluster_anchoring_chain @? { cluster }.blockchain.rid
    ).to_gtv());
}

@extend(before_cluster_removal) function(cluster) {
    send_message(cluster_update_topic, cluster_update_message(
        name = cluster.name,
        deleted = true,
        operational = cluster.operational,
        cluster_units = cluster.cluster_units,
        extra_storage = cluster.extra_storage,
        anchoring_chain = cluster_anchoring_chain @? { cluster }.blockchain.rid
    ).to_gtv());
}

@extend(after_node_added) function(node) {
    send_message(node_update_topic, node_update_message(
        provider_pubkey = node.provider.pubkey,
        pubkey = node.pubkey,
        active = node.active,
        territory = node.territory,
        cluster_units = node.cluster_units,
        extra_storage = node.extra_storage,
        deleted = false
    ).to_gtv());
}

@extend(after_node_updated) function(node) {
    send_message(node_update_topic, node_update_message(
        provider_pubkey = node.provider.pubkey,
        pubkey = node.pubkey,
        active = node.active,
        territory = node.territory,
        cluster_units = node.cluster_units,
        extra_storage = node.extra_storage,
        deleted = false
    ).to_gtv());
}

@extend(before_node_removal) function(node) {
    send_message(node_update_topic, node_update_message(
        provider_pubkey = node.provider.pubkey,
        pubkey = node.pubkey,
        active = node.active,
        territory = node.territory,
        cluster_units = node.cluster_units,
        extra_storage = node.extra_storage,
        deleted = true
    ).to_gtv());
}

@extend(after_node_added_to_cluster) function(node, cluster) {
    after_node_added_to_cluster_impl(node, cluster, false);
}

@extend(after_replica_node_added_to_cluster) function(node, cluster) {
    after_node_added_to_cluster_impl(node, cluster, true);
}

function after_node_added_to_cluster_impl(node, cluster, replica: boolean) {
    send_message(cluster_node_update_topic, cluster_node_update_message(
        name = cluster.name,
        pubkey = node.pubkey,
        replica_node = replica,
        deleted = false
    ).to_gtv());
}

@extend(after_node_removed_from_cluster) function(node, cluster?) {
    after_node_removed_from_cluster_impl(node, cluster, false);
}

@extend(after_replica_node_removed_from_cluster) function(node, cluster?) {
    after_node_removed_from_cluster_impl(node, cluster, true);
}

function after_node_removed_from_cluster_impl(node, cluster?, replica: boolean) {
    val name = if (exists(cluster)) cluster.name else null;
    send_message(cluster_node_update_topic, cluster_node_update_message(
        name = name,
        pubkey = node.pubkey,
        replica_node = replica,
        deleted = true
    ).to_gtv());
}

@extend(after_subnode_image_creation) function(subnode_image) {
    update_subnode_image(subnode_image);
}

@extend(after_subnode_image_updated) function(subnode_image) {
    update_subnode_image(subnode_image);
}

function update_subnode_image(subnode_image) {
    send_message(subnode_image_update_topic, subnode_image_update_message(
        name = subnode_image.name,
        url = subnode_image.url,
        digest = subnode_image.digest,
        subnode_image_type = subnode_image.subnode_image_type.name,
        owner = subnode_image.owner.pubkey,
        description = subnode_image.description,
        active = subnode_image.active,
    ).to_gtv());
}

@extend(after_cluster_subnode_image_added) function(cluster, subnode_image) {
    send_message(cluster_subnode_image_update_topic, cluster_subnode_image_update_message(
        cluster = cluster.name,
        subnode_image = subnode_image.name,
        deleted = false,
    ).to_gtv());
}

@extend(after_cluster_subnode_image_removed) function(cluster, subnode_image) {
    send_message(cluster_subnode_image_update_topic, cluster_subnode_image_update_message(
        cluster = cluster.name,
        subnode_image = subnode_image.name,
        deleted = true,
    ).to_gtv());
}
