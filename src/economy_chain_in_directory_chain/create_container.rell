@extend(receive_icmf_message) function receive_create_container(sender: byte_array, topic: text, body: gtv) {
    if (topic != create_container_topic) return;

    if (sender != economy_chain.rid) {
        log("Sender %s is not the economy chain, ignoring".format(sender));
        return;
    }

    receive_create_container_impl(body);
}

function decode_create_container_message(gtv): create_container_message {
    when (list<gtv>.from_gtv(gtv).size()) {
        6 -> {
            val v1 = create_container_message_v1.from_gtv(gtv);
            return create_container_message(
                ticket_id = v1.ticket_id,
                provider_pubkey = v1.provider_pubkey,
                container_units = v1.container_units,
                extra_storage = v1.extra_storage,
                cluster_name = v1.cluster_name,
                subnode_image_name = v1.subnode_image_name,
                extra_compute_requests = 0,
                subnode_jar_extension_names = [],
            );
        }
        7 -> {
            val v2 = create_container_message_v2.from_gtv(gtv);
            return create_container_message(
                ticket_id = v2.ticket_id,
                provider_pubkey = v2.provider_pubkey,
                container_units = v2.container_units,
                extra_storage = v2.extra_storage,
                cluster_name = v2.cluster_name,
                subnode_image_name = v2.subnode_image_name,
                extra_compute_requests = v2.extra_compute_requests,
                subnode_jar_extension_names = [],
            );
        }
        8 -> {
            return create_container_message.from_gtv(gtv);
        }
        else -> {
            require(false, "Unable to decode create_container_message");
            return create_container_message.from_gtv(gtv); // will not happen
        }
    }
}

function receive_create_container_impl(body: gtv) {
    val message = decode_create_container_message(body);

    val container_cluster_names = try_call(create_container_from_ticket(
        provider_pubkey = message.provider_pubkey,
        container_units = message.container_units,
        extra_storage = message.extra_storage,
        cluster_name = message.cluster_name,
        subnode_image_name = message.subnode_image_name,
        extra_compute_requests = message.extra_compute_requests,
        subnode_jar_extension_names = message.subnode_jar_extension_names,
        *));

    val error_message = if (container_cluster_names == null)
        "Unexpected error"
    else if (container_cluster_names.container_name.empty())
        "Unable to find suitable cluster"
    else null;
    send_message(ticket_container_result_topic, ticket_container_result_message(
        ticket_id = message.ticket_id,
        error_message = error_message,
        container_name = container_cluster_names?.container_name,
        cluster_name = container_cluster_names?.cluster_name
    ).to_gtv());
}

function create_container_from_ticket(
    provider_pubkey: pubkey,
    container_units: integer,
    extra_storage: integer,
    cluster_name: text,
    subnode_image_name: text,
    extra_compute_requests: integer,
    subnode_jar_extension_names: list<text>
): (container_name: text, cluster_name: text) {

    require_pubkey(provider_pubkey);
    require(not cluster_name.empty(), "Cluster name must be specified");

    val provider = create_provider_if_not_exist(provider_pubkey);
    val cluster = cluster @? { .name == cluster_name, .name != clusters.system, .operational };

    if (
        cluster != null and
        get_available_container_units(cluster) >= container_units and
        get_available_extra_storage(cluster) >= extra_storage
    ) {
        var maybe_subnode_image: subnode_image? = null;
        if (not subnode_image_name.empty()) {
            maybe_subnode_image = require_subnode_image(subnode_image_name);
            require(maybe_subnode_image.active, "Subnode image %s is not active".format(maybe_subnode_image.name));
            require(maybe_subnode_image.subnode_image_type == subnode_image_type.COMMON or not empty(cluster_subnode_image @? { cluster, maybe_subnode_image }),
                "Subnode image %s is not compatible with cluster %s".format(maybe_subnode_image.name, cluster.name));
        }

        val maybe_subnode_jar_extensions = list<subnode_jar_extension>();
        for (subnode_jar_extension_name in subnode_jar_extension_names) {
            val subnode_jar_extension = require_cluster_compatible_subnode_jar_extension(subnode_jar_extension_name, cluster);
            maybe_subnode_jar_extensions.add(subnode_jar_extension);
        }

        val container = create_container_in_cluster(provider, cluster, container_units, extra_storage, extra_compute_requests);

        if (maybe_subnode_image != null) {
            create container_subnode_image(container, maybe_subnode_image);
        }

        for (subnode_jar_extension in maybe_subnode_jar_extensions) {
            create container_subnode_jar_extension(container, subnode_jar_extension);
        }

        return (container_name = container.name, cluster_name = cluster.name);
    }

    return (container_name = "", cluster_name = "");
}

function create_container_in_cluster(provider, cluster, container_units: integer, extra_storage: integer,
        extra_compute_requests: integer): container {
    val name = [cluster.to_gtv(), provider.pubkey.to_gtv(), op_context.transaction.tx_rid.to_gtv(), op_context.op_index.to_gtv()].hash().to_hex();
    return create_container_impl(
        provider, name, cluster, 1, [provider.pubkey],
        container_units,
        standard_container_defaults.max_blockchains,
        extra_storage,
        extra_compute_requests,
    );
}
