@extend(receive_icmf_message) function receive_upgrade_container(sender: byte_array, topic: text, body: gtv) {
    if (topic != upgrade_container_topic) return;

    if (sender != economy_chain.rid) {
        log("Sender %s is not the economy chain, ignoring".format(sender));
        return;
    }

    receive_upgrade_container_impl(body);
}

function decode_upgrade_container_message(gtv): upgrade_container_message {
    when (list<gtv>.from_gtv(gtv).size()) {
        5 -> {
            val v1 = upgrade_container_message_v1.from_gtv(gtv);
            return upgrade_container_message(
                ticket_id = v1.ticket_id,
                container_name = v1.container_name,
                container_units = v1.container_units,
                extra_storage = v1.extra_storage,
                cluster_name = v1.cluster_name,
                extra_compute_requests = 0,
            );
        }
        else -> {
            return try_call(upgrade_container_message.from_gtv(gtv, *)) ?: rell.error("Unable to decode upgrade_container_message");
        }
    }
}

function receive_upgrade_container_impl(body: gtv) {
    val message = decode_upgrade_container_message(body);

    val container = container @? { message.container_name };
    if (container == null) {
        send_upgrade_container_result(message, "Unable to upgrade non-existing container %s".format(message.container_name));
        return;
    }

    if (message.require_empty_container and exists(container_blockchain @* { container })) {
        send_upgrade_container_result(message, "Unable to upgrade non-empty container %s which is required to be empty".format(message.container_name));
        return;
    }

    require(container.cluster.name == message.cluster_name,
        "Unable to upgrade container: expected cluster_name '%s' to match the container's current cluster_name '%s' (container migration not supported)"
            .format(message.cluster_name, container.cluster.name)
    );

    val upgrade_result = try_call(check_and_upgrade_container(container, message, *));
    send_upgrade_container_result(message, if (upgrade_result) null else "Unable to upgrade container %s".format(message.container_name));
}

function send_upgrade_container_result(
    message: upgrade_container_message,
    error_message: text?,
    dst_container_name: text? = null,
    dst_cluster_name: text? = null
) {
    send_message(
        ticket_container_result_topic,
        ticket_container_result_message(
            ticket_id = message.ticket_id,
            error_message = error_message,
            container_name = dst_container_name ?: message.container_name,
            cluster_name = dst_cluster_name ?: message.cluster_name
        ).to_gtv()
    );
}

function check_and_upgrade_container(container, message: upgrade_container_message) {
    upgrade_container(container, message.container_units, message.extra_storage,
        standard_container_defaults.max_blockchains, message.extra_compute_requests);
    // In case container was stopped
    restart_container(message.container_name);
}
