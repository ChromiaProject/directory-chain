@test module;

import ^^^.common.operations.*;
import ^^^.common.test.setup.*;
import ^^^.common.test.util.*;
import ^^^.direct_cluster.*;
import ^^^.direct_container.*;
import ^^.*;
import ^.helpers.*;

function test_container_state_operations() {
    setup_module();

    val cluster_name = "bob_cluster";
    val container_name = "bob_container";
    val blockchain_name = "bob_blockchain";
    val cluster_data = cluster_creation_data(cluster_units = 1, extra_storage = 1024);
    val register_node_data = register_node_data(
        rell.test.pubkeys.charlie, host = "host", port = 7777, api_url = "http://host/api_url", [cluster_name],
        cluster_units = 1, extra_storage = 1024
    );
    var conf = apply_required_configuration_properties();

    rell.test.tx().op(
        create_cluster_with_cluster_data(initial_provider.pub, cluster_name, system_p_voter_set().name, [initial_provider.pub], cluster_data),
        register_node_with_node_data(initial_provider.pub, register_node_data),
        create_container(initial_provider.pub, container_name, cluster_name, 1, [initial_provider.pub]),
        // Add a bc to test that this works even when container is not empty
        propose_blockchain(initial_provider.pub, conf.to_gtv().to_bytes(), blockchain_name, container_name)
    ).sign(initial_provider).run();
    val bob_cluster = cluster @ { .name == cluster_name };
    val bob_container = container @ { .name == container_name };
    val bob_blockchain = blockchain @ { .name == blockchain_name };

    // Stopping
    rell.test.tx().op(
        receive_stop_container_op(stop_container_message(container_name).to_gtv())
    ).run();
    assert_equals(bob_container.state, container_state.STOPPED);

    // Restarting
    rell.test.tx().op(
        receive_restart_container_op(restart_container_message(container_name).to_gtv())
    ).run();
    assert_equals(bob_container.state, container_state.RUNNING);

    // Removing
    rell.test.tx().op(
        receive_remove_container_op(remove_container_message(container_name).to_gtv())
    ).run();
    assert_null(container @? { .name == container_name });
    assert_equals(bob_blockchain.state, blockchain_state.REMOVED);
}

/**
 * Sets up a cluster `s1` with two containers, `c1` and `c2`,
 * and starts a blockchain in container `c1`.
 */
function _setup_cluster_with_two_containers_and_blockchain(): blockchain {
    setup_module(provider_quota_max_containers = 3);

    val cluster_data = cluster_creation_data(cluster_units = 1, extra_storage = 1024);
    val register_node_data = register_node_data(
        rell.test.pubkeys.charlie, host = "host", port = 7777, api_url = "http://host/api_url", ["s1"],
        cluster_units = 1, extra_storage = 1024
    );
    var conf = apply_required_configuration_properties();

    // setup
    rell.test.tx().op(
        create_cluster_with_cluster_data(initial_provider.pub, "s1", system_p_voter_set().name, [initial_provider.pub], cluster_data),
        register_node_with_node_data(initial_provider.pub, register_node_data),
        create_container(initial_provider.pub, "c1", "s1", 1, [initial_provider.pub]),
        create_container(initial_provider.pub, "c2", "s1", 1, [initial_provider.pub]),
        propose_blockchain(initial_provider.pub, conf.to_gtv().to_bytes(), "foo_chain", "c1")
    ).sign(initial_provider).run();

    return blockchain @ { .name == "foo_chain" };
}

function _start_blockchain_moving_to_c2(foo_chain: blockchain) {
    rell.test.tx().op(
        propose_blockchain_move(initial_provider.pub, foo_chain.rid, "c2")
    ).sign(initial_provider).run();
    assert_not_null(moving_blockchain @? { foo_chain });
}

function test_remove_source_container_during_blockchain_move() {
    val foo_chain = _setup_cluster_with_two_containers_and_blockchain();
    _start_blockchain_moving_to_c2(foo_chain);

    // Removing container
    rell.test.tx().op(
        receive_remove_container_op(remove_container_message("c1").to_gtv())
    ).run();
    assert_null(container @? { "c1" });
    assert_equals(foo_chain.state, blockchain_state.REMOVED);
    assert_null(moving_blockchain @? { foo_chain });
}

function test_remove_destination_container_during_blockchain_move() {
    val foo_chain = _setup_cluster_with_two_containers_and_blockchain();
    _start_blockchain_moving_to_c2(foo_chain);

    // Removing container
    rell.test.tx().op(
        receive_remove_container_op(remove_container_message("c2").to_gtv())
    ).run();
    assert_null(container @? { "c2" });
    assert_equals(foo_chain.state, blockchain_state.REMOVED);
    assert_null(moving_blockchain @? { foo_chain });
}

function _archive_blockchain_then_start_unarchiving_to_c2(foo_chain: blockchain) {
    // Archive blockchain
    rell.test.tx().op(
        propose_blockchain_action(initial_provider.pub, foo_chain.rid, blockchain_action.archive)
    ).sign(initial_provider).run();
    assert_equals(foo_chain.state, blockchain_state.ARCHIVED);
    // 2. Unarchive blockchain from c1 to c2
    rell.test.tx().op(
        propose_blockchain_unarchive_action(initial_provider.pub, foo_chain.rid, "c2", 100)
    ).sign(initial_provider).run();
    assert_not_null(
        unarchiving_blockchain @? { foo_chain, .source.name == "c1", .destination.name == "c2" }
    );
}

function test_remove_source_container_during_blockchain_unarchiving() {
    val foo_chain = _setup_cluster_with_two_containers_and_blockchain();
    _archive_blockchain_then_start_unarchiving_to_c2(foo_chain);

    // Removing container
    rell.test.tx().op(
        receive_remove_container_op(remove_container_message("c1").to_gtv())
    ).run();
    assert_null(container @? { "c1" });
    assert_equals(foo_chain.state, blockchain_state.REMOVED);
    assert_null(moving_blockchain @? { foo_chain });
}

function test_remove_destination_container_during_blockchain_unarchiving() {
    val foo_chain = _setup_cluster_with_two_containers_and_blockchain();
    _archive_blockchain_then_start_unarchiving_to_c2(foo_chain);

    // Removing container
    rell.test.tx().op(
        receive_remove_container_op(remove_container_message("c2").to_gtv())
    ).run();
    assert_null(container @? { "c2" });
    assert_equals(foo_chain.state, blockchain_state.REMOVED);
    assert_null(moving_blockchain @? { foo_chain });
}
