import proposal_provider.*;
import proposal_subnode_image.*;

function test_init_events() {
    setup_module();

    val provider_auth_update_message = ("icmf_message", (
        topic = provider_auth_update_topic,
        body = provider_auth_update_message(
        provider_pubkey = initial_provider.pub,
        key_roles = [provider_auth_update_role(
        role = provider_key_role.main,
        threshold = 1,
        [(pubkey = initial_provider.pub, active = true)])]).to_gtv()).to_gtv_pretty()
    );

    val directory_chain_brid = blockchain @ { blockchains.directory_chain } (.rid);
    assert_events(
        provider_auth_update_message,
        provider_auth_update_message,
        ("icmf_message", (
            topic = provider_update_topic,
            body = provider_update_message(
                pubkey = initial_provider.pub,
                system = false,
                tier = provider_tier.NODE_PROVIDER.name,
                active = true).to_gtv()).to_gtv_pretty()
        ),
        ("icmf_message", (
            topic = cluster_update_topic,
            body = cluster_update_message(
                name = clusters.system,
                deleted = false,
                operational = false,
                cluster_units = 1,
                extra_storage = 0,
                anchoring_chain = null).to_gtv()).to_gtv_pretty()
        ),
        ("icmf_message", (
            topic = provider_update_topic,
            body = provider_update_message(
                pubkey = initial_provider.pub,
                system = true,
                tier = provider_tier.NODE_PROVIDER.name,
                active = true).to_gtv()).to_gtv_pretty()
        ),
        ("icmf_message", (
            topic = signer_list_update_topic,
            body = signer_list_update_message(
                serial = 1,
                blockchain_rid = directory_chain_brid,
                signers = [test_node.pubkey].to_gtv().to_bytes(),
                confirmed_in_directory_at_height = 0).to_gtv()).to_gtv_pretty()
        ),
        ("signer_list_update_event", signer_list_update_event(
            1,
            directory_chain_brid,
            [test_node.pubkey]
        ).to_gtv()),
        ("icmf_message", (
            topic = node_update_topic,
            body = node_update_message(
                provider_pubkey = initial_provider.pub,
                pubkey = test_node.pubkey,
                active = true,
                territory = test_node.territory,
                cluster_units = 1,
                extra_storage = 0,
                deleted = false).to_gtv()).to_gtv_pretty()
        ),
        ("icmf_message", (
            topic = cluster_node_update_topic,
            body = cluster_node_update_message(
                name = clusters.system,
                pubkey = test_node.pubkey,
                replica_node = false,
                deleted = false).to_gtv()).to_gtv_pretty()
        ),
        ("icmf_message", (
            topic = cluster_update_topic,
            body = cluster_update_message(
                name = clusters.system,
                deleted = false,
                operational = true,
                cluster_units = 1,
                extra_storage = 0,
                anchoring_chain = null).to_gtv()).to_gtv_pretty()
        )
    );
}

function test_provider() {
    setup_module();

    val test_provider = rell.test.keypairs.bob;

    // Add provider (after_provider_registered)
    rell.test.tx().op(
        register_provider(initial_provider.pub, test_provider.pub, provider_tier.NODE_PROVIDER)
    ).sign(initial_provider).run();

    val provider_auth_update_message = ("icmf_message", (
        topic = provider_auth_update_topic,
        body = provider_auth_update_message(
        provider_pubkey = test_provider.pub,
        key_roles = [provider_auth_update_role(
        role = provider_key_role.main,
        threshold = 1,
        [(pubkey = test_provider.pub, active = true)])]).to_gtv()).to_gtv_pretty()
    );

    assert_events(
        provider_auth_update_message,
        provider_auth_update_message,
        ("icmf_message", (
            topic = provider_update_topic,
            body = provider_update_message(
                pubkey = test_provider.pub,
                system = false,
                tier = provider_tier.NODE_PROVIDER.name,
                active = false).to_gtv()).to_gtv_pretty()
        ),
        ("icmf_message", (
            topic = provider_update_topic,
            body = provider_update_message(
                pubkey = test_provider.pub,
                system = false,
                tier = provider_tier.NODE_PROVIDER.name,
                active = false).to_gtv()).to_gtv_pretty()
        )
    );

    // Enable provider (after_provider_update)
    rell.test.tx().op(
        propose_provider_state(initial_provider.pub, test_provider.pub, true)
    ).sign(initial_provider).run();

    assert_events(
        ("icmf_message", (
            topic = provider_update_topic,
            body = provider_update_message(
                pubkey = test_provider.pub,
                system = false,
                tier = provider_tier.NODE_PROVIDER.name,
                active = true).to_gtv()).to_gtv_pretty()
        )
    );

    // Disable provider (after_provider_update)
    rell.test.tx().op(
        propose_provider_state(initial_provider.pub, test_provider.pub, false)
    ).sign(initial_provider).run();

    assert_events(
        ("icmf_message", (
            topic = provider_update_topic,
            body = provider_update_message(
                pubkey = test_provider.pub,
                system = false,
                tier = provider_tier.NODE_PROVIDER.name,
                active = false).to_gtv()).to_gtv_pretty()
        )
    );
}

function test_cluster() {
    setup_module();

    val test_provider = rell.test.keypairs.bob;
    val cluster_name = "bob_cluster";
    val cluster_creation_data = cluster_creation_data(cluster_units = 1, extra_storage = 1024);

    // Add cluster (after_cluster_creation)
    rell.test.tx().op(
        create_cluster_with_cluster_data(initial_provider.pub, cluster_name, system_voter_set().name, [initial_provider.pub], cluster_creation_data)
    ).sign(initial_provider).run();
    val bob_cluster = cluster @ { .name == cluster_name };

    assert_events(
        ("icmf_message", (
            topic = cluster_update_topic,
            body = cluster_update_message(name = cluster_name, deleted = false, operational = false, cluster_units = 1, extra_storage = 1024, anchoring_chain = null).to_gtv()
        ).to_gtv_pretty())
    );

    // Remove cluster (before_cluster_removal)
    rell.test.tx().op(
        cluster_remove(bob_cluster)
    ).sign(initial_provider).run();

    assert_events(
        ("icmf_message", (
            topic = cluster_update_topic,
            body = cluster_update_message(name = cluster_name, deleted = true, operational = false, cluster_units = 1, extra_storage = 1024, anchoring_chain = null).to_gtv()
        ).to_gtv_pretty())
    );
}

function test_node() {
    setup_module();

    val test_provider = rell.test.keypairs.bob;
    val provider = initial_provider;
    val provider_pubkey = initial_provider.pub;
    val node_pubkey = rell.test.pubkeys.charlie;

    // Add node (after_node_added)
    val register_node_data = register_node_data(
        node_pubkey, host = "host", port = 7777, api_url = "http://host/api_url", list<text>(),
        cluster_units = 1, extra_storage = 1024
    );

    rell.test.tx().op(
        register_node_with_node_data(provider_pubkey, register_node_data)
    ).sign(provider).run();

    assert_events(
        ("icmf_message", (
            topic = node_update_topic,
            body = node_update_message(
                provider_pubkey = provider_pubkey,
                pubkey = node_pubkey,
                active = true,
                territory = "",
                cluster_units = 1,
                extra_storage = 1024,
                deleted = false).to_gtv()).to_gtv_pretty()
        )
    );

    // Update node (after_node_updated)
    val update_node_data = update_node_data(node_pubkey, host = "host", port = 7777,
        api_url = "http://host/api_url", cluster_units = 10, extra_storage = 42, territory = ""
    );

    rell.test.tx().op(
        update_node_with_node_data(provider_pubkey, update_node_data)
    ).sign(provider).run();

    assert_events(
        ("icmf_message", (
            topic = node_update_topic,
            body = node_update_message(
                provider_pubkey = provider_pubkey,
                pubkey = node_pubkey,
                active = true,
                territory = "",
                cluster_units = 10,
                extra_storage = 42,
                deleted = false).to_gtv()).to_gtv_pretty()
        )
    );

    // Disable and remove node (before_node_removal)
    rell.test.tx().op(
        disable_node(my_pubkey = provider_pubkey, node_pubkey = node_pubkey),
        remove_node(my_pubkey = provider_pubkey, node_pubkey = node_pubkey)
    ).sign(provider).run();

    assert_events(
        ("icmf_message", (
            topic = cluster_node_update_topic,
            body = cluster_node_update_message(
                name = null,
                pubkey = node_pubkey,
                replica_node = false,
                deleted = true).to_gtv()).to_gtv_pretty()
        ),
        ("icmf_message", (
            topic = cluster_node_update_topic,
            body = cluster_node_update_message(
                name = null,
                pubkey = node_pubkey,
                replica_node = true,
                deleted = true).to_gtv()).to_gtv_pretty()
        ),
        ("icmf_message", (
            topic = node_update_topic,
            body = node_update_message(
                provider_pubkey = provider_pubkey,
                pubkey = node_pubkey,
                active = false,
                territory = "",
                cluster_units = 10,
                extra_storage = 42,
                deleted = true).to_gtv()).to_gtv_pretty()
        )
    );
}

function test_subnode_image() {
    setup_module();

    val test_provider = rell.test.keypairs.bob;
    val cluster_name = "bob_cluster";
    val cluster_creation_data = cluster_creation_data(cluster_units = 1, extra_storage = 1024);
    rell.test.tx().op(
        create_cluster_with_cluster_data(initial_provider.pub, cluster_name, system_p_voter_set().name, [initial_provider.pub], cluster_creation_data)
    ).sign(initial_provider).run();
    val bob_cluster = cluster @ { .name == cluster_name };

    assert_events(
        ("icmf_message", (
            topic = cluster_update_topic,
            body = cluster_update_message(name = cluster_name, deleted = false, operational = false, cluster_units = 1, extra_storage = 1024, anchoring_chain = null).to_gtv()
        ).to_gtv_pretty())
    );

    rell.test.tx().op(
        propose_subnode_image(initial_provider.pub, "subnode_image1", "url", "digest", subnode_image_type.SPECIAL, "one", "", "")
    ).sign(initial_provider).run();

    assert_events(
        ("icmf_message", (
            topic = subnode_image_update_topic,
            body = subnode_image_update_message(
                name = "subnode_image1",
                url = "url",
                digest = "digest",
                subnode_image_type = subnode_image_type.SPECIAL.name,
                owner = initial_provider.pub,
                description = "one",
                active = true,
            ).to_gtv()
        ).to_gtv_pretty())
    );

    rell.test.tx().op(
        propose_update_subnode_image(initial_provider.pub, "subnode_image1", "url2", "digest2")
    ).sign(initial_provider).run();

    assert_events(
        ("icmf_message", (
            topic = subnode_image_update_topic,
            body = subnode_image_update_message(
                name = "subnode_image1",
                url = "url2",
                digest = "digest2",
                subnode_image_type = subnode_image_type.SPECIAL.name,
                owner = initial_provider.pub,
                description = "one",
                active = true,
            ).to_gtv()
        ).to_gtv_pretty())
    );

    rell.test.tx().op(
        propose_add_cluster_subnode_image(initial_provider.pub, cluster_name, "subnode_image1")
    ).sign(initial_provider).run();

    assert_events(
        ("icmf_message", (
            topic = cluster_subnode_image_update_topic,
            body = cluster_subnode_image_update_message(
                cluster = cluster_name,
                subnode_image = "subnode_image1",
                deleted = false,
            ).to_gtv()
        ).to_gtv_pretty())
    );

    rell.test.tx().op(
        propose_remove_cluster_subnode_image(initial_provider.pub, cluster_name, "subnode_image1")
    ).sign(initial_provider).run();

    assert_events(
        ("icmf_message", (
            topic = cluster_subnode_image_update_topic,
            body = cluster_subnode_image_update_message(
                cluster = cluster_name,
                subnode_image = "subnode_image1",
                deleted = true,
            ).to_gtv()
        ).to_gtv_pretty())
    );

    rell.test.tx().op(
        propose_subnode_image_state(initial_provider.pub, "subnode_image1", false)
    ).sign(initial_provider).run();

    assert_events(
        ("icmf_message", (
            topic = subnode_image_update_topic,
            body = subnode_image_update_message(
                name = "subnode_image1",
                url = "url2",
                digest = "digest2",
                subnode_image_type = subnode_image_type.SPECIAL.name,
                owner = initial_provider.pub,
                description = "one",
                active = false,
            ).to_gtv()
        ).to_gtv_pretty())
    );
}

function test_provider_auth_update() {

    val key2 = rell.test.keypairs.bob;
    val key3 = rell.test.keypairs.charlie;

    // Register provider - will trigger 2 messages
    rell.test.tx().op(
        create_test_provider("P1", initial_provider.pub),
    ).sign(initial_provider, key2, key3).run();

    val provider_key_message = ("icmf_message", (
        topic = provider_auth_update_topic,
        body = provider_auth_update_message(
        provider_pubkey = initial_provider.pub,
        key_roles = [provider_auth_update_role(
        role = provider_key_role.main,
        threshold = 1,
        [(pubkey = initial_provider.pub, active = true)])]).to_gtv()).to_gtv_pretty()
    );

    assert_events(
        provider_key_message,
            provider_key_message,
    );

    // Add a key
    rell.test.tx().op(
        add_provider_key(provider_key_role.main, key2.pub),
    ).sign(initial_provider, key2, key3).run();

    val provider_and_key2_message = ("icmf_message", (
        topic = provider_auth_update_topic,
        body = provider_auth_update_message(
        provider_pubkey = initial_provider.pub,
        key_roles = [provider_auth_update_role(
        role = provider_key_role.main,
        threshold = 1,
        [(pubkey = initial_provider.pub, active = true), (pubkey = key2.pub, active = true)])]).to_gtv()).to_gtv_pretty()
    );

    assert_events(
        provider_and_key2_message,
    );

    // Add a key of new role - will trigger 2 messages
    rell.test.tx().op(
        add_provider_key(provider_key_role.configuration_proposal_vote, key3.pub),
    ).sign(initial_provider, key2, key3).run();

    val all_keys_and_new_role_message = ("icmf_message", (
        topic = provider_auth_update_topic,
        body = provider_auth_update_message(
        provider_pubkey = initial_provider.pub,
        key_roles = [
        provider_auth_update_role(
            role = provider_key_role.main,
            threshold = 1,
            [(pubkey = initial_provider.pub, active = true), (pubkey = key2.pub, active = true)]
        ),
        provider_auth_update_role(
            role = provider_key_role.configuration_proposal_vote,
            threshold = 1,
            [(pubkey = key3.pub, active = true)]
        )
    ]).to_gtv()).to_gtv_pretty());

    assert_events(
        all_keys_and_new_role_message,
            all_keys_and_new_role_message,
    );

    rell.test.tx().op(
        set_provider_key_threshold(provider_key_role.configuration_proposal_vote, consensus_threshold.super_majority),
    ).sign(initial_provider, key2, key3).run();
    assert_events(
        ("icmf_message", (
            topic = provider_auth_update_topic,
            body = provider_auth_update_message(
            provider_pubkey = initial_provider.pub,
            key_roles = [
                provider_auth_update_role(
                    role = provider_key_role.main,
                    threshold = 1,
                    [(pubkey = initial_provider.pub, active = true), (pubkey = key2.pub, active = true)]),
                provider_auth_update_role(
                    role = provider_key_role.configuration_proposal_vote,
                    threshold = 0,
                    [(pubkey = key3.pub, active = true)]),
            ]).to_gtv()).to_gtv_pretty()
        )
    );

    rell.test.tx().op(
        revoke_provider_key(provider_key_role.configuration_proposal_vote, key3.pub),
    ).sign(initial_provider, key2).run();
    assert_events(
        ("icmf_message", (
            topic = provider_auth_update_topic,
            body = provider_auth_update_message(
                provider_pubkey = initial_provider.pub,
                key_roles = [
                    provider_auth_update_role(
                        role = provider_key_role.main,
                        threshold = 1,
                        [
                            (pubkey = initial_provider.pub, active = true),
                            (pubkey = key2.pub, active = true),
                        ]),
                    provider_auth_update_role(
                        role = provider_key_role.configuration_proposal_vote,
                        threshold = 0,
                        [
                            (pubkey = key3.pub, active = false),
                        ]),
                ]
            ).to_gtv()).to_gtv_pretty()
        )
    );
}
