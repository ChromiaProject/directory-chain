@test module;

import common.operations.*;
import common.test.setup.*;
import common.test.util.*;
import direct_container.*;
import ^^.*;
import ^.helpers.*;

function test_register_dapp_provider() {
    setup_module();

    val conf = apply_required_configuration_properties();
    val container_name = "container1";
    rell.test.tx().op(
        init_economy_chain(initial_provider.pub, conf.to_gtv().to_bytes()),
        create_container(initial_provider.pub, container_name, clusters.system, 0, [initial_provider.pub])
    ).sign(initial_provider).run();
    val container = container @ { .name == container_name };

    val dapp_provider_key = rell.test.pubkeys.bob;
    rell.test.tx().op(
        register_dapp_provider_op(register_dapp_provider_message(
            container_name,
            dapp_provider_key
        ).to_gtv())
    ).run();

    val dapp_provider = provider @ { .pubkey == dapp_provider_key };
    val proposal = voter_set_update.new_member @ { .provider == dapp_provider }.pending_voter_set_update.proposal;

    rell.test.tx().op(
        make_vote(initial_provider.pub, proposal.rowid.to_integer(), true)
    ).sign(initial_provider).run();

    assert_not_null(voter_set_member @? { .voter_set == container.deployer, .provider == dapp_provider });
}

function test_register_dapp_provider_without_container_name() {
    setup_module();

    val conf = apply_required_configuration_properties();
    rell.test.tx().op(
        init_economy_chain(initial_provider.pub, conf.to_gtv().to_bytes()),
    ).sign(initial_provider).run();

    val dapp_provider_key = rell.test.pubkeys.bob;
    rell.test.tx().op(
        register_dapp_provider_op(register_dapp_provider_message(
            "",
            dapp_provider_key
        ).to_gtv())
    ).run();

    val dapp_provider = provider @ { .pubkey == dapp_provider_key };
    assert_null(voter_set_update.new_member @? { .provider == dapp_provider }.pending_voter_set_update.proposal);
}
