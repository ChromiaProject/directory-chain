@extend(receive_icmf_message) function receive_create_cluster(sender: byte_array, topic: text, body: gtv) {
    if (topic != create_cluster_v2_topic) return;

    if (sender != economy_chain.rid) {
        log("Sender %s is not the economy chain, ignoring".format(sender));
        return;
    }

    val message = create_cluster_v2_message.from_gtv(body);

    val cluster_name = try_call(create_cluster_from_v2_message(message, *));

    if (cluster_name == null)
        send_message(create_cluster_error_topic, create_cluster_error_message (
            name = message.name,
            error_message = "Unexpected error"
        ).to_gtv());
}


function create_cluster_from_v2_message(
    message: create_cluster_v2_message
): text {
    val proposer = require_provider(message.proposer_pubkey);
    val governor = require_voter_set(message.governor_voter_set_name);
    val node_provider_set = require_voter_set(message.voter_set_name);

    create_cluster_impl(proposer, message.name, governor, voter_set_member @* { node_provider_set }.provider.pubkey,
        cluster_creation_data(
            cluster_units = message.cluster_units, extra_storage = message.extra_storage,
            system_container_units = message.system_container_units,
            container_unit_cpu = message.container_unit_cpu,
            container_unit_ram = message.container_unit_ram,
            container_unit_io_read = message.container_unit_io_read,
            container_unit_io_write = message.container_unit_io_write,
            container_unit_storage = message.container_unit_storage,
            max_nodes = message.max_nodes
        ));

    return message.name;
}
