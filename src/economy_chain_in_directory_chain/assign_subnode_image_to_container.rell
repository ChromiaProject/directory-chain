@extend(receive_icmf_message) function receive_assign_subnode_image_to_container(sender: byte_array, topic: text, body: gtv) {
    if (topic != assign_subnode_image_to_container_topic) return;

    if (sender != economy_chain.rid) {
        log("Sender %s is not the economy chain, ignoring".format(sender));
        return;
    }

    receive_assign_subnode_image_to_container_impl(body);
}

function receive_assign_subnode_image_to_container_impl(body: gtv) {
    val message = assign_subnode_image_to_container_message.from_gtv(body);

    val container = container @? { .name == message.container_name };
    if (empty(container)) {
        send_response(message.ticket_id, "Container %s not found".format(message.container_name));
        return;
    }

    val subnode_image = subnode_image @? { .name == message.subnode_image_name };
    if (empty(subnode_image)) {
        send_response(message.ticket_id, "Subnode image %s not found".format(message.subnode_image_name));
        return;
    }

    if (not subnode_image.active) {
        send_response(message.ticket_id, "Subnode image %s is not active".format(message.subnode_image_name));
        return;
    }

    if (not (subnode_image.subnode_image_type == subnode_image_type.COMMON or not empty(cluster_subnode_image @? { container.cluster, subnode_image }))) {
        send_response(message.ticket_id, "Subnode image %s is not compatible with cluster %s".format(message.subnode_image_name, container.cluster.name));
        return;
    }

    if (not empty(container_subnode_image @? { container })) {
        send_response(message.ticket_id, "Container %s already has a subnode image".format(message.container_name));
        return;
    }

    create container_subnode_image(container, subnode_image);
    send_response(message.ticket_id, null);
}

function send_response(ticket_id: integer, error_message: text?) {
    send_message(ticket_container_result_topic, ticket_container_result_message(
        ticket_id = ticket_id,
        error_message = error_message,
        container_name = null,
        cluster_name = null,
    ).to_gtv());
}
