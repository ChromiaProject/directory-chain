entity pending_subnode_jar_extension {
    key proposal;
    key name;
    jar: byte_array;
    hash: byte_array;
    subnode_jar_extension_type;
    description: text;
    /** GTX modules exposed by this Subnode JAR extension (comma separated list of FQCNs) */
    gtx_modules: text;
    /** Synchronization infrastructure extensions exposed by this Subnode JAR extension (comma separated list of FQCNs) */
    sync_exts: text;
    /** Rell native function implementations exposed by this Subnode JAR extension (comma separated list of FQCNs) */
    native_functions: text = "";
}

struct pending_subnode_jar_extension_data {
    name;
    hash: byte_array;
    subnode_jar_extension_type;
    description: text;
    /** GTX modules exposed by this Subnode JAR extension (comma separated list of FQCNs) */
    gtx_modules: text;
    /** Synchronization infrastructure extensions exposed by this Subnode JAR extension (comma separated list of FQCNs) */
    sync_exts: text;
    /** Rell native function implementations exposed by this Subnode JAR extension (comma separated list of FQCNs) */
    native_functions: text?;
}

@extend(apply_voting_result_handlers) function() = [proposal_type.subnode_jar_extension.name: apply_subnode_jar_extension(*)];
function apply_subnode_jar_extension(proposal) {
    val psje = pending_subnode_jar_extension @? { proposal };
    if (psje == null) return;
    validate_subnode_jar_extension_proposal(psje);
    val subnode_jar_extension = create subnode_jar_extension(
        name = psje.name,
        jar = psje.jar,
        hash = psje.hash,
        psje.subnode_jar_extension_type,
        proposal.proposed_by,
        description = psje.description,
        gtx_modules = psje.gtx_modules,
        sync_exts = psje.sync_exts,
        native_functions = psje.native_functions
    );
    after_subnode_jar_extension_creation(subnode_jar_extension);
}

@extend(delete_proposal_handlers) function(): map<text, (proposal) -> unit> = [proposal_type.subnode_jar_extension.name: delete_pending_subnode_jar_extension(*)];
function delete_pending_subnode_jar_extension(proposal) {
    delete pending_subnode_jar_extension @? { proposal };
}

@extend(scheduled_proposal_delay_time_handlers) function() = [proposal_type.subnode_jar_extension.name: scheduled_proposals_delay_time_handler(*)];

/**
 * Propose new Subnode JAR extension.
 * 
 * Permission: system provider
 * 
 * Rate limit: actions
 * 
 * @param my_pubkey Pubkey of the provider creating this proposal
 * @param jar Raw JAR file content for the extension in bytes
 * @param subnode_jar_extension_type Type of extension, common to or specific to certain clusters
 * @param extension_description Description of the new extension
 * @param gtx_modules GTX modules exposed by this Subnode JAR extension (comma separated list of FQCNs)
 * @param sync_exts Synchronization infrastructure extensions exposed by this Subnode JAR extension (comma separated list of FQCNs)
 * @param proposal_description Description of the proposal
 * @param scheduled_at The time to apply this proposal when approved. If the proposal is approved after the time has passed the proposal is applied right away.
 * @param native_functions Rell native function implementations exposed by this Subnode JAR extension (comma separated list of FQCNs)
 */
operation propose_subnode_jar_extension(my_pubkey: pubkey, name, jar: byte_array, subnode_jar_extension_type,
        extension_description: text, gtx_modules: text, sync_exts: text, proposal_description: text = "",
        scheduled_at: timestamp? = null, native_functions: text = "") {
    val me = require_is_provider_with_rate_limit(my_pubkey);
    require_system_access(me);

    validate_entity_name(name);
    validate_metadata_text("extension_description", extension_description);
    validate_list_of_classes("gtx_modules", gtx_modules);
    validate_list_of_classes("sync_exts", sync_exts);
    validate_list_of_classes("native_functions", native_functions);

    val prop = create_proposal(proposal_type.subnode_jar_extension, me, system_p_voter_set(), proposal_description);
    if (scheduled_at != null) {
        add_scheduled_event(delay_type.PROPOSAL, prop.rowid.to_integer(), scheduled_at);
    }
    val pending_subnode_jar_extension = create pending_subnode_jar_extension(
        prop,
        name,
        jar = jar,
        hash = crypto.sha256(jar),
        subnode_jar_extension_type,
        gtx_modules,
        sync_exts,
        native_functions,
        description = extension_description,
    );
    validate_subnode_jar_extension_proposal(pending_subnode_jar_extension);
    internal_vote(me, prop, true);
}

/**
 * Returns new Subnode JAR extension proposal, without the raw JAR file.
 */
query get_subnode_jar_extension_proposal(rowid): pending_subnode_jar_extension_data? {
    val proposal = get_latest_proposal(rowid, proposal_type.subnode_jar_extension);
    if (proposal == null) return null;
    val psje = pending_subnode_jar_extension @ { proposal };
    return pending_subnode_jar_extension_data(
        name = psje.name,
        hash = psje.hash,
        subnode_jar_extension_type = psje.subnode_jar_extension_type,
        description = psje.description,
        gtx_modules = psje.gtx_modules,
        sync_exts = psje.sync_exts,
        native_functions = psje.native_functions
    );
}

/**
 * Returns new Subnode JAR extension proposal raw JAR file.
 */
query get_subnode_jar_extension_proposal_jar_file(rowid): byte_array? {
    val proposal = get_latest_proposal(rowid, proposal_type.subnode_jar_extension);
    if (proposal == null) return null;
    val psje = pending_subnode_jar_extension @ { proposal };
    return psje.jar;
}

function validate_subnode_jar_extension_proposal(pending_subnode_jar_extension) {
    require(
        empty(subnode_jar_extension @? { .name == pending_subnode_jar_extension.name }),
        "Subnode JAR extension %s already exists".format(pending_subnode_jar_extension.name)
    );
}
