@test module;

import common.operations.*;
import common.queries.*;
import common.test.setup.*;
import common.test.util.*;
import model.*;
import proposal_subnode_jar_extension.*;
import proposal_container.*;
import proposal_provider.*;
import direct_cluster.*;

function test_propose_subnode_jar_extension_update() {
    setup_module();
    val sp1 = rell.test.keypairs.bob;

    rell.test.tx().op(
        register_provider(initial_provider.pub, sp1.pub, provider_tier.NODE_PROVIDER),
        propose_provider_is_system(initial_provider.pub, sp1.pub, true),
    ).sign(initial_provider).run();

    rell.test.tx().op(
        propose_subnode_jar_extension(initial_provider.pub, "subnode_jar_extension1", x"00", subnode_jar_extension_type.SPECIAL,
            "extension description", "gtx", "sync_ext", "prop description", null)
    ).sign(initial_provider).run();
    vote_for_last_proposal(sp1);

    assert_not_null(subnode_jar_extension @? { .name == "subnode_jar_extension1" });

    // Update JAR and description
    rell.test.tx().op(
        propose_update_subnode_jar_extension(initial_provider.pub, "subnode_jar_extension1", x"01", "v2", null, null,
            "Pop desc", null)
    ).sign(initial_provider).run();

    val proposal1 = get_update_subnode_jar_extension_proposal(last_proposal().rowid);
    assert_not_null(proposal1);
    assert_equals(proposal1.hash, crypto.sha256(x"01"));
    assert_equals(proposal1.description, "v2");
    assert_null(proposal1.gtx_modules);
    assert_null(proposal1.sync_exts);

    val proposal1_jar = get_update_subnode_jar_extension_proposal_jar_file(last_proposal().rowid);
    assert_equals(proposal1_jar, x"01");

    vote_for_last_proposal(sp1);

    val si = subnode_jar_extension @ { .name == "subnode_jar_extension1" };
    assert_equals(si.hash, crypto.sha256(x"01"));
    assert_equals(si.description, "v2");
    assert_equals(si.gtx_modules, "gtx");           // Unchanged
    assert_equals(si.sync_exts, "sync_ext");        // Unchanged

    // Update gtx, sync_ext and base_compute_requests
    rell.test.tx().op(
        propose_update_subnode_jar_extension(initial_provider.pub, "subnode_jar_extension1", null, null, "gtx,gtx2", "ext1,ext2",
            "Pop desc", null)
    ).sign(initial_provider).run();

    val proposal2 = get_update_subnode_jar_extension_proposal(last_proposal().rowid);
    assert_not_null(proposal2);
    assert_null(proposal2.hash);
    assert_null(proposal2.description);
    assert_equals(proposal2.gtx_modules, "gtx,gtx2");
    assert_equals(proposal2.sync_exts, "ext1,ext2");

    vote_for_last_proposal(sp1);

    assert_equals(si.jar, x"01");           // Unchanged
    assert_equals(si.description, "v2");     // Unchanged
    assert_equals(si.gtx_modules, "gtx,gtx2");
    assert_equals(si.sync_exts, "ext1,ext2");
}
