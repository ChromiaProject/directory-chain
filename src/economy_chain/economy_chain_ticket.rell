function has_pending_upgrade(container_name: text): boolean =
    not empty(upgrade_container_ticket @* { container_name, .ticket.state == ticket_state.PENDING});

function has_pending_subnode_image_assignment(container_name: text): boolean =
    not empty(assign_subnode_image_to_container_ticket @* { container_name, .ticket.state == ticket_state.PENDING});

function has_pending_subnode_jar_extensions_assignment(container_name: text): boolean =
    not empty(add_subnode_jar_extensions_to_container_ticket @* { container_name, .ticket.state == ticket_state.PENDING});

function receive_ticket_container_result_message(body: gtv) {
    val message = ticket_container_result_message.from_gtv(body);
    val ticket = ticket @? { .rowid == rowid(message.ticket_id) };
    if (ticket == null) {
        log("ticket_id %d not found".format(message.ticket_id));
        return;
    }
    ticket.state = if (message.error_message == null) ticket_state.SUCCESS else ticket_state.FAILURE;
    ticket.error_message = message.error_message ?: "";

    when (ticket.type) {
        ticket_type.CREATE_CONTAINER -> {
            val specific_ticket = create_container_ticket @ { ticket };
            val cluster = cluster @ { .name == specific_ticket.cluster_name };
            when (ticket.state) {
                ticket_state.SUCCESS -> {
                    val container_name = message.container_name!!;
                    val cluster_name = message.cluster_name!!;
                    log("Successfully created container %s in cluster %s for ticket %d".format(container_name, cluster_name, message.ticket_id));
                    specific_ticket.container_name = container_name;
                    val lease = create lease(
                        container_name = container_name,
                        account = ticket.account,
                        container_units = specific_ticket.container_units,
                        extra_storage_gib = specific_ticket.extra_storage_gib,
                        cluster = cluster,
                        start_time = op_context.last_block_time,
                        duration_millis = specific_ticket.duration_millis,
                        auto_renew = specific_ticket.auto_renew,
                        extra_compute_requests = specific_ticket.extra_compute_requests,
                    );
                    if (not specific_ticket.subnode_image_name.empty()) {
                        create lease_subnode_image(lease, subnode_image @ { .name == specific_ticket.subnode_image_name });
                    }
                    if (not specific_ticket.subnode_jar_extension_names.empty()) {
                        for (subnode_jar_extension_name in specific_ticket.subnode_jar_extension_names.split(",")) {
                            create lease_subnode_jar_extension(lease, subnode_jar_extension @ { .name == subnode_jar_extension_name });
                        }
                    }
                }
                ticket_state.FAILURE -> {
                    log("Failed to create container for ticket %d".format(message.ticket_id));

                    ft4.assets.Unsafe.transfer(get_pool_account(), ticket.account, get_asset(), specific_ticket.cost);
                    create lease_refund(ticket.account, specific_ticket.cost);
                }
            }
        }

        ticket_type.UPGRADE_CONTAINER -> {
            val specific_ticket = upgrade_container_ticket @ { ticket };
            val cluster = cluster @ { .name == specific_ticket.cluster_name };
            when (ticket.state) {
                ticket_state.SUCCESS -> {
                    // Note: When we implement "move" the container name might change so we should check what name D1 returns
                    val upgraded_container_name = message.container_name!!;
                    val upgraded_cluster_name = message.cluster_name!!;
                    log("Successfully upgraded container %s for ticket %d".format(upgraded_container_name, message.ticket_id));
                    val current_lease = lease @ { .container_name == specific_ticket.container_name };
                    val currently_auto_renewed = current_lease.auto_renew;
                    val bridge_leases = delete_bridge_leases(current_lease);
                    val lease_dapp_providers = delete_lease_dapp_providers(current_lease);
                    val maybe_lease_subnode_image = lease_subnode_image @? { current_lease };
                    val current_subnode_image: subnode_image?;
                    if (maybe_lease_subnode_image != null) {
                        current_subnode_image = maybe_lease_subnode_image.subnode_image;
                        delete maybe_lease_subnode_image;
                    } else {
                        current_subnode_image = null;
                    }
                    val current_lease_subnode_jar_extensions = lease_subnode_jar_extension @* { current_lease };
                    val current_subnode_jar_extensions = current_lease_subnode_jar_extensions @* { }.subnode_jar_extension;
                    delete current_lease_subnode_jar_extensions;
                    delete current_lease;
                    val new_lease = create lease(
                        container_name = upgraded_container_name,
                        account = ticket.account,
                        container_units = specific_ticket.container_units,
                        extra_storage_gib = specific_ticket.extra_storage_gib,
                        cluster = cluster,
                        start_time = op_context.last_block_time,
                        duration_millis = specific_ticket.duration_weeks * millis_per_week,
                        auto_renew = currently_auto_renewed,
                        extra_compute_requests = specific_ticket.extra_compute_requests,
                    );
                    if (current_subnode_image != null) {
                        create lease_subnode_image(new_lease, current_subnode_image);
                    }
                    for (current_subnode_jar_extension in current_subnode_jar_extensions) {
                        create lease_subnode_jar_extension(new_lease, current_subnode_jar_extension);
                    }
                    transfer_bridge_leases_to_lease(new_lease, bridge_leases);
                    transfer_dapp_providers_to_lease(new_lease, lease_dapp_providers);
                }
                ticket_state.FAILURE -> {
                    log("Failed to upgrade container for ticket %d".format(message.ticket_id));
                    if (specific_ticket.cost > 0) {
                        ft4.assets.Unsafe.transfer(get_pool_account(), ticket.account, get_asset(), specific_ticket.cost);
                    } else if (specific_ticket.cost < 0) {
                        ft4.assets.Unsafe.transfer(ticket.account, get_pool_account(), get_asset(), abs(specific_ticket.cost));
                    }
                    create lease_refund(ticket.account, specific_ticket.cost);
                }
            }
        }

        ticket_type.ASSIGN_SUBNODE_IMAGE_TO_CONTAINER -> {
            val specific_ticket = assign_subnode_image_to_container_ticket @ { ticket };
            when (ticket.state) {
                ticket_state.SUCCESS -> {
                    log("Successfully assigned subnode image %s to container %s for ticket %d".format(
                        specific_ticket.subnode_image_name, specific_ticket.container_name, message.ticket_id));
                    val lease = lease @ { .container_name == specific_ticket.container_name };
                    create lease_subnode_image(lease, subnode_image @ { .name == specific_ticket.subnode_image_name });
                }
                ticket_state.FAILURE -> {
                    log("Failed to assign subnode image %s to container %s for ticket %d".format(
                        specific_ticket.subnode_image_name, specific_ticket.container_name, message.ticket_id));
                }
            }
        }

        ticket_type.ADD_SUBNODE_JAR_EXTENSIONS_TO_CONTAINER -> {
            val specific_ticket = add_subnode_jar_extensions_to_container_ticket @ { ticket };
            when (ticket.state) {
                ticket_state.SUCCESS -> {
                    log("Successfully added subnode JAR extension(s) %s to container %s for ticket %d".format(
                        specific_ticket.subnode_jar_extension_names, specific_ticket.container_name, message.ticket_id));
                    val lease = lease @ { .container_name == specific_ticket.container_name };
                    for (subnode_jar_extension_name in specific_ticket.subnode_jar_extension_names.split(",")) {
                        create lease_subnode_jar_extension(lease, subnode_jar_extension @ { .name == subnode_jar_extension_name });
                    }
                }
                ticket_state.FAILURE -> {
                    log("Failed to add subnode JAR extension(s) %s to container %s for ticket %d".format(
                        specific_ticket.subnode_jar_extension_names, specific_ticket.container_name, message.ticket_id));
                }
            }
        }

        ticket_type.REMOVE_CONTAINER -> {
            val specific_ticket = remove_container_ticket @ { ticket };
            when (ticket.state) {
                ticket_state.SUCCESS -> {
                    log("Successfully removed container %s for ticket %d".format(
                        specific_ticket.container_name, message.ticket_id));
                    val lease = lease @ { .container_name == specific_ticket.container_name };
                    on_lease_expired(lease);
                    on_expired_lease_removed(lease);
                    delete lease_subnode_jar_extension @* { lease };
                    delete lease_subnode_image @? { lease };
                    delete lease;
                }
                ticket_state.FAILURE -> {
                    log("Failed to remove container %s for ticket %d".format(
                        specific_ticket.container_name, message.ticket_id));
                }
            }
        }
    }
}