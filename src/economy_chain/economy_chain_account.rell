/**
 * CHR accounts on the economy chain.
 *
 * Two families of account are defined here, and they differ in who can move the money:
 *
 * 1. PROVIDER accounts -- `register_provider_account`. Created *with* an auth descriptor
 *    (single-sig on the provider pubkey), so the provider itself can sign transfers.
 *    One per registered provider, no matter how many nodes it runs.
 *
 *    Providers are not registered on this chain directly: they are SYNCED FROM THE
 *    DIRECTORY CHAIN over ICMF. The `provider` entity is created or updated from a
 *    `provider_update` message, and the account is created locally as a side effect of
 *    first seeing that provider -- see `receive_provider_update_message` in
 *    `economy_chain_directory_chain_sync.rell`, the only caller of
 *    `register_provider_account`. So the pubkey the auth descriptor is built from is
 *    DC-supplied, and no provider account can exist here without DC having announced it.
 *
 * 2. SYSTEM accounts -- created with `create_account_without_auth`, so they have NO auth
 *    descriptor and nobody can sign for them. Their funds move only through `Unsafe.*`
 *    calls in protocol code. There are exactly three:
 *
 *      REWARD_POOL  the only account CHR is ever minted into, and the source of every
 *                   reward payout. See `refill_pool_account_if_possible`.
 *      DEPOSIT      escrow for native staking principal only. Staked CHR is transferred
 *                   in by `economy_chain_staking`, and back out on withdrawal. No reward
 *                   is ever paid out of it, and it is not treasury money -- it belongs to
 *                   the stakers.
 *      FOUNDATION   Chromia Foundation treasury. Receives the foundation fee share each
 *                   reward round; paid out again only by governance proposal.
 *
 * Every system account id is derived as `(<type name> + blockchain_rid).hash()`, so it is
 * deterministic per chain and needs no registry.
 */

/**
 * Create a provider's own CHR account, if it does not already have one.
 *
 * Called only from `receive_provider_update_message`
 * (`economy_chain_directory_chain_sync.rell`) when a provider synced from the directory
 * chain over ICMF is seen for the first time. The provider record is DC's; the account is
 * created here.
 *
 * Unlike the system accounts below this one IS user-controlled: it gets a single-signature
 * auth descriptor over `provider.pubkey` with the "A" and "T" flags, so the provider can
 * transfer out of it. `provider_account` and `provider_staking_account` are both pointed at
 * the same underlying account -- reward payouts and staking share one balance.
 */
function register_provider_account(provider) {

    if (provider_account @? { provider } == null) {

        val auth_descriptor = ft4.accounts.single_sig_auth_descriptor(provider.pubkey, set(["A", "T"]));
        val account = ft4.accounts.create_account_with_auth(auth_descriptor);

        create provider_account(provider, account);
        create provider_staking_account(provider, account);

        _add_provider_key(provider.pubkey, provider.pubkey);
    }
}

/**
 * Get balance of the account.
 */
query get_balance(account_id: byte_array): big_integer {
    val account = ft4.accounts.Account(account_id);
    return get_account_balance(account);
}

function get_account_balance(ft4.accounts.account): big_integer =
        (ft4.assets.balance @? { account, get_asset() }.amount) ?: 0L;

/**
 * Get information about the CHR asset.
 */
query get_chr_asset() = ft4.assets.map_asset(get_asset());

function get_asset(): ft4.assets.asset {
    val asset_id = (chain_context.args.asset_name, chain_context.blockchain_rid).hash();
    return ft4.assets.asset @ { .id == asset_id };
}

/**
 * REWARD_POOL -- the account CHR is minted into and every reward is paid from.
 *
 * Created without an auth descriptor, so no key can move its funds; only protocol code can,
 * via `Unsafe.transfer`. Funded by container lease payments and by minting
 * (`refill_pool_account_if_possible`), and drained by provider rewards, the foundation fee
 * share, and staking rewards.
 */
val pool_account_type = "REWARD_POOL";

function create_pool_account() =
    ft4.accounts.create_account_without_auth(get_pool_account_id(), pool_account_type);

query get_pool_balance(): big_integer = get_account_balance(get_pool_account());

function get_pool_account() = ft4.accounts.account_by_id(get_pool_account_id());

query get_pool_account_id_query() = get_pool_account_id();

function get_pool_account_id() = (pool_account_type + chain_context.blockchain_rid).hash();


/**
 * DEPOSIT -- escrow holding native staking principal, and nothing else.
 *
 * Stakers' CHR is transferred in when they stake and back out when they withdraw, after
 * `staking_withdrawal_delay_ms`. Do not confuse this with treasury: the balance belongs to
 * the stakers, and no reward is ever paid out of it -- staking rewards come from
 * REWARD_POOL. Its balance therefore equals the total native stake.
 */
val deposit_account_type = "DEPOSIT";

function create_deposit_account() =
    ft4.accounts.create_account_without_auth(get_deposit_account_id(), deposit_account_type);

function get_deposit_account() = ft4.accounts.account_by_id(get_deposit_account_id());

function get_deposit_account_id() = (deposit_account_type + chain_context.blockchain_rid).hash();


/**
 * FOUNDATION -- the Chromia Foundation treasury.
 *
 * Credited once per reward round with `chromia_foundation_fee_share` of notional cluster
 * revenue. Unlike provider rewards that credit is not scaled by node availability and is
 * not gated by staking requirements. Funds leave only through the
 * `transfer_chromia_foundation_funds` governance proposal.
 */
val foundation_account_type = "FOUNDATION";

function create_chromia_foundation_account() =
    ft4.accounts.create_account_without_auth(get_chromia_foundation_account_id(), foundation_account_type);

function get_chromia_foundation_account() = ft4.accounts.account_by_id(get_chromia_foundation_account_id());

function get_chromia_foundation_account_id() = (foundation_account_type + chain_context.blockchain_rid).hash();


/**
 * Register the CHR asset itself. Called once, from `init()`.
 */
function register_assets() {
    return ft4.assets.Unsafe.register_asset(
        chain_context.args.asset_name,
        chain_context.args.asset_symbol,
        chain_context.args.asset_decimals,
        chain_context.blockchain_rid,
        chain_context.args.asset_icon
    );
}

/**
 * Mint `pool_amount_to_mint` CHR into REWARD_POOL, if the rate limit allows it.
 *
 * This is one of only two places CHR is created on this chain -- the other being the
 * `propose_minting` governance path. It is called lazily from the reward and staking payout
 * paths whenever the pool cannot cover what it owes, so minting is demand-driven rather
 * than scheduled.
 *
 * Two behaviours worth knowing before relying on this:
 *
 * - When the rate limit has not yet elapsed it LOGS AND RETURNS NORMALLY. It does not throw,
 *   so a caller cannot distinguish "refilled" from "refused" by control flow -- only by
 *   comparing the returned balance against what it needs.
 * - Nothing here, or anywhere in the mint path, compares total supply against any maximum.
 *   The only ceiling is FT4's `max_asset_amount` (2^256-1). Any published "max supply"
 *   figure is off-chain metadata and is not enforced by this function.
 *
 * @return the pool balance after the attempt, refilled or not
 */
function refill_pool_account_if_possible() {
    val pool = get_pool_account();
    if (pool_details.last_refill_millis + chain_context.args.pool_refill_limit_ms > op_context.last_block_time) {
        log("Pool account have already claimed %s %s within the last %s millis.".format(
            chain_context.args.pool_amount_to_mint,
            chain_context.args.asset_symbol,
            chain_context.args.pool_refill_limit_ms));
    } else {
        // Clamp to whatever headroom the supply cap leaves. Deliberately does not throw: this
        // runs inside ICMF reward processing, where a throw would abort the whole round.
        val amount = min(chain_context.args.pool_amount_to_mint, remaining_mintable_chr());
        if (amount <= 0) {
            log("Cannot mint to pool account: CHR total supply has reached max_total_supply %s."
                .format(get_max_total_supply()));
        } else {
            if (amount < chain_context.args.pool_amount_to_mint) {
                log("Clamping pool refill from %s to %s %s: only that much headroom remains under max_total_supply %s."
                    .format(chain_context.args.pool_amount_to_mint, amount, chain_context.args.asset_symbol, get_max_total_supply()));
            }
            log("Mint %s %s to pool account.".format(amount, chain_context.args.asset_symbol));
            ft4.assets.Unsafe.mint(pool, get_asset(), amount);
            pool_details.last_refill_millis = op_context.last_block_time;
        }
    }
    return get_account_balance(pool);
}

/**
 * Ids of the system accounts, for off-chain consumers that cannot derive them.
 *
 * NOTE: this returns only REWARD_POOL and FOUNDATION -- DEPOSIT is missing, so anything
 * computing circulating supply from this query will not see the staking escrow. Use
 * `ft4.get_accounts_by_type("DEPOSIT")` for that one.
 */
query get_ft4_account_ids() {
    return [
        "pool_account_id": get_pool_account().id,
        "chromia_foundation_account_id": get_chromia_foundation_account().id
    ];
}
