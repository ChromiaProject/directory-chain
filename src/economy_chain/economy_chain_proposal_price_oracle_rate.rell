entity pending_price_oracle_rate {
    key proposal: common_proposal, symbol: text;
    name: text;
    price: decimal;
}

struct pending_price_oracle_rate_data {
    symbol: text;
    name: text? = null;
    price: decimal;
}

@extend(apply_common_voting_result_handlers) function() = [common_proposal_type.ec_price_oracle_rate.name: apply_ec_pending_price_oracle_rate(*)];
@extend(delete_common_proposal_handlers) function(): map<text, (common_proposal) -> unit> = [common_proposal_type.ec_price_oracle_rate.name: cleanup_ec_pending_price_oracle_rate(*)];

operation propose_price_oracle_rate(rates: list<pending_price_oracle_rate_data>) {

    val provider = require_system_provider_signer_entity();
    val proposal = create common_proposal(
        op_context.last_block_time,
        common_proposal_type.ec_price_oracle_rate,
        provider.pubkey,
        system_p_voter_set(),
        "Update price oracle rates");

    for (rate_update in rates) {
        create pending_price_oracle_rate(
            proposal,
            symbol = rate_update.symbol,
            name = rate_update.name ?: "",
            rate_update.price,
        );
    }
    validate_ec_price_oracle_rate_proposal(proposal);

    internal_common_vote(proposal.proposed_by, proposal, true);
}

query get_price_oracle_rate_proposal(proposal_id: rowid) {

    val proposal = require_common_proposal(proposal_id);
    val rates = pending_price_oracle_rate @* { proposal } (.symbol, .name, .price);

    require(not(empty(rates)), "Proposal %s is not of type price oracle update".format(proposal_id));

    val result = list<pending_price_oracle_rate_data>();
    for (rate in rates) {
        result.add(pending_price_oracle_rate_data(
            symbol = rate.symbol,
            name = if (rate.name.empty()) null else rate.name,
            price = rate.price));
    }

    return result;
}

function apply_ec_pending_price_oracle_rate(proposal: common_proposal) {

    val pending_rates = pending_price_oracle_rate @* { proposal };

    log("Apply price oracle rate proposal %d".format(proposal.rowid));

    for (rate in pending_rates) {
        set_token_rate(rate.symbol, rate.name, rate.price);
    }
}

function cleanup_ec_pending_price_oracle_rate(proposal: common_proposal) {

    log("Cleaning up pending price oracle rate update");

    delete pending_price_oracle_rate @* { proposal };
}

function validate_ec_price_oracle_rate_proposal(proposal: common_proposal) {

    val rates = pending_price_oracle_rate @* { proposal } ( .symbol, .name, .price );
    require(not(empty(rates)), "Proposal has no symbol rates");
    
    for (rate in rates) {
        require(rate.symbol.empty() == false, "Symbol %s can't be empty".format(rate.symbol));
        require(rate.price > 0, "Price for %s must be positive".format(rate.symbol));
        if (rate.name.empty()) {
            require(price_oracle_rates @? { .symbol == rate.symbol }, "Name is required for new tokens");
        }
    }
}
