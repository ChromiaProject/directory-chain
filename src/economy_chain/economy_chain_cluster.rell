/**
 * Returns information for clusters, including any active special subnode images supported by the cluster.
 */
query get_clusters(): list<cluster_data> {
    val counts = map(cluster_node @* {} (@group .cluster, @sum 1));
    return (cluster, @outer cluster_subnode_image @* { .cluster == cluster, .subnode_image.active }) @* {} (
        @group name = .name,
        @group is_operational = .operational,
        @group cluster_units = .cluster_units,
        @group extra_storage = .extra_storage,
        @group tag_name = .tag.name,
        @list subnode_images = cluster_subnode_image?.subnode_image?.name,
        @group number_of_nodes = counts.get_or_default(cluster, 0),
    ) @* {} (cluster_data(
        name = .name,
        is_operational = .is_operational,
        cluster_units = .cluster_units,
        extra_storage = .extra_storage,
        tag_name = .tag_name,
        subnode_images = .subnode_images @* { $ != null } ($!!),
        number_of_nodes = .number_of_nodes,
   ));
}

/**
 * Returns information for a specified cluster, including any active special subnode images supported by the cluster.
 */
query get_cluster_by_name(name): cluster_data? {
    val cluster = cluster @? { name };
    if (cluster == null) return null;
    return cluster_data(
        name = cluster.name,
        is_operational = cluster.operational,
        cluster_units = cluster.cluster_units,
        extra_storage = cluster.extra_storage,
        tag_name = cluster.tag.name,
        subnode_images = cluster_subnode_image @* { cluster, .subnode_image.active } (.subnode_image.name),
        number_of_nodes = cluster_node @ { cluster } ( @sum 1 ),
    );
}

/**
 * See if the cluster was created successfully, is still pending, or failed to be created.
 * If the cluster does not exist, the creation status will be unknown.
 */
query get_cluster_creation_status(name): cluster_creation_status {
    var status = cluster_creation_status.SUCCESS;
    val cluster = cluster @? { name };
    if (cluster == null) {
        val pending_cluster = pending_cluster @? { name };
        if (pending_cluster == null) {
            status = cluster_creation_status.UNKNOWN;
        } else if (pending_cluster.status == pending_cluster_status.PENDING_APPROVAL) {
            status = cluster_creation_status.PENDING_APPROVAL;
        } else if (pending_cluster.status == pending_cluster_status.PENDING_CREATION) {
            status = cluster_creation_status.PENDING_CREATION;
        } else if (pending_cluster.status == pending_cluster_status.FAILURE) {
            status = cluster_creation_status.FAILURE;
        }
    }
    return status;
}

function receive_create_cluster_error_message(body: gtv) {
    val create_cluster_error_message = create_cluster_error_message.from_gtv(body);
    val pending_cluster = pending_cluster @ { .name == create_cluster_error_message.name };
    pending_cluster.status = pending_cluster_status.FAILURE;
}
