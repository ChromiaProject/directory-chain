namespace voter_sets {
    val system_p = "SYSTEM_P";
    val chromia_foundation = "CHROMIA_FOUNDATION";
}

function system_p_voter_set() = common_voter_set @ { voter_sets.system_p };
function require_mint_chr_voter_set() = require_common_voter_set(voter_sets.chromia_foundation);
function require_chromia_foundation_voter_set() = require_common_voter_set(voter_sets.chromia_foundation);

@extend(validate_voter_set_proposal) function common_voter_set_update_allowed_ec(pending_proposal: voter_set_update.pending_proposal) {
    require(pending_proposal.voter_set.name != voter_sets.system_p, "Cannot update system voter set. Update this by proposing system provider role");
}
