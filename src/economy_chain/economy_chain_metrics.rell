/**
 * Return provider performance metrics.
 *
 * @param pubkey  provider pubkey
 * @param start  collect metrics from this time
 */
query get_provider_performance_metrics(pubkey, start: timestamp): provider_performance_metrics {
    val provider = require_provider(pubkey);

    val availabilities = get_provider_availabilities(provider, start);
    val payed_rewards = get_provider_payed_rewards(provider, start);

    return provider_performance_metrics(
        availabilities,
        payed_rewards
    );
}

/**
 * Return provider performance metrics over the last 7 days.
 *
 * @param pubkey  provider pubkey
 */
query get_provider_performance_metrics_last_7_days(pubkey): provider_performance_metrics {
    return get_provider_performance_metrics(pubkey, get_last_blocktime() - millis_per_week);
}

/**
 * Return provider performance metrics over the last 30 days.
 *
 * @param pubkey  provider pubkey
 */
query get_provider_performance_metrics_last_30_days(pubkey): provider_performance_metrics {
    return get_provider_performance_metrics(pubkey, get_last_blocktime() - millis_per_month);
}

/**
 * Return provider performance metrics over the last 365 days.
 *
 * @param pubkey  provider pubkey
 */
query get_provider_performance_metrics_last_365_days(pubkey): provider_performance_metrics {
    return get_provider_performance_metrics(pubkey, get_last_blocktime() - millis_per_year);
}

/**
 * Return economy metrics.
 *
 * @param pubkey  provider pubkey
 */
query get_economy_metrics(pubkey): economy_metrics {
    val provider = require_provider(pubkey);
    val provider_nodes = node @* { provider };

    val provider_availabilities = get_provider_availabilities(provider, get_last_blocktime() - millis_per_day);
    val average_availability_on_a_providers_nodes = provider_availabilities @ {} ( @sum .availability ) / provider_availabilities.size();
    val total_number_of_nodes_per_provider = provider_nodes.size();
    val total_number_of_scus_per_provider = get_total_number_of_scus_per_provider(provider_nodes);
    val average_occupancy_rate_of_a_providers_scus = get_average_occupancy_rate_of_a_providers_scus(provider_nodes);
    val amount_of_the_last_reward_payout = get_total_provider_reward_payed_in_the_last_24h(provider);

    return economy_metrics(
        average_availability_on_a_providers_nodes,
        total_number_of_nodes_per_provider,
        total_number_of_scus_per_provider,
        average_occupancy_rate_of_a_providers_scus,
        amount_of_the_last_reward_payout
    );
}

/**
 * Get economy details for a specific node.
 * 
 * @param pubkey The nodes pubkey
 */
query get_economy_metrics_per_node(pubkey): economy_node_metrics {
    val node = require_node(pubkey);
    return get_economy_metrics_per_node_internal(node);
}

/**
 * Get economy metrics for all provider nodes.
 * 
 * @param pubkey The providers pubkey.
 */
query get_economy_metrics_per_provider_nodes(pubkey): list<economy_node_metrics> {
    val provider = require_provider(pubkey);
    val provider_nodes = node @* { provider };
    val result = list<economy_node_metrics>();

    for (node in provider_nodes) {
        result.add(get_economy_metrics_per_node_internal(node));
    }

    return result;
}

function get_economy_metrics_per_node_internal(node): economy_node_metrics {
    return economy_node_metrics(
        node_pubkey = node.pubkey,
        availability = get_average_availability_on_a_provider_nodes_in_the_last_24h(["" : set<pubkey>([node.pubkey])]),
        amount_of_the_last_reward_payout = get_total_node_reward_payed_in_the_last_24h(node.pubkey),
        signing_clusters = cluster_node @* { node } ( .cluster.name ),
        replicating_clusters = cluster_replica_node @* { node } ( .cluster.name ),
    );
}

function get_average_availability_on_a_provider_nodes_in_the_last_24h(cluster_nodes: map<text, set<pubkey>>): decimal {
    val provider_availabilities = get_provider_node_availabilities(cluster_nodes, get_last_blocktime() - millis_per_day);
    val number_of_availabilities = provider_availabilities.size();
    var total_availability = 0.0;
    for (availability in provider_availabilities) {
        total_availability += availability.availability;
    }
    return if (number_of_availabilities != 0) total_availability / number_of_availabilities else 0.0;
}

/** Return all nodes for a provider grouped by cluster. This includes active, inactive and deleted nodes, but not existing nodes without a cluster */
function get_all_provider_nodes_by_cluster(provider) {
    val all_nodes = cluster_node @* { cluster_node.node.provider == provider } ( cluster = cluster_node.cluster.name, node = cluster_node.node.pubkey );
    all_nodes.add_all(reward_provider_deleted_node @* { provider } ( cluster = .cluster.name, node = .node ));
    return all_nodes @* { } ( @group .cluster, @set .node ) @ { } ( @map $ );
}

/** Return all provider nodes, even deleted ones */
function get_all_provider_node(provider) {
    val all_nodes = cluster_node @* { cluster_node.node.provider == provider } ( cluster_node.node.pubkey );
    all_nodes.add_all(reward_provider_deleted_node @* { provider } ( .node ));
    return all_nodes;
}

/** Get availability for a provider including all nodes (active and deleted) */
function get_provider_availabilities(provider, start: timestamp): list<provider_availability> {
    val cluster_nodes = get_all_provider_nodes_by_cluster(provider);
    return get_provider_node_availabilities(cluster_nodes, start);
}

/**
 * Get availability for given nodes.
 * @param cluster_nodes A list of nodes, grouped (key) by cluster. Availability for a group of nodes in a cluster is aggregated.
 */
function get_provider_node_availabilities(cluster_nodes: map<text, set<pubkey>>, start: timestamp) {
    val all_nodes = set<byte_array>();
    for (cluster_node_value in cluster_nodes.values()) {
       all_nodes.add_all(cluster_node_value);
    }

    // Group availability per day and node.
    val availabilities = node_availability @* { .node in all_nodes  and .end_time >= start }
        ( node = .node, start_time = .start_time, availability = .availability);
    var days_to_availabilities = map<integer, list<(node: pubkey, availability: decimal)>>();
    for (node_availability in availabilities) {
        val day = (node_availability.start_time - start) / millis_per_day;
        val node_day_availability = (node = node_availability.node, availability = node_availability.availability);
        if (days_to_availabilities.contains(day)) {
            days_to_availabilities[day].add(node_day_availability);
        } else {
            days_to_availabilities[day] = [node_day_availability];
        }
    }

    // Calculate average daily availability (clusters with multiple)
    val result = list<provider_availability>();
    for ((day, node_day_availabilities) in days_to_availabilities) {

        // This is to deal with node replacement within a cluster. Sum all nodes availability per cluster, and then get the average.
        val cluster_availability = map<text, decimal>();
        for (node_availabilities in node_day_availabilities) {
            for ((cluster, cluster_node_list) in cluster_nodes) {
                if (cluster_node_list.contains(node_availabilities.node)) {
                    val sum = cluster_availability.get_or_null(cluster) ?: 0.0;
                    cluster_availability[cluster] = sum + node_availabilities.availability;
                    break;
                }
            }
        }


        val provider_availability_average = cluster_availability.values() @ {} (@sum $) / cluster_availability.size();
        result.add(
            provider_availability(
                availability = provider_availability_average,
                start_time = start + day * millis_per_day,
                end_time = start + (day + 1) * millis_per_day - 1
            )
        );
    }
    return result;
}

/**
 * Return a sum of the total number of SCUs available in all nodes dapp clusters,
 * excluding the units allocated by system.
 */
function get_total_number_of_scus_per_provider(provider_nodes: list<node>): integer {

    var total_cluster_units = 0;
    val clusters = cluster_node @* { .node in provider_nodes, .cluster.name != system_cluster_name } ( .cluster.cluster_units );
    for (cluster_units in clusters) {
        total_cluster_units += total_available_scus(cluster_units);
    }
    return total_cluster_units - (clusters.size() * standard_cluster_unit.system_container_units);
}

// Based on leasable scus
function get_occupied_nodes_scus(nodes: list<node>): integer {
    val node_dapp_clusters = cluster_node @* { .node in nodes, .cluster.name != system_cluster_name } ( .cluster );
    var scus_occupied = 0;
    for (dapp_cluster in node_dapp_clusters) {
        scus_occupied += occupied_scus(dapp_cluster);
    }
    return scus_occupied;
}

// Based on leasable scus
function get_occupied_node_cluster_scus(node, cluster): integer? {
    val node_cluster = cluster_node @? { node, cluster, .cluster.name != system_cluster_name } ( .cluster );
    return if (not empty(node_cluster)) occupied_scus(node_cluster) else null;
}

// This is the rate of leasable scus
function get_average_occupancy_rate_of_a_providers_scus(provider_nodes: list<node>): decimal {
    val scus_total = get_total_number_of_scus_per_provider(provider_nodes);
    val scus_occupied = get_occupied_nodes_scus(provider_nodes);
    return if (scus_total > 0) decimal(scus_occupied) / scus_total else 0;
}

function get_total_node_reward_payed_in_the_last_24h(node: pubkey) {
    return sum_payed_rewards(get_nodes_payed_rewards([node], get_last_blocktime() - millis_per_day));
}

function get_total_provider_reward_payed_in_the_last_24h(provider) {
    return sum_payed_rewards(get_provider_payed_rewards(provider, get_last_blocktime() - millis_per_day));
}

function sum_payed_rewards(rewards: list<provider_payed_reward>) {
    var total_reward = 0L;
    for (reward in rewards) {
        total_reward += reward.value;
    }
    return total_reward;
}

function get_provider_payed_rewards(provider, start: timestamp): list<provider_payed_reward> {
    val provider_cluster_nodes = get_all_provider_node(provider);
    return get_nodes_payed_rewards(provider_cluster_nodes, start);
}

function get_nodes_payed_rewards(nodes: list<pubkey>, start: timestamp): list<provider_payed_reward> {
    return node_payed_reward @* { .node in nodes and .time >= start }
        ( @omit @sort .time, provider_payed_reward(.time, .value) );
}
