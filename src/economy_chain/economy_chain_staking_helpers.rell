function _staking_cannot_change_before(): timestamp = _staking_last_known_time() + chain_context.args.staking_delegation_delay_ms;

// As per https://learn.chromia.com/courses/latest-known-time
function _staking_last_known_time() 
    = if (op_context.exists) op_context.last_block_time else block @ {} (@max .timestamp) ?: 0;

function get_null_account(): pubkey {
    return "NULL".hash();
}

struct account_staking_balance {
    account: byte_array;
    balance: integer;
}

function get_paginated_accounts_with_native_stake(page_size: integer?, page_cursor: text?) {
    val before_rowid = ft4.utils.before_rowid(page_cursor);
    return staker_state @* {
        .network == network.CHR,
        .rowid > (before_rowid ?: rowid(0))
    } (
        ft4.utils.pagination_result(
            data = account_staking_balance( 
                account = .account.id,
                balance = .balance
            ).to_gtv(),
            rowid = .rowid
        )
    ) limit ft4.utils.fetch_data_size(page_size);
}