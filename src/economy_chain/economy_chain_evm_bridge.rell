object bridge_mode_conversion {
	mutable active: boolean = true;
}

struct evm_bridge {
	network_id: integer;
	asset_address: byte_array;
	bridge_address: byte_array;
}

function register_and_link_bridge_and_erc20_asset(ft4.assets.asset) {
	val bridges = list<evm_bridge>.from_gtv_pretty(chain_context.args.evm_bridges);
	for (bridge in bridges) {
		val existing_bridge_asset = eif.hbridge.erc20_asset @? {
			asset,
			.network_id == bridge.network_id,
			.token_address == bridge.asset_address
		};
		if (empty(existing_bridge_asset)) {
			eif.hbridge.register_bridge_and_erc20_asset(
					bridge.network_id,
					bridge.asset_address,
					asset,
					//Should be native for mainnet
					eif.hbridge.bridge_mode.foreign,
					bridge_address = bridge.bridge_address
				);
		} else {
			val existing_bridge = eif.hbridge.bridge_erc20_asset @? {
				existing_bridge_asset
			};
			if (exists(existing_bridge) and existing_bridge.bridge_contract.contract_address != bridge.bridge_address) {
				log("New bridge contract detected for network id %s. Replacing existing contract.".format(bridge.network_id));
				eif.hbridge.register_bridge_with_erc20_assets(
					bridge.network_id,
					bridge.bridge_address,
					[existing_bridge_asset]
				);

				// Clean up old bridge
				val existing_bridge_contract = existing_bridge.bridge_contract;
				delete existing_bridge;
				delete existing_bridge_contract;
			}
		}

		val obsolete_bridge_assets = eif.hbridge.erc20_asset @* {
			asset,
			.network_id == bridge.network_id,
			.token_address != bridge.asset_address
		};
		// It's not safe to delete obsolete assets but we can remove any bridges that are connected to it
		for (obsolete_asset in obsolete_bridge_assets) {
			val obsolete_bridge = eif.hbridge.bridge_erc20_asset @? {
				obsolete_asset
			};

			if (exists(obsolete_bridge)) {
				// Clean up obsolete bridge
				log("Removing obsolete bridge for asset with address %s".format(obsolete_asset.token_address));
				val obsolete_bridge_contract = obsolete_bridge.bridge_contract;
				delete obsolete_bridge;
				delete obsolete_bridge_contract;
			}
		}
	}
}

struct evm_supply {
	network_id: integer;
	total_supply: big_integer;
	timestamp: timestamp;
}

function convert_bridge_mode() {
	val supplies = list<evm_supply>.from_gtv_pretty(chain_context.args.evm_supplies);
	val erc20_assets = eif.hbridge.erc20_asset @* { get_asset() };
	for (erc20_asset in erc20_assets) {
		log("Converting bridge mode for chain id %s".format(erc20_asset.network_id));
		erc20_asset.bridge_mode = eif.hbridge.bridge_mode.native;
		val supply = supplies @? { .network_id == erc20_asset.network_id };
		if (empty(supply)) {
			log("No supply found for network id ", erc20_asset.network_id);
			continue;
		}
		val bridge_account = eif.hbridge.ensure_bridge_account(erc20_asset.virtual_blockchain_rid);

		val pending_withdrawals = eif.hbridge.erc20_withdrawal_status @ {
			.erc20_withdrawal.network_id == supply!!.network_id,
			.erc20_withdrawal.transaction.block.timestamp <= supply!!.timestamp,
			.withdrawal_status not in [eif.hbridge.withdrawal_status.withdrawn, eif.hbridge.withdrawal_status.withdrawn_to_chromia]
		} (
			@sum .erc20_withdrawal.amount
		);

		val new_withdrawals = eif.hbridge.erc20_withdrawal @ {
			.network_id == supply.network_id,
			.transaction.block.timestamp > supply.timestamp,
		} (
			@sum .amount
		);

		val new_deposits = eif.hbridge.erc20_deposit @ {
			.network_id == supply.network_id,
			.last_updated > supply.timestamp,
		} (
			@sum .amount
		);

		val mint_amount = supply.total_supply + pending_withdrawals + new_withdrawals - new_deposits;
		ft4.assets.Unsafe.mint(bridge_account, erc20_asset.asset, mint_amount);
		log("Minted %s EVM balance for chain id %s".format(mint_amount, erc20_asset.network_id));
	}
}

function __bridge_mode_begin_block() {
	if (bridge_mode_conversion.active == false) return;
	convert_bridge_mode();
	bridge_mode_conversion.active = false;
}

/**
 * Update the EVM supply for a given network id and token address. Must be called by the supply admin.
 * 
 * @param network_id The network id of the EVM chain.
 * @param token_address The address of the ERC20 token.
 * @param delta The amount to update the supply by.
 * @param mint Whether to mint or burn the supply.
 */
operation update_evm_supply(network_id: integer, token_address: byte_array, delta: big_integer, mint: boolean) {
	require(op_context.is_signer(chain_context.args.evm_supply_admin), "Only the supply admin can update the supply");
	val id = eif.hbridge.erc20_asset @? { .network_id == network_id, .token_address == token_address } (.virtual_blockchain_rid);
	val account = require(ft4.accounts.account @? { .id == id }, "Bridge account not found");

	if (mint) {
		ft4.assets.Unsafe.mint(account, get_asset(), delta);
	} else {
		ft4.assets.Unsafe.burn(account, get_asset(), delta);
	}
}