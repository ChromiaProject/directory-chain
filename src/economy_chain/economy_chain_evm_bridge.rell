struct evm_bridge {
	network_id: integer;
	asset_address: byte_array;
	bridge_address: byte_array;
}

function register_and_link_bridge_and_erc20_asset(ft4.assets.asset) {
	val bridges = list<evm_bridge>.from_gtv_pretty(chain_context.args.evm_bridges);
	for (bridge in bridges) {
		val existing_bridge_asset = eif.hbridge.erc20_asset @? {
			asset,
			.network_id == bridge.network_id,
			.token_address == bridge.asset_address
		};
		if (empty(existing_bridge_asset)) {
			eif.hbridge.register_bridge_and_erc20_asset(
					bridge.network_id,
					bridge.asset_address,
					asset,
					//Should be native for mainnet
					eif.hbridge.bridge_mode.foreign,
					bridge_address = bridge.bridge_address
				);
		} else {
			val existing_bridge = eif.hbridge.bridge_erc20_asset @? {
				existing_bridge_asset
			};
			if (exists(existing_bridge) and existing_bridge.bridge_contract.contract_address != bridge.bridge_address) {
				log("New bridge contract detected for network id %s. Replacing existing contract.".format(bridge.network_id));
				eif.hbridge.register_bridge_with_erc20_assets(
					bridge.network_id,
					bridge.bridge_address,
					[existing_bridge_asset]
				);

				// Clean up old bridge
				val existing_bridge_contract = existing_bridge.bridge_contract;
				delete existing_bridge;
				delete existing_bridge_contract;
			}
		}

		val obsolete_bridge_assets = eif.hbridge.erc20_asset @* {
			asset,
			.network_id == bridge.network_id,
			.token_address != bridge.asset_address
		};
		// It's not safe to delete obsolete assets but we can remove any bridges that are connected to it
		for (obsolete_asset in obsolete_bridge_assets) {
			val obsolete_bridge = eif.hbridge.bridge_erc20_asset @? {
				obsolete_asset
			};

			if (exists(obsolete_bridge)) {
				// Clean up obsolete bridge
				log("Removing obsolete bridge for asset with address %s".format(obsolete_asset.token_address));
				val obsolete_bridge_contract = obsolete_bridge.bridge_contract;
				delete obsolete_bridge;
				delete obsolete_bridge_contract;
			}
		}
	}
}