object pending_evm_links {
	mutable add: boolean = true;
}

struct evm_bridge {
	network_id: integer;
	asset_address: byte_array;
	bridge_address: byte_array;
}

function register_and_link_bridge_and_erc20_asset(ft4.assets.asset) {
	val bridges = list<evm_bridge>.from_gtv_pretty(chain_context.args.evm_bridges);
	for (bridge in bridges) {
		val existing_bridge_asset = eif.hbridge.get_erc20_for_asset(asset.id) @? {
			.network_id == bridge.network_id,
			.token_address == bridge.asset_address
		};
		if (empty(existing_bridge_asset)) {
			eif.hbridge.register_bridge_and_erc20_asset(
					bridge.network_id,
					bridge.asset_address,
					asset,
					//Should be native for mainnet
					eif.hbridge.bridge_mode.foreign,
					bridge_address = bridge.bridge_address
				);
		}
	}
}

function __evm_links_begin_block() {
	if (pending_evm_links.add == false) return;
	add_missing_evm_links();
	pending_evm_links.add = false;
}

function add_missing_evm_links() {
	val new_links = ( ads: ft4.accounts.auth_descriptor_signer, mad: ft4.accounts.main_auth_descriptor) @* {
		ads.id.size() == 20 //ensure signer is an EVM address
		and ads.account_auth_descriptor == mad.auth_descriptor //ensure signer is for a main AD
		and empty ( // filter out accounts that already has a link
			(e: eif.hbridge.evm_eoa_account_link) @* {
				e.account == mad.account
			}
		)
	} ( struct<eif.hbridge.evm_eoa_account_link> (address = ads.id, account = mad.account) );

	create eif.hbridge.evm_eoa_account_link ( new_links );
	log("Added %s missing evm links.".format(new_links.size()));
}
