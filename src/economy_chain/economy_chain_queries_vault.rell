
struct dapp_details_blockchain {
    name: text;
    brid: byte_array;
    role: text;
}

struct dapp_media {
    name: text;
    url: text;
    type: dapp_content_type;
}

enum dapp_content_type {
    landscape,
    portrait,
    promotional,
    video,
    icon
}

query find_dapp_details(dapp_rowid: rowid, requested_content_types: list<dapp_content_type>? = null) {
    return (
        rowid = dapp_rowid,
        name = "Chromia Economy Chain",
        description = "Economy chain handles native CHR payments, container leases and provider rewards",
        launch_url = null,
        genre = "System Chain",
        chain_list = [dapp_details_blockchain(
            name = "Chromia Economy Chain",
            brid = chain_context.blockchain_rid,
            role = ""
        )],
        content = get_dapp_media(requested_content_types),
    ).to_gtv_pretty();
}

function get_dapp_media(requested_content_types: list<dapp_content_type>? = null): list<dapp_media>? {

    val ec_media: map<dapp_content_type, dapp_media> = [
        dapp_content_type.icon: dapp_media(name = "icon1", url = "https://assets.chromia.com/chr.png", dapp_content_type.icon),
        dapp_content_type.landscape: dapp_media(name = "landscape1", url = "https://assets.chromia.com/chr-1000.png", dapp_content_type.landscape),
        dapp_content_type.portrait: dapp_media(name = "portrait1", url = "https://assets.chromia.com/chr-1000.png", dapp_content_type.portrait),
        dapp_content_type.promotional: dapp_media(name = "promotional1", url = "https://assets.chromia.com/chr-1000.png", dapp_content_type.promotional),
    ];

    if (not empty(requested_content_types)) {

        val media = list<dapp_media>();

        for (type_requested in requested_content_types) {
            if (ec_media.contains(type_requested)) {
                media.add(ec_media[type_requested]);
            }
        }

        return if (media.size() > 0) media else null;
    }

    return null;
}
