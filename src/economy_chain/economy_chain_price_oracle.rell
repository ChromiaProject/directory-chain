function receive_price_oracle_update(sender: byte_array, body: gtv) {

    require(exists(sender_blockchain @? { .name == blockchains.price_oracle_chain_name, .rid == sender }),
        "Received price oracle message from sender: %s that is not tracked by economy chain.".format(sender));

    val message = decode_token_price_changed_body(body);

    handle_price_oracle_update(message.symbol, message.name, message.price, message.tvl ?: 1.0);
}

function handle_price_oracle_update(symbol: text, name, price: decimal, tvl: decimal) {
    require(price > 0, "Received incorrect rate from price oracle for %s (%s): %s".format(name, symbol, price));
    require(tvl > 0, "Received incorrect tvl from price oracle for %s (%s): %s".format(name, symbol, tvl));

    log("Received price oracle update for %s (%s): price=%s tvl=%s".format(name, symbol, price, tvl));

    val price_oracle_update = price_oracle_update @? { .symbol == symbol };
    if (price_oracle_update == null) {
        create price_oracle_update(symbol = symbol, name = name, price_tvl = price * tvl, tvl);
    } else {
        price_oracle_update.price_tvl += price * tvl;
        price_oracle_update.tvl += tvl;
    }
}

function price_oracle_updates_begin_block(current_time_millis: integer) {
    if (current_time_millis - price_oracle_update_state.last_update_millis > chain_context.args.token_rate_update_interval_ms) {
        log("Updating token rates");
        for (pou in price_oracle_update @* {}) {
            val average_price = pou.price_tvl / pou.tvl;
            set_token_rate(pou.symbol, pou.name, average_price);
            delete pou;
        }

        price_oracle_update_state.last_update_millis = current_time_millis;
    }
}

object price_oracle_update_state {
    mutable last_update_millis: integer = 0;
}

entity price_oracle_update {
    key symbol: text;
    name: text;
    mutable price_tvl: decimal;
    mutable tvl: decimal;
}

// All currencies stored as usd-per-crypto (the opposite to chr_per_usd constant)
entity price_oracle_rates {
    key symbol: text;
    name: text;
    mutable price: decimal;
}

struct price_oracle_rates_data {
    symbol: text;
    name: text;
    price: decimal;
}

function set_initial_token_rates() {

    // Set default values
    set_token_rate(chain_context.args.asset_symbol, "Chromia - USD per CHR", 1 / economy_constants.chr_per_usd);
    set_token_rate("ETH", "Ether - USD per ETH", 3375.0);
    set_token_rate("BNB", "Binance - USD per BNB", 575.0);
}

function set_token_rate(symbol: text, name, price: decimal) {

    if (price > 0) {

        upsert_price_oracle_rate_entity(name, symbol, price);

        if (symbol == chain_context.args.asset_symbol) {
            economy_constants.chr_per_usd = 1 / price;

            log("CHR per USD updated to: %s".format(economy_constants.chr_per_usd));
        }
    } else {
        log("Received incorrect rate from price oracle for %s (%s): %s".format(name, symbol, price));
    }
}

function upsert_price_oracle_rate_entity(name, symbol: text,  price: decimal) {

    val price_oracle_rates = price_oracle_rates @? { .symbol == symbol };

    if (price_oracle_rates == null) {
        create price_oracle_rates(symbol = symbol, name = name, price);
    } else {
        price_oracle_rates.price = price;
    }
}

query get_price_oracle_rates() {
    return price_oracle_rates @* {} (price_oracle_rates_data(.symbol, .name, .price));
}

function convert_token_rate(
    amount: big_integer,
    from_symbol: text,
    from_units: big_integer,
    to_symbol: text,
    to_units: big_integer
): big_integer? {

    val currency_to_price = map<text, decimal>(
        price_oracle_rates @* { .symbol in [from_symbol, to_symbol]} (.symbol, .price)
    );

    if (not currency_to_price.contains(from_symbol)) {
        log("Warning: Currency %s does not exists in price oracle.".format(from_symbol));
    } else if (not currency_to_price.contains(to_symbol)) {
        log("Warning: Currency %s does not exists in price oracle.".format(to_symbol));
    } else {

        val from_amount_decimal = decimal(amount) / from_units;

        val rate = currency_to_price[from_symbol] / currency_to_price[to_symbol];
        val to_amount = (from_amount_decimal * rate * to_units).to_big_integer();

        log("Converted %s %s to %s %s with rate %s".format(
            amount,
            from_symbol,
            to_amount,
            to_symbol,
            rate
        ));

        return to_amount;
    }

    return null;
}
