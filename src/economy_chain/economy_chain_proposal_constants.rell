entity pending_economy_constants {
    key proposal: common_proposal;
    min_lease_time_weeks: integer;
    max_lease_time_weeks: integer;
    staking_reward_rate: decimal;
    staking_reward_fee_share: decimal = 0.1; // Deprecated
    chromia_foundation_fee_share: decimal;
    resource_pool_margin_fee_share: decimal;
    dapp_provider_risk_share: decimal;
    scheduled_at: timestamp = 0;
}

@extend(apply_common_voting_result_handlers) function() = [common_proposal_type.ec_constants_update.name: apply_economy_constants(*)];
@extend(delete_common_proposal_handlers) function(): map<text, (common_proposal) -> unit> = [common_proposal_type.ec_constants_update.name: cleanup_pending_economy_constants(*)];

operation update_economy_constants(
    my_pubkey: pubkey,
    min_lease_time_weeks: integer?,
    max_lease_time_weeks: integer?,
    staking_reward_rate: decimal?,
    chromia_foundation_fee_share: decimal?,
    resource_pool_margin_fee_share: decimal?,
    dapp_provider_risk_share: decimal?,
    scheduled_at: timestamp? = null,
) {

    val provider = require_is_system_provider_and_signer(my_pubkey);
    require(scheduled_at == null or scheduled_at > get_last_blocktime(),
        "Scheduled time must be later than last block time (%s > %s)".format(scheduled_at, get_last_blocktime()));

    val proposal = create_system_p_proposal(common_proposal_type.ec_constants_update, provider, "Update economy constants");
    val proposal_details = create pending_economy_constants(
        proposal,
        min_lease_time_weeks = min_lease_time_weeks ?: -1,
        max_lease_time_weeks = max_lease_time_weeks ?: -1,
        staking_reward_rate = staking_reward_rate ?: -1.0,
        chromia_foundation_fee_share = chromia_foundation_fee_share ?: -1.0,
        resource_pool_margin_fee_share = resource_pool_margin_fee_share ?: -1.0,
        dapp_provider_risk_share = dapp_provider_risk_share ?: -1.0,
        scheduled_at = scheduled_at ?: 0,
    );
    validate_economy_constants_proposal(proposal_details);
    internal_common_vote(provider.pubkey, proposal, true);
}

function apply_economy_constants(proposal: common_proposal) {

    val pending_economy_constants = pending_economy_constants @ { proposal };
    validate_economy_constants_proposal(pending_economy_constants);

    log("Updating economy constants after approval of proposal %d".format(proposal.rowid));

    if (pending_economy_constants.min_lease_time_weeks >= 0) {
        economy_constants.min_lease_time_weeks = pending_economy_constants.min_lease_time_weeks;
    }
    if (pending_economy_constants.max_lease_time_weeks >= 0) {
        economy_constants.max_lease_time_weeks = pending_economy_constants.max_lease_time_weeks;
    }
    if (pending_economy_constants.staking_reward_rate >= 0) {
        economy_constants.staking_reward_rate = pending_economy_constants.staking_reward_rate;
    }
    if (pending_economy_constants.chromia_foundation_fee_share >= 0) {
        economy_constants.chromia_foundation_fee_share = pending_economy_constants.chromia_foundation_fee_share;
    }
    if (pending_economy_constants.resource_pool_margin_fee_share >= 0) {
        economy_constants.resource_pool_margin_fee_share = pending_economy_constants.resource_pool_margin_fee_share;
    }
    if (pending_economy_constants.dapp_provider_risk_share >= 0) {
        economy_constants.dapp_provider_risk_share = pending_economy_constants.dapp_provider_risk_share;
    }
}

function cleanup_pending_economy_constants(proposal: common_proposal) {

    log("Cleaning up pending_economy_constants");

    delete pending_economy_constants @ { proposal };
}

/**
 * @deprecated due to typo, use get_economy_constants_proposal()
 */
query get_econony_constants_proposal(proposal_id: rowid) =
    get_economy_constants_proposal(proposal_id);

query get_economy_constants_proposal(proposal_id: rowid) {

    val proposal = require_common_proposal(proposal_id);
    val pending_economy_constants = pending_economy_constants @ { proposal };

    return pending_economy_constants_data(
        min_lease_time_weeks = get_optional_proposal_int(pending_economy_constants.min_lease_time_weeks),
        max_lease_time_weeks = get_optional_proposal_int(pending_economy_constants.max_lease_time_weeks),
        staking_reward_rate = get_optional_proposal_decimal(pending_economy_constants.staking_reward_rate),
        chromia_foundation_fee_share = get_optional_proposal_decimal(pending_economy_constants.chromia_foundation_fee_share),
        resource_pool_margin_fee_share = get_optional_proposal_decimal(pending_economy_constants.resource_pool_margin_fee_share),
        dapp_provider_risk_share = get_optional_proposal_decimal(pending_economy_constants.dapp_provider_risk_share)
    );
}

function validate_economy_constants_proposal(proposal_details: pending_economy_constants) {

    require_only_pending_proposal_of_type(proposal_details.proposal);

    val min_lease_time_weeks_after_update = get_optional_proposal_int(proposal_details.min_lease_time_weeks) ?: economy_constants.min_lease_time_weeks;
    val max_lease_time_weeks_after_update = get_optional_proposal_int(proposal_details.max_lease_time_weeks) ?: economy_constants.max_lease_time_weeks;
    require_proposal_value_ge_1(min_lease_time_weeks_after_update, "Min lease time weeks");
    require_proposal_value_ge_1(max_lease_time_weeks_after_update, "Max lease time weeks");
    require(min_lease_time_weeks_after_update <= max_lease_time_weeks_after_update, "Min lease time weeks can't be more than max value");

    require_proposal_value_ge_0(proposal_details.staking_reward_rate, "Staking reward rate");
    require_ec_constant_share_value(proposal_details.staking_reward_fee_share, "Staking reward fee share");
    require_ec_constant_share_value(proposal_details.chromia_foundation_fee_share, "Chromia foundation fee share");
    require_ec_constant_share_value(proposal_details.resource_pool_margin_fee_share, "Resource pool margin fee share");
    require_ec_constant_share_value(proposal_details.dapp_provider_risk_share, "Dapp provider risk fee share");

    require_valid_ec_total_share(
        chromia_foundation_fee_share = get_optional_proposal_decimal(proposal_details.chromia_foundation_fee_share) ?: economy_constants.chromia_foundation_fee_share,
        resource_pool_margin_fee_share = get_optional_proposal_decimal(proposal_details.resource_pool_margin_fee_share) ?: economy_constants.resource_pool_margin_fee_share,
        dapp_provider_risk_share = get_optional_proposal_decimal(proposal_details.dapp_provider_risk_share) ?: economy_constants.dapp_provider_risk_share
    );
}

function require_proposal_value_ge_1(value: decimal, name: text) {
    if (value != -1) {
        require(value >= 1, name + " must be greater or equal to 1");
    }
}

function require_proposal_value_ge_0(value: decimal, name: text) {
    if (value != -1) {
        require(value >= 0, name + " must be greater or equal to 0");
    }
}

function require_ec_constant_share_value(value: decimal, name: text) {
    if (value != -1) {
        require(value >= 0 and value <= 1, name + " must be between 0 and 1");
    }
}

function require_valid_ec_total_share(
    system_provider_fee_share: decimal = economy_constants.system_provider_fee_share,
    chromia_foundation_fee_share: decimal = economy_constants.chromia_foundation_fee_share,
    resource_pool_margin_fee_share: decimal = economy_constants.resource_pool_margin_fee_share,
    system_provider_risk_share: decimal = economy_constants.system_provider_risk_share,
    dapp_provider_risk_share: decimal = economy_constants.dapp_provider_risk_share,
) {
    val sum = system_provider_fee_share +
        chromia_foundation_fee_share +
        resource_pool_margin_fee_share +
        system_provider_risk_share +
        dapp_provider_risk_share;

    require(sum >= 0 and sum <= 1.0, "The sum (%f) of all economy chain share values must be between 0 and 1.0 inclusive".format(sum));
}

/**
 * Get economy constants.
 */
query get_economy_constants(): economy_constants_data = economy_constants_data(
    min_lease_time_weeks = economy_constants.min_lease_time_weeks,
    max_lease_time_weeks = economy_constants.max_lease_time_weeks,
    chr_per_usd = economy_constants.chr_per_usd,
    total_cost_system_providers = economy_constants.total_cost_system_providers,
    system_provider_fee_share = economy_constants.system_provider_fee_share,
    staking_reward_rate = economy_constants.staking_reward_rate,
    chromia_foundation_fee_share = economy_constants.chromia_foundation_fee_share,
    resource_pool_margin_fee_share = economy_constants.resource_pool_margin_fee_share,
    system_provider_risk_share = economy_constants.system_provider_risk_share,
    dapp_provider_risk_share = economy_constants.dapp_provider_risk_share,
    staking_requirements_enabled = economy_constants.staking_requirements_enabled,
    staking_requirement_stop_payout_days = economy_constants.staking_requirement_stop_payout_days,
    staking_requirement_system_node_own_stake_chr = economy_constants.staking_requirement_system_node_own_stake_chr,
    staking_requirement_system_node_total_stake_chr = economy_constants.staking_requirement_system_node_total_stake_chr,
    staking_requirement_dapp_node_own_stake_chr = economy_constants.staking_requirement_dapp_node_own_stake_chr,
    staking_requirement_dapp_node_total_stake_chr = economy_constants.staking_requirement_dapp_node_total_stake_chr,
    bridge_lease_add_min_balance_usd = economy_constants.bridge_lease_add_min_balance_usd,
);

@extend(common_scheduled_proposal_time_handlers) function() = [common_proposal_type.ec_constants_update.name: scheduled_proposal_constants_time_handler(*)];
function scheduled_proposal_constants_time_handler(common_proposal): timestamp? {
    return pending_economy_constants @? { common_proposal }( .scheduled_at );
}
