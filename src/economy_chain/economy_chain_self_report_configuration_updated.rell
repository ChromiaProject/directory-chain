object economy_chain_self_report {
    mutable config_hash: byte_array = x"";
    mutable update_deposit_account_to_regular_ft4_account: boolean = true;
}

function economy_chain_self_report_configuration_change(height: integer) {
    val new_config_hash = chain_context.raw_config.hash();
    if (economy_chain_self_report.config_hash != new_config_hash) {
        log("Economy chain %s detected updated configuration for itself at height %d to %s"
            .format(chain_context.blockchain_rid, height, new_config_hash)
        );

        if (economy_chain_self_report.update_deposit_account_to_regular_ft4_account) {
            update_deposit_account_to_regular_ft4_account();
            economy_chain_self_report.update_deposit_account_to_regular_ft4_account = false;
        }
    }
}

function update_deposit_account_to_regular_ft4_account() {
    val deposit_account = get_deposit_account();
    val account_auth_descriptor = ft4.accounts.add_auth_descriptor(deposit_account, get_deposit_account_auth_descriptor());
    ft4.accounts.set_main_auth_descriptor(deposit_account, account_auth_descriptor);
}

function get_deposit_account_auth_descriptor() = ft4.accounts.single_sig_auth_descriptor(chain_context.args.deposit_account_pubkey, set(["A", "T"]));