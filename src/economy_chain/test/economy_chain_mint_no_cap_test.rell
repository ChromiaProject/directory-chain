@test module;

/*
 * What this proves
 * ----------------
 * There are exactly two points at which CHR can be created on the economy chain, and
 * neither of them consults any maximum supply:
 *
 *   C1  refill_pool_account_if_possible()  (economy_chain_account.rell)
 *       Mints a flat `pool_amount_to_mint` into REWARD_POOL whenever a payout finds the
 *       pool short. Rate-limited to once per `pool_refill_limit_ms`, and nothing else.
 *       No signature, no proposal, no human decision - it fires as a side effect of
 *       processing a routine node availability report.
 *
 *   C2  propose_minting()  (economy_chain_proposal_mint.rell)
 *       Governance mint, rate-limited per window by `chromia_foundation_mint_amount_limit`.
 *       Covered by economy_chain_supply_cap_test.rell.
 *
 * Both limits are RATE limits: they bound how fast CHR can be minted, never how much has
 * been minted in total. Neither reads `total_supply` before minting, and the two paths
 * share no budget with each other.
 *
 * This file concentrates on C1, because C1 is the path that mints on mainnet. C2 has never
 * been used in production; every CHR minted on mainnet came from C1, including the mint on
 * 2026-08-14 that carried supply past the published maximum.
 *
 * The contrast worth noting: this repo already implements the missing cumulative check, for
 * third-party tokens only. `src/token_chain/minting.rell` enforces
 * `require(amount + total_minted <= minting_policy.max_supply, ...)` alongside its
 * per-interval limit. CHR has the per-window limit and nothing else.
 */

import ^^.*;
import ^.helper_functions.*;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.assets;
}

/** The "max supply" Chromia publishes, in whole CHR. Enforced nowhere in this codebase. */
val published_max_supply_chr = 978064789;

function published_max_supply_units(): big_integer = (published_max_supply_chr * units_per_asset).to_big_integer();

/**
 * Any delta larger than `pool_refill_limit_ms` opens a fresh refill window. A generous fixed
 * value is used rather than reading the config, because a `@test module` would need its own
 * `module_args` to reach `chain_context.args`, and the test should not have to be kept in
 * step with the chain configuration to stay correct.
 */
val a_new_refill_window_ms = 86400000 * 30; // 30 days

/** Larger than any plausible refill, so a payout of this size always leaves the pool empty. */
val more_than_the_pool_can_pay = (1000000 * units_per_asset).to_big_integer();

/**
 * The size of one refill, measured rather than assumed: on a fresh chain, supply is zero, so
 * the supply left behind by the first forced refill IS `pool_amount_to_mint`.
 */
function measure_one_refill(recipient: ft4.accounts.account): big_integer {
    assert_equals(get_chr_asset().supply, 0L);
    force_payout_needing_refill(recipient);
    val amount = get_chr_asset().supply;
    assert_true(amount > 0L);
    return amount;
}

/**
 * Open a fresh refill window.
 *
 * The delta is applied by running an empty block, not just set: `refill_pool_account_if_possible`
 * compares against `op_context.last_block_time`, which is the PREVIOUS block's timestamp, so a
 * delta set immediately before the payout would not yet be visible to the rate-limit check.
 */
function open_new_refill_window() {
    rell.test.set_next_block_time_delta(a_new_refill_window_ms);
    rell.test.block().run();
}

/**
 * Force one reward payout that the pool cannot cover, which makes `pay_reward` call
 * `refill_pool_account_if_possible()`. The reward is deliberately larger than a refill, so
 * the pool is drained again afterwards and every round has to refill anew.
 */
function force_payout_needing_refill(recipient: ft4.accounts.account) {
    rell.test.tx()
        .op(pay_reward_op(get_pool_account(), recipient, 0, more_than_the_pool_can_pay, "test provider", 0.0))
        .nop()
        .run();
}

/**
 * C1 walks supply past the published maximum, using nothing but ordinary reward payouts.
 *
 * Supply starts just below the published max, as mainnet did on 2026-08-14. Each round is a
 * legitimate payout against an empty pool, so the refill fires, mints, and pays out. There is
 * no `run_must_fail` below: nothing in production code objects at any point, least of all at
 * the round that crosses the line.
 */
function test_pool_refill_mint_crosses_published_max_supply() {

    rell.test.tx().op(init()).run();

    val recipient = get_chromia_foundation_account();

    // Learn the refill size from the chain itself, then reproduce the mainnet starting point:
    // a couple of refills short of the published maximum.
    val one_refill = measure_one_refill(recipient);
    rell.test.tx()
        .op(mint_to(recipient, published_max_supply_units() - one_refill * 3))
        .run();

    val supply_before = get_chr_asset().supply;
    assert_equals(supply_before, published_max_supply_units() - one_refill * 2);
    assert_true(supply_before < published_max_supply_units());
    assert_equals(get_pool_balance(), 0L);
    log("Supply before: %s units (published max supply is %s units)".format(supply_before, published_max_supply_units()));

    var refills = 0;
    while (get_chr_asset().supply <= published_max_supply_units()) {
        val before_round = get_chr_asset().supply;
        open_new_refill_window();
        force_payout_needing_refill(recipient);
        // Every opened window mints, so iterations and mints stay in step.
        assert_equals(get_chr_asset().supply, before_round + one_refill);
        refills += 1;
    }

    val supply_after = get_chr_asset().supply;
    log("Supply after %s refill(s) of %s units: %s units".format(refills, one_refill, supply_after));

    // The point of the file: the published maximum was crossed by routine operation.
    assert_true(supply_after > published_max_supply_units());
    assert_equals(supply_after, supply_before + (refills * one_refill));

    // Being over the published maximum changes nothing. The next round mints again, on top
    // of a supply that is already above it, and the mint is the same flat amount as before -
    // it is not tapered as any ceiling is approached, because no ceiling is known.
    open_new_refill_window();
    force_payout_needing_refill(recipient);

    assert_equals(get_chr_asset().supply, supply_after + one_refill);
}

/**
 * `pool_refill_limit_ms` bounds how OFTEN CHR is minted, never how much in total.
 *
 * Two payouts inside one window mint once, so the rate limit genuinely works. But the number
 * of windows is unbounded, the amount already minted in earlier windows is never consulted,
 * and supply is therefore just `windows * pool_amount_to_mint` with no ceiling in sight.
 */
function test_pool_refill_is_a_rate_limit_not_a_cumulative_cap() {

    rell.test.tx().op(init()).run();

    val recipient = get_chromia_foundation_account();
    assert_equals(get_chr_asset().supply, 0L);

    // First payout of the window: refills.
    val one_refill = measure_one_refill(recipient);
    val after_first = get_chr_asset().supply;
    assert_equals(after_first, one_refill);

    // Second payout in the SAME window: refused, and refused quietly. The rate limit holds.
    force_payout_needing_refill(recipient);
    assert_equals(get_chr_asset().supply, after_first);

    // Now let windows elapse. Every one of them mints the full amount again.
    val windows = 25;
    var i = 0;
    while (i < windows) {
        open_new_refill_window();
        force_payout_needing_refill(recipient);
        i += 1;
    }

    // Strictly linear in the number of windows. Nothing converges on any maximum.
    assert_equals(get_chr_asset().supply, (windows + 1) * one_refill);

    // At mainnet's own configured 600,000 CHR per day, the published maximum is reachable
    // from zero in this many days by the automatic path alone - no governance involved.
    val mainnet_pool_amount_chr = 600000;
    val days_to_published_max = published_max_supply_chr / mainnet_pool_amount_chr + 1;
    assert_equals(days_to_published_max, 1631);
    log("At mainnet's 600,000 CHR/day pool refill, %s daily refills reach the published max supply from zero".format(days_to_published_max));
}

/**
 * The two mint paths share no budget and no ceiling.
 *
 * Exhausting the governance quota for a window does not stop the pool refill in that same
 * window, and vice versa. Supply after using both is exactly the sum of the two, so nothing
 * anywhere adds them up and compares the result against anything.
 */
function test_both_mint_paths_compound_with_no_combined_ceiling() {

    rell.test.tx().op(init(), create_test_cluster("cluster_name")).run();

    val foundation = get_chromia_foundation_account();
    val governance_limit = get_ec_mint_proposal_amount_limit();
    assert_equals(get_chr_asset().supply, 0L);

    rell.test.tx()
        .op(create_chromia_foundation_voter_set())
        .sign(rell.test.keypairs.alice)
        .run();

    // C2 at its full per-window quota.
    rell.test.tx()
        .op(propose_minting(rell.test.pubkeys.alice, governance_limit, foundation.id))
        .sign(rell.test.keypairs.alice)
        .nop()
        .run();
    assert_equals(get_chr_asset().supply, governance_limit.to_big_integer());

    // C1 in the same window, with C2's quota already spent. It mints regardless.
    val before_refill = get_chr_asset().supply;
    force_payout_needing_refill(foundation);
    val minted_by_refill = get_chr_asset().supply - before_refill;

    assert_true(minted_by_refill > 0L);
    assert_equals(get_chr_asset().supply, governance_limit.to_big_integer() + minted_by_refill);
    log("Both mint paths ran in one window: %s units total".format(get_chr_asset().supply));
}
