@test module;

import ^^.*;

function test_add_bridge_and_erc20_link_on_init() {

	rell.test.tx().op(
			init()
		).run();

	val bsc_asset = eif.hbridge.erc20_asset @ { get_asset(), .network_id == 97 } (eif.hbridge.map_erc20_asset_to_erc20_asset_info($));
	val eth_asset = eif.hbridge.erc20_asset @ { get_asset(), .network_id == 1 } (eif.hbridge.map_erc20_asset_to_erc20_asset_info($));

	assert_equals(
		eif.hbridge.get_bridge_contracts(network_id = 97),
		[
			eif.hbridge.bridge_contract_info(
				contract_address = x"2Cf48D2891CC286d18596Df1261D011d1B78E03E",
				evm_read_offset = 10,
				erc20_assets = [bsc_asset]
			)
		]
	);

	assert_equals(
		eif.hbridge.get_bridge_contracts(network_id = 1),
		[
			eif.hbridge.bridge_contract_info(
				contract_address = x"2Cf48D2891CC286d18596Df1261D011d1B78E04E",
				evm_read_offset = 10,
				erc20_assets = [eth_asset]
			)
		]
	);
}
