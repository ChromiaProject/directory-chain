@test module;

import ^^.*;
import ^.helper_operations.*;
import ^.helper_functions.*;

function test_add_bridge_and_erc20_link_on_init() {

	rell.test.tx().op(
		init()
	).run();

	assert_bridge_contracts();
}

function test_updating_bridge_contract() {
	rell.test.tx().op(
		init()
	).run();

	// Simulate config update
	rell.test.tx().op(
			override_existing_bridge(97, x"1010"), // BOGUS address
			try_to_update_assets()
		).run();
	assert_bridge_contracts();
}

function test_obsolete_asset_bridge_contract_removed() {
	rell.test.tx().op(
		init()
	).run();

	// Simulate obsolete asset and assert that it is immediately removed
	rell.test.tx().op(
			add_bridge(97, x"1010", x"2020"),
			try_to_update_assets()
		).run();
	assert_bridge_contracts();
}

function assert_bridge_contracts() {
	val bsc_asset = eif.hbridge.erc20_asset @ { get_asset(), .network_id == 97 } (eif.hbridge.map_erc20_asset_to_erc20_asset_info($)) limit 1;
	val eth_asset = eif.hbridge.erc20_asset @ { get_asset(), .network_id == 1 } (eif.hbridge.map_erc20_asset_to_erc20_asset_info($)) limit 1;

	assert_equals(
		eif.hbridge.get_bridge_contracts(network_id = 97),
		[
			eif.hbridge.bridge_contract_info(
				contract_address = x"2Cf48D2891CC286d18596Df1261D011d1B78E03E",
				evm_read_offset = 10,
				erc20_assets = [bsc_asset]
			)
		]
	);

	assert_equals(
		eif.hbridge.get_bridge_contracts(network_id = 1),
		[
			eif.hbridge.bridge_contract_info(
				contract_address = x"2Cf48D2891CC286d18596Df1261D011d1B78E04E",
				evm_read_offset = 10,
				erc20_assets = [eth_asset]
			)
		]
	);
}

function test_convert_bridge_mode() {
	rell.test.tx().op(
		set_bridge_mode_conversion(false)
	).run();
	rell.test.tx().op(
		init()
	).run();
	
	val alice_evm_address = crypto.eth_pubkey_to_address(rell.test.keypairs.alice.pub);
    do_evm_stake_update_bsc(alice_evm_address, 50 * units_per_asset);

    val test_account_alice = require(do_create_account_using_ras_staking(rell.test.keypairs.alice));

	assert_equals(assets.get_asset_balance(test_account_alice, get_asset()), 1000 * units_per_asset);

	//Total initial native supply will be 6000
	do_create_erc20_deposit_event(97, alice_evm_address, 500);
	do_create_erc20_deposit_event(97, alice_evm_address, 1500);
	do_create_erc20_deposit_event(1, alice_evm_address, 1000);
	do_create_erc20_deposit_event(1, alice_evm_address, 2000);

	assert_equals(assets.get_asset_balance(test_account_alice, get_asset()), 6000 * units_per_asset);

	//Native supply = 5000 - 1000 = 4000
	//97 supply = 100
	//1 supply = 700
	//Total supply = 4000 + 100 + 700 = 4800
	val hash1 = do_create_erc20_withdrawal(97, 100, rell.test.keypairs.alice, alice_evm_address);
	val hash2 = do_create_erc20_withdrawal(97, 200, rell.test.keypairs.alice, alice_evm_address);
	val hash3 = do_create_erc20_withdrawal(1, 300, rell.test.keypairs.alice, alice_evm_address);
	val hash4 = do_create_erc20_withdrawal(1, 400, rell.test.keypairs.alice, alice_evm_address);

	//Hash 2 should not be included in the supply
	do_update_withdrawal_status(hash1, eif.hbridge.withdrawal_status.requested);
	do_update_withdrawal_status(hash2, eif.hbridge.withdrawal_status.withdrawn);

	//Move past supply timestamp
	rell.test.set_next_block_time_delta(100000);
    rell.test.block().run();

	//Native supply = 4000 + 13000 = 17000
	//97 supply = 100 - 6000 = -5900
	//1 supply = 700 - 7000 = -6300
	//Total supply = 17000 - 5900 - 6300 = 4800
	do_create_erc20_deposit_event(97, alice_evm_address, 2500);
	do_create_erc20_deposit_event(97, alice_evm_address, 3500);
	do_create_erc20_deposit_event(1, alice_evm_address, 3000);
	do_create_erc20_deposit_event(1, alice_evm_address, 4000);

	//These withdrawals should be included in the supply
	//Native supply = 17000 - 2600 = 14400
	//97 supply = -5900 + 1100 = -4800
	//1 supply = -6300 + 1500 = -4800
	//Total supply = 14400 - 4800 - 4800 = 4800
	val hash5 = do_create_erc20_withdrawal(97, 500, rell.test.keypairs.alice, alice_evm_address);
	val hash6 = do_create_erc20_withdrawal(97, 600, rell.test.keypairs.alice, alice_evm_address);
	val hash7 = do_create_erc20_withdrawal(1, 700, rell.test.keypairs.alice, alice_evm_address);
	val hash8 = do_create_erc20_withdrawal(1, 800, rell.test.keypairs.alice, alice_evm_address);

	do_update_withdrawal_status(hash5, eif.hbridge.withdrawal_status.requested);
	do_update_withdrawal_status(hash6, eif.hbridge.withdrawal_status.withdrawn);

	rell.test.tx().op(
		set_bridge_mode_conversion(true)
	).run();
    rell.test.block().run();
	
	//Initial supply for both chains is 10000
	assert_equals(get_asset().total_supply, ((10000 - 4800) + (10000 - 4800) + 15400) * units_per_asset);
	
	val account_97 = accounts.account @ { .id == eif.hbridge.erc20_asset @ { .network_id == 97 } (.virtual_blockchain_rid) };
	assert_equals(assets.get_asset_balance(account_97, get_asset()), (10000 - 4800) * units_per_asset);

	val account_1 = accounts.account @ { .id == eif.hbridge.erc20_asset @ { .network_id == 1 } (.virtual_blockchain_rid) };
	assert_equals(assets.get_asset_balance(account_1, get_asset()), (10000 - 4800) * units_per_asset);
	
	//Verify that bridge mode is native
	do_create_erc20_deposit_event(97, alice_evm_address, 1000);
	assert_equals(assets.get_asset_balance(account_97, get_asset()), (10000 - 5800) * units_per_asset);


	//Alice keypair is admin
	rell.test.tx().op(
		update_evm_supply(97, x"AaE0437b279696464f5d49C54f9E8Fe5488F9323", 1000 * units_per_asset, true)
	).sign(rell.test.keypairs.bob).run_must_fail();

	rell.test.tx().op(
		update_evm_supply(97, x"AaE0437b279696464f5d49C54f9E8Fe5488F9323", 1000 * units_per_asset, true)
	).sign(rell.test.keypairs.alice).run();

	assert_equals(assets.get_asset_balance(account_97, get_asset()), (10000 - 5800 + 1000) * units_per_asset);

	rell.test.tx().op(
		update_evm_supply(97, x"AaE0437b279696464f5d49C54f9E8Fe5488F9323", 2000 * units_per_asset, false)
	).sign(rell.test.keypairs.alice).run();

	assert_equals(assets.get_asset_balance(account_97, get_asset()), (10000 - 5800 + 1000 - 2000) * units_per_asset);

}
