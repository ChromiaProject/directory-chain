@test module;

/*
 * Reward constants tuned to pay roughly 60,000 CHR per node per month.
 *
 * This is a calibration test, not a behavioural one. It reproduces mainnet's shape -- one
 * dapp cluster, its real tag prices, its real occupancy, and the number of nodes signing in
 * each cluster -- and then shows which two constants land a node near the target, so the
 * values can be taken straight into a governance proposal.
 *
 * The target is PER NODE, not per provider. A provider is paid once per node it signs with,
 * so a provider signing in two clusters receives roughly twice the figure below. Nothing in
 * the economy chain caps a provider's total; see the note at the end of this file.
 *
 * Two levers, one per cluster type, because the two reward formulas share no terms:
 *
 *   system cluster  ->  total_cost_system_providers   (economy_chain_reward.rell:69-70)
 *   dapp cluster    ->  dapp_provider_risk_share      (economy_chain_reward.rell:108)
 *
 * Both are reachable by governance: the first through
 * `propose_system_provider_economy_constants`, the second through `update_economy_constants`.
 */

import ^^.*;
import ^.helper_constants.*;
import ^.helper_functions.*;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.assets;
}

/* ---------------------------------------------------------------- mainnet shape ---- */

/** Tag `standard` on mainnet: $12.864885 per SCU per day. */
val SCU_PRICE = 12864885;
/** Tag `standard` on mainnet: $0.004142 per GiB per day. */
val EXTRA_STORAGE_PRICE = 4142;
/** Cluster `pink`: 8 cluster units -> 8 * 16 = 128 SCU, less 4 reserved for the system container. */
val CLUSTER_UNITS = 8;
/** Cluster `pink` extra storage, in MiB. Divided by 1024 in the reward formula. */
val EXTRA_STORAGE_MIB = 5722046;
/** Leased SCU on `pink`: 12 of 124 chargeable, so occupancy is ~9.7%. */
val LEASED_SCU = 12;
/** Nodes signing in each cluster on mainnet. */
val SYSTEM_NODES = 12;
val DAPP_NODES = 6;
/** Oracle rate at the time these values were calibrated (CHR ~ $0.01503). */
val CHR_PER_USD = 66.53304;

/* ------------------------------------------------------------- proposed constants ---- */

/**
 * Down from $131, and whole dollars is as fine as this lever gets: the formula divides by
 * `units_per_usd` at economy_chain_reward.rell:70, and both sides are integers, so anything
 * below a dollar is truncated away. $35.61 and $35.00 pay exactly the same. $36 is therefore
 * the closest reachable setting to the target -- $35 undershoots by ~991 CHR a month.
 */
val PROPOSED_TOTAL_COST_SYSTEM_PROVIDERS_UNITS = 36000000; // $36
/**
 * The second system lever, and the one that gets the figure close. $36 alone overshoots by
 * ~625 CHR a month and $35 undershoots by ~991; a decimal risk share closes the gap the
 * whole-dollar cost cannot. It also shifts a little more of the reward onto cluster revenue,
 * which is the direction this is meant to move in anyway.
 */
val PROPOSED_SYSTEM_PROVIDER_RISK_SHARE = 0.115;
/** Up from 0.2. At this level a dapp node is paid almost entirely on what the cluster earns. */
val PROPOSED_DAPP_PROVIDER_RISK_SHARE = 0.911;

val TARGET_PER_NODE_PER_MONTH = 60000L * units_per_asset;
/** The target is approximate, so calibration is checked to within 5%. */
val TOLERANCE = 3000L * units_per_asset;
val DAYS_PER_MONTH = 30;

val dapp_cluster_name = "pink";
/**
 * Provider 0 signs in both clusters, as ChromaWay does on mainnet. Every other provider holds
 * exactly one node, so 18 nodes belong to 17 providers.
 */
val BOTH_CLUSTERS_PROVIDER = 0;
/** Controls: one signs only in the system cluster, the other only in the dapp cluster. */
val SYSTEM_ONLY_PROVIDER = 1;
val DAPP_ONLY_PROVIDER = SYSTEM_NODES;
val TOTAL_PROVIDERS = SYSTEM_NODES + DAPP_NODES - 1;
/** Long enough that `__begin_block` never expires the occupancy lease mid-test. */
val LEASE_DURATION_MS = 1000 * 365 * 24 * 60 * 60 * 1000;

/** Node keys are only ever stored and compared, never used to sign, so they are synthesised. */
function node_key(i: integer): pubkey = byte_array.from_hex("02" + "%064x".format(i));

/**
 * Provider keys must be real points: creating a provider also creates its FT4 account with a
 * single-signature auth descriptor over this key.
 */
function provider_key(i: integer): pubkey {
    val priv = ("provider " + i).hash();
    return crypto.privkey_to_pubkey(priv, true);
}

/**
 * Which provider holds node `i`. System nodes are 0..11 and dapp nodes 12..17; node 0 and node
 * 12 are both held by `BOTH_CLUSTERS_PROVIDER`, which is what shifts the dapp nodes down by one.
 */
function node_owner(i: integer): integer = when {
    i == 0 or i == SYSTEM_NODES -> BOTH_CLUSTERS_PROVIDER;
    i < SYSTEM_NODES -> i;
    else -> i - 1;
};

/* --------------------------------------------------------------------- fixtures ---- */

/**
 * Build a network with mainnet's proportions and apply the proposed constants.
 *
 * Staking requirements are switched off so that `is_staking_approved` cannot skip a node --
 * this test is about the size of the reward, not about eligibility.
 */
function setup_mainnet_shaped_network() {
    rell.test.tx().op(init()).run();
    update_staking_requirements_constants(staking_requirements_enabled = false);

    rell.test.tx().op(
        update_reward_economy_constants(
            chr_per_usd = CHR_PER_USD,
            dapp_provider_risk_share = PROPOSED_DAPP_PROVIDER_RISK_SHARE,
            total_cost_system_providers_units = PROPOSED_TOTAL_COST_SYSTEM_PROVIDERS_UNITS,
            system_provider_risk_share = PROPOSED_SYSTEM_PROVIDER_RISK_SHARE
        )
    ).run();

    val system_cluster = ensure_system_cluster();
    val dapp_cluster = ensure_cluster(
        dapp_cluster_name, false, false, CLUSTER_UNITS, EXTRA_STORAGE_MIB,
        scu_price = SCU_PRICE, extra_storage_price = EXTRA_STORAGE_PRICE
    );

    // One provider per node, except provider 0 which holds a node in each cluster. Providers
    // signing in the system cluster carry the system flag, matching mainnet; `add_provider`
    // returns the existing record on the second call for provider 0.
    for (i in range(SYSTEM_NODES + DAPP_NODES)) {
        val in_system_cluster = i < SYSTEM_NODES;
        val owner = provider_key(node_owner(i));
        add_provider(owner, in_system_cluster, provider_tier.NODE_PROVIDER);
        ensure_node(owner, node_key(i), true, "SE", 1, 0, false);
        add_cluster_node(if (in_system_cluster) system_cluster.name else dapp_cluster.name, node_key(i), false);
    }

    // Occupancy. The lease holder is irrelevant to the reward formula -- only the summed
    // container_units of unexpired leases are read -- so an existing system account is used
    // rather than creating one, which would need the account-creator key.
    rell.test.tx().op(
        create_lease("occupancy", LEASED_SCU, get_chromia_foundation_account(), dapp_cluster, false, LEASE_DURATION_MS),
        set_pool_details_last_refill_millis_last_block_time_op()
    ).run();

    // Fund the pool far beyond a month of rounds so nothing is clamped or deferred into
    // reward_debt; partial payment is a different concern and would mask the calibration.
    add_assets_to_pool(50000000 * units_per_asset);

    return (system_cluster = system_cluster, dapp_cluster = dapp_cluster);
}

/** Every node in the cluster reporting full availability, so the factor is exactly 1.0. */
function full_availability(from: integer, count: integer): map<byte_array, decimal> {
    val report = map<byte_array, decimal>();
    for (i in range(from, from + count)) {
        report[node_key(i)] = 1.0;
    }
    return report;
}

/** Run a month of daily reward rounds for one cluster. */
function pay_a_month(cluster: cluster, from: integer, count: integer) {
    val report = node_availability_report(start_time = 0, end_time = 0, full_availability(from, count));
    for (day in range(DAYS_PER_MONTH)) {
        rell.test.set_next_block_time_delta(millis_per_day);
        rell.test.tx().op(pay_rewards_op(cluster, report)).nop().run();
    }
}

/**
 * What a provider holds. Rewards are measured as the change in this across a month, because
 * the balance is the money that actually arrived -- `node_payed_reward` is only the ledger
 * entry, and would not notice a provider's payouts failing to accumulate.
 */
function balance_of(provider): big_integer = get_account_balance(provider_account @ { provider } .account);

/** Run a month and return what reached the provider at `provider_index`. */
function monthly_for(provider_index: integer, cluster: cluster, from: integer, count: integer): big_integer {
    val p = provider @ { provider_key(provider_index) };
    val before = balance_of(p);
    pay_a_month(cluster, from, count);
    return balance_of(p) - before;
}

/**
 * The multiplier the dapp formula applies at a given occupancy: `(1 - r) + r * occupancy`.
 * Linear in occupancy, which is what makes the effect of leasing more SCU exactly predictable.
 */
function occupancy_multiplier(chargeable_scu: integer, leased_scu: integer): decimal {
    val occupancy = decimal(leased_scu) / chargeable_scu;
    return (1 - PROPOSED_DAPP_PROVIDER_RISK_SHARE) + PROPOSED_DAPP_PROVIDER_RISK_SHARE * occupancy;
}

/** What a month should pay at `leased_scu`, given what it paid at `LEASED_SCU`. */
function predicted_monthly(base: big_integer, chargeable_scu: integer, leased_scu: integer): big_integer {
    val ratio = occupancy_multiplier(chargeable_scu, leased_scu)
              / occupancy_multiplier(chargeable_scu, LEASED_SCU);
    return (decimal(base) * ratio).to_big_integer();
}

/** Occupy `scu` more of the cluster. */
function lease_more(name: text, scu: integer, cluster: cluster) {
    rell.test.tx().op(
        create_lease(name, scu, get_chromia_foundation_account(), cluster, false, LEASE_DURATION_MS)
    ).run();
}

function assert_near_target(label: text, monthly: big_integer) {
    val delta = abs(monthly - TARGET_PER_NODE_PER_MONTH);
    // Printed so the calibration is readable from the test output, not just asserted.
    log("%s: %s CHR per month (target %s, off by %s)".format(
        label,
        monthly / units_per_asset,
        TARGET_PER_NODE_PER_MONTH / units_per_asset,
        delta / units_per_asset));
    assert_true(delta <= TOLERANCE);
    // Calibrated to sit on or just above the target: paying a provider less than the figure
    // that was announced is the one direction that is not merely inaccurate.
    assert_true(monthly >= TARGET_PER_NODE_PER_MONTH);
}

/* ------------------------------------------------------------------------ tests ---- */

/**
 * The mainnet shape is reproduced faithfully, so the calibration below means something.
 *
 * 8 cluster units give 128 SCU, less the 4 the system container reserves, leaves 124
 * chargeable; 12 of those are leased.
 */
function test_fixture_matches_mainnet_shape() {
    val clusters = setup_mainnet_shaped_network();

    assert_equals(total_available_scus(CLUSTER_UNITS), 128);
    assert_equals(total_available_scus_exclude_system(clusters.dapp_cluster), 124);
    assert_equals(occupied_scus(clusters.dapp_cluster), LEASED_SCU);
    assert_equals(occupancy_rate(clusters.dapp_cluster), decimal(LEASED_SCU) / 124);

    assert_equals(cluster_node @ { clusters.system_cluster } ( @sum 1 ), SYSTEM_NODES);
    assert_equals(cluster_node @ { clusters.dapp_cluster } ( @sum 1 ), DAPP_NODES);
    assert_equals(economy_constants.chr_per_usd, CHR_PER_USD);

    // 18 nodes held by 17 providers, because one provider signs in both clusters.
    //
    // Counted over node holders rather than over `provider`: creating a cluster goes through
    // `create_pending_cluster` -> `create_proposal`, which seeds proposal-machinery providers
    // of its own. Those are fixture artifacts and not part of the shape being modelled.
    assert_equals(node @ { } ( @sum 1 ), SYSTEM_NODES + DAPP_NODES);

    val holders = set<pubkey>();
    for (pk in node @* { } ( .provider.pubkey )) holders.add(pk);
    assert_equals(holders.size(), TOTAL_PROVIDERS);

    // Every one of them has an account, so rewards land in 17 distinct places.
    for (pk in holders) {
        assert_true(exists(provider_account @? { .provider.pubkey == pk }));
    }

    // The provider in both clusters holds exactly two nodes, one on each side.
    val both = provider @ { provider_key(BOTH_CLUSTERS_PROVIDER) };
    assert_equals(node @ { .provider == both } ( @sum 1 ), 2);
    assert_equals(cluster_node @ { .node.provider == both, .cluster == clusters.system_cluster } ( @sum 1 ), 1);
    assert_equals(cluster_node @ { .node.provider == both, .cluster == clusters.dapp_cluster } ( @sum 1 ), 1);
}

/**
 * `total_cost_system_providers` at $36 with a 0.115 risk share pays a system node about
 * 60,000 CHR a month.
 *
 * The flat cost term dominates the formula, so this lever is very nearly linear: it was $131,
 * which is why system nodes are on roughly 231,000 CHR a month today.
 */
function test_system_node_is_paid_about_60k_chr_per_month() {
    val clusters = setup_mainnet_shaped_network();

    val monthly = monthly_for(SYSTEM_ONLY_PROVIDER, clusters.system_cluster, 0, SYSTEM_NODES);

    assert_true(monthly > 0);
    assert_near_target("system node", monthly);
}

/**
 * `dapp_provider_risk_share` at 0.911 pays a dapp node about 60,000 CHR a month.
 *
 * The multiplier is `(1 - risk_share) + risk_share * occupancy`. At the current 0.2 a node is
 * paid 82% of cluster value on a cluster that is a tenth full; at 0.911 it is paid almost
 * entirely on what the cluster actually earns.
 */
function test_dapp_node_is_paid_about_60k_chr_per_month() {
    val clusters = setup_mainnet_shaped_network();

    val monthly = monthly_for(DAPP_ONLY_PROVIDER, clusters.dapp_cluster, SYSTEM_NODES, DAPP_NODES);

    assert_true(monthly > 0);
    assert_near_target("dapp node", monthly);
}

/**
 * Raising `dapp_provider_risk_share` ties the reward to demand rather than to capacity.
 *
 * Worth knowing before proposing it: 60,000 is the figure at today's ~9.7% occupancy, not a
 * ceiling. Fill the cluster and the same constant pays substantially more, because the
 * occupancy term stops being close to zero. That is the intended behaviour -- providers are
 * then paid out of what the network earns -- but it does mean the number moves on its own.
 */
function test_dapp_reward_rises_with_occupancy_at_the_proposed_risk_share() {
    val clusters = setup_mainnet_shaped_network();
    val chargeable = total_available_scus_exclude_system(clusters.dapp_cluster);
    // A CHR of slack absorbs the per-day rounding that accumulates over a month.
    val rounding = units_per_asset;

    val at_1x = monthly_for(DAPP_ONLY_PROVIDER, clusters.dapp_cluster, SYSTEM_NODES, DAPP_NODES);
    log("dapp node, %s of %s SCU leased: %s CHR per month".format(
        LEASED_SCU, chargeable, at_1x / units_per_asset));

    lease_more("double", LEASED_SCU, clusters.dapp_cluster);
    assert_equals(occupied_scus(clusters.dapp_cluster), 2 * LEASED_SCU);
    val at_2x = monthly_for(DAPP_ONLY_PROVIDER, clusters.dapp_cluster, SYSTEM_NODES, DAPP_NODES);
    val expect_2x = predicted_monthly(at_1x, chargeable, 2 * LEASED_SCU);
    log("dapp node, %s of %s SCU leased: %s CHR per month (predicted %s, +%s%%)".format(
        2 * LEASED_SCU, chargeable, at_2x / units_per_asset, expect_2x / units_per_asset,
        (at_2x - at_1x) * 100 / at_1x));

    lease_more("triple", LEASED_SCU, clusters.dapp_cluster);
    assert_equals(occupied_scus(clusters.dapp_cluster), 3 * LEASED_SCU);
    val at_3x = monthly_for(DAPP_ONLY_PROVIDER, clusters.dapp_cluster, SYSTEM_NODES, DAPP_NODES);
    val expect_3x = predicted_monthly(at_1x, chargeable, 3 * LEASED_SCU);
    log("dapp node, %s of %s SCU leased: %s CHR per month (predicted %s, +%s%%)".format(
        3 * LEASED_SCU, chargeable, at_3x / units_per_asset, expect_3x / units_per_asset,
        (at_3x - at_1x) * 100 / at_1x));

    assert_true(at_2x > at_1x);
    assert_true(at_3x > at_2x);

    // Measured against the closed form, so the test pins the size of the effect and not
    // merely its direction.
    assert_true(abs(at_2x - expect_2x) <= rounding);
    assert_true(abs(at_3x - expect_3x) <= rounding);
}

/**
 * The target is per node, so a provider signing in two clusters is paid twice.
 *
 * ChromaWay is in exactly this position on mainnet -- one node in the system cluster and one
 * in `pink` -- so a per-node calibration pays it around 120,000 CHR a month. Capping a
 * provider's total would need a per-provider accounting window, which the economy chain does
 * not have.
 */
function test_a_provider_signing_in_two_clusters_is_paid_per_node() {
    val clusters = setup_mainnet_shaped_network();

    val both_clusters = provider @ { provider_key(BOTH_CLUSTERS_PROVIDER) };
    val system_only = provider @ { provider_key(SYSTEM_ONLY_PROVIDER) };
    val dapp_only = provider @ { provider_key(DAPP_ONLY_PROVIDER) };

    // Asserted here rather than left implicit in `node_owner()`: the relationship this test is
    // about is that ONE provider holds a node on each side, against controls holding one each.
    assert_equals(node @ { .provider == both_clusters } ( @sum 1 ), 2);
    assert_equals(cluster_node @ { .node.provider == both_clusters, .cluster == clusters.system_cluster } ( @sum 1 ), 1);
    assert_equals(cluster_node @ { .node.provider == both_clusters, .cluster == clusters.dapp_cluster } ( @sum 1 ), 1);
    assert_equals(node @ { .provider == system_only } ( @sum 1 ), 1);
    assert_equals(node @ { .provider == dapp_only } ( @sum 1 ), 1);

    val both_before = balance_of(both_clusters);
    val system_before = balance_of(system_only);
    val dapp_before = balance_of(dapp_only);

    pay_a_month(clusters.system_cluster, 0, SYSTEM_NODES);
    pay_a_month(clusters.dapp_cluster, SYSTEM_NODES, DAPP_NODES);

    val both_month = balance_of(both_clusters) - both_before;
    val system_month = balance_of(system_only) - system_before;
    val dapp_month = balance_of(dapp_only) - dapp_before;

    log("provider in both clusters: %s CHR per month, against %s (system only) and %s (dapp only)".format(
        both_month / units_per_asset, system_month / units_per_asset, dapp_month / units_per_asset));

    // Paid strictly per node: the two-cluster provider receives exactly what a system-only
    // provider earned plus what a dapp-only provider earned. Nothing caps its total.
    assert_true(abs(both_month - (system_month + dapp_month)) <= units_per_asset);
    assert_true(both_month > system_month);
    assert_true(both_month > dapp_month);
    assert_true(both_month > TARGET_PER_NODE_PER_MONTH + TOLERANCE);
}
