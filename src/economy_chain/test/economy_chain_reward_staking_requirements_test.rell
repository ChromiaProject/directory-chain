@test module;

import ^^.*;
import ^.helper_functions.*;
import ^.helper_operations.*;

val provider_key = rell.test.keypairs.alice;
val provider_pubkey = provider_key.pub;
val node1_keys = rell.test.keypairs.bob;

function test_get_provider_nodes() {

    val provider = add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER);
    create_cluster_nodes(provider, true, 3);

    assert_equals(get_provider_node_type_count(provider), (system = 1, dapp = 3));
}

function test_get_staking_requirements() {

    val provider = add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER);
    create_cluster_nodes(provider, true, 1);

    assert_equals(get_staking_requirements(provider), (own = 90000000000, total = 900000000000));
}

function test_get_staking_requirements_3_dapp_nodes() {

    val provider = add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER);
    create_cluster_nodes(provider, true, 3);

    assert_equals(get_staking_requirements(provider),
        (own = economy_constants.staking_requirement_system_node_own_stake_chr
        + 3 * economy_constants.staking_requirement_dapp_node_own_stake_chr,
            total = economy_constants.staking_requirement_system_node_total_stake_chr
        + 3 * economy_constants.staking_requirement_dapp_node_total_stake_chr));
}

function test_get_provider_staking_status_approved() {

    val provider = add_provider(provider_pubkey, true, provider_tier.NODE_PROVIDER);
    val provider_staking_account = provider_staking_account @ { provider };

    rell.test.block().run();
    rell.test.tx().op(
        staking_init_op(),
        add_staking(provider_staking_account, 9999999999999),
        set_last_approved_stake_requirements(provider_staking_account, get_last_blocktime())
    ).sign(provider_key).run();

    rell.test.set_next_block_time_delta(604800001);
    rell.test.block().run();

    val staking_status = get_provider_staking_status(provider_pubkey);
    val expected = provider_staking_status(
        staking_account_id = provider_staking_account.staking_account.id,
        own_staking_chr = 9999999999999,
        total_staking_chr = 9999999999999,
        approved = true,
        days_since_last_approved = 7,
        days_until_reward_stops = null
    );
    assert_equals(staking_status, expected);
}

function test_get_provider_staking_status_never_approved() {

    val provider = add_provider(provider_pubkey, true, provider_tier.NODE_PROVIDER);
    val provider_account = provider_account @ { provider };
    create_cluster_nodes(provider, true, 1);

    rell.test.tx().op(
        staking_init_op(),
    ).sign(provider_key).run();

    val staking_status = get_provider_staking_status(provider_pubkey);
    val expected = provider_staking_status(
        staking_account_id = provider_account.account.id,
        own_staking_chr = 0,
        total_staking_chr = 0,
        approved = false,
        days_since_last_approved = null,
        days_until_reward_stops = 0
    );
    assert_equals(staking_status, expected);
}

function test_get_provider_staking_status_not_approved() {

    val provider = add_provider(provider_pubkey, true, provider_tier.NODE_PROVIDER);
    val provider_staking_account = provider_staking_account @ { provider };
    create_cluster_nodes(provider, true, 1);

    rell.test.block().run();
    rell.test.tx().op(
        staking_init_op(),
        set_last_approved_stake_requirements(provider_staking_account, get_last_blocktime())
    ).sign(provider_key).run();

    rell.test.set_next_block_time_delta(604800001);
    rell.test.block().run();

    val staking_status = get_provider_staking_status(provider_pubkey);
    val expected = provider_staking_status(
        staking_account_id = provider_staking_account.staking_account.id,
        own_staking_chr = 0,
        total_staking_chr = 0,
        approved = false,
        days_since_last_approved = 7,
        days_until_reward_stops = 7
    );
    assert_equals(staking_status, expected);
}

function test_provider_meets_staking_requirements__require_native_staking() {

    val provider = add_provider(provider_pubkey, true, provider_tier.NODE_PROVIDER);
    val provider_staking_account = provider_staking_account @ { provider };

    val cluster = ensure_cluster("cluster_name", false, false, 1, 1024);
    add_provider(provider_pubkey, true, provider_tier.NODE_PROVIDER);
    val node = ensure_node(provider_pubkey, node1_keys.pub, true, "SE", 1, 1024, false);
    add_cluster_node(cluster.name, node1_keys.pub, false);

    rell.test.tx().op(
        staking_init_op(),
        update_staking_requirements_economy_constants(staking_requirement_dapp_node_own_stake_chr = 1, staking_requirement_dapp_node_total_stake_chr = 0),
        add_staking(provider_staking_account, 1, network.BSC),
        add_staking(provider_staking_account, 1, network.ETH),
    ).sign(provider_key).run();

    assert_equals(staking_get_provider_stake(provider_pubkey), 2);
    assert_false(provider_meets_staking_requirements(provider));

    rell.test.tx().op(
        add_staking(provider_staking_account, 1, network.CHR),
    ).sign(provider_key).run();

    assert_equals(staking_get_provider_stake(provider_pubkey), 3);
    assert_true(provider_meets_staking_requirements(provider));
}
