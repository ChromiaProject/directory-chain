@test module;

import ^^.*;
import ^.helper_functions.*;
import ^.helper_operations.*;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.assets;
    import lib.ft4.auth;
    import test_utils: lib.ft4.test.utils;
}
import lib.auth;

struct module_args {
    auth_privkey: byte_array;
    admin_privkey: byte_array;
}

val auth_privkey = chain_context.args.auth_privkey;
val cluster_name = "Bob's cluster";


function test_create_container_success() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init, cluster_name = cluster_name, container_units = 2);

    assert_false(lease @ { container_name } (.auto_renew));

    val expected_lease = lease_data(
        container_name = container_name,
        cluster_name = cluster_name,
        container_units = 2,
        extra_storage_gib = 0,
        expire_time_millis = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL*3 + millis_per_week,
        expired = false,
        auto_renew = false,
        subnode_image_name = "",
    );

    val leases2 = get_leases_by_account(alice.id);
    assert_equals(leases2.size(), 1);
    assert_equals(leases2[0], expected_lease);

    val lease_data = require(get_lease_by_container_name(container_name));
    assert_equals(lease_data, expected_lease);
}

function test_create_container_with_subnode_image() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val bob = add_provider(rell.test.pubkeys.bob);
    rell.test.tx().op(create_test_subnode_image(name = "subnode_image1", owner = bob)).run();
    val container_name = do_create_container(
        alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init + 11, cluster_name = cluster_name, container_units = 2, subnode_image_name = "subnode_image1");

    val expected_lease = lease_data(
        container_name = container_name,
        cluster_name = cluster_name,
        container_units = 2,
        extra_storage_gib = 0,
        expire_time_millis = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL*5 + millis_per_week,
        expired = false,
        auto_renew = false,
        subnode_image_name = "subnode_image1",
    );

    val leases2 = get_leases_by_account(alice.id);
    assert_equals(leases2.size(), 1);
    assert_equals(leases2[0], expected_lease);

    val lease_data = require(get_lease_by_container_name(container_name));
    assert_equals(lease_data, expected_lease);
}

