function test_create_container_with_subnode_image() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val bob = add_provider(rell.test.pubkeys.bob);
    rell.test.tx().op(create_test_subnode_image(name = "subnode_image1", owner = bob)).run();
    rell.test.tx().op(create_test_subnode_image(name = "subnode_image2", owner = bob)).run();
    val container_name = do_create_container(
        alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init + 14, cluster_name = cluster_name, container_units = 2, subnode_image_name = "subnode_image1");

    val lease = lease @ { container_name };

    val expected_lease = lease_data(
        container_name = container_name,
        cluster_name = cluster_name,
        container_units = 2,
        extra_storage_gib = 0,
        expire_time_millis = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL*5 + millis_per_week,
        expired = false,
        auto_renew = false,
        subnode_image_name = "subnode_image1",
        subnode_jar_extension_names = [],
        bridge_leases = [],
        lease_owner_account_id = alice.id,
        extra_compute_requests = 0,
    );

    val leases = get_leases_by_account(alice.id);
    assert_equals(leases.size(), 1);
    assert_equals(leases[0], expected_lease);

    val container_name2 = do_create_container(
        alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init + 21, cluster_name = cluster_name, container_units = 2,
            subnode_image_name = "subnode_image2", container_name = "container2", extra_compute_requests = 5);

    val expected_lease2 = lease_data(
        container_name = "container2",
        cluster_name = cluster_name,
        container_units = 2,
        extra_storage_gib = 0,
        expire_time_millis = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL*7 + millis_per_week,
        expired = false,
        auto_renew = false,
        subnode_image_name = "subnode_image2",
        subnode_jar_extension_names = [],
        bridge_leases = [],
        lease_owner_account_id = alice.id,
        extra_compute_requests = 5,
    );

    val leases2 = get_leases_by_account(alice.id);
    assert_equals(leases2.size(), 2);
    assert_equals(leases2[0], expected_lease);
    assert_equals(leases2[1], expected_lease2);

    val lease_data = require(get_lease_by_container_name(container_name));
    assert_equals(lease_data, expected_lease);

    val lease_data2 = require(get_lease_by_container_name(container_name2));
    assert_equals(lease_data2, expected_lease2);

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.privkeys.alice, assign_subnode_image_to_container(container_name, "subnode_image1"))
    ).op(
        assign_subnode_image_to_container(container_name, "subnode_image1")
    ).run_must_fail("Container %s already has a custom subnode image".format(container_name));
}

function test_create_container_with_subnode_image_fail_when_not_exist() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
