function test_renew_non_expired_container() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init);

    val alice_balance = get_account_balance(alice);
    val pool_balance = get_pool_balance();

    assert_equals(lease @ { container_name } (.duration_millis), 1 * millis_per_week);
    val renew_cost = renew_container_cost(container_name, 1);
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.privkeys.alice, renew_container(container_name, 1))
    ).op(
        renew_container(container_name, 1)
    ).run();
    val purchases = get_lease_purchases_by_account(alice.id, null, null).data;
    val latest_purchase = lease_purchase_data.from_gtv_pretty(purchases[purchases.size() - 1]);
    assert_equals(latest_purchase.type, lease_purchase_type.RENEWAL);
    assert_equals(latest_purchase.price, renew_cost);
    assert_equals(latest_purchase.price, alice_balance - get_account_balance(alice));
    assert_equals(latest_purchase.price, get_pool_balance() - pool_balance);

    assert_equals(lease @ { container_name } (.duration_millis), 2 * millis_per_week);
    assert_false(lease @ { container_name } (.expired));
    assert_events(); // assert no ICMF messages sent
}

function test_renew_expired_container() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init);

    val alice_balance = get_account_balance(alice);
    val pool_balance = get_pool_balance();

    // The amount of time the container will be expired, container will be created with start_time as last block time
    // and we will build an extra block with default block interval to trigger change in block time delta
    // Hence we overshoot by 1 + 2 * rell.test.block_interval
    val expired_container_time = 1 + rell.test.block_interval * 2;
    rell.test.set_next_block_time_delta(millis_per_week + 1);
    rell.test.block().run();
    rell.test.block().run();
    assert_true(lease @ { container_name } (.expired));

    val renew_cost = renew_container_cost(container_name, 1);
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.privkeys.alice, renew_container(container_name, 1))
    ).op(
        renew_container(container_name, 1)
    ).run();
    val purchases = get_lease_purchases_by_account(alice.id, null, null).data;
    val latest_purchase = lease_purchase_data.from_gtv_pretty(purchases[purchases.size() - 1]);
    assert_equals(latest_purchase.type, lease_purchase_type.RENEWAL);
    assert_equals(latest_purchase.price, renew_cost);
    assert_equals(latest_purchase.price, alice_balance - get_account_balance(alice));
    assert_equals(latest_purchase.price, get_pool_balance() - pool_balance);

    assert_equals(lease @ { container_name } (.duration_millis), 2 * millis_per_week + expired_container_time);
    assert_false(lease @ { container_name } (.expired));
    assert_events(("icmf_message", (
        topic = restart_container_topic,
        body = restart_container_message(container_name).to_gtv()
    ).to_gtv_pretty()));
}

function test_renew_non_expired_container_beyond_max_lease_time() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init);

    val alice_balance = get_account_balance(alice);
    val pool_balance = get_pool_balance();

    // Renew by more than allowed
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.privkeys.alice, renew_container(container_name, 13))
    ).op(
        renew_container(container_name, 13)
    ).run_must_fail("lease duration can be max 12 weeks");

    // Asser limit can not be circumvented by doing multiple renewals
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.privkeys.alice, renew_container(container_name, 7))
    ).op(
        renew_container(container_name, 7)
    ).run();

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.privkeys.alice, renew_container(container_name, 7))
    ).op(
        renew_container(container_name, 7)
    ).run_must_fail("lease duration can be max 12 weeks");
}

