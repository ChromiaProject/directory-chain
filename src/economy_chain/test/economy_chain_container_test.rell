@test module;

import ^^.*;
import ^.helper_functions.*;
import ^.helper_operations.*;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.assets;
    import lib.ft4.auth;
    import test_utils: lib.ft4.test.core;
    import test_auth: lib.ft4.test.core.auth;
    import test_accounts: lib.ft4.test.core.accounts;
    import test_assets: lib.ft4.test.core.assets;
}

struct module_args {
    account_creator_privkey: byte_array;
    container_removal_timeout: integer;
}

val auth_privkey = chain_context.args.account_creator_privkey;
val cluster_name = "Bob's cluster";


function test_create_container_and_assign_subnode_image_later_success() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val bob = add_provider(rell.test.pubkeys.bob);
    rell.test.tx().op(create_test_subnode_image(name = "subnode_image1", owner = bob)).run();
    val container_name = do_create_container(
        alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init + 13, cluster_name = cluster_name, container_units = 2);

    val lease = lease @ { container_name };
    assert_false(lease.auto_renew);

    val expected_lease = lease_data(
        container_name = container_name,
        cluster_name = cluster_name,
        container_units = 2,
        extra_storage_gib = 0,
        expire_time_millis = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL*4 + millis_per_week,
        expired = false,
        auto_renew = false,
        subnode_image_name = "",
        subnode_jar_extension_names = [],
        bridge_leases = [],
        lease_owner_account_id = alice.id,
        extra_compute_requests = 0,
    );

    val leases = get_leases_by_account(alice.id);
    assert_equals(leases.size(), 1);
    assert_equals(leases[0], expected_lease);

    val lease_data = require(get_lease_by_container_name(container_name));
    assert_equals(lease_data, expected_lease);

    do_assign_subnode_image_to_container(
        rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init + 17, current_lease = lease, subnode_image_name = "subnode_image1");

    val expected_lease2 = lease_data(
        container_name = container_name,
        cluster_name = cluster_name,
        container_units = 2,
        extra_storage_gib = 0,
        expire_time_millis = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL*4 + millis_per_week,
        expired = false,
        auto_renew = false,
        subnode_image_name = "subnode_image1",
        subnode_jar_extension_names = [],
        bridge_leases = [],
        lease_owner_account_id = alice.id,
        extra_compute_requests = 0,
    );
    val lease_data2 = require(get_lease_by_container_name(container_name));
    assert_equals(lease_data2, expected_lease2);
}

function test_create_container_and_assign_subnode_image_later_fail_when_not_exist() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val bob = add_provider(rell.test.pubkeys.bob);
    rell.test.tx().op(create_test_subnode_image(name = "subnode_image1", owner = bob)).run();
    val container_name = do_create_container(
        alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init + 13, cluster_name = cluster_name, container_units = 2);

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.privkeys.alice, assign_subnode_image_to_container(container_name, "subnode_image2"))
    ).op(
        assign_subnode_image_to_container(container_name, "subnode_image2")
    ).run_must_fail("Subnode image subnode_image2 not found");
}

