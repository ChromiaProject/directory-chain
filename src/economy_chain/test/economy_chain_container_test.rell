        ft4.test_utils.evm_auth_operation_for(rell.test.privkeys.alice,
            create_container_with_subnode_image(rell.test.pubkeys.alice, 2, 1, 0, cluster_name, false, "subnode_image2"))
    ).op(
        create_container_with_subnode_image(rell.test.pubkeys.alice, 2, 1, 0, cluster_name, false, "subnode_image2")
