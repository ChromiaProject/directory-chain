function test_receive_resource_usage_statistics_cleanup() {
    rell.test.set_next_block_time(1);
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init, container_units = 2);

    // Add a container
    rell.test.tx().op(
        wipe_upgrade_container_tickets(container_name),
        receive_resource_usage_statistics_message_op(resource_usage_statistics_message(
            rell.test.pubkeys.alice,
            container_name = container_name,
            measurement_time = get_last_blocktime(),
            type = resource_type.space_usage_mib.name,
            metric_value = 0
        ).to_gtv())
    ).nop().run();

    assert_not_null(node_container_space_usage @? { container_name });

    // Forward time 1 week and add another container, this should remove the first container
    rell.test.set_next_block_time_delta(millis_per_week);
    rell.test.block().run();
    rell.test.tx().op(
        wipe_upgrade_container_tickets(container_name),
        receive_resource_usage_statistics_message_op(resource_usage_statistics_message(
            rell.test.pubkeys.alice,
            container_name = "container 2",
            measurement_time = get_last_blocktime() + millis_per_week,
            type = resource_type.space_usage_mib.name,
            metric_value = 0
        ).to_gtv())
    ).nop().run();

    // container_name removed, we only have "container 2"
    assert_null(node_container_space_usage @? { container_name });
    assert_not_null(node_container_space_usage @? { "container 2" });
}

function test_upgrade_container_lower_total_storage_too_old_space_data() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init, container_units = 2);

    rell.test.tx().op(
        wipe_upgrade_container_tickets(container_name),
        receive_resource_usage_statistics_message_op(resource_usage_statistics_message(
            rell.test.pubkeys.alice,
            container_name = container_name,
            measurement_time = get_last_blocktime(),
            type = resource_type.space_usage_mib.name,
            metric_value = 0
        ).to_gtv())
    ).nop().run();

    rell.test.set_next_block_time_delta(60 * 10 * 1000 + 1); // Default value fo container_reduce_space_resource_usage_statistics_expire_ms
    rell.test.block().run();

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.privkeys.alice, upgrade_container(container_name, 1, 15, cluster_name, 1))
    ).op(
        upgrade_container(container_name, 1, 15, cluster_name, 1)
    ).run_must_fail("Can't reduce space: Container space data is too old to be able to continue");
}

function test_upgrade_container_lower_total_storage_success() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init, container_units = 2);
    val lease = lease @ {};

    // Reducing SCU with 75% space usage is not allowed
    run_container_upgrade(container_name, integer(lease.container_units * standard_cluster_unit.storage * 0.75), 1, 0)
        .run_must_fail("Can't reduce space: 16384 is not enough container space. Container is currently using 24576 MiB, and with a margin of 4915 MiB the minimum total allowed space is 29491 MiB");

    // 12 is not enough
    run_container_upgrade(container_name, integer(lease.container_units * standard_cluster_unit.storage * 0.75), 1, 12)
        .run_must_fail("28672 is not enough container space.");

    // 13 is enough
    run_container_upgrade(container_name, integer(lease.container_units * standard_cluster_unit.storage * 0.75), 1, 13)
        .run();

    // 3 is not enough with 50% disk usage
    run_container_upgrade(container_name, integer(lease.container_units * standard_cluster_unit.storage * 0.5), 1, 3)
        .run_must_fail("Can't reduce space: 19456 is not enough container space. Container is currently using 16384 MiB, and with a margin of 3276 MiB the minimum total allowed space is 19660 MiB");

    // ...but 4 is
    run_container_upgrade(container_name, integer(standard_cluster_unit.storage * 0.5), 1, 4)
        .run();

    // Reset to 1 SCU and 10 gib of extra storage
    run_container_upgrade(container_name, 0, 1, 10).run();

    // Remove extra storage
    run_container_upgrade(container_name, integer(standard_cluster_unit.storage * 1.0), 1, 0).run_must_fail();
    run_container_upgrade(container_name, integer(standard_cluster_unit.storage * 0.4), 1, 0).run();
    run_container_upgrade(container_name, 0, 1, 0).run();
}

function run_container_upgrade(container_name: text, space_usage: integer, upgraded_scus: integer, upgraded_extra_storage: integer) {

    rell.test.tx().op(
        wipe_upgrade_container_tickets(container_name),
        receive_resource_usage_statistics_message_op(resource_usage_statistics_message(
            rell.test.pubkeys.alice,
            container_name = container_name,
            measurement_time = integer.MAX_VALUE,
            type = resource_type.space_usage_mib.name,
            metric_value = space_usage
        ).to_gtv())
    ).nop().run();

    val ft4_op = upgrade_container(container_name, upgraded_scus, upgraded_extra_storage, cluster_name, 1);
    return rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.privkeys.alice, ft4_op)
    ).op(
        ft4_op
    ).nop();
}

function test_remaining_lease_value_is_correct() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init, container_units = 2);

    val tag = cluster @ { .name == cluster_name }.tag;
    val lease = lease @ { container_name };
    val lease_value = calculate_container_cost(1, 2, 0, tag, extra_compute_requests = 0);

    val quarter_week_passed_remaining_value = calculate_remaining_lease_value(lease, lease.start_time + millis_per_week / 4);
    assert_equals(3 * lease_value / 4, quarter_week_passed_remaining_value);

    val half_week_passed_remaining_value = calculate_remaining_lease_value(lease, lease.start_time + millis_per_week / 2);
    assert_equals(lease_value / 2, half_week_passed_remaining_value);

    val expired_lease_remaining_value = calculate_remaining_lease_value(lease, lease.start_time + millis_per_week);
    assert_equals(expired_lease_remaining_value, 0);
}

function test_calculate_container_cost() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name, scu_price = 1234000, extra_storage_price = 1234000)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init, container_units = 2);

    val tag = cluster @ { .name == cluster_name }.tag;
    val lease = lease @ { container_name };
    val lease_value = calculate_container_cost(1, 2, 0, tag, extra_compute_requests = 0);

    assert_equals(lease_value, 86380000);
}

function test_expire_lease_not_done_when_upgrade_is_pending() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init);

    // Make a pending upgrade
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, upgrade_container(container_name, 3, 0, cluster_name, 1))
    ).op(
        upgrade_container(container_name, 3, 0, cluster_name, 1)
    ).run();

    assert_false(lease @ { container_name } (.expired));
    rell.test.set_next_block_time_delta(millis_per_week + 1);
    rell.test.block().run();
    rell.test.block().run();
    assert_false(lease @ { container_name } (.expired));
}

function test_get_lease_duration() {
    assert_equals(get_min_lease_duration(), economy_constants.min_lease_time_weeks);
    assert_equals(get_max_lease_duration(), economy_constants.max_lease_time_weeks);
}

function test_auth_messages() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();

    // Create
    assert_equals(
        create_container_auth_message([rell.test.keypairs.alice.pub.to_gtv(), (1).to_gtv(), (1).to_gtv(), (0).to_gtv(), cluster_name.to_gtv(), false.to_gtv()].to_gtv()),
        "Please sign the message\nto lease container with 1 SCUs and 0 GiB extra storage\nin cluster Bob's cluster\nfor 1 weeks\ncosting 35.000000 tCHR\non account {account_id}"
    );

    // Create with subnode image
    assert_equals(
        create_container_with_subnode_image_auth_message([rell.test.keypairs.alice.pub.to_gtv(), (1).to_gtv(), (1).to_gtv(), (0).to_gtv(), cluster_name.to_gtv(), false.to_gtv(), "vector".to_gtv(), (5).to_gtv()].to_gtv()),
        "Please sign the message\nto lease container with 1 SCUs and 0 GiB extra storage and 5 extra compute requests and subnode image vector\nin cluster Bob's cluster\nfor 1 weeks\ncosting 35.000000 tCHR\non account {account_id}"
    );

    // Upgrade
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init, container_units = 2);

    assert_equals(
        upgrade_container_auth_message([container_name.to_gtv(), (2).to_gtv(), (0).to_gtv(), cluster_name.to_gtv(), (1).to_gtv(), (5).to_gtv()].to_gtv()),
        "Please sign the message\nto upgrade container container name\nto have 2 SCUs and 0 GiB extra storage and 5 extra compute requests\nin cluster Bob's cluster\nfor 1 weeks\ncosting (before applying refund of current lease) 70.000000 tCHR\non account {account_id}"
    );

    // Renew
    assert_equals(renew_container_auth_message([container_name.to_gtv(), (1).to_gtv()].to_gtv()), "Please sign the message\nto renew lease of container container name\nfor 1 weeks\ncosting 70.000000 tCHR\non account {account_id}");

    // Auto-renew
    assert_equals(auto_renew_container_auth_message([container_name.to_gtv()].to_gtv()), "Please sign the message\nto enable auto-renewal of container container name\ncosting 70.000000 tCHR per week\non account {account_id}");

    // Cancel auto-renew
    assert_equals(cancel_renew_container_auth_message([container_name.to_gtv()].to_gtv()), "Please sign the message\nto cancel auto-renewal of container container name\non account {account_id}");
}

function test_remove_expired_lease() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init);

    assert_false(lease @ { container_name } (.expired));
    rell.test.set_next_block_time_delta(millis_per_week + 1);
    rell.test.block().run();
    rell.test.set_next_block_time_delta(chain_context.args.container_removal_timeout);
    rell.test.block().run();
    assert_true(lease @ { container_name } (.expired));
    assert_events(("icmf_message", (
        topic = stop_container_topic,
        body = stop_container_message(container_name).to_gtv()
    ).to_gtv_pretty()));

    rell.test.block().run();
    assert_events(("icmf_message", (
        topic = remove_container_topic,
        body = remove_container_message(container_name).to_gtv()
    ).to_gtv_pretty()));
    assert_null(lease @? { container_name });
}

function test_no_early_removal_of_expired_lease() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init);

    assert_false(lease @ { container_name } (.expired));
    rell.test.set_next_block_time_delta(millis_per_week + 1);
    rell.test.block().run();
    rell.test.set_next_block_time_delta(chain_context.args.container_removal_timeout - 60000);
    rell.test.block().run();
    assert_true(lease @ { container_name } (.expired));
    assert_events(("icmf_message", (
        topic = stop_container_topic,
        body = stop_container_message(container_name).to_gtv()
    ).to_gtv_pretty()));

    rell.test.block().run();
    assert_not_null(lease @? { container_name });
}

function test_downgrade_container_and_reduce_cost() {
    rell.test.tx().op(init(), create_test_cluster(
        cluster_name,
        scu_price = 12 * units_per_usd,
        extra_storage_price = 4142)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    rell.test.tx().op(
        mint_to(alice, 99000000000)
    ).run();
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init + 1, container_units = 3);
    val alice_balance_after_container = get_account_balance(alice);

    val created_lease = lease @ { container_name };
    do_upgrade_container(alice, rell.test.keypairs.alice, success = true, block_height = 4, ticket_id = ticket_id_after_init + 7, current_lease = created_lease, container_units = 1, upgraded_extra_storage_gib = 40);

    // Got money back
    val alice_balance_after_upgrade = get_account_balance(alice);
    assert_gt(alice_balance_after_upgrade, alice_balance_after_container);

    val expected_lease = lease_data(
        container_name = container_name,
        cluster_name = cluster_name,
        container_units = 1, // Should be 1 now
        extra_storage_gib = 40, // Should be 40 now
        expire_time_millis = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL*5 + millis_per_week,
        expired = false,
        auto_renew = false,
        subnode_image_name = "",
        subnode_jar_extension_names = [],
        bridge_leases = [],
        lease_owner_account_id = alice.id,
        extra_compute_requests = 0,
    );

    val leases2 = get_leases_by_account(alice.id);
    assert_equals(leases2.size(), 1);
    assert_equals(leases2[0], expected_lease);

    val lease_data = require(get_lease_by_container_name(container_name));
    assert_equals(lease_data, expected_lease);
}

function test_container_lease_ownership_transfer() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();

    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val bob = require(do_create_account(rell.test.keypairs.bob, auth_privkey));

    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init + 9);

    assert_equals(
        offer_container_lease_ownership_transfer_auth_message([container_name.to_gtv(), bob.id.to_gtv()].to_gtv()),
        "Please sign the message\nto offer transfer of lease ownership of container %s\nto account %s".format(container_name, bob.id)
    );

    rell.test.tx()
        .op(ft4.test_auth.evm_auth_operation_for(rell.test.keypairs.alice.priv, offer_container_lease_ownership_transfer(container_name, bob.id)))
        .op(offer_container_lease_ownership_transfer(container_name, bob.id))
        .run();

    val offer = get_container_lease_ownership_transfer_offer(container_name);

    assert_equals(offer, container_lease_ownership_transfer_offer_data(container_name, bob.id));

    assert_equals(
        accept_container_lease_ownership_transfer_offer_auth_message([container_name.to_gtv()].to_gtv()),
        "Please sign the message\nto accept transfer of lease ownership of container %s\n".format(container_name)
    );

    rell.test.tx()
        .op(ft4.test_auth.evm_auth_operation_for(rell.test.keypairs.bob.priv, accept_container_lease_ownership_transfer_offer(container_name)))
        .op(accept_container_lease_ownership_transfer_offer(container_name))
        .run();

    assert_null(get_container_lease_ownership_transfer_offer(container_name));

    val expected_lease = lease_data(
        container_name = container_name,
        cluster_name = cluster_name,
        container_units = 2,
        extra_storage_gib = 0,
        expire_time_millis = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL * 3 + millis_per_week,
        expired = false,
        auto_renew = false,
        subnode_image_name = "",
        subnode_jar_extension_names = [],
        bridge_leases = [],
        lease_owner_account_id = bob.id,
        extra_compute_requests = 0,
    );

    assert_equals(get_leases_by_account(alice.id), list<lease_data>());
    assert_equals(get_leases_by_account(bob.id), [expected_lease]);
}

function test_wrong_call_offer_container_lease_ownership_transfer_operation() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();

    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val bob = require(do_create_account(rell.test.keypairs.bob, auth_privkey));

    rell.test.tx()
        .op(offer_container_lease_ownership_transfer("container_name", bob.id))
        .run_must_fail("No current lease for container container_name");

    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init + 9);

    rell.test.tx()
        .op(offer_container_lease_ownership_transfer(container_name, rell.test.keypairs.charlie.pub))
        .run_must_fail("Account not found: '%s'".format(rell.test.keypairs.charlie.pub));

    rell.test.tx()
        .op(offer_container_lease_ownership_transfer(container_name, bob.id))
        .run_must_fail("Expected at least two operations, make sure that you included auth operation.");

    rell.test.tx()
        .op(ft4.test_auth.evm_auth_operation_for(rell.test.keypairs.bob.priv, offer_container_lease_ownership_transfer(container_name, bob.id)))
        .op(offer_container_lease_ownership_transfer(container_name, bob.id))
        .run_must_fail("Lease for container: %s was not created by you.".format(container_name));

    rell.test.tx()
        .op(ft4.test_auth.evm_auth_operation_for(rell.test.keypairs.alice.priv, offer_container_lease_ownership_transfer(container_name, alice.id)))
        .op(offer_container_lease_ownership_transfer(container_name, alice.id))
        .run_must_fail("You cannot transfer lease ownership to yourself.");

    rell.test.tx()
        .op(ft4.test_auth.evm_auth_operation_for(rell.test.keypairs.alice.priv, offer_container_lease_ownership_transfer(container_name, bob.id)))
        .op(offer_container_lease_ownership_transfer(container_name, bob.id))
        .run();

    rell.test.tx()
        .op(ft4.test_auth.evm_auth_operation_for(rell.test.keypairs.alice.priv, offer_container_lease_ownership_transfer(container_name, bob.id)))
        .op(offer_container_lease_ownership_transfer(container_name, bob.id))
        .run_must_fail("Offer for container: %s already exists!".format(container_name));
}

