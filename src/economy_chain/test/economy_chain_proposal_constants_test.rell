@test module;

import ^^.*;
import ^.helper_functions.*;

function test_update_economy_constants_validate_input() {

    add_provider(rell.test.keypairs.alice.pub, true, provider_tier.NODE_PROVIDER);

    rell.test.tx().op(
        update_economy_constants(0, null, null, null, null, null, null)
    ).sign(rell.test.keypairs.alice).run_must_fail("Min lease time weeks must be greater or equal to 1");

    rell.test.tx().op(
        update_economy_constants(1, 0, null, null, null, null, null)
    ).sign(rell.test.keypairs.alice).run_must_fail("Max lease time weeks must be greater or equal to 1");

    rell.test.tx().op(
        update_economy_constants(2, 1, null, null, null, null, null)
    ).sign(rell.test.keypairs.alice).run_must_fail("Min lease time weeks can't be more than max value");

    rell.test.tx().op(
        update_economy_constants(1, 2, -0.5, null, null, null, null)
    ).sign(rell.test.keypairs.alice).run_must_fail("Staking reward rate must be greater or equal to 0");

    rell.test.tx().op(
        update_economy_constants(1, 2, 3, 1.01, null, null, null)
    ).sign(rell.test.keypairs.alice).run_must_fail("Staking reward fee share must be between 0 and 1");

    rell.test.tx().op(
        update_economy_constants(1, 2, 3, 0.1, 2, null, null)
    ).sign(rell.test.keypairs.alice).run_must_fail("Chromia foundation fee share must be between 0 and 1");

    rell.test.tx().op(
        update_economy_constants(1, 2, 3, 0.1, 0.2, -5, null)
    ).sign(rell.test.keypairs.alice).run_must_fail("Resource pool margin fee share must be between 0 and 1");

    rell.test.tx().op(
        update_economy_constants(1, 2, 3, 0.1, 0.2, 0.3, 10000)
    ).sign(rell.test.keypairs.alice).run_must_fail("Dapp provider risk fee share must be between 0 and 1");

    // Total sum of "share" values exceeds 1.0
    rell.test.tx().op(
        update_economy_constants(1, 2, 3, 0.5, 0.5, 0.5, 0.5)
    ).sign(rell.test.keypairs.alice).run_must_fail("The sum (2.200000) of all economy chain share values must be between 0 and 1.0 inclusive");
}

function test_update_economy_constants() {
    val constants: economy_constants_data = get_economy_constants();
    assert_equals(constants.min_lease_time_weeks, 1);
    assert_equals(constants.max_lease_time_weeks, 12);
    assert_equals(constants.chr_per_usd, 5);
    assert_equals(constants.total_cost_system_providers, 828 * units_per_usd);
    assert_equals(constants.system_provider_fee_share, 0.1);
    assert_equals(constants.staking_reward_rate, 0.1);
    assert_equals(constants.staking_reward_fee_share, 0.1);
    assert_equals(constants.chromia_foundation_fee_share, 0.1);
    assert_equals(constants.resource_pool_margin_fee_share, 0.1);
    assert_equals(constants.system_provider_risk_share, 0.1);
    assert_equals(constants.dapp_provider_risk_share, 0.2);

    // Update constants
    rell.test.tx().op(
        update_economy_constants(1, 2, 3, 4, 5, 6, 7)
    ).run_must_fail("Expected system provider signature");

    add_provider(rell.test.keypairs.alice.pub, true, provider_tier.NODE_PROVIDER);

    rell.test.tx().op(
        update_economy_constants(1, 2, 3, 0.04, 0.05, 0.06, 0.07)
    ).sign(rell.test.keypairs.alice).run();

    val updated_constants: economy_constants_data = get_economy_constants();
    assert_equals(updated_constants.min_lease_time_weeks, 1);
    assert_equals(updated_constants.max_lease_time_weeks, 2);
    assert_equals(updated_constants.chr_per_usd, 5); // Unchanged
    assert_equals(updated_constants.total_cost_system_providers, 828 * units_per_usd); // Unchanged
    assert_equals(updated_constants.system_provider_fee_share, 0.1); // Unchanged
    assert_equals(updated_constants.staking_reward_rate, 3);
    assert_equals(updated_constants.staking_reward_fee_share, 0.04);
    assert_equals(updated_constants.chromia_foundation_fee_share, 0.05);
    assert_equals(updated_constants.resource_pool_margin_fee_share, 0.06);
    assert_equals(updated_constants.system_provider_risk_share, 0.1); // Unchanged
    assert_equals(updated_constants.dapp_provider_risk_share, 0.07);
}