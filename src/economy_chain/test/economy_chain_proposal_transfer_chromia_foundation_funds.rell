@test module;

import ^^.*;
import ^.helper_functions.*;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.auth;
}

struct module_args {
    account_creator_privkey: byte_array;
}

val auth_privkey = chain_context.args.account_creator_privkey;

function test_propose_transfer_chromia_foundation_funds_validation() {

    // Voter set must exist
    rell.test.tx().op(
        propose_transfer_chromia_foundation_funds(rell.test.keypairs.alice.pub, 100, x"01")
    )
        .sign(rell.test.keypairs.alice)
        .run_must_fail("does not exist");

    // proposal_by must be signer
    rell.test.tx().op(
        propose_transfer_chromia_foundation_funds(rell.test.keypairs.alice.pub, 1000000, x"01")
    )
        .sign(rell.test.keypairs.bob)
        .run_must_fail("Operation must be signed by 0x02466d7fcae563e5cb09a0d1870bb580344804617879a14949cf22285f1bae3f27");

    // Create voter set and account
    rell.test.tx().op(
        create_chromia_foundation_voter_set()
    )
        .sign(rell.test.keypairs.alice)
        .run();

    // proposal_by must be part of voter set
    rell.test.tx().op(
        propose_transfer_chromia_foundation_funds(rell.test.keypairs.bob.pub, 1000000, x"01")
    )
        .sign(rell.test.keypairs.bob)
        .run_must_fail("0x034f355bdcb7cc0af728ef3cceb9615d90684bb5b2ca5f859ab0f0b704075871aa is not part of voter set CHROMIA_FOUNDATION");

    // Account not found
    rell.test.tx().op(
        propose_transfer_chromia_foundation_funds(rell.test.keypairs.alice.pub, 1000000, x"01")
    )
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Account not found: 0x01");
}

function test_propose_transfer_chromia_foundation_funds_success() {

    rell.test.tx().op(init(), create_test_cluster("cluster_name")).run();
    val alice_account = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val foundation_funds = 1000000;
    val receiver_init_balance = 1000000000;
    val amount = 1000000;
    assert_equals(get_account_balance(alice_account), receiver_init_balance);

    rell.test.tx().op(
        mint_to(get_chromia_foundation_account(), foundation_funds),
        create_chromia_foundation_voter_set(),
        propose_transfer_chromia_foundation_funds(rell.test.keypairs.alice.pub, amount, alice_account.id)
    )
        .sign(rell.test.keypairs.alice)
        .run();

    assert_equals(get_account_balance(get_chromia_foundation_account()), foundation_funds - amount);
    assert_equals(get_account_balance(alice_account), receiver_init_balance + amount);
    assert_true(empty(pending_transfer_chromia_foundation_funds @* { }));
}

function test_propose_transfer_chromia_foundation_funds_revoked() {

    rell.test.tx().op(init(), create_test_cluster("cluster_name")).run();
    val alice_account = require(do_create_account(rell.test.keypairs.alice, auth_privkey));

    // Create voter set with alice and bob as members
    rell.test.tx().op(
        mint_to(get_chromia_foundation_account(), 1000),
        create_chromia_foundation_voter_set(),
        propose_transfer_chromia_foundation_funds(rell.test.keypairs.alice.pub, 1, alice_account.id)
    )
        .sign(rell.test.keypairs.alice, rell.test.keypairs.bob)
        .run();

    assert_equals(pending_transfer_chromia_foundation_funds @ { } ( @sum 1 ), 1);

    rell.test.tx().op(
        revoke_common_proposal_v65(get_latest_common_proposal_id())
    )
        .sign(rell.test.keypairs.alice)
        .run();

    assert_true(empty(pending_transfer_chromia_foundation_funds @* { }));
}

function test_get_transfer_chromia_foundation_funds_proposal() {

    rell.test.tx().op(init(), create_test_cluster("cluster_name")).run();
    val alice_account = require(do_create_account(rell.test.keypairs.alice, auth_privkey));

    // Create voter set with alice and bob as members
    rell.test.tx().op(
        mint_to(get_chromia_foundation_account(), 1),
        create_chromia_foundation_voter_set(),
        propose_transfer_chromia_foundation_funds(rell.test.keypairs.alice.pub, 1, alice_account.id)
    )
        .sign(rell.test.keypairs.alice, rell.test.keypairs.bob)
        .run();

    val proposal_details = get_propose_transfer_chromia_foundation_funds_proposal(get_latest_common_proposal_id());
    assert_equals(proposal_details.amount, 1);
    assert_equals(proposal_details.account_id, alice_account.id);
}
