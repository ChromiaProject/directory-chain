    val auth_descriptor = ft4.accounts.single_sig_auth_descriptor(pubkey, set(["A", "T"]));

    ft4.accounts.create_account_with_auth(auth_descriptor);
}

operation update_system_provider_economy_constants(
    total_cost_system_providers: integer? = null,
    system_provider_fee_share: decimal? = null,
    system_provider_risk_share: decimal? = null
) {
    if (total_cost_system_providers != null) {
        economy_constants.total_cost_system_providers = total_cost_system_providers * units_per_usd;
    }
    economy_constants.system_provider_fee_share = system_provider_fee_share ?: economy_constants.system_provider_fee_share;
    economy_constants.system_provider_risk_share = system_provider_risk_share ?: economy_constants.system_provider_risk_share;
}

operation update_staking_requirements_economy_constants(
    staking_requirements_enabled: boolean? = null,
    staking_requirement_stop_payout_days: integer? = null,
    staking_requirement_system_node_own_stake_chr: integer? = null,
    staking_requirement_system_node_total_stake_chr: integer? = null,
    staking_requirement_dapp_node_own_stake_chr: integer? = null,
    staking_requirement_dapp_node_total_stake_chr: integer? = null
) {
    economy_constants.staking_requirements_enabled = staking_requirements_enabled ?: economy_constants.staking_requirements_enabled;
    economy_constants.staking_requirement_stop_payout_days = staking_requirement_stop_payout_days ?: economy_constants.staking_requirement_stop_payout_days;
    economy_constants.staking_requirement_system_node_own_stake_chr = staking_requirement_system_node_own_stake_chr ?: economy_constants.staking_requirement_system_node_own_stake_chr;
    economy_constants.staking_requirement_system_node_total_stake_chr = staking_requirement_system_node_total_stake_chr ?: economy_constants.staking_requirement_system_node_total_stake_chr;
    economy_constants.staking_requirement_dapp_node_own_stake_chr = staking_requirement_dapp_node_own_stake_chr ?: economy_constants.staking_requirement_dapp_node_own_stake_chr;
    economy_constants.staking_requirement_dapp_node_total_stake_chr = staking_requirement_dapp_node_total_stake_chr ?: economy_constants.staking_requirement_dapp_node_total_stake_chr;
}

