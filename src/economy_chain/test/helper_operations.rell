operation begin_block_op(height: integer) {
    if (state.initialized) {
        handle_configuration_update();
    }
}

operation icmf_message_op(sender: byte_array, topic: text, body: gtv) {
    handle_icmf_message(sender, topic, body);
}

operation empty_account_op(ft4.accounts.account) {
    val balance = get_account_balance(account);
    ft4.assets.Unsafe.transfer(account, get_pool_account(), get_asset(), balance);
}

operation set_account_balance_op(ft4.accounts.account, amount: big_integer) {
    update ft4.assets.balance @? { account, get_asset() } ( .amount = amount );
}

operation unsafe_transfer_op(from: ft4.accounts.account, to: ft4.accounts.account, amount: big_integer) {
    ft4.assets.Unsafe.transfer(from, to, get_asset(), amount);
}

operation mint_to(account: ft4.accounts.account, amount: big_integer) {
    ft4.assets.Unsafe.mint(account, get_asset(), amount);
}

operation mint_to_pool(amount: big_integer) {
    ft4.assets.Unsafe.mint(get_pool_account(), get_asset(), amount);
}

operation create_pending_cluster(
    cluster_name: text,
    tag_name: text,
    status: pending_cluster_status = pending_cluster_status.PENDING_APPROVAL,
    scu_price: integer = 1 * units_per_usd,
    extra_storage_price: integer = 1 * units_per_usd
) {

    val tag = create_or_return_tag(tag_name, scu_price = scu_price, extra_storage_price = extra_storage_price);
    val proposal = create_proposal(common_proposal_type.ec_cluster_create);

    create pending_cluster(
        name = cluster_name,
        tag,
        proposer_pubkey = x"",
        governor_voter_set_name = "governor_voter_set_name",
        voter_set_name = "voter_set_name",
        cluster_units = 1,
        extra_storage = 1,
        proposal,
        status
    );
}

operation create_pending_tag_operation(name: text, scu_price: integer = -1, extra_storage_price: integer = -1) {

    val proposal = create_proposal(common_proposal_type.ec_tag_create);
    create pending_tag_operation(
        name,
        proposal,
        scu_price = scu_price,
        extra_storage_price = extra_storage_price
    );
}

operation create_pending_cluster_change_tag(cluster_name: text, current_tag_name: text, new_tag_name: text) {

    val current_tag = create_or_return_tag(current_tag_name);
    val new_tag = create_or_return_tag(new_tag_name);
    val proposal = create_proposal(common_proposal_type.ec_cluster_create);

    val cluster = create cluster(cluster_name, true, cluster_units = 1, extra_storage = 1, anchoring_chain = x"", current_tag);
    create pending_cluster_change_tag(cluster, proposal, new_tag);
}

operation create_test_cluster(
    cluster_name: text,
    tag_name: text = "test-tag",
    cluster_units: integer = 1,
    extra_storage: integer = 1,
    scu_price: integer = 1 * units_per_usd,
    extra_storage_price: integer = 1 * units_per_usd,
) {
    val tag = create tag(tag_name, scu_price, extra_storage_price);
    create cluster(name = cluster_name, operational = true, cluster_units = cluster_units, extra_storage = extra_storage,
        anchoring_chain = x"", tag = tag);
}

operation create_test_subnode_image(
    name: text,
    url: text = "url",
    digest: text = "digest",
    subnode_image_type = subnode_image_type.COMMON,
    owner: provider,
    description: text = "description",
    active: boolean = true,
    cluster_name: text = "",
) {
    val s = create subnode_image(name, url = url, digest = digest, subnode_image_type = subnode_image_type, owner, description, active);
    if (not cluster_name.empty()) {
        create cluster_subnode_image(cluster @ { .name == cluster_name }, s);
    }
}

operation create_lease(container_name: text, container_units: integer, account: ft4.accounts.account, cluster: cluster, expired: boolean) {
    create lease(
        container_name = container_name,
        account = account,
        container_units = container_units,
        cluster = cluster,
        start_time = 0,
        duration_millis = 0,
        expired = expired,
        auto_renew = false,
        extra_storage_gib = 0
    );
}

