operation add_staking(provider_staking_account, amount: integer, network: network = network.CHR) {
    val ss = create staker_state (
        account = provider_staking_account.staking_account,
        network = network,
        balance = amount,
        last_update = 0,
        pending_token_time = 0
    );
    create staker_state_to_provider (
        _staking_last_known_time(),
        ss,
        provider = provider_staking_account.provider,
        previous_provider = provider @ { get_null_account() }
    );
    create delegation_state(
        staker_state = ss,
        current_provider = provider_staking_account.provider,
        current_active_from = _staking_last_known_time(),
        next_provider = provider @ { get_null_account() },
        next_change_at = 0
    );
}

