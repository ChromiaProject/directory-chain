function test_get_aggregated_node_availability_max() {

    val cluster = ensure_cluster(cluster_name, false, false, 1, 1024);
    val provider = add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER);
    val node = ensure_node(provider_pubkey, node_pubkey, true, "SE", 1, 1024, false);

    add_cluster_node(cluster.name, node_pubkey, false);
    add_reward_provider_deleted_node(provider, x"01", cluster);

    assert_equals(get_aggregated_node_availability([x"01": 0.5, node_pubkey: 0.65], node @ { node_pubkey }, cluster), 1);
}

function test_get_aggregated_node_availability_node_removed_and_added_again() {

    val cluster = ensure_cluster(cluster_name, false, false, 1, 1024);
    val provider = add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER);
    val node = ensure_node(provider_pubkey, node_pubkey, true, "SE", 1, 1024, false);

    add_cluster_node(cluster.name, node_pubkey, false);
    add_reward_provider_deleted_node(provider, node_pubkey, cluster);

    assert_equals(get_aggregated_node_availability([node_pubkey: 0.99], node @ { node_pubkey }, cluster), 0.99);
}
