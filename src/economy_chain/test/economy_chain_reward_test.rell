function test_pay_rewards_dapp_cluster_full_reward_is_payed() {
    val pa = run_pay_rewards(TEST_DAPP_CLUSTER_VALUE, false);

    assert_equals(get_account_balance(pa.account), remove_delegation_share(TEST_DAPP_CLUSTER_VALUE));
    assert_equals(pa.reward_debt, 0);
    assert_equals(get_pool_balance(), get_delegation_share(TEST_DAPP_CLUSTER_VALUE));
    assert_equals(node_payed_reward @ {} ( .value), remove_delegation_share(TEST_DAPP_CLUSTER_VALUE));
}

function test_pay_rewards_dapp_cluster_empty_pool_balance() {

    val pa = run_pay_rewards(0, false);

    assert_equals(get_account_balance(pa.account), 0);
    assert_equals(pa.reward_debt, TEST_DAPP_CLUSTER_VALUE);
    assert_equals(get_pool_balance(), 0);
    assert_equals(node_payed_reward @ {} ( .value), 0);
}

function test_pay_rewards_dapp_cluster_not_enough_funds() {

    val pa = run_pay_rewards(add_delegation_share(10), false);

    assert_equals(get_account_balance(pa.account), 10);
    assert_equals(pa.reward_debt, TEST_DAPP_CLUSTER_VALUE - add_delegation_share(10));
    assert_equals(get_pool_balance(), get_delegation_share(10));
    assert_equals(node_payed_reward @ {} ( .value), 10);
}

function test_pay_rewards_dapp_cluster_pay_full_debt() {

    val pa = run_pay_rewards(TEST_DAPP_CLUSTER_VALUE + 100, false, 90);

    assert_equals(get_account_balance(pa.account), remove_delegation_share(TEST_DAPP_CLUSTER_VALUE + 90));
    assert_equals(pa.reward_debt, 0);
    assert_equals(get_pool_balance(), get_delegation_share(TEST_DAPP_CLUSTER_VALUE + 90) + 10);
    assert_equals(node_payed_reward @ {} ( .value), remove_delegation_share(TEST_DAPP_CLUSTER_VALUE + 90));
}

function test_pay_rewards_dapp_cluster_pay_partialy_debt() {

    val pa = run_pay_rewards(TEST_DAPP_CLUSTER_VALUE + 90, false, 100);

    assert_equals(get_account_balance(pa.account), remove_delegation_share(TEST_DAPP_CLUSTER_VALUE + 90));
    assert_equals(pa.reward_debt, 10);
    assert_equals(get_pool_balance(), get_delegation_share(TEST_DAPP_CLUSTER_VALUE + 90));
    assert_equals(node_payed_reward @ {} ( .value), remove_delegation_share(TEST_DAPP_CLUSTER_VALUE + 90));
}

function test_pay_reward_to_system_cluster() {

    val pa = run_pay_rewards(TEST_SYSTEM_CLUSTER_VALUE + 6500000, true);

    val chromia_foundation_account = get_chromia_foundation_account();

    assert_equals(get_account_balance(pa.account), remove_delegation_share(TEST_SYSTEM_CLUSTER_VALUE));
    assert_equals(pa.reward_debt, 0);
    assert_equals(get_account_balance(chromia_foundation_account), 6500000);
    assert_equals(chromia_foundation.reward_debt, 0);
    assert_equals(get_pool_balance(), get_delegation_share(TEST_SYSTEM_CLUSTER_VALUE));
}

function test_pay_dapp_reward_include_removed_node() {

    val deleted_node_pubkey = x"AABBCC";

    val pa = run_pay_rewards(
        pool_assets = TEST_DAPP_CLUSTER_VALUE,
            calculate_system_reward = false,
            reward_debt = 0,
            node_availability = [deleted_node_pubkey: 0.7, node_pubkey: 0.3],
            deleted_nodes = [deleted_node_pubkey]
    );

    assert_equals(get_account_balance(pa.account), remove_delegation_share(TEST_DAPP_CLUSTER_VALUE));
    assert_true(exists(reward_provider_deleted_node @? { deleted_node_pubkey }));
}

function test_pay_system_reward_include_removed_node() {

    val deleted_node1_pubkey = x"AABBCC";
    val deleted_node2_pubkey = x"DDEEFF";

    val pa = run_pay_rewards(
        pool_assets = TEST_DAPP_CLUSTER_VALUE,
            calculate_system_reward = true,
            reward_debt = 0,
            node_availability = [deleted_node1_pubkey: 0.2, deleted_node2_pubkey: 0.5, node_pubkey: 0.3],
            deleted_nodes = [deleted_node1_pubkey, deleted_node2_pubkey]
    );

    assert_equals(get_account_balance(pa.account), remove_delegation_share(TEST_DAPP_CLUSTER_VALUE));
    assert_true(exists(reward_provider_deleted_node @? { deleted_node1_pubkey }));
    assert_true(exists(reward_provider_deleted_node @? { deleted_node2_pubkey }));
}

function test_pay_reward_new_account_and_empty_pool() {

    val alice = run_pay_reward(1000, false);

    assert_equals(get_account_balance(alice), 1000000000);
    assert_equals(get_pool_balance(), 0);
}

function test_pay_reward_mint_pool_account() {
    rell.test.set_next_block_time_delta(86400001);
    rell.test.block().run();

    val alice = run_pay_reward(1000, true);

    assert_equals(get_account_balance(alice), 1000001000);
    assert_equals(get_pool_balance(), 999999000);
}

function test_pay_evm_transaction_submitter_rewards() {
    rell.test.tx().op(init()).run();

    val cluster = ensure_cluster(cluster_name, false, false, 1, 1024);
    val provider = add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER);
    val node = ensure_node(provider_pubkey, node_pubkey, true, "SE", 1, 1024, false);
    add_cluster_node(cluster_name, node_pubkey, false);

    rell.test.tx().op(
        pay_evm_transaction_submitter_rewards_op(
            evm_transaction_submitter_cost(id = x"01", processed_by = node.pubkey, cost  = 182081 * 1000000000, currency_symbol = "BNB", payer_chain = x"AA"),
            10123000
        )
    ).run();

    assert_equals(node_payed_reward @ {} ( .value), 10123000);
    val pa = provider_account @ { provider } ( .account );
    assert_equals(get_account_balance(pa), 10123000);
}

function test_receive_evm_transaction_submitter_cost_invalid_sender() {
    rell.test.tx().op(init()).run();

    rell.test.tx().op(
        icmf_message_op(x"", evm_transaction_submitter_cost_topic, body = evm_transaction_submitter_cost(
            id = x"10",
            processed_by = node_pubkey,
            cost = 6L * units_per_txs_evm_cost,
            currency_symbol = "ETH",
            payer_chain = x"",
        ).to_gtv())
    ).run();
    assert_true(node_payed_reward @? {} == null);
}

function test_pay_shared_rewards_dapp_cluster_full_reward_is_payed() {
    rell.test.tx().op(init()).run();

    val test_account_dave = require(do_create_account(rell.test.keypairs.dave, auth_privkey));
    val test_account_charlie = require(do_create_account(rell.test.keypairs.charlie, auth_privkey));

    rell.test.tx()
        .op(mint_to_pool(8888888888))
        .op(mint_to(test_account_dave, 9999999))
    .sign(admin_privkey).run();

    add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER);

    do_staking_deposit_native(rell.test.keypairs.dave, 9999999);
    do_staking_delegate(rell.test.keypairs.dave, provider_pubkey);

    assert_equals(get_account_balance(test_account_dave), 1000000000);

    // FFWD
    rell.test.set_next_block_time_delta(staking_delegation_delay_ms);
    rell.test.block().run(); rell.test.block().run();

    assert_equals(staking_get_current_delegate(test_account_dave.id), provider_pubkey);

    val pa = run_pay_rewards(TEST_SYSTEM_CLUSTER_VALUE, true);

    assert_equals(get_account_balance(pa.account), remove_delegation_share(TEST_SYSTEM_CLUSTER_VALUE));
    assert_equals(pa.reward_debt, 0);

    // assert that rewards are not paid out yet
    val regular_staking_reward = staking_rewards_claimable_for(test_account_dave.id);

    assert_not_equals(
        get_account_balance(
            test_account_dave
        ),
        1000000000 + regular_staking_reward + 0.1 * TEST_SYSTEM_CLUSTER_VALUE
    );

    rell.test.tx().op(staking_claim_rewards(true, true)).sign(admin_privkey).run();

    // assert that staking reward + shared reward is paid out
    assert_equals(
        get_account_balance(
            test_account_dave
        ),
        1000000000 + regular_staking_reward + 0.1 * TEST_SYSTEM_CLUSTER_VALUE
    );

    assert_equals(staking_get_shared_rewards_paid(test_account_dave.id), 0.1 * TEST_SYSTEM_CLUSTER_VALUE);
    assert_equals(staking_get_all_rewards_paid().staking_rewards, regular_staking_reward);
    assert_equals(staking_get_all_rewards_paid().shared_rewards, 0.1 * TEST_SYSTEM_CLUSTER_VALUE);

}

function test_pay_shared_rewards_dapp_cluster_small_staking_share() {
    rell.test.tx().op(init()).run();

    val test_account_dave = require(do_create_account(rell.test.keypairs.dave, auth_privkey));
    val test_account_charlie = require(do_create_account(rell.test.keypairs.charlie, auth_privkey));
    val test_account_bob = require(do_create_account(rell.test.keypairs.bob, auth_privkey));

    val reward_amount = remove_delegation_share(TEST_SYSTEM_CLUSTER_VALUE);
    val an_amount = 9999999;
    val dave_amount = integer(an_amount * 0.3);
    val bob_amount = integer(an_amount * 0.7);

    val too_small_to_care = 0.01 * reward_amount;

    rell.test.tx()
        .op(mint_to_pool(8888888888))
        .op(mint_to(test_account_dave, dave_amount))
        .op(mint_to(test_account_bob, bob_amount))
    .sign(admin_privkey).run();

    add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER);

    do_staking_deposit_native(rell.test.keypairs.dave, dave_amount);
    do_staking_deposit_native(rell.test.keypairs.bob, bob_amount);
    do_staking_delegate(rell.test.keypairs.dave, provider_pubkey);
    do_staking_delegate(rell.test.keypairs.bob, provider_pubkey);

    val pre_reward_dave_balance = get_account_balance(test_account_dave);
    val pre_reward_bob_balance = get_account_balance(test_account_bob);

    // FFWD
    rell.test.set_next_block_time_delta(staking_delegation_delay_ms);
    rell.test.block().run(); rell.test.block().run();

    assert_equals(staking_get_current_delegate(test_account_dave.id), provider_pubkey);
    assert_equals(staking_get_current_delegate(test_account_bob.id), provider_pubkey);

    val pa = run_pay_rewards(0, true);

    assert_equals(get_account_balance(pa.account), reward_amount);
    assert_equals(pa.reward_debt, 0);

    rell.test.tx().op(staking_claim_rewards(true, true)).sign(admin_privkey).run();

    log("dave balance ", get_account_balance(test_account_dave));
    log("dave pre balance ", pre_reward_dave_balance);

    log("bob balance ", get_account_balance(test_account_bob));
    log("bob pre balance ", pre_reward_bob_balance);

    assert_true(too_small_to_care >= abs(get_account_balance(test_account_dave) - pre_reward_dave_balance - (0.1 * reward_amount * 0.3)));
    assert_true(too_small_to_care >= abs(get_account_balance(test_account_bob) - pre_reward_bob_balance - (0.1 * reward_amount * 0.7)));
}

function test_staking_req_reward_fail_due_to_low_own() {

    update_staking_requirements_constants(
        staking_requirements_enabled = true,
        staking_requirement_system_node_own_stake_chr = 100000000000
    );

    val psa = run_staking_pay_out();

    assert_equals(get_account_balance(psa.staking_account), 0);
    assert_equals(psa.last_approved_stake_requirements, 0);
}

