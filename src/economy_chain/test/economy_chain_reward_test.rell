function test_staking_req_reward_successful() {
    rell.test.tx().op(init()).run();

    update_staking_requirements_constants(
        staking_requirements_enabled = true
    );
    rell.test.tx()
        .op(mint_to_pool(2000000000))
        .sign(admin_privkey).run();

    val psa = run_staking_pay_out(
        reward = 10,
        staking_amount = economy_constants.staking_requirement_system_node_total_stake_chr +
            economy_constants.staking_requirement_dapp_node_total_stake_chr + 100,
        staking_rewards_share = 0.2,
    );
    val regular_staking_reward = staking_rewards_claimable_for(psa.staking_account.id);

    rell.test.tx().op(staking_claim_rewards(true, true)).sign(admin_privkey).run();

    //assert that the reward is paid out. We subtract the regular staking reward from the total
    assert_equals(get_account_balance(psa.staking_account) - regular_staking_reward, (12 * (1 - psa.provider.staking_rewards_share)).round().to_big_integer());
    assert_gt(psa.last_approved_stake_requirements, 0);
}

function test_staking_req_reward_successful_due_to_disabled() {

    update_staking_requirements_constants(staking_requirements_enabled = false);

    val psa = run_staking_pay_out(
        staking_amount = 0
    );

    assert_equals(get_account_balance(psa.staking_account), (10 * (1 - psa.provider.staking_rewards_share)).round().to_big_integer());
    assert_equals(psa.last_approved_stake_requirements, 0);
}

function test_staking_req_reward_successful_followed_by_stopped() {
    rell.test.tx().op(init()).run();

    rell.test.tx()
        .op(mint_to_pool(10000000000))
        .sign(admin_privkey).run();
    // Staking OK - pay reward
    update_staking_requirements_constants(
        staking_requirements_enabled = true,
        staking_requirement_system_node_own_stake_chr = 0,
        staking_requirement_system_node_total_stake_chr = 0,
        staking_requirement_dapp_node_own_stake_chr = 1,
        staking_requirement_dapp_node_total_stake_chr = 0
    );

    var psa = run_staking_pay_out(
        reward = 10,
        staking_amount = 10
    );
    rell.test.tx().op(staking_claim_rewards(true, true)).sign(admin_privkey).run();

    assert_equals(get_account_balance(psa.staking_account), (10 * (1 - psa.provider.staking_rewards_share)).round().to_big_integer());
    assert_gt(psa.last_approved_stake_requirements, 0);

    val node = node @ { node_pubkey };
    var last_approved_stake_requirements = psa.last_approved_stake_requirements;
    val node_reward = map<node, big_integer>();
    node_reward[node] = 10;

    // Staking not OK - pay reward since number of days not yet reached for a stop
    update_staking_requirements_constants(
        staking_requirement_dapp_node_total_stake_chr = 1000000
    );
    rell.test.set_next_block_time_delta((economy_constants.staking_requirement_stop_payout_days - 1) * DAY_MS); // Time is limit-1 day
    rell.test.block().run();

    rell.test.tx().op(
        pay_out_node_rewards_op(node_reward, true)
    ).nop().sign(provider_key).run();

    psa = provider_staking_account @ { provider @ { provider_pubkey } };

    rell.test.tx().op(staking_claim_rewards(true, true)).sign(admin_privkey).nop().run();

    assert_equals(get_account_balance(psa.staking_account), (20 * (1 - psa.provider.staking_rewards_share)).round().to_big_integer());
    assert_equals(psa.last_approved_stake_requirements, last_approved_stake_requirements);

    // Staking not OK - do not pay reward since number of days passed
    rell.test.set_next_block_time_delta(2 * DAY_MS); // + 2 days (days limit passed)
    rell.test.block().run();

    node_reward[node] = 20;
    rell.test.tx().op(
        pay_out_node_rewards_op(node_reward, true)
    ).sign(provider_key).run();

    psa = provider_staking_account @ { provider @ { provider_pubkey } };

    assert_equals(get_account_balance(psa.staking_account), (20 * (1 - psa.provider.staking_rewards_share)).round().to_big_integer());
    assert_equals(psa.last_approved_stake_requirements, last_approved_stake_requirements);
}

///////////////////
// Helper functions

function add_delegation_share(total: big_integer) {
    return (total / (1 - delegation_share)).round().to_big_integer();
}

function get_delegation_share(total: big_integer) {
    return (total * delegation_share).round().to_big_integer();
}

function remove_delegation_share(total: big_integer) {
    return (total * (1 - delegation_share)).round().to_big_integer();
}

function run_staking_pay_out(
    reward: integer = 10,
    staking_amount: integer = 0,
    staking_rewards_share: decimal = 0.1,
) {

    if (not state.initialized) rell.test.tx().op(init()).run();

    val system_cluster = ensure_system_cluster();
    val cluster = ensure_cluster(cluster_name, false, false, 1, 1024);
    val provider = add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER);
    rell.test.tx().op(
        set_provider_staking_rewards_share(provider_pubkey, staking_rewards_share)
    ).run();
    assert_equals(staking_provider_staking_rewards_share(provider_pubkey), staking_rewards_share);
    val node = ensure_node(provider_pubkey, node_pubkey, true, "SE", 1, 1024, false);
    add_cluster_node(cluster_name, node_pubkey, false);
    val system_node = ensure_node(provider_pubkey, system_node_pubkey, true, "SE", 1, 1024, false);
    add_cluster_node(system_cluster_name, system_node_pubkey, false);

    rell.test.tx().op(
        register_provider_account_op(provider)
    ).sign(provider_key).run();

    val psa = provider_staking_account @ { provider @ { provider_pubkey } };
    assert_equals(get_account_balance(psa.staking_account), 0);
    assert_equals(psa.last_approved_stake_requirements, 0);

    val node_reward = map<node, big_integer>();
    node_reward[node] = reward;
    rell.test.tx().op(
        add_staking(psa, staking_amount)
    ).sign(provider_key).run();

    rell.test.set_next_block_time_delta(chain_context.args.staking_delegation_delay_ms);
    rell.test.block().run();

    rell.test.tx().op(
        pay_out_node_rewards_op(node_reward, true)
    ).sign(provider_key).run();

    return provider_staking_account @ { provider @ { provider_pubkey } };
}

function run_calculate_reward(node_availability_report: node_availability_report, create_lease_number: integer, calculate_system_reward: boolean, provider_staking_rewards_share: decimal = 0.1) {

    if (not state.initialized) rell.test.tx().op(init()).run();

    val system_cluster = ensure_system_cluster();
    val cluster = ensure_cluster(cluster_name, false, false, 1, 1024);
    val provider = add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER, staking_rewards_share = provider_staking_rewards_share);
    val node = ensure_node(provider_pubkey, node_pubkey, true, "SE", 1, 1024, false);
    add_cluster_node(cluster_name, node_pubkey, false);
    val system_node = ensure_node(provider_pubkey, system_node_pubkey, true, "SE", 1, 1024, false);
    add_cluster_node(system_cluster_name, system_node_pubkey, false);

    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));

    if (create_lease_number > 0) {
        rell.test.tx().op(
            create_lease("lease", create_lease_number, alice, cluster, false)
        ).run();
    }

    if (calculate_system_reward) {
        return calculate_system_cluster_rewards(system_cluster, node_availability_report)[system_node] * (1 - provider.staking_rewards_share);
    } else {
        return calculate_dapp_cluster_rewards(cluster, node_availability_report)[node] * (1 - provider.staking_rewards_share);
    }
}

function run_pay_rewards(
    pool_assets: big_integer = 0,
    calculate_system_reward: boolean,
    reward_debt: big_integer = 0,
    node_availability: map<byte_array, decimal> = [node_pubkey: 1.0],
    deleted_nodes: list<pubkey> = []
) {

    if (not state.initialized) rell.test.tx().op(init()).run();

    update_staking_requirements_constants(staking_requirements_enabled = false);

    val system_cluster = ensure_system_cluster();
    val cluster = ensure_cluster(cluster_name, false, false, 1, 1024);
    val provider = add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER);
    val node = ensure_node(provider_pubkey, node_pubkey, true, "SE", 1, 1024, false);
    val node_availability_report = node_availability_report(start_time = 0, end_time = 0, node_availability);

    val calculate_cluster = if (calculate_system_reward) system_cluster else cluster;
    add_cluster_node(calculate_cluster.name, node_pubkey, false);
    for (deleted_node in deleted_nodes) {
        add_reward_provider_deleted_node(provider, deleted_node, calculate_cluster);
    }

    rell.test.tx().op(
        set_pool_details_last_refill_millis_last_block_time_op()
    ).run();

    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    if (pool_assets != 0) {
        add_assets_to_pool(pool_assets);
    }

    rell.test.tx().op(
        register_provider_account_op(provider),
        set_reward_debt_op(provider_pubkey, reward_debt),
        pay_rewards_op(calculate_cluster, node_availability_report)
    ).sign(provider_key).run();

    val pa = provider_account @ { provider @ { provider_pubkey } };
    return pa;
}

function run_pay_reward(reward: big_integer = 0, refill: boolean) {

    if (not state.initialized) rell.test.tx().op(init()).run();

    val pool = get_pool_account();

    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));

    if (not refill) {
        rell.test.tx().op(
            set_pool_details_last_refill_millis_last_block_time_op()
        ).run();
    }

    rell.test.tx().op(
        pay_reward_op(pool, alice, 0, reward, "test", 0.0)
    ).run();

    return alice;
}

function test_reset_provider_rewards() {
    val pa = run_pay_rewards(0, false);

    assert_equals(pa.reward_debt, TEST_DAPP_CLUSTER_VALUE);

    rell.test.tx().op(
        reset_provider_reward_debt(provider_pubkey)
    ).sign(rell.test.keypairs.alice).run_must_fail("Operation must be signed by provider " + provider_pubkey);

    rell.test.tx().op(
        reset_provider_reward_debt(provider_pubkey)
    ).sign(provider_key).run();

    assert_equals(pa.reward_debt, 0);
}

function test_sn_initial_mainnet_reward() {
    add_provider(rell.test.keypairs.alice.pub, true, provider_tier.NODE_PROVIDER);

    val scu_price = 12864857;
    val extra_storage_price = 4142;
    val create_lease_number = 5;

    rell.test.tx().op(
        update_system_provider_economy_constants(
            118, // cant set decimals - 457142, // total cost system provider USD
            0.1, // System provider fee share
            0.1, // System provider risk share
        ),
        update_chr_per_usd(4)
    ).sign(admin_privkey).run();
    rell.test.tx().op(
        update_economy_constants(
            rell.test.keypairs.alice.pub,
            1,  // min_lease_time_weeks: integer?,
            1,  // max_lease_time_weeks: integer?,
            0,  // staking_reward_rate: decimal?,
            0.1, // chromia_foundation_fee_share: decimal?,
            0.1, // resource_pool_margin_fee_share: decimal?,
            0.2, // dapp_provider_risk_share: decimal?
        )

    ).sign(rell.test.keypairs.alice).run();

    val node_availability_report = node_availability_report(start_time = 0, end_time = 0, [system_node_pubkey: 1.0]); // 100 % availability

    if (not state.initialized) rell.test.tx().op(init()).run();

    val system_cluster = ensure_system_cluster();
    val cluster = ensure_cluster(cluster_name, false, false, 1, 1024,
        scu_price = scu_price, extra_storage_price = extra_storage_price
    );
    val provider = add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER, staking_rewards_share = 0);
    val node = ensure_node(provider_pubkey, node_pubkey, true, "SE", 1, 1024, false);
    add_cluster_node(cluster_name, node_pubkey, false);
    val system_node = ensure_node(provider_pubkey, system_node_pubkey, true, "SE", 1, 1024, false);
    add_cluster_node(system_cluster_name, system_node_pubkey, false);

    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));

    rell.test.tx().op(
        create_lease("lease", create_lease_number, alice, cluster, false)
    ).run();

    val reward = calculate_system_cluster_rewards(system_cluster, node_availability_report)[system_node];

    log("--------------------------------------");
    log("Reward: %s raw CHR".format(reward));
    log("Reward: %s CHR".format(decimal(reward) / units_per_asset));
    log("Reward: %s USD".format((decimal(reward) / units_per_asset) / economy_constants.chr_per_usd));
    log("CHR per USD: %s".format(economy_constants.chr_per_usd));
}

