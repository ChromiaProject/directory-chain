@test module;

import ^^.*;
import ^.helper_functions.*;
import ^.helper_operations.*;
import provider_auth.test.helper_operations.*;

function test_migrate_provider_staking_accounts() {

    // Create 3 providers and their accounts
    add_provider(rell.test.pubkeys.alice, false, provider_tier.NODE_PROVIDER);
    add_provider(rell.test.pubkeys.bob, false, provider_tier.NODE_PROVIDER);
    add_provider(rell.test.pubkeys.charlie, false, provider_tier.NODE_PROVIDER);

    // Purge all provider_staking_account entities and set migration to not be completed
    rell.test.tx().op(
        purge_provider_staking_account_entities(),
        set_migrations_completed(false)
    ).run();

    // Migrate
    rell.test.block().run();

    // Make sure provider_staking_account entities were created
    assert_equals(migration_completed.provider_staking_account_entity, true);
    assert_equals(provider_staking_account @ {} ( @sum 1 ), 3);

    for (pa in provider_account @* {}) {
        assert_true(exists(provider_staking_account @? { pa.provider,
            .staking_account.id == pa.account.id,
            .last_approved_stake_requirements == pa.last_approved_stake_requirements
        }));
    }
}

function test_migrate_provider_keys() {

    // The migration has already been done, but lets flip it to trigger it again next block building
    // and also set the system_p voter type it will have before migration.
    add_provider(rell.test.pubkeys.alice, false, provider_tier.NODE_PROVIDER);
    rell.test.tx().op(
        set_provider_multi_key_false(),
        set_system_p_member_key_vote_set(),
    ).run();

    assert_equals(system_p_voter_set().member_key_type, common_proposal_vote_type.VOTER_SET_MEMBER_KEY);

    // Will only be run once
    rell.test.block().run();

    // System_p voter set is changed to provider auth
    assert_equals(system_p_voter_set().member_key_type, common_proposal_vote_type.PROVIDER_AUTH);

    // Key is created
    val keys = provider_auth_key @* { .provider_pubkey == rell.test.keypairs.alice.pub, .active };
    assert_equals(keys.size(), 1);
    assert_equals(keys[0].provider_pubkey, rell.test.keypairs.alice.pub);
    assert_equals(keys[0].pubkey, rell.test.keypairs.alice.pub);
    assert_equals(keys[0].provider_key_role, provider_key_role.main);

    // Default threshold is set
    val threshold = provider_auth_threshold @ { .provider_pubkey == rell.test.keypairs.alice.pub, provider_key_role.main } ( .threshold );
    assert_equals(threshold, 1);

    // Migration job marked as completed
    assert_true(migration_completed.provider_multi_key);

    // Test auth - fail with no key type set
    rell.test.tx().op(
        provider_is_signer_op(rell.test.keypairs.alice.pub, []),
    ).sign(rell.test.keypairs.alice).run_must_fail("auth failed");

    // Test auth - works
    rell.test.tx().op(
        provider_is_signer_op(rell.test.keypairs.alice.pub, [provider_key_role.main]),
        provider_is_signer_op(rell.test.keypairs.alice.pub, [provider_key_role.main, provider_key_role.configuration_proposal_vote]),
    ).sign(rell.test.keypairs.alice).run();
}

function test_migrate_publish_staking_state() {

    rell.test.tx().op(init()).run();

    val users = list([
        rell.test.keypairs.alice,
        rell.test.keypairs.bob,
        rell.test.keypairs.charlie,
        rell.test.keypairs.dave,
        rell.test.keypairs.eve,
        rell.test.keypairs.frank,
    ]);

    val user_account_ids = list<pubkey>();
    for (keypair in users) {
        val evm_address = crypto.eth_privkey_to_address(keypair.priv);
        do_evm_stake_update_bsc(evm_address, 50 * units_per_asset);
        val test_account = require(do_create_account_using_ras_staking(keypair));
        user_account_ids.add(test_account.id);
        assert_equals(staking_get_balance(test_account.id), 50 * units_per_asset);
    }

    assert_equals(staking_total_accounts(), 6);

    rell.test.tx().op(
        set_migrations_completed(publish_staking_state = false)
    ).run();

    for (i in range(users.size() / 2 + 1)) {

        // The last iteration will set this to true
        assert_false(migration_completed.publish_staking_state);

        rell.test.block().run();

        if (not migration_completed.publish_staking_state) {
            assert_events(
                ("icmf_message",(topic = economy_chain_staking_state_update, body = economy_chain_staking_state_update_message(
                    user_account_ids[i * 2],
                    50 * units_per_asset,
                    list<economy_chain_staking_state_withdrawal>(),
                ).to_gtv()).to_gtv_pretty()),
                ("icmf_message",(topic = economy_chain_staking_state_update, body = economy_chain_staking_state_update_message(
                    user_account_ids[i * 2 + 1],
                    50 * units_per_asset,
                    list<economy_chain_staking_state_withdrawal>(),
                ).to_gtv()).to_gtv_pretty()),
            );
        }
    }

    assert_true(migration_completed.publish_staking_state);
    assert_true(migration_staking_account_state_published @ {} ( @sum 1 ) == 0);
}

function test_migrate_publish_staking_state_multiple_networks() {

    rell.test.tx().op(init()).run();

    val evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);
    do_evm_stake_update_eth(evm_address, 50 * units_per_asset);
    do_evm_stake_update_bsc(evm_address, 50 * units_per_asset);
    val test_account = require(do_create_account_using_ras_staking(rell.test.keypairs.alice));
    assert_equals(staking_get_balance(test_account.id), 2 * 50 * units_per_asset);

    rell.test.tx().op(
        set_migrations_completed(publish_staking_state = false)
    ).run();

    rell.test.block().run();
    assert_false(migration_completed.publish_staking_state);

    rell.test.block().run();
    assert_true(migration_completed.publish_staking_state);
    assert_true(migration_staking_account_state_published @ {} ( @sum 1 ) == 0);
}
