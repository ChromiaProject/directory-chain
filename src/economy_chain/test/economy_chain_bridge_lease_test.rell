@test module;

import ^^.*;
import ^.helper_functions.*;
import ^.helper_operations.*;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.assets;
    import lib.ft4.auth;
    import test_utils: lib.ft4.test.core;
}
import lib.auth;

struct module_args {
    auth_privkey: byte_array;
    admin_privkey: byte_array;
    container_removal_timeout: integer;
}

val auth_privkey = chain_context.args.auth_privkey;
val cluster_name = "test_cluster";
val brid = x"00".repeat(32);

function test_bridge_lease_add_update_and_remove() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init, cluster_name = cluster_name, container_units = 2);

    val container_lease = lease @ { container_name };

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, add_bridge_lease(container_name, brid, 1, "validator", "bridge", false)),
        add_bridge_lease(container_name, brid, 1, "validator", "bridge", false)
    ).sign(rell.test.keypairs.alice).run();

    assert_not_null(bridge_lease @? { .lease == container_lease });
    assert_events(("icmf_message", (
        topic = bridge_mapping_topic,
        body = bridge_mapping_message(
            blockchain_rid = brid,
            validator_contract = "validator",
            bridge_contract = "bridge",
            evm_network_id = 1,
            deleted = false
        ).to_gtv()
    ).to_gtv_pretty()));
    assert_equals(bridge_lease @? { .lease == container_lease } ( .anomaly_detection ), false);
    assert_true(empty(get_blockchains_with_bridge_and_anomaly_detection()));
    assert_equals(get_lease_by_container_name(container_name)!!.bridge_leases[0].bridge_contract, "bridge");

    // Duplicates prevented
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, add_bridge_lease(container_name, brid, 1, "validator", "bridge", false)),
        add_bridge_lease(container_name, brid, 1, "validator", "bridge", false)
    ).nop().sign(rell.test.keypairs.alice).run_must_fail("Bridge lease already exists for blockchain %s and EVM network 1".format(brid));

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, update_bridge_lease(brid, 1, "validator2", "bridge2", true)),
        update_bridge_lease(brid, 1, "validator2", "bridge2", true)
    ).sign(rell.test.keypairs.alice).run();
    assert_equals(bridge_lease @? { .lease == container_lease } ( .anomaly_detection ), true);
    assert_equals(get_blockchains_with_bridge_and_anomaly_detection(), [bridge_anomaly_detector_data(
        blockchain_rid = brid,
        evm_network_id = 1,
        bridge_contract = "bridge2"
    )]);

    val updated_bridge_lease = bridge_lease @ { .lease == container_lease };
    assert_equals(updated_bridge_lease.validator_contract, "validator2");
    assert_equals(updated_bridge_lease.bridge_contract, "bridge2");

    assert_events(("icmf_message", (
        topic = bridge_mapping_topic,
        body = bridge_mapping_message(
            blockchain_rid = brid,
            validator_contract = "validator2",
            bridge_contract = "bridge2",
            evm_network_id = 1,
            deleted = false
        ).to_gtv()
    ).to_gtv_pretty()));

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, remove_bridge_lease(brid, 1)),
        remove_bridge_lease(brid, 1)
    ).sign(rell.test.keypairs.alice).run();

    assert_null(bridge_lease @? { .lease == container_lease });
}

function test_expired_container_lease_removes_bridge_leases() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init, cluster_name = cluster_name, container_units = 2);

    val container_lease = lease @ { container_name };

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, add_bridge_lease(container_name, brid, 1, "validator", "bridge", false)),
        add_bridge_lease(container_name, brid, 1, "validator", "bridge", false)
    ).sign(rell.test.keypairs.alice).run();

    assert_not_null(bridge_lease @? { .lease == container_lease });

    rell.test.set_next_block_time_delta(millis_per_week + 1);
    rell.test.block().run();
    rell.test.set_next_block_time_delta(1);
    rell.test.block().run();

    assert_true(container_lease.expired);
    assert_events(("icmf_message", (
        topic = stop_container_topic,
        body = stop_container_message(container_name).to_gtv()
    ).to_gtv_pretty()),
    ("icmf_message", (
        topic = bridge_mapping_topic,
        body = bridge_mapping_message(
            blockchain_rid = brid,
            validator_contract = "validator",
            bridge_contract = "bridge",
            evm_network_id = 1,
            deleted = true
        ).to_gtv()
    ).to_gtv_pretty()));

    // Assert no mappings can be added/updated when lease is expired
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, add_bridge_lease(container_name, brid, 2, "validator", "bridge", false)),
        add_bridge_lease(container_name, brid, 1, "validator", "bridge", false)
    ).sign(rell.test.keypairs.alice).run_must_fail("Container lease is expired");
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, update_bridge_lease(brid, 1, "validator2", "bridge2", false)),
        update_bridge_lease(brid, 1, "validator2", "bridge2", false)
    ).sign(rell.test.keypairs.alice).run_must_fail("Container lease is expired");

    // Assert complete removal when lease is removed
    rell.test.set_next_block_time_delta(chain_context.args.container_removal_timeout);
    rell.test.block().run();
    rell.test.block().run();
    assert_events(("icmf_message", (
        topic = remove_container_topic,
        body = remove_container_message(container_name).to_gtv()
    ).to_gtv_pretty()));
    assert_null(bridge_lease @? { .lease == container_lease });
}

function test_bridge_leases_are_transferred_on_container_upgrade() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init, cluster_name = cluster_name, container_units = 2);

    val container_lease = lease @ { container_name };
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, add_bridge_lease(container_name, brid, 1, "validator", "bridge", false)),
        add_bridge_lease(container_name, brid, 1, "validator", "bridge", false)
    ).sign(rell.test.keypairs.alice).run();

    assert_not_null(bridge_lease @? { .lease == container_lease });

    val upgraded_container_name = do_upgrade_container(alice, rell.test.keypairs.alice, success = true, block_height = 5, ticket_id = ticket_id_after_init + 7, current_lease = container_lease, container_units = 3, cluster_name = cluster_name, upgraded_container_name = "upgraded_container");

    val upgraded_container_lease = lease @ { upgraded_container_name };
    assert_null(bridge_lease @? { .lease == container_lease });
    assert_not_null(bridge_lease @? { .lease == upgraded_container_lease });
}

function test_bridge_lease_add_required_funds() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init, cluster_name = cluster_name, container_units = 2);

    val container_lease = lease @ { container_name };

    // Can't create due to insufficient account funds
    rell.test.tx().op(
        empty_account_op(alice)
    ).run();

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, add_bridge_lease(container_name, brid, 1, "validator", "bridge", false)),
        add_bridge_lease(container_name, brid, 1, "validator", "bridge", false)
    ).sign(rell.test.keypairs.alice)
        .run_must_fail("An amount of %s is required on account to add a bridge lease".format(economy_constants.bridge_lease_add_min_balance_usd));

    // Sufficient funds - add bridge contract
    rell.test.tx().op(
        mint_to(alice, (economy_constants.bridge_lease_add_min_balance_usd * economy_constants.chr_per_usd * units_per_asset).to_big_integer())
    ).run();

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, add_bridge_lease(container_name, brid, 1, "validator", "bridge", false)),
        add_bridge_lease(container_name, brid, 1, "validator", "bridge", false)
    ).sign(rell.test.keypairs.alice).run();

    assert_not_null(bridge_lease @? { .lease == container_lease });
}

function test_invalid_bridge_lease_brid() {
    rell.test.tx().op(init(), create_test_cluster(cluster_name)).run();
    val alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val container_name = do_create_container(alice, rell.test.keypairs.alice, success = true, ticket_id = ticket_id_after_init, cluster_name = cluster_name, container_units = 2);

    val container_lease = lease @ { container_name };

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, add_bridge_lease(container_name, x"01", 1, "validator", "bridge", false)),
        add_bridge_lease(container_name, x"01", 1, "validator", "bridge", false)
    ).sign(rell.test.keypairs.alice).run_must_fail("blockchain_rid must be 32 bytes");
}
