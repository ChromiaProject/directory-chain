@test module;

import ^^.*;
import ^.helper_functions.*;

function test_propose_price_oracle_rate_require_system_provider_signer() {

    rell.test.tx().op(
        propose_price_oracle_rate([
            pending_price_oracle_rate_data(symbol = "CHR", name = "Chromia", price = 2)
        ])
    ).run_must_fail("Expected system provider signature");
}

function test_propose_price_oracle_rate_validate_input() {

    add_provider(rell.test.keypairs.alice.pub, true, provider_tier.NODE_PROVIDER);

    rell.test.tx().op(
        propose_price_oracle_rate([])
    ).sign(rell.test.keypairs.alice).run_must_fail("Proposal has no symbol rates");

    rell.test.tx().op(
        propose_price_oracle_rate([
            pending_price_oracle_rate_data(symbol = "CHR", price = 2)
        ])
    ).sign(rell.test.keypairs.alice).run_must_fail("Name is required for new tokens");

    rell.test.tx().op(
        propose_price_oracle_rate([
            pending_price_oracle_rate_data(symbol = "CHR", name = "Chromia", price = -1)
        ])
    ).sign(rell.test.keypairs.alice).run_must_fail("Price for CHR must be positive");
}

function test_propose_price_oracle_rate_update_and_add_saucessfully() {

    add_provider(rell.test.keypairs.alice.pub, true, provider_tier.NODE_PROVIDER);

    // Create sender
    rell.test.tx().op(
        icmf_message_op(x"", blockchain_rid_topic, body = blockchain_rid(rid = x"", name = blockchains.price_oracle_chain_name).to_gtv())
    ).run();

    // Create entity
    rell.test.tx().op(
        icmf_message_op(x"", token_price_changed_topic, body = token_price_changed_body(
            symbol = "CHR",
            name = "Chromia",
            1.1
        ).to_gtv())
    ).run();

    assert_equals(price_oracle_rates @ { .symbol == "CHR" } ( .price ), 1.1);

    // Update existing one and add a new symbol
    rell.test.tx().op(
        propose_price_oracle_rate([
            pending_price_oracle_rate_data(symbol = "CHR", 1.2),
            pending_price_oracle_rate_data(symbol = "ETH", name = "Ethereum", 123.456),
        ])
    ).sign(rell.test.keypairs.alice).run();

    assert_equals(price_oracle_rates @ { .symbol == "CHR" } ( .price ), 1.2);
    assert_equals(price_oracle_rates @ { .symbol == "ETH" } ( .price ), 123.456);

    assert_true(empty(pending_price_oracle_rate @* { }));
}

function test_get_price_oracle_rate_proposal() {

    add_provider(rell.test.keypairs.alice.pub, true, provider_tier.NODE_PROVIDER);
    add_provider(rell.test.keypairs.bob.pub, true, provider_tier.NODE_PROVIDER);

    // Create sender
    rell.test.tx().op(
        icmf_message_op(x"", blockchain_rid_topic, body = blockchain_rid(rid = x"", name = blockchains.price_oracle_chain_name).to_gtv())
    ).run();

    // Create entity
    rell.test.tx().op(
        icmf_message_op(x"", token_price_changed_topic, body = token_price_changed_body(
            symbol = "CHR",
            name = "Chromia",
            1.1
        ).to_gtv())
    ).run();

    rell.test.tx().op(
        propose_price_oracle_rate([
            pending_price_oracle_rate_data(symbol = "CHR", 1.2),
            pending_price_oracle_rate_data(symbol = "ETH", name = "Ethereum", 123.456),
        ])
    ).sign(rell.test.keypairs.alice).run();

    val proposal = get_price_oracle_rate_proposal(get_latest_proposal_id());
    assert_equals(proposal.size(), 2);
    assert_equals(proposal[0].symbol, "CHR");
    assert_equals(proposal[0].name, null);
    assert_equals(proposal[0].price, 1.2);
    assert_equals(proposal[1].symbol, "ETH");
    assert_equals(proposal[1].name, "Ethereum");
    assert_equals(proposal[1].price, 123.456);
}
