@test module;

import ^^.*;

function test_valid_entity_name() {
    validate_entity_name("f");
    validate_entity_name("foobar_BAR_1");
}

function test_names_cannot_be_empty() {
    assert_fails("Entity name cannot be empty", validate_entity_name("", *));
}

function test_valid_entity_name_invalid() {
    assert_fails(invalid_entity_message, validate_entity_name("_name", *));
}
