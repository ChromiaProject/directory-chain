@test module;

import ^^.*;
import ^.helper_functions.*;
import common_proposal.test.helper_functions.*;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.assets;
    import lib.ft4.auth;
    import test_utils: lib.ft4.test.core;
}

struct module_args {
    account_creator_privkey: byte_array = x"F5216FCCF80F13A2CCEA31F331D881A620F60596B21A9737989297896A8F7E65";
}

val auth_privkey = chain_context.args.account_creator_privkey;

val provider_key = rell.test.keypairs.bob;
val provider_pubkey = provider_key.pub;
val cluster_name = "bob_cluster";
val cluster_bob = "bob_cluster";
val cluster_charlie = "charlie_cluster";
val node_pubkey_bob = rell.test.pubkeys.bob;
val node_pubkey_charlie = rell.test.pubkeys.charlie;
val node_pubkey_alice = rell.test.pubkeys.alice;
val node_pubkey_dave = rell.test.pubkeys.dave;
val node_pubkey_eve = rell.test.pubkeys.eve;

function test_get_all_provider_nodes_by_cluster() {
    val provider1 = add_provider(rell.test.pubkeys.alice, false, provider_tier.NODE_PROVIDER);
    val provider2 = add_provider(rell.test.pubkeys.bob, false, provider_tier.NODE_PROVIDER);
    val node1 = x"0001"; // In cluster 1
    val node2 = x"0002"; // In cluster 2
    val node4 = x"0004"; // Deleted node, previously in cluster 1
    val node5 = x"0005"; // Provider 2 node

    val cluster1 = ensure_cluster("c1", false, false, 1, 1024);
    val cluster2 = ensure_cluster("c2", false, false, 1, 1024);
    ensure_node(provider1.pubkey, node1, true, "SE", 1, 1024, false);
    ensure_node(provider1.pubkey, node2, true, "SE", 1, 1024, false);
    ensure_node(provider2.pubkey, node5, true, "SE", 1, 1024, false);
    add_cluster_node(cluster1.name, node1, false);
    add_cluster_node(cluster2.name, node2, false);
    add_cluster_node(cluster1.name, node5, false);
    add_reward_provider_deleted_node(provider1, node4, cluster1);

    assert_equals(get_all_provider_nodes_by_cluster(provider1), map<text, set<pubkey>>([
        ("c1", set([node1, node4])),
        ("c2", set([node2])),
    ]));
}

function test_get_average_availability_on_a_providers_nodes() {
    val provider = add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER);
    ensure_node(provider_pubkey, node_pubkey_bob, true, "SE", 1, 1024, false);
    ensure_node(provider_pubkey, node_pubkey_charlie, true, "SE", 1, 1024, false);
    val cluster1 = ensure_cluster(cluster_bob, false, false, 1, 1024);
    val cluster2 = ensure_cluster(cluster_charlie, false, false, 1, 1024);
    add_cluster_node(cluster1.name, node_pubkey_bob, false);
    add_cluster_node(cluster2.name, node_pubkey_charlie, false);
    val last_block_time = get_last_blocktime();
    val node_availability_report1 = node_availability_report(start_time = 0, end_time = last_block_time, [node_pubkey_charlie: 0.90]);
    val node_availability_report2 = node_availability_report(start_time = 0, end_time = last_block_time, [node_pubkey_bob: 1.0]);
    rell.test.tx().op(
        save_node_availability_op(node_availability_report1),
        save_node_availability_op(node_availability_report2))
        .sign(provider_key)
        .run();

    val provider_cluster_nodes = get_all_provider_nodes_by_cluster(provider);
    val average = get_average_availability_on_a_provider_nodes_in_the_last_24h(provider_cluster_nodes);

    assert_equals(average, 0.95);
}

function test_get_average_availability_on_a_providers_nodes_only_last_24_hours() {
    val provider = add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER);
    ensure_node(provider_pubkey, node_pubkey_bob, true, "SE", 1, 1024, false);
    val cluster1 = ensure_cluster(cluster_bob, false, false, 1, 1024);
    add_cluster_node(cluster1.name, node_pubkey_bob, false);
    val node_availability_report1 = node_availability_report(start_time = 1, end_time = get_last_blocktime(), [node_pubkey_bob: 1.0]);
    rell.test.block().run();
    rell.test.set_next_block_time(get_last_blocktime() + millis_per_day);
    rell.test.block().run();
    val last_blocktime = get_last_blocktime();
    val node_availability_report2 = node_availability_report(start_time = last_blocktime, end_time = last_blocktime, [node_pubkey_bob: 0.5]);
    rell.test.tx().op(
        save_node_availability_op(node_availability_report1),
        save_node_availability_op(node_availability_report2))
        .sign(provider_key)
        .run();

    val cluster_nodes = get_all_provider_nodes_by_cluster(provider);
    val average = get_average_availability_on_a_provider_nodes_in_the_last_24h(cluster_nodes);

    assert_equals(average, 0.5);
}

function test_get_average_availability_on_a_providers_nodes_in_the_last_24h_no_availability_data() {
    val provider = add_provider(provider_pubkey, false, provider_tier.NODE_PROVIDER);
