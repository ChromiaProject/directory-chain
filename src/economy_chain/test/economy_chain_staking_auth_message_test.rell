@test module;

import ^^.*;

function test_staking_deposit_auth_message_without_delegate() {
    assert_equals(
        staking_deposit_auth_message([(1000000).to_gtv(), null.to_gtv()].to_gtv()),
        "Please sign the message\nto transfer 1.000000 tCHR from account {account_id} \nto deposit account."
    );
}

function test_staking_deposit_auth_message_with_delegate() {
    val provider_pubkey = rell.test.keypairs.alice.pub;

    assert_equals(
        staking_deposit_auth_message([(1000000).to_gtv(), provider_pubkey.to_gtv()].to_gtv()),
        "Please sign the message\nto transfer 1.000000 tCHR from account {account_id} \nto deposit account.\nand delegate to provider %s."
            .format(provider_pubkey)
    );
}
