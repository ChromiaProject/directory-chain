function test_get_available_subnode_jar_extensions_for_cluster() {
    rell.test.tx().op(init()).run();
    val bob = add_provider(rell.test.pubkeys.bob);
    rell.test.tx().op(create_test_cluster("cluster")).run();
    rell.test.tx()
        .op(create_test_subnode_jar_extension(name = "common_active", owner = bob))
        .op(create_test_subnode_jar_extension(name = "common_inactive", owner = bob, active = false))
        .op(create_test_subnode_jar_extension(name = "special_active", owner = bob, subnode_jar_extension_type = subnode_jar_extension_type.SPECIAL, cluster_name = "cluster"))
        .op(create_test_subnode_jar_extension(name = "special_inactive", owner = bob, subnode_jar_extension_type = subnode_jar_extension_type.SPECIAL, active = false, cluster_name = "cluster"))
        .run();

    assert_equals(get_available_subnode_jar_extensions_for_cluster("cluster"), [
        subnode_jar_extension_data(name = "common_active", owner = bob.pubkey, description = "description"),
        subnode_jar_extension_data(name = "special_active", owner = bob.pubkey, description = "description"),
    ]);
}

function test_get_tag_proposal() {

    rell.test.tx().op(
        create_pending_tag_operation("t1", 1, 2))
        .sign(provider_key)
        .run();

    val tag_proposal = get_tag_proposal(get_latest_common_proposal_id());
    assert_equals(tag_proposal.name, "t1");
    assert_equals(tag_proposal.scu_price, 1);
    assert_equals(tag_proposal.extra_storage_price, 2);
}

function test_get_cluster_create_proposal() {

    rell.test.tx().op(
        create_pending_cluster(cluster_name, "t1", pending_cluster_status.PENDING_APPROVAL,
        container_unit_cpu = 100,
        container_unit_io_read = 30,
        ))
        .sign(provider_key)
        .run();

    val cluster_create_proposal = get_cluster_create_proposal(get_latest_common_proposal_id());

    assert_equals(cluster_create_proposal.name, cluster_name);
    assert_equals(cluster_create_proposal.tag, "t1");
    assert_equals(cluster_create_proposal.proposer_pubkey, x"");
    assert_equals(cluster_create_proposal.governor_voter_set_name, "governor_voter_set_name");
    assert_equals(cluster_create_proposal.voter_set_name, "voter_set_name");
    assert_equals(cluster_create_proposal.cluster_units, 1);
    assert_equals(cluster_create_proposal.extra_storage, 1);

    assert_equals(cluster_create_proposal.container_unit_cpu, 100);
    assert_equals(cluster_create_proposal.container_unit_ram, 2048);
    assert_equals(cluster_create_proposal.container_unit_io_read, 30);
    assert_equals(cluster_create_proposal.container_unit_io_write, 20);
    assert_equals(cluster_create_proposal.container_unit_storage, 16384);
    assert_equals(cluster_create_proposal.system_container_units, 4);


    assert_equals(cluster_create_proposal.status, pending_cluster_status.PENDING_APPROVAL);
}

function test_get_cluster_change_tag_proposal() {

    rell.test.tx().op(
        create_pending_cluster_change_tag(cluster_name, "t1", "t2"))
    .sign(provider_key)
    .run();

    val cluster_change_tag_propsal = get_cluster_change_tag_proposal(get_latest_common_proposal_id());

    assert_equals(cluster_change_tag_propsal.cluster, cluster_name);
    assert_equals(cluster_change_tag_propsal.current_tag, "t1");
    assert_equals(cluster_change_tag_propsal.new_tag, "t2");
}

function test_get_pool_account_id_query(){
    rell.test.tx().op(init()).run();

    val pool_account_id = get_pool_account_id_query();

    assert_equals(pool_account_id, x"ada12b87eab1c6fca6e99781a6059e1763e868baec5f5385dfca6c308cf1d605");
}
