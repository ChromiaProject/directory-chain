@test module;

import ^^.*;
import ^.helper_functions.*;
import common_proposal.test.helper_functions.*;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.assets;
    import lib.ft4.auth;
    import test_utils: lib.ft4.test.core;
}

struct module_args {
    account_creator_privkey: byte_array;
}

val auth_privkey = chain_context.args.account_creator_privkey;

val provider_key = rell.test.keypairs.bob;
val provider_pubkey = provider_key.pub;
val provider_alice_pubkey = rell.test.pubkeys.alice;
val cluster_name = "bob_cluster";
val cluster_bob = "bob_cluster";
val cluster_charlie = "charlie_cluster";
val node_pubkey_bob = rell.test.pubkeys.bob;
val node_pubkey_charlie = rell.test.pubkeys.charlie;
val node_pubkey_alice = rell.test.pubkeys.alice;
val node_pubkey_dave = rell.test.pubkeys.dave;

function test_get_all_tags() {
    val provider = add_provider(provider_pubkey, true, provider_tier.NODE_PROVIDER);
    rell.test.tx().op(
        create_tag(
            my_pubkey = provider_pubkey,
            name = "tag1",
            scu_price = 1,
            extra_storage_price = 2),
        create_tag(
            my_pubkey = provider_pubkey,
            name = "tag2",
            scu_price = 3,
            extra_storage_price = 4))
        .sign(provider_key)
        .run();

    val tags = get_tags();

    assert_equals(tags.size(), 2);
}

function test_get_tag_by_name() {
    val provider = add_provider(provider_pubkey, true, provider_tier.NODE_PROVIDER);
    rell.test.tx().op(
        create_tag(
            my_pubkey = provider_pubkey,
            name = "tag1",
            scu_price = 1,
            extra_storage_price = 2),
        create_tag(
            my_pubkey = provider_pubkey,
            name = "tag2",
            scu_price = 3,
            extra_storage_price = 4))
        .sign(provider_key)
        .run();

    val tag2 = get_tag_by_name("tag2");
    val non_existing_tag = get_tag_by_name("tagX");

    assert_not_null(tag2);
    assert_null(non_existing_tag);
}


function test_get_clusters() {
    rell.test.tx().op(init()).run();
    val bob = add_provider(rell.test.pubkeys.bob);
    val node_bob = ensure_node(rell.test.pubkeys.bob, rell.test.pubkeys.charlie, true, "SE", 2, 1024, false);

    rell.test.tx().op(
        create_test_cluster(cluster_name + "1", "tag-1", cluster_units = 11, extra_storage = 11),
        create_test_cluster(cluster_name + "2", "tag-2", cluster_units = 22, extra_storage = 22),
    ).sign(provider_key).run();
    rell.test.tx().op(
        create_cluster_node_op(cluster @ { cluster_name + "1" }, node_bob),
        create_test_subnode_image(name = "special_active", owner = bob, subnode_image_type = subnode_image_type.SPECIAL, cluster_name = cluster_name + "1"),
        create_test_subnode_image(name = "special_inactive", owner = bob, subnode_image_type = subnode_image_type.SPECIAL, active = false, cluster_name = cluster_name + "1"),
        create_test_subnode_jar_extension(name = "special_active", owner = bob, subnode_jar_extension_type = subnode_jar_extension_type.SPECIAL, cluster_name = cluster_name + "1"),
        create_test_subnode_jar_extension(name = "special_inactive", owner = bob, subnode_jar_extension_type = subnode_jar_extension_type.SPECIAL, active = false, cluster_name = cluster_name + "1"),
    ).sign(provider_key).run();

    val clusters = get_clusters();

    val expected = [
        cluster_data(
            name = cluster_name + "1",
            is_operational = true,
            cluster_units = 11,
            extra_storage = 11,
            tag_name = "tag-1",
            subnode_images = ["special_active"],
            number_of_nodes = 1,
            subnode_jar_extensions = ["special_active"]),
        cluster_data(
            name = cluster_name + "2",
            is_operational = true,
            cluster_units = 22,
            extra_storage = 22,
            tag_name = "tag-2",
            subnode_images = [],
            number_of_nodes = 0,
            subnode_jar_extensions = []),
    ];
    assert_equals(clusters, expected);
}

function test_get_cluster() {
    rell.test.tx().op(init()).run();
    val bob = add_provider(rell.test.pubkeys.bob);
    val node_bob = ensure_node(rell.test.pubkeys.bob, rell.test.pubkeys.charlie, true, "SE", 2, 1024, false);

    rell.test.tx().op(
        create_test_cluster(cluster_name, cluster_units = 11, extra_storage = 22),
    ).sign(provider_key).run();
    rell.test.tx().op(
        create_cluster_node_op(cluster @ { cluster_name }, node_bob),
        create_test_subnode_image(name = "special_active", owner = bob, subnode_image_type = subnode_image_type.SPECIAL, cluster_name = cluster_name),
        create_test_subnode_image(name = "special_inactive", owner = bob, subnode_image_type = subnode_image_type.SPECIAL, active = false, cluster_name = cluster_name),
        create_test_subnode_jar_extension(name = "special_active", owner = bob, subnode_jar_extension_type = subnode_jar_extension_type.SPECIAL, cluster_name = cluster_name),
        create_test_subnode_jar_extension(name = "special_inactive", owner = bob, subnode_jar_extension_type = subnode_jar_extension_type.SPECIAL, active = false, cluster_name = cluster_name),
    ).sign(provider_key)
        .run();

    val non_existing_cluster = get_cluster_by_name("cluster-name-does-not-exist");
    assert_null(non_existing_cluster);

    val cluster = get_cluster_by_name(cluster_name);
    val expected = cluster_data(
        name = cluster_name,
        is_operational = true,
        cluster_units = 11,
        extra_storage = 22,
        tag_name = "test-tag",
        subnode_images = ["special_active"],
        number_of_nodes = 1,
        subnode_jar_extensions = ["special_active"]);
    assert_equals(cluster, expected);
}

function test_get_cluster_creation_status_with_success() {

    rell.test.tx().op(
        create_test_cluster(cluster_name))
        .sign(provider_key)
        .run();

    val status = get_cluster_creation_status(cluster_name);

    assert_equals(status, cluster_creation_status.SUCCESS);
}

function test_get_cluster_creation_status_with_unknown() {

    val status = get_cluster_creation_status(cluster_name);

    assert_equals(status, cluster_creation_status.UNKNOWN);
}

function test_get_cluster_creation_status_with_pending_approval() {

    rell.test.tx().op(
        create_pending_cluster(cluster_name,
            "tag1",
            pending_cluster_status.PENDING_APPROVAL)
    )
        .sign(provider_key)
        .run();

    val status = get_cluster_creation_status(cluster_name);

    assert_equals(status, cluster_creation_status.PENDING_APPROVAL);
}

function test_get_cluster_creation_status_with_failure() {

    val provider = add_provider(provider_pubkey, true, provider_tier.NODE_PROVIDER);
    rell.test.tx().op( create_tag(
        my_pubkey = provider_pubkey,
        name = "tag1",
        scu_price = 1,
        extra_storage_price = 2),
        create_cluster(
            provider_pubkey,
            cluster_name,
            "governor_voter_set_name",
            "voter_set_name",
            1,
            1,
            container_unit_cpu = 50,
            container_unit_ram = 2048,
            container_unit_io_read = 25,
            container_unit_io_write = 20,
            container_unit_storage = 16384,
            system_container_units = 4,
            tag_name = "tag1"),
        receive_create_cluster_error_message_op(cluster_name, "error_message"))
        .sign(provider_key)
        .run();

    val status = get_cluster_creation_status(cluster_name);

    assert_equals(status, cluster_creation_status.FAILURE);
}

function test_get_available_subnode_images_for_all_clusters() {
    rell.test.tx().op(init()).run();
    val bob = add_provider(rell.test.pubkeys.bob);
    rell.test.tx().op(create_test_cluster("cluster")).run();
    rell.test.tx()
        .op(create_test_subnode_image(name = "common_active", owner = bob))
        .op(create_test_subnode_image(name = "common_inactive", owner = bob, active = false))
        .op(create_test_subnode_image(name = "special_active", owner = bob, subnode_image_type = subnode_image_type.SPECIAL, cluster_name = "cluster"))
        .op(create_test_subnode_image(name = "special_inactive", owner = bob, subnode_image_type = subnode_image_type.SPECIAL, active = false, cluster_name = "cluster"))
        .run();

    assert_equals(get_available_subnode_images_for_all_clusters(), [
        subnode_image_data(name = "common_active", url = "url", digest = "digest", owner = bob.pubkey, description = "description"),
    ]);
}

function test_get_available_subnode_images_for_cluster() {
    rell.test.tx().op(init()).run();
    val bob = add_provider(rell.test.pubkeys.bob);
    rell.test.tx().op(create_test_cluster("cluster")).run();
    rell.test.tx()
        .op(create_test_subnode_image(name = "common_active", owner = bob))
        .op(create_test_subnode_image(name = "common_inactive", owner = bob, active = false))
        .op(create_test_subnode_image(name = "special_active", owner = bob, subnode_image_type = subnode_image_type.SPECIAL, cluster_name = "cluster"))
        .op(create_test_subnode_image(name = "special_inactive", owner = bob, subnode_image_type = subnode_image_type.SPECIAL, active = false, cluster_name = "cluster"))
        .run();

    assert_equals(get_available_subnode_images_for_cluster("cluster"), [
        subnode_image_data(name = "common_active", url = "url", digest = "digest", owner = bob.pubkey, description = "description"),
        subnode_image_data(name = "special_active", url = "url", digest = "digest", owner = bob.pubkey, description = "description"),
    ]);
}

