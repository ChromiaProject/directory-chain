@test module;

import ^^.*;
import ^.helper_functions.*;
import ^.helper_operations.*;

namespace ft4 {
    import lib.ft4.accounts;
}

function test_set_provider_staking_account_validation() {

    // Provider and current staking account are both Alice

    // Invalid - no such provider
    rell.test.tx().op(
        set_provider_staking_account(rell.test.keypairs.alice.pub, rell.test.keypairs.bob.pub)
    )
        .sign(rell.test.keypairs.alice, rell.test.keypairs.bob)
        .run_must_fail("Operation must be signed by provider 0x02466d7fcae563e5cb09a0d1870bb580344804617879a14949cf22285f1bae3f27");

    // Invalid - must be signed by provider
    add_provider(rell.test.keypairs.alice.pub);
    rell.test.tx().op(
        set_provider_staking_account(rell.test.keypairs.alice.pub, rell.test.keypairs.bob.pub)
    )
        .sign(rell.test.keypairs.bob)
        .run_must_fail("must be signed by provider");

    // Invalid - not signed by new account
    rell.test.tx().op(
        set_provider_staking_account(rell.test.keypairs.alice.pub, rell.test.keypairs.bob.pub)
    )
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Operation must be signed by %s".format(rell.test.keypairs.bob.pub));

    // Invalid - account is already in use
    rell.test.tx().op(
        set_provider_staking_account(rell.test.keypairs.alice.pub, rell.test.keypairs.alice.pub)
    ).sign(rell.test.keypairs.alice, rell.test.keypairs.bob)
        .run_must_fail("already in use");

    // Change account to bob not be the same as provider key
    rell.test.tx().op(
        set_provider_staking_account(rell.test.keypairs.alice.pub, rell.test.keypairs.bob.pub)
    ).sign(rell.test.keypairs.alice, rell.test.keypairs.bob)
        .run();

    // Invalid - not signed by old account key bob
    rell.test.tx().op(
        set_provider_staking_account(rell.test.keypairs.alice.pub, rell.test.keypairs.charlie.pub)
    ).sign(rell.test.keypairs.alice, rell.test.keypairs.charlie)
    .run_must_fail("Operation must be signed by owner of account id ".format(rell.test.keypairs.alice.pub));
}

function test_set_provider_staking_account() {

    add_provider(rell.test.keypairs.alice.pub);

    assert_true(exists(provider_staking_account @* {
        .provider.pubkey == rell.test.keypairs.alice.pub,
        .staking_account.id == ft4.accounts.get_account_id_from_signers([rell.test.keypairs.alice.pub]) }));

    rell.test.tx().op(
        set_provider_staking_account(rell.test.keypairs.alice.pub, rell.test.keypairs.bob.pub)
    ).sign(rell.test.keypairs.alice, rell.test.keypairs.bob)
        .run();

    assert_true(exists(provider_staking_account @* {
        .provider.pubkey == rell.test.keypairs.alice.pub,
        .staking_account.id == ft4.accounts.get_account_id_from_signers([rell.test.keypairs.bob.pub]) }));
}
