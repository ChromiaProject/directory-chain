@test module;

import ^^.*;
import ^.helper_functions.*;
import ^.helper_operations.*;
import ^.ft4.accounts.{ create_register_account_evm_tx };

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.external.accounts.strategies;
    import lib.ft4.accounts.strategies.transfer;
    import lib.ft4.accounts.strategies.transfer.fee;
    import lib.ft4.assets;
    import lib.ft4.auth;
    import test_utils: lib.ft4.test.utils;
}

struct module_args {
    admin_privkey: byte_array;
    amount_to_mint: big_integer = 1000000000;
    asset: gtv = ["name": "Chromia Test".to_gtv(), "amount": "10000000".to_gtv()].to_gtv();
}

function test_create_account_on_internal_transfer_success() {
    rell.test.tx().op(init()).run();

    rell.test.tx().op(
        register_test_account(rell.test.pubkeys.alice)
    ).sign(chain_context.args.admin_privkey).run();
    val sender = ft4.accounts.account_by_id(rell.test.pubkeys.alice.hash());
    val sender_auth_descriptor = ft4.accounts.single_sig_auth_descriptor(rell.test.pubkeys.alice, set(["A", "T"]));
    val recipient_id = rell.test.pubkeys.bob.hash();

    rell.test.tx().op(
        mint_to(sender, chain_context.args.amount_to_mint)
    ).run();

    val allowed_assets = require(ft4.transfer.get_allowed_assets(chain_context.blockchain_rid, sender.id, recipient_id));
    require(allowed_assets.size() == 1);
    val asset_id = allowed_assets[0].asset_id;
    require(asset_id == get_asset().id);
    val min_amount = allowed_assets[0].min_amount;
    require(min_amount > 0);

    val amount = min_amount;

    rell.test.tx()
        .op(ft4.auth.external.ft_auth(sender.id, sender_auth_descriptor.hash()))
        .op(ft4.assets.external.transfer(recipient_id, asset_id, amount))
        .sign(rell.test.keypairs.alice)
        .run();

    assert_true("fee" in ft4.transfer.get_pending_transfer_strategies(recipient_id));

    rell.test.tx()
        .op(ft4.fee.ras_transfer_fee(asset_id, ft4.accounts.single_sig_auth_descriptor(rell.test.pubkeys.bob, set(["A", "T"]))))
        .op(ft4.strategies.register_account())
        .sign(rell.test.keypairs.bob)
        .run();

    assert_true(empty(ft4.transfer.get_pending_transfer_strategies(recipient_id)));

    val recipient = ft4.accounts.account_by_id(recipient_id);
    assert_equals(ft4.assets.get_asset_balance(recipient, get_asset()), 0L);

    val pool_account = get_pool_account();
    assert_equals(ft4.assets.get_asset_balance(pool_account, get_asset()), amount);
}

function test_internal_transfer_fails_if_insufficient_amount_is_transferred() {
    rell.test.tx().op(init()).run();

    rell.test.tx().op(
        register_test_account(rell.test.pubkeys.alice)
    ).sign(chain_context.args.admin_privkey).run();
    val sender = ft4.accounts.account_by_id(rell.test.pubkeys.alice.hash());
    val sender_auth_descriptor = ft4.accounts.single_sig_auth_descriptor(rell.test.pubkeys.alice, set(["A", "T"]));
    val recipient_id = rell.test.pubkeys.bob.hash();

    rell.test.tx().op(
        mint_to(sender, chain_context.args.amount_to_mint)
    ).run();

    val allowed_assets = require(ft4.transfer.get_allowed_assets(chain_context.blockchain_rid, sender.id, recipient_id));
    require(allowed_assets.size() == 1);
    val asset_id = allowed_assets[0].asset_id;
    require(asset_id == get_asset().id);
    val min_amount = allowed_assets[0].min_amount;
    require(min_amount > 0);

    val amount = min_amount - 1;

    rell.test.tx()
        .op(ft4.auth.external.ft_auth(sender.id, sender_auth_descriptor.hash()))
        .op(ft4.assets.external.transfer(recipient_id, asset_id, amount))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("no rule was found that allows account creation with");

    assert_true(empty(ft4.transfer.get_pending_transfer_strategies(recipient_id)));
}

function test_add_missing_evm_links() {
	rell.test.tx().op(init()).run();

    val alice_evm_address = crypto.eth_pubkey_to_address(rell.test.keypairs.alice.pub);
    val bob_evm_address = crypto.eth_pubkey_to_address(rell.test.keypairs.bob.pub);
    val charlie_evm_address = crypto.eth_pubkey_to_address(rell.test.keypairs.charlie.pub);


    do_evm_stake_update_bsc(alice_evm_address, 100 * units_per_asset);
    val alice_account = require(do_create_account_using_ras_staking(rell.test.keypairs.alice));

    val bob_id = bob_evm_address.hash();
    val charlie_id = charlie_evm_address.hash();
    val dave_id = rell.test.pubkeys.dave.hash();

    rell.test.tx().op(
        mint_to(alice_account, 1000000000)
    ).run();

    val allowed_assets = require(ft4.transfer.get_allowed_assets(chain_context.blockchain_rid, alice_account.id, bob_id));
    val asset_id = allowed_assets[0].asset_id;
    val amount = 100000000;

    rell.test.tx()
        .op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, ft4.assets.external.transfer(bob_id, asset_id, amount)))
        .op(ft4.assets.external.transfer(bob_id, asset_id, amount))
        .run();

    rell.test.tx()
        .op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, ft4.assets.external.transfer(charlie_id, asset_id, amount)))
        .op(ft4.assets.external.transfer(charlie_id, asset_id, amount))
        .run();

    rell.test.tx()
        .op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, ft4.assets.external.transfer(dave_id, asset_id, amount)))
        .op(ft4.assets.external.transfer(dave_id, asset_id, amount))
        .run();

    create_register_account_evm_tx([rell.test.keypairs.bob], ft4.fee.ras_transfer_fee(asset_id, ft4.accounts.single_sig_auth_descriptor(bob_evm_address, set(["A", "T"])))).run();
    create_register_account_evm_tx([rell.test.keypairs.charlie], ft4.fee.ras_transfer_fee(asset_id, ft4.accounts.single_sig_auth_descriptor(charlie_evm_address, set(["A", "T"])))).run();

    //Dave is not an EVM signer
    rell.test.tx()
        .op(ft4.fee.ras_transfer_fee(asset_id, ft4.accounts.single_sig_auth_descriptor(rell.test.pubkeys.dave, set(["A", "T"]))))
        .op(ft4.strategies.register_account())
        .sign(rell.test.keypairs.dave)
        .run();

    assert_equals((eif.hbridge.evm_eoa_account_link @* { alice_account }).size(), 1);    
    assert_null(eif.hbridge.evm_eoa_account_link @? { bob_evm_address });    
    assert_null(eif.hbridge.evm_eoa_account_link @? { charlie_evm_address }); 
    assert_null(eif.hbridge.evm_eoa_account_link @? { ft4.accounts.account_by_id(dave_id) }); 

    rell.test.tx()
        .op(add_missing_evm_links())
        .run();

    //Alice links are unchanged
    assert_equals((eif.hbridge.evm_eoa_account_link @* { alice_account }).size(), 1);    
    assert_equals(eif.hbridge.evm_eoa_account_link @? { bob_evm_address } (.account), ft4.accounts.account_by_id(bob_id));    
    assert_equals(eif.hbridge.evm_eoa_account_link @? { charlie_evm_address } (.account), ft4.accounts.account_by_id(charlie_id)); 
    //Dave is not an EVM signer and should not get a link
    assert_null(eif.hbridge.evm_eoa_account_link @? { ft4.accounts.account_by_id(dave_id) });

    //Should not be runnable again
    rell.test.tx()
        .op(add_missing_evm_links())
        .nop()
        .run_must_fail("No new links to add");
}