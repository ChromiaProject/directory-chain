@test module;

import ^^.*;
import ^.helper_functions.*;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.auth;
}

function test_propose_minting_validation() {

    // Voter set must exist
    rell.test.tx().op(
        propose_minting(rell.test.keypairs.alice.pub, 1000000, x"01")
    )
        .sign(rell.test.keypairs.alice)
        .run_must_fail("does not exist");

    // proposal_by must be signer
    rell.test.tx().op(
        propose_minting(rell.test.keypairs.alice.pub, 1000000, x"01")
    )
        .sign(rell.test.keypairs.bob)
        .run_must_fail("Operation must be signed by 0x02466d7fcae563e5cb09a0d1870bb580344804617879a14949cf22285f1bae3f27");

    // Create voter set and account
    rell.test.tx().op(
        create_chromia_foundation_voter_set()
    )
        .sign(rell.test.keypairs.alice)
        .run();

    // proposal_by must be part of voter set
    rell.test.tx().op(
        propose_minting(rell.test.keypairs.bob.pub, 1000000, x"01")
    )
        .sign(rell.test.keypairs.bob)
        .run_must_fail("0x034f355bdcb7cc0af728ef3cceb9615d90684bb5b2ca5f859ab0f0b704075871aa is not part of voter set CHROMIA_FOUNDATION");

    // Account not found
    rell.test.tx().op(
        propose_minting(rell.test.keypairs.alice.pub, 1000000, x"01")
    )
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Account not found: 0x01");

    // Invalid amount
    rell.test.tx().op(
        propose_minting(rell.test.keypairs.alice.pub, 0, x"01")
    )
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Amount must be greater than 0");
}

function test_propose_minting_success() {

    val init_amount = 10000000000;
    val amount = 1000000;

    rell.test.tx().op(init(), create_test_cluster("cluster_name")).run();
    val alice_account = register_test_account_op(rell.test.pubkeys.alice, init_amount);
    assert_equals(get_account_balance(alice_account), init_amount);

    rell.test.tx().op(
        create_chromia_foundation_voter_set(),
        propose_minting(rell.test.keypairs.alice.pub, amount, alice_account.id)
    )
        .sign(rell.test.keypairs.alice)
        .run();

    assert_equals(get_account_balance(alice_account), init_amount + amount);
    assert_true(empty(pending_minting @* { }));
}

function test_propose_minting_limit__one_too_large() {

    rell.test.tx().op(init(), create_test_cluster("cluster_name")).run();
    val amount_to_mint = get_ec_mint_proposal_amount_limit() + 1;

    rell.test.tx()
        .op(
            create_chromia_foundation_voter_set(),
            propose_minting(rell.test.pubkeys.alice, amount_to_mint, get_chromia_foundation_account().id)
        )
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Limit (%s) is reached with %s minted within %s ms".format(
            get_ec_mint_proposal_amount_limit(), amount_to_mint, get_ec_mint_proposal_time_limit_ms()
        ));
}

function test_propose_minting_limit__2_accepted_1_rejected_wait_1_accepted() {

    rell.test.tx().op(init(), create_test_cluster("cluster_name")).run();

    rell.test.tx()
        .op(
            create_chromia_foundation_voter_set(),
            propose_minting(rell.test.pubkeys.alice, 10000000, get_chromia_foundation_account().id)
        )
        .sign(rell.test.keypairs.alice)
        .run();

    rell.test.tx()
        .op(
            propose_minting(rell.test.pubkeys.alice, 10000000, get_chromia_foundation_account().id)
        )
        .sign(rell.test.keypairs.alice)
        .run();

    rell.test.tx()
        .op(
            propose_minting(rell.test.pubkeys.alice, get_ec_mint_proposal_amount_limit(), get_chromia_foundation_account().id)
        )
        .sign(rell.test.keypairs.alice)
        .run_must_fail("is reached with");

    rell.test.set_next_block_time_delta(get_ec_mint_proposal_time_limit_ms());
    rell.test.block().run();

    rell.test.tx()
        .op(
            propose_minting(rell.test.pubkeys.alice, get_ec_mint_proposal_amount_limit(), get_chromia_foundation_account().id)
        )
        .sign(rell.test.keypairs.alice)
        .run();
}

function test_propose_minting_revoked() {

    rell.test.tx().op(init(), create_test_cluster("cluster_name")).run();
    val alice_account = register_test_account_op(rell.test.pubkeys.alice);

    // Create voter set with alice and bob as members
    rell.test.tx().op(
        create_chromia_foundation_voter_set(),
        propose_minting(rell.test.keypairs.alice.pub, 1, alice_account.id)
    )
        .sign(rell.test.keypairs.alice, rell.test.keypairs.bob)
        .run();

    assert_equals(pending_minting @ { } ( @sum 1 ), 1);

    rell.test.tx().op(
        revoke_common_proposal(rell.test.keypairs.alice.pub, get_latest_common_proposal_id())
    )
        .sign(rell.test.keypairs.alice)
        .run();

    assert_true(empty(pending_minting @* { }));
}

function test_get_minting_proposal() {

    rell.test.tx().op(init(), create_test_cluster("cluster_name")).run();
    val alice_account = register_test_account_op(rell.test.pubkeys.alice);

    // Create voter set with alice and bob as members
    rell.test.tx().op(
        create_chromia_foundation_voter_set(),
        propose_minting(rell.test.keypairs.alice.pub, 1, alice_account.id)
    )
        .sign(rell.test.keypairs.alice, rell.test.keypairs.bob)
        .run();

    val minting_proposal = get_minting_proposal(get_latest_common_proposal_id());
    assert_equals(minting_proposal.amount, 1);
    assert_equals(minting_proposal.account_id, alice_account.id);
}

