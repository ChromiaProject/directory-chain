    assert_true(exists(provider_staking_account @* {
        .provider.pubkey == provider_keypair.pub,
        .staking_account.id == initial_provider_account.id}));

    rell.test.tx()
        .op(register_test_account(new_provider_account_keypair.pub))
        .run();

    // Change provider staking account
    rell.test.tx()
        .op(ft4.test_utils.ft_auth_operation_for(new_provider_account_keypair.pub))
        .op(set_provider_staking_account_ft4(provider_keypair.pub))
        .sign(provider_keypair, new_provider_account_keypair)
        .run();
    assert_equals(staking_get_balance(initial_provider_account.id), 0);
    assert_equals(staking_get_balance(new_provider_account_id), 9999999);
    assert_null(staking_get_current_delegate(initial_provider_account.id));
    assert_equals(staking_get_current_delegate(new_provider_account_id), provider_keypair.pub);
    assert_true(exists(provider_staking_account @* {
        .provider.pubkey == provider_keypair.pub,
        .staking_account.id == new_provider_account_id}));
}

function test_evm_withdrawal_with_small_native_balance() {
    rell.test.tx().op(init()).run();

    val alice_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);
    do_evm_stake_update_bsc(alice_evm_address, 50 * units_per_asset);
    val test_account_alice = do_create_account_using_ras_staking(rell.test.keypairs.alice)!!;

    // Make tiny native deposit
    do_staking_deposit_native(rell.test.keypairs.alice, 2);

    // Delegate (immediate as from undelegated)
    add_provider(rell.test.keypairs.bob.pub);
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.bob.pub);

    // Set a future delegation
    add_provider(rell.test.keypairs.charlie.pub);
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.charlie.pub);

    // Withdraw all on EVM
    do_evm_stake_update_bsc(alice_evm_address, 0);

    // Should still be delegated overall, and on native
    assert_equals(staking_get_current_delegate(test_account_alice.id), rell.test.keypairs.bob.pub);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.CHR), rell.test.keypairs.bob.pub);
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));

    // And this should still be true in a year and future delegation has been applied
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();
    assert_equals(staking_get_current_delegate(test_account_alice.id), rell.test.keypairs.charlie.pub);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.CHR), rell.test.keypairs.charlie.pub);
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));
}

function test_stake_on_evm_carry_over_to_native_withdraw_evm() {
    rell.test.tx().op(init()).run();

    val alice_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);
