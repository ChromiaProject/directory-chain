function test_staking_shared_reward_calculation_delayed_delegation() {

    // Basic initialisation
    rell.test.tx()
        .op(init())
        .op(mint_to_pool(100000 * units_per_asset))
    .sign(admin_privkey).run();

    // Make Bob with an existing 100 BSC stake
    val alice_evm_address = crypto.eth_pubkey_to_address(rell.test.keypairs.alice.pub);
    val bob_evm_address = crypto.eth_pubkey_to_address(rell.test.keypairs.bob.pub);
    do_evm_stake_update_bsc(alice_evm_address, 100 * units_per_asset);
    do_evm_stake_update_bsc(bob_evm_address, 100 * units_per_asset);
    val test_account_bob = require(do_create_account_using_ras_staking(rell.test.keypairs.bob));
    val test_account_alice = require(do_create_account_using_ras_staking(rell.test.keypairs.alice));

    val charlie_provider = add_provider(rell.test.keypairs.charlie.pub);
    add_provider(rell.test.keypairs.dave.pub);

    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.charlie.pub);
    do_staking_delegate(rell.test.keypairs.bob, rell.test.keypairs.dave.pub);

    // FFWD
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    val pool = get_pool_account();
     rell.test.tx().op(
        register_provider_account_op(charlie_provider)
    ).run();

    val charlie_account = ft4.accounts.account @ {.id == get_provider_account_id(rell.test.keypairs.charlie.pub) };

    //Pay reward to Charlie provider
    rell.test.tx().op(
        pay_reward_op(pool, charlie_account, 0, 100 * units_per_asset, "test", charlie_provider.staking_rewards_share)
    ).run();

    // Do staking payout
    rell.test.tx().op(staking_claim_rewards()).sign(admin_privkey).run();

    //Alice has 100% of all delegation to Charlie and gets the full 10%
    assert_equals(staking_get_shared_rewards_paid(test_account_alice.id), 10 * units_per_asset);

    do_staking_delegate(rell.test.keypairs.bob, rell.test.keypairs.charlie.pub);

    //Bobs new delegation is not yet applied
    assert_equals(staking_get_current_delegate(test_account_bob.id), rell.test.keypairs.dave.pub);

    //Do another reward to Charlie
    rell.test.tx().op(
        pay_reward_op(pool, charlie_account, 0, 100 * units_per_asset, "test", charlie_provider.staking_rewards_share)
    ).nop().run();

    // Do staking payout
    rell.test.tx().op(staking_claim_rewards()).sign(admin_privkey).nop().run();

    //Alice should still get the full 10%
    assert_equals(staking_get_shared_rewards_paid(test_account_alice.id), 20 * units_per_asset);
    assert_equals(staking_get_shared_rewards_paid(test_account_bob.id), 0);

    // FFWD
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    //Do another reward to Charlie
    rell.test.tx().op(
        pay_reward_op(pool, charlie_account, 0, 100 * units_per_asset, "test", charlie_provider.staking_rewards_share)
    ).nop().run();

    // Do staking payout
    rell.test.tx().op(staking_claim_rewards()).sign(admin_privkey).nop().run();

    //Alice should now get half of the 10%
    assert_equals(staking_get_shared_rewards_paid(test_account_alice.id), 25 * units_per_asset);
    assert_equals(staking_get_shared_rewards_paid(test_account_bob.id), 5 * units_per_asset);
}

function test_staking_pending_delegation_new_stake() {
    rell.test.tx().op(init()).run();

    val alice_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);
    do_evm_stake_update_bsc(alice_evm_address, 100 * units_per_asset);
