    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC), rell.test.keypairs.bob.pub);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.CHR), rell.test.keypairs.bob.pub);

    // Withdraw all on EVM
    do_evm_stake_update_bsc(alice_evm_address, 0);

    // Should still be delegated overall, and on native
