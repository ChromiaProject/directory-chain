@test module;

import ^^.*;
import ^.helper_functions.*;
import ^.helper_operations.*;
import economy_chain_test_admin.*;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.assets;
    import lib.ft4.auth;
    import test_utils: lib.ft4.test.core;
    import lib.ft4.accounts.strategies;
}

import lib.hbridge;

struct module_args {
    account_creator_privkey: byte_array;
    admin_privkey: byte_array;
    staking_delegation_delay_ms: integer;
    staking_withdrawal_delay_ms: integer;
    staking_rewards_payout_interval_ms: integer;
    staking_withdrawals_payout_interval_ms: integer;
    amount_to_mint: big_integer = 1000000000;
    staking_rewards_payout_batch_size: integer = 10;
}

val auth_privkey = chain_context.args.account_creator_privkey;
val admin_privkey = chain_context.args.admin_privkey;
val staking_delegation_delay_ms = chain_context.args.staking_delegation_delay_ms;

function test_add_remove_providers() {
    rell.test.tx().op(init()).run();

    val test_account_alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val test_account_bob = require(do_create_account(rell.test.keypairs.bob, auth_privkey));
    val test_account_charlie = require(do_create_account(rell.test.keypairs.charlie, auth_privkey));
    val test_account_dave = require(do_create_account(rell.test.keypairs.dave, auth_privkey));

    rell.test.tx()
        .op(mint_to(test_account_alice, 9999999))
        .op(mint_to(test_account_dave, 9999999))
    .sign(admin_privkey).run();

    add_provider(rell.test.keypairs.charlie.pub);
    add_provider(rell.test.keypairs.bob.pub);

    // Add some delegation
    // Have A deposit and delegate to C
    do_staking_deposit_native(rell.test.keypairs.alice, 9999999);
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.charlie.pub);

    // Have D deposit 11 and delagate to B
    do_staking_deposit_native(rell.test.keypairs.dave, 11);
    do_staking_delegate(rell.test.keypairs.dave, rell.test.keypairs.bob.pub);

    // Wait for delegation to take effect
    rell.test.set_next_block_time_delta(millis_per_month);
    rell.test.block().run();
    rell.test.block().run();
    assert_equals(staking_get_balance(test_account_alice.id), 9999999);
    assert_equals(staking_get_total_delegation_to(rell.test.keypairs.charlie.pub), 9999999);
    assert_equals(staking_get_total_delegation_to(rell.test.keypairs.bob.pub), 11);
    assert_true(staking_rewards_claimable_for(test_account_alice.id) > 0);

    remove_provider(rell.test.keypairs.charlie.pub);

    // Ensure delegates have been removed
    assert_equals(staking_get_total_delegation_to(rell.test.keypairs.charlie.pub), 0); // <- Removed immediately
    assert_equals(staking_get_total_delegation_to(rell.test.keypairs.bob.pub), 11); // <- Unchanged
    assert_equals(staking_get_number_of_delegates_to(rell.test.keypairs.bob.pub), 1);
    assert_equals(staking_get_number_of_delegates_to(rell.test.keypairs.charlie.pub), 0);

    log("Staking start time: ", staking_get_rewards_start());

    // Should have earned something
    assert_true(staking_rewards_claimable_for(test_account_alice.id) > 0);
}

function test_delegation() {
    rell.test.tx().op(init()).run();

    val test_account_alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val test_account_bob = require(do_create_account(rell.test.keypairs.bob, auth_privkey));
    val test_account_charlie = require(do_create_account(rell.test.keypairs.charlie, auth_privkey));

    rell.test.tx()
        .op(mint_to(test_account_alice, 9999999))
    .sign(admin_privkey).run();

    rell.test.set_next_block_time_delta(staking_delegation_delay_ms + 1);
    rell.test.block().run();

    assert_equals(staking_rewards_claimable_for(test_account_alice.id), 0);
    assert_equals(staking_rewards_claimable_for(test_account_bob.id), 0);

    add_provider(rell.test.keypairs.bob.pub);
    add_provider(rell.test.keypairs.charlie.pub);
    assert_equals(staking_get_number_of_delegates_to(rell.test.keypairs.bob.pub), 0);
    assert_equals(staking_get_number_of_delegates_to(rell.test.keypairs.charlie.pub), 0);

    do_staking_delegate_failure(rell.test.keypairs.alice, rell.test.keypairs.bob.pub, "Need stake to delegate.");

    do_staking_deposit_native(rell.test.keypairs.alice, 8000, rell.test.keypairs.charlie.pub);
    assert_events(
        ("icmf_message",(topic = economy_chain_staking_state_update, body = economy_chain_staking_state_update_message(
            test_account_alice.id,
            8000,
            list<economy_chain_staking_state_withdrawal>(),
        ).to_gtv()).to_gtv_pretty()),
    );
    assert_equals(staking_get_number_of_delegates_to(rell.test.keypairs.bob.pub), 0);
    assert_equals(staking_get_number_of_delegates_to(rell.test.keypairs.charlie.pub), 1);
    rell.test.set_next_block_time_delta(1);
    rell.test.block().run();

    // Should be near immediate as delegating from nothing
    assert_equals(staking_get_number_of_delegates_to(rell.test.keypairs.bob.pub), 0);
    assert_equals(staking_get_number_of_delegates_to(rell.test.keypairs.charlie.pub), 1);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.CHR), rell.test.keypairs.charlie.pub);
    assert_equals(staking_get_current_delegate(test_account_alice.id), rell.test.keypairs.charlie.pub);

    rell.test.set_next_block_time_delta(staking_delegation_delay_ms);
    rell.test.block().run();

    do_staking_delegate_failure(rell.test.keypairs.alice, rell.test.keypairs.dave.pub, "No provider for this public key.");

    // This should have a delay though
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.bob.pub);
    assert_equals(staking_get_current_delegate(test_account_alice.id), rell.test.keypairs.charlie.pub);
    rell.test.set_next_block_time_delta(staking_delegation_delay_ms);
    rell.test.block().run();

    assert_equals(staking_get_current_delegate(test_account_alice.id), rell.test.keypairs.bob.pub);
    assert_null(staking_get_next_delegation_change(test_account_alice.id));

    // Undelegating has a delay
    do_staking_undelegate(rell.test.keypairs.alice);

    assert_equals(staking_get_current_delegate(test_account_alice.id), rell.test.keypairs.bob.pub); // No change now.

    rell.test.set_next_block_time_delta(staking_delegation_delay_ms);
    rell.test.block().run();
    assert_null(staking_get_current_delegate(test_account_alice.id)); // Change in a week
}

function test_delegation_across_measures() {
    rell.test.tx().op(init()).run();

    // Check rate is 0.1 decimal
    assert_equals(staking_get_current_rate(), 0.1);

    // Just one native account
    val test_account_alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    rell.test.tx()
        .op(mint_to(test_account_alice, 12000 * units_per_asset))
    .sign(admin_privkey).run();

    // Just one provider
    add_provider(rell.test.keypairs.charlie.pub);

    // Deposit 100
    do_staking_deposit_native(rell.test.keypairs.alice, 100 * units_per_asset);

    // Check undelegated and next is undelegated
    assert_null(staking_get_current_delegate(test_account_alice.id));
    assert_null(staking_get_next_delegation_change(test_account_alice.id));

    // Leap forward a month
    rell.test.set_next_block_time_delta(millis_per_month);
    rell.test.block().run();

    // Check undelegated and next is undelegated
    assert_null(staking_get_current_delegate(test_account_alice.id));
    assert_null(staking_get_next_delegation_change(test_account_alice.id));

    // Check nothing earned
    assert_equals(staking_rewards_claimable_for(test_account_alice.id), 0);

    // Native deposit 900 to make 1000 and delegate
    do_staking_deposit_native(rell.test.keypairs.alice, 900 * units_per_asset, rell.test.keypairs.charlie.pub);

    // Check delegation is provider
    assert_equals(rell.test.keypairs.charlie.pub, staking_get_current_delegate(test_account_alice.id));

    // No next delegation
    assert_null(staking_get_next_delegation_change(test_account_alice.id));

    // Advance 1/2 a year
    rell.test.set_next_block_time_delta(millis_per_year / 2);
    rell.test.block().run();

    // Check that accumulated reward is ~50
    assert_equals(staking_rewards_claimable_for(test_account_alice.id) / units_per_asset, 50);

    // Undelegate
    rell.test.set_next_block_time_delta(888);
    do_staking_undelegate(rell.test.keypairs.alice);

    // Check still delegated
    assert_equals(rell.test.keypairs.charlie.pub, staking_get_current_delegate(test_account_alice.id));

    // Check next delegation is null, and time is + period
    assert_null(staking_get_next_delegation_change(test_account_alice.id)?.pubkey);
    val next_delegation_time = staking_get_next_delegation_change(test_account_alice.id)?.time;
    assert_equals(
        next_delegation_time,
        _staking_last_known_time() + chain_context.args.staking_delegation_delay_ms - 888 /* test blocktime */
    );
 
    // Go to next delegation time minus 1 second
    rell.test.set_next_block_time(require(next_delegation_time) - 1000);
    rell.test.block().run();
    assert_equals(next_delegation_time - 1000, _staking_last_known_time());

    // Check delegated to provider
    assert_equals(staking_get_current_delegate(test_account_alice.id), rell.test.keypairs.charlie.pub);

    // Check next delegation is null, and time is + period
    assert_null(staking_get_next_delegation_change(test_account_alice.id)?.pubkey);
    assert_equals(next_delegation_time, staking_get_next_delegation_change(test_account_alice.id)?.time);

    // Advance 2 seconds
    rell.test.set_next_block_time_delta(2000);
    rell.test.block().run();

    // Check undelegated
    assert_null(staking_get_current_delegate(test_account_alice.id));

    // Check next delegation is null
    assert_null(staking_get_next_delegation_change(test_account_alice.id));

    // Check that accumulated reward is ~50
    assert_equals(staking_rewards_claimable_for(test_account_alice.id) / units_per_asset, 50);

    // Trigger payout
    rell.test.tx().op(staking_claim_rewards()).sign(admin_privkey).run();

    // Check paid is 50
    assert_equals(staking_get_rewards_paid(test_account_alice.id) / units_per_asset, 50);

    // Check that accumulated reward is now zero
    assert_equals(staking_rewards_claimable_for(test_account_alice.id) / units_per_asset, 0);

    // Advance 1 year
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    // Delegate to provider
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.charlie.pub);

    // Advance 2 years + period
    rell.test.set_next_block_time((2 * millis_per_year) + staking_get_cannot_change_before());
    rell.test.block().run();

    // Check accumulated is ~200
    assert_equals(staking_rewards_claimable_for(test_account_alice.id) / units_per_asset, 200);

    // Deposit 2000 and delegate to another provider
    do_staking_deposit_native(rell.test.keypairs.alice, 2000 * units_per_asset);
    add_provider(rell.test.keypairs.dave.pub);
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.dave.pub);

    // Advance 1 year in 2 blocks
    rell.test.set_next_block_time_delta(millis_per_year / 2);
    rell.test.block().run();
    rell.test.set_next_block_time_delta(millis_per_year / 2);
    rell.test.block().run();

    // Check accumulated is ~500
    // 1000 for 2 years gave 200. The 3000 for 1 year gives 300.
    assert_equals(staking_rewards_claimable_for(test_account_alice.id) / units_per_asset, 500);
}

function test_three_networks_multiple_deposits_withdrawals_rewards() {

    // Initialise and top-up rewards pool
    rell.test.tx()
        .op(init())
        .op(mint_to_pool(888 * units_per_asset))
    .sign(admin_privkey).run();
    assert_equals(888 * units_per_asset, get_account_balance(get_pool_account()));

    val alice_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);
    do_evm_stake_update_bsc(alice_evm_address, 10 * units_per_asset);
    val test_account_alice = require(do_create_account_using_ras_staking(rell.test.keypairs.alice));
    assert_equals(staking_get_balance(test_account_alice.id), 10 * units_per_asset);

    val initial_alice_balance = get_account_balance(test_account_alice);

    do_evm_stake_update_eth(alice_evm_address, 30 * units_per_asset);
    assert_equals(staking_get_balance(test_account_alice.id), 40 * units_per_asset);

    do_staking_deposit_native(rell.test.keypairs.alice, 50 * units_per_asset);
    assert_equals(staking_get_balance(test_account_alice.id), 90 * units_per_asset);

    // Delegate and run forwards 1 year + 1 week
    add_provider(rell.test.keypairs.dave.pub);
    assert_equals(staking_get_number_of_delegates_to(rell.test.keypairs.dave.pub), 0);
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.dave.pub);
    assert_equals(staking_get_number_of_delegates_to(rell.test.keypairs.dave.pub), 1);
    rell.test.set_next_block_time_delta(millis_per_year + staking_delegation_delay_ms);
    rell.test.block().run();

    // Check that we now have 9 rewards in total.
    assert_equals(staking_rewards_claimable_for(test_account_alice.id) / units_per_asset, 9);

    // Payout out all
    rell.test.tx().op(staking_claim_rewards()).sign(admin_privkey).run();

    // Withdraw native only
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, staking_request_withdrawal())
    ).op(
        staking_request_withdrawal()
    ).run();

    // Run forwards 1 year + 1 week
    rell.test.set_next_block_time_delta(millis_per_year + staking_delegation_delay_ms);
    rell.test.block().run();

    // Check we have ~4 rewards
    assert_equals(staking_rewards_claimable_for(test_account_alice.id) / units_per_asset, 4);

    // Payout out all withdrawals and rewards
    do_pay_everything_native();

    // Withdraw BSC
    do_evm_withdrawal_request_bsc(test_account_alice);

    // Run forwards 1 week
    rell.test.set_next_block_time_delta(staking_delegation_delay_ms + 2000);
    rell.test.block().run();
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));

    // Run forwards 1 year + 1 week
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));

    // Check we have ~3 rewards
    assert_equals(staking_rewards_claimable_for(test_account_alice.id) / units_per_asset, 3);

    // Payout out all withdrawals and rewards (remember how native sees the EVM withdrawals)
    do_pay_everything_native();
    do_evm_withdrawal_request_eth(test_account_alice);
    assert_equals(rell.test.keypairs.dave.pub, staking_get_current_delegate(test_account_alice.id));
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.ETH), rell.test.keypairs.dave.pub);

    // Withdraw ETH
    do_evm_stake_update_eth(alice_evm_address, 0);
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.ETH));

    // Run forwards 1 year + 1 week
    rell.test.set_next_block_time_delta(millis_per_year + staking_delegation_delay_ms);
    rell.test.block().run();
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.ETH));

    // Check we have no rewards
    assert_equals(staking_rewards_claimable_for(test_account_alice.id) / units_per_asset, 0);

    // Payout out all withdrawals and rewards
    do_pay_everything_native();
    do_evm_stake_update_bsc(alice_evm_address, 0);

    // Check empty
    assert_equals(staking_get_balance(test_account_alice.id), 0);

    // Reconcile
    val rewards_balance = get_account_balance(test_account_alice) - initial_alice_balance;
    assert_equals(rewards_balance /  units_per_asset, 16);
    assert_equals(
        888 * units_per_asset + initial_alice_balance,
            get_account_balance(get_pool_account())
        +   get_account_balance(test_account_alice)
    );

    // No next withdrawals
    assert_null(staking_get_withdrawal_time(test_account_alice.id));
    assert_null(staking_get_withdrawal_time(test_account_alice.id, network.CHR));
    assert_null(staking_get_withdrawal_time(test_account_alice.id, network.BSC));
    assert_null(staking_get_withdrawal_time(test_account_alice.id, network.ETH));

    // No delegation
    assert_null(staking_get_current_delegate(test_account_alice.id));
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.CHR));
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.ETH));
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));

    // Start again by depositing the 16 rewards plus 4 on ETH
    do_staking_deposit_native(rell.test.keypairs.alice, 16 * units_per_asset, rell.test.keypairs.dave.pub);
    do_evm_stake_update_eth(alice_evm_address, 1 * units_per_asset); // Spurious, to see if query gets confused
    do_evm_stake_update_eth(alice_evm_address, 4 * units_per_asset);
    assert_equals(staking_get_balance(test_account_alice.id) / units_per_asset, 20);

    // Run forwards 1 year + 1 week
    rell.test.set_next_block_time_delta(millis_per_year + staking_delegation_delay_ms);
    rell.test.block().run();

    // Dave delegation except on BSC
    assert_equals(staking_get_current_delegate(test_account_alice.id), rell.test.keypairs.dave.pub);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.CHR), rell.test.keypairs.dave.pub);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.ETH), rell.test.keypairs.dave.pub);
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));

    // Check we have ~2 rewards
    assert_equals(staking_rewards_claimable_for(test_account_alice.id) / units_per_asset, 2);

    // Re-delegate immediately
    add_provider(rell.test.keypairs.charlie.pub);
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.charlie.pub);

    // Withdraw on native and ETH
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, staking_request_withdrawal())
    ).op(
        staking_request_withdrawal()
    ).run();
    do_evm_withdrawal_request_eth(test_account_alice);

    // Run forwards a year
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    // Clear out all
    do_pay_everything_native();
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.CHR));
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));
    assert_null(staking_get_withdrawal_time(test_account_alice.id, network.CHR));

    do_evm_stake_update_eth(alice_evm_address, 0);
    assert_equals(staking_get_balance(test_account_alice.id), 0);

    // No next withdrawals
    assert_null(staking_get_withdrawal_time(test_account_alice.id));
    assert_null(staking_get_withdrawal_time(test_account_alice.id, network.CHR));
    assert_null(staking_get_withdrawal_time(test_account_alice.id, network.ETH));
    assert_null(staking_get_withdrawal_time(test_account_alice.id, network.BSC));

    // No delegation
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.CHR));
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.ETH));
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));
    assert_null(staking_get_current_delegate(test_account_alice.id));

    // Re-reconcile
    assert_equals(
        888 * units_per_asset + initial_alice_balance,
            get_account_balance(get_pool_account())
        +   get_account_balance(test_account_alice)
    );
}

function test_delegation_bsc_and_native_crosschain() {
    rell.test.tx().op(init()).run();

    // Make two accounts BSC and native
    val alice_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);
    do_evm_stake_update_bsc(alice_evm_address, 50 * units_per_asset);
    val test_account_alice = require(do_create_account_using_ras_staking(rell.test.keypairs.alice));
    assert_equals(staking_get_balance(test_account_alice.id), 50 * units_per_asset);
    do_staking_deposit_native(rell.test.keypairs.alice, 100 * units_per_asset);

    // Delegate them both
    add_provider(rell.test.keypairs.charlie.pub);
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.charlie.pub);

    // First delegation is instant

    // Withdraw them
    do_evm_withdrawal_request_bsc(test_account_alice);
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, staking_request_withdrawal())
    ).op(
        staking_request_withdrawal()
    ).run();

    // Check future zero'd delegation state
    val future_alice_delegation = staking_get_next_delegation_change(test_account_alice.id);
    assert_false(empty(future_alice_delegation));
    assert_null(future_alice_delegation?.pubkey);

    // But not yet undelegated
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.ETH), null);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.CHR), rell.test.keypairs.charlie.pub);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC), rell.test.keypairs.charlie.pub);

    // Wait a delegation period
    rell.test.set_next_block_time_delta(staking_delegation_delay_ms);
    rell.test.block().run();

    // Check undelegated all
    assert_null(staking_get_current_delegate(test_account_alice.id));
    check_account_invariants(test_account_alice);

    // Not future delegation either
    assert_null(staking_get_next_delegation_change(test_account_alice.id));

    // Flush both after waiting for the withdrawal
    rell.test.set_next_block_time_delta(chain_context.args.staking_withdrawals_payout_interval_ms);
    rell.test.block().run();
    do_pay_everything_native();
    do_evm_stake_update_bsc(alice_evm_address, 0);

    // No balance
    assert_equals(staking_get_balance(test_account_alice.id), 0);

    // Check undelegated all
    assert_null(staking_get_current_delegate(test_account_alice.id));
    check_account_invariants(test_account_alice);

    // Not future delegation either
    assert_null(staking_get_next_delegation_change(test_account_alice.id));

    // Deposit and delegate them again
    do_staking_deposit_native(rell.test.keypairs.alice, 50 * units_per_asset);
    do_evm_stake_update_bsc(alice_evm_address, 100 * units_per_asset);
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.charlie.pub);

    // Delegation from null is instant
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.ETH), null);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.CHR), rell.test.keypairs.charlie.pub);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC), rell.test.keypairs.charlie.pub);

    // Withdraw both in other order
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, staking_request_withdrawal())
    ).op(
        staking_request_withdrawal()
    ).run();
    do_evm_withdrawal_request_bsc(test_account_alice);
    rell.test.set_next_block_time_delta(chain_context.args.staking_withdrawals_payout_interval_ms);
    rell.test.block().run();
    do_evm_stake_update_bsc(alice_evm_address, 0);
    do_pay_everything_native();

    // Check zero'd delegation state
    assert_null(staking_get_current_delegate(test_account_alice.id));
    // No balance
    assert_equals(staking_get_balance(test_account_alice.id), 0);

    check_account_invariants(test_account_alice);
}


function test_delegation_bsc_only() {
    rell.test.tx().op(init()).run();

    val alice_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);
    do_evm_stake_update_bsc(alice_evm_address, 50 * units_per_asset);
    val test_account_alice = require(do_create_account_using_ras_staking(rell.test.keypairs.alice));
    assert_equals(staking_get_balance(test_account_alice.id), 50 * units_per_asset);

    add_provider(rell.test.keypairs.charlie.pub);
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.charlie.pub);

    // First delegation is immediate
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.ETH), null);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.CHR), null);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC), rell.test.keypairs.charlie.pub);
    assert_equals(staking_get_current_delegate(test_account_alice.id), rell.test.keypairs.charlie.pub);

    // Re-delegate
    add_provider(rell.test.keypairs.dave.pub);
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.dave.pub);

    // Second delegation hasn't taken effect yet
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.ETH), null);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.CHR), null);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC), rell.test.keypairs.charlie.pub);
    assert_equals(staking_get_current_delegate(test_account_alice.id), rell.test.keypairs.charlie.pub);

    // FFWD
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    // Second delegation will now have effect
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.ETH), null);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.CHR), null);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC), rell.test.keypairs.dave.pub);
    assert_equals(staking_get_current_delegate(test_account_alice.id), rell.test.keypairs.dave.pub);

    // Make sure a BSC withdrawal clears the delegation state, inc future ones
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.charlie.pub);
    do_evm_stake_update_bsc(alice_evm_address, 0);
    rell.test.set_next_block_time_delta(chain_context.args.staking_withdrawal_delay_ms);
    rell.test.block().run();

    assert_null(staking_get_current_delegate(test_account_alice.id));
    assert_null(staking_get_next_delegation_change(test_account_alice.id));
    check_account_invariants(test_account_alice);
}

function test_staking_deposit() {
    rell.test.tx().op(init()).run();

    val test_account_alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));

    assert_equals(staking_get_balance(test_account_alice.id), 0);
    rell.test.tx()
        .op(mint_to(test_account_alice, 9999999))
    .run();
    do_staking_deposit_native(rell.test.keypairs.alice, 7777);
    assert_equals(staking_get_balance(test_account_alice.id), 7777);
    assert_equals(get_account_balance(get_deposit_account()), 7777);
}

function test_yield_and_payout_crudely () {

    log("Rate per year: ", staking_get_current_rate());

    val too_small_to_care = 10 * units_per_asset;

    // Basic initialisation
    rell.test.tx()
        .op(init())
        .op(mint_to_pool(888 * units_per_asset))
    .sign(admin_privkey).run();

    val test_account_alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));

    // Make Bob with an existing 100 BSC stake
    val bob_evm_address = crypto.eth_pubkey_to_address(rell.test.keypairs.bob.pub);
    do_evm_stake_update_bsc(bob_evm_address, 100 * units_per_asset);
    val test_account_bob = require(do_create_account_using_ras_staking(rell.test.keypairs.bob));

    val test_account_charlie = require(do_create_account(rell.test.keypairs.charlie, auth_privkey));

    add_provider(rell.test.keypairs.charlie.pub);

    rell.test.tx()
        .op(mint_to(test_account_alice, 1000 * units_per_asset))
    .sign(admin_privkey).run();

    // Check no yield
   assert_equals(staking_rewards_claimable_for(test_account_alice.id), 0);
   assert_equals(staking_rewards_claimable_for(test_account_bob.id), 0);
   assert_equals(staking_rewards_claimable_for(test_account_charlie.id), 0);

    // FFWD
   rell.test.set_next_block_time_delta(millis_per_year);
   rell.test.block().run();

    // Check no yield
   assert_equals(staking_rewards_claimable_for(test_account_alice.id), 0);
   assert_equals(staking_rewards_claimable_for(test_account_bob.id), 0);
   assert_equals(staking_rewards_claimable_for(test_account_charlie.id), 0);

    // Deposit 100 with A on native and stake to C
    do_staking_deposit_native(rell.test.keypairs.alice, 100 * units_per_asset);
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.charlie.pub);

    // Deposit an additional 100 with B (total 200) on BSC+native and stake to C
    do_staking_deposit_native(rell.test.keypairs.bob, 100 * units_per_asset);
    do_staking_delegate(rell.test.keypairs.bob, rell.test.keypairs.charlie.pub);

    // Check balances
    assert_equals(staking_get_balance(test_account_alice.id), 100 * units_per_asset);
    assert_equals(staking_get_balance(test_account_bob.id), 200 * units_per_asset);

    // FFWD
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    // Check 2 delegations for C
    assert_equals(staking_get_number_of_delegates_to(rell.test.keypairs.charlie.pub), 2);
    assert_equals(staking_get_number_of_delegates_to(rell.test.keypairs.charlie.pub, network.CHR), 2);
    assert_equals(staking_get_number_of_delegates_to(rell.test.keypairs.charlie.pub, network.ETH), 0);
    assert_equals(staking_get_number_of_delegates_to(rell.test.keypairs.charlie.pub, network.BSC), 1);

    // Check that there is a yield and that B is twice of A (allow for rounding)
    val alice_amount = staking_rewards_claimable_for(test_account_alice.id);
    val bob_amount = staking_rewards_claimable_for(test_account_bob.id);
    assert_true(alice_amount > 0);
    assert_true(bob_amount > 0);
    assert_equals(staking_rewards_claimable_for(test_account_charlie.id), 0);
    log("alice %s claimable amount: %s".format(test_account_alice.id, alice_amount));
    log("bob %s claimable amount: %s".format(test_account_bob.id, bob_amount));
    assert_true(too_small_to_care >= abs(2 * alice_amount - bob_amount));

    // Check balances
    assert_equals(staking_get_balance(test_account_alice.id), 100 * units_per_asset);
    assert_equals(staking_get_balance(test_account_bob.id), 200 * units_per_asset);

    // FFWD
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    // Check both numbers have doubled (allow for rounding)
    val alice_amount_2 = staking_rewards_for(test_account_alice.id);
    val bob_amount_2 = staking_rewards_for(test_account_bob.id);
    log("Alice amount 2: ", alice_amount_2);
    log("Bob amount 2: ", bob_amount_2);
    assert_true(too_small_to_care >= abs(alice_amount_2 - 2 * alice_amount));
    assert_true(too_small_to_care >= abs(bob_amount_2 - 2 * bob_amount));
    assert_equals(staking_rewards_for(test_account_charlie.id), 0);

    // Do payout
    rell.test.tx().op(staking_claim_rewards()).sign(admin_privkey).run();

    // Ensure there's no (more than a few seconds worth of) claimable yield after payout
    log("Alice is ", test_account_alice.id);
    assert_true(too_small_to_care >= staking_rewards_claimable_for(test_account_alice.id));
    log("Bob is ", test_account_bob.id);
    assert_true(too_small_to_care >= staking_rewards_claimable_for(test_account_bob.id));
    assert_true(too_small_to_care >= staking_rewards_claimable_for(test_account_charlie.id));

    // Run the clock forward a 6 months and check we have claimable rewards
    rell.test.set_next_block_time_delta(integer(millis_per_year / 2));
    rell.test.block().run(); rell.test.block().run();
    assert_true(staking_rewards_claimable_for(test_account_alice.id) > 1 * units_per_asset);
    assert_true(staking_rewards_claimable_for(test_account_bob.id) > 1 * units_per_asset);

    // Run the clock forward another 24 months and see that payout has triggered
    rell.test.set_next_block_time_delta(integer(millis_per_year * 2));
    rell.test.block().run();
    assert_true(staking_get_rewards_paid(test_account_alice.id) > 1 * units_per_asset);
    assert_true(staking_get_rewards_paid(test_account_bob.id) > 1 * units_per_asset);

    // However the total amount ever earned is not going to be 
    assert_true(staking_rewards_for(test_account_bob.id) > 1 * units_per_asset);

    // Everything paid up
    assert_equals(staking_rewards_for(test_account_bob.id), staking_get_rewards_paid(test_account_bob.id) + staking_rewards_claimable_for(test_account_bob.id));
}

function test_yield_and_batch_payout() {
    log("Rate per year: ", staking_get_current_rate());

    val too_small_to_care = 10 * units_per_asset;

    // Basic initialisation
    rell.test.tx()
        .op(init())
        .op(mint_to_pool(888 * units_per_asset))
        .sign(admin_privkey).run();

    val test_account_alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));

    // Make Bob with an existing 100 BSC stake
    val bob_evm_address = crypto.eth_pubkey_to_address(rell.test.keypairs.bob.pub);
    do_evm_stake_update_bsc(bob_evm_address, 100 * units_per_asset);
    val test_account_bob = require(do_create_account_using_ras_staking(rell.test.keypairs.bob));

    val test_account_charlie = require(do_create_account(rell.test.keypairs.charlie, auth_privkey));

    add_provider(rell.test.keypairs.charlie.pub);

    rell.test.tx()
        .op(mint_to(test_account_alice, 1000 * units_per_asset))
        .sign(admin_privkey).run();

    // Check no yield
    assert_equals(staking_rewards_claimable_for(test_account_alice.id), 0);
    assert_equals(staking_rewards_claimable_for(test_account_bob.id), 0);
    assert_equals(staking_rewards_claimable_for(test_account_charlie.id), 0);

    // FFWD
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    // Check no yield
    assert_equals(staking_rewards_claimable_for(test_account_alice.id), 0);
    assert_equals(staking_rewards_claimable_for(test_account_bob.id), 0);
    assert_equals(staking_rewards_claimable_for(test_account_charlie.id), 0);

    // Deposit 100 with A on native and stake to C
    do_staking_deposit_native(rell.test.keypairs.alice, 100 * units_per_asset);
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.charlie.pub);

    // Deposit an additional 100 with B (total 200) on BSC+native and stake to C
    do_staking_deposit_native(rell.test.keypairs.bob, 100 * units_per_asset);
    do_staking_delegate(rell.test.keypairs.bob, rell.test.keypairs.charlie.pub);

    // Check balances
    assert_equals(staking_get_balance(test_account_alice.id), 100 * units_per_asset);
    assert_equals(staking_get_balance(test_account_bob.id), 200 * units_per_asset);

    // FFWD
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    // Check that there is a yield and that B is twice of A (allow for rounding)
    val alice_amount = staking_rewards_claimable_for(test_account_alice.id);
    val bob_amount = staking_rewards_claimable_for(test_account_bob.id);
    assert_true(alice_amount > 0);
    assert_true(bob_amount > 0);
    assert_equals(staking_rewards_claimable_for(test_account_charlie.id), 0);
    log("alice %s claimable amount: %s".format(test_account_alice.id, alice_amount));
    log("bob %s claimable amount: %s".format(test_account_bob.id, bob_amount));
    assert_true(too_small_to_care >= abs(2 * alice_amount - bob_amount));

    // Check balances
    assert_equals(staking_get_balance(test_account_alice.id), 100 * units_per_asset);
    assert_equals(staking_get_balance(test_account_bob.id), 200 * units_per_asset);

    // FFWD
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    // Check both numbers have doubled (allow for rounding)
    val alice_amount_2 = staking_rewards_for(test_account_alice.id);
    val bob_amount_2 = staking_rewards_for(test_account_bob.id);
    log("Alice amount 2: ", alice_amount_2);
    log("Bob amount 2: ", bob_amount_2);
    assert_true(too_small_to_care >= abs(alice_amount_2 - 2 * alice_amount));
    assert_true(too_small_to_care >= abs(bob_amount_2 - 2 * bob_amount));
    assert_equals(staking_rewards_for(test_account_charlie.id), 0);

    // Do payout batch 0
    rell.test.tx().op(staking_claim_rewards(true, true)).sign(admin_privkey).run();
    // Ensure there's no (more than a few seconds worth of) claimable yield after payout
    log("Alice is ", test_account_alice.id);
    log("Bob is ", test_account_bob.id);
    assert_true(too_small_to_care >= staking_rewards_claimable_for(test_account_alice.id));
    assert_true(too_small_to_care >= staking_rewards_claimable_for(test_account_bob.id));

    // Run the clock forward a 6 months and check we have claimable rewards
    rell.test.set_next_block_time_delta(integer(millis_per_year / 2));
    rell.test.block().run();
    rell.test.block().run();
    assert_true(staking_rewards_claimable_for(test_account_alice.id) > 1 * units_per_asset);
    assert_true(staking_rewards_claimable_for(test_account_bob.id) > 1 * units_per_asset);

    // Run the clock forward another 24 months and see that payout has triggered
    rell.test.set_next_block_time_delta(integer(millis_per_year * 2));
    rell.test.block().run();
    assert_true(staking_get_rewards_paid(test_account_alice.id) > 1 * units_per_asset);
    assert_true(staking_get_rewards_paid(test_account_bob.id) > 1 * units_per_asset);

    // However the total amount ever earned is not going to be 
    assert_true(staking_rewards_for(test_account_bob.id) > 1 * units_per_asset);

    // Everything paid up
    assert_equals(
        staking_rewards_for(
            test_account_bob
                .id
        ),
        staking_get_rewards_paid(
            test_account_bob
                .id
        ) + staking_rewards_claimable_for(
            test_account_bob
                .id
        )
    );
}

function make_n_delegations(n: integer) {
    var accounts = list<ft4.accounts.account>();
    for (i in range(0, n)) {
        val priv_key = i.to_text().hash();
        val kp = rell.test.keypair(priv = priv_key, pub = crypto.privkey_to_pubkey(priv_key));
        val test_account = require(do_create_account(kp, auth_privkey));
        accounts.add(test_account);

        do_staking_deposit_native(kp, 100 * units_per_asset);
        do_staking_delegate(kp, rell.test.keypairs.charlie.pub);
    }
    return accounts;
}

function test_yield_and_batch_payout_many() {
    log("Rate per year: ", staking_get_current_rate());

    val too_small_to_care = 10 * units_per_asset;

    // Basic initialisation
    rell.test.tx()
        .op(init())
        .op(mint_to_pool(88888888 * units_per_asset))
        .sign(admin_privkey).run();

    val test_account_charlie = require(do_create_account(rell.test.keypairs.charlie, auth_privkey));

    add_provider(rell.test.keypairs.charlie.pub);


    // FFWD
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    val staked_accounts = make_n_delegations(100);

    // Check balances
    for (account in staked_accounts) {
        assert_equals(staking_get_balance(account.id), 100 * units_per_asset);
    }

    // FFWD
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    // Check that there is a yield
    for (account in staked_accounts) {
        assert_true(staking_rewards_claimable_for(account.id) > 0);
    }

    // Check balances
    for (account in staked_accounts) {
        assert_equals(staking_get_balance(account.id), 100 * units_per_asset);
    }

    // FFWD
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    // Do all batch payouts
    for (i in range(0,staked_accounts.size()/chain_context.args.staking_rewards_payout_batch_size)) {
        rell.test.tx().op(staking_claim_rewards(true, i == 0)).sign(admin_privkey).nop().run();
        for (j in range(0,chain_context.args.staking_rewards_payout_batch_size)) {
            if (i * chain_context.args.staking_rewards_payout_batch_size + j >= staked_accounts.size()) {
                break;
            }
            assert_true(
                too_small_to_care >= staking_rewards_claimable_for(
                    staked_accounts[i * chain_context
                            .args
                            .staking_rewards_payout_batch_size + j]
                        .id
                )
            );
        }
        if ((i+1) * chain_context.args.staking_rewards_payout_batch_size >= staked_accounts.size()) {
            break;
        }
    }
    
    // Run the clock forward 6 months and check we have claimable rewards
    rell.test.set_next_block_time_delta(integer(millis_per_year / 2));
    rell.test.block().run();
    rell.test.block().run();

    for (account in staked_accounts) {
        assert_true(staking_rewards_claimable_for(account.id) > 1 * units_per_asset);
    }

    // Run the clock forward another 24 months and see that payout has triggered
    rell.test.set_next_block_time_delta(integer(millis_per_year * 2));
    rell.test.block().run();
    for (account in staked_accounts) {
        assert_true(staking_get_rewards_paid(account.id) > 1 * units_per_asset);
    }

    // However, the total amount ever earned is not going to be 
    for (account in staked_accounts) {
        assert_true(staking_rewards_for(account.id) > 1 * units_per_asset);
    }
}

function test_potential_entity_join_issues_on_delegation() {
    val too_small_to_care = 0.001 * units_per_asset;

    rell.test.tx().op(init()).run();

    // Start with two accounts.

    // One EVM + native.
    val alice_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);
    do_evm_stake_update_bsc(alice_evm_address, 50 * units_per_asset);
    val test_account_alice = require(do_create_account_using_ras_staking(rell.test.keypairs.alice));
    do_staking_deposit_native(rell.test.keypairs.alice, 50 * units_per_asset);
    assert_equals(staking_get_balance(test_account_alice.id), 100 * units_per_asset);

    // One native.
    val test_account_bob = require(do_create_account(rell.test.keypairs.bob, auth_privkey));
    do_staking_deposit_native(rell.test.keypairs.bob, 100 * units_per_asset);
    assert_equals(staking_get_balance(test_account_bob.id), 100 * units_per_asset);

    // Add two providers
    add_provider(rell.test.keypairs.charlie.pub);
    add_provider(rell.test.keypairs.dave.pub);

    check_account_invariants(test_account_alice);
    check_account_invariants(test_account_bob);

    // Delegate both
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.charlie.pub);
    do_staking_delegate(rell.test.keypairs.bob, rell.test.keypairs.charlie.pub);

    // Run forward time
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    // Re-delegate the combined one
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.dave.pub);

    // Run forward more time
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    // They should be the same
    val alice_rewards = staking_rewards_claimable_for(test_account_alice.id);
    val bob_rewards = staking_rewards_claimable_for(test_account_bob.id);
    assert_true(too_small_to_care >= abs(alice_rewards - bob_rewards));

    check_account_invariants(test_account_alice);
    check_account_invariants(test_account_bob);

    // Re-delegate the other one
    do_staking_delegate(rell.test.keypairs.bob, rell.test.keypairs.dave.pub);

    // Run forward more time
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    // They should be the same
    val alice_rewards_2 = staking_rewards_claimable_for(test_account_alice.id);
    val bob_rewards_2 = staking_rewards_claimable_for(test_account_bob.id);
    assert_true(too_small_to_care >= abs(alice_rewards_2 - bob_rewards_2));

    assert_equals(rell.test.keypairs.dave.pub, staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));

    // Now withdraw on native without doing it on EVM
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, staking_request_withdrawal())
    ).op(
        staking_request_withdrawal()
    ).run();
    assert_equals(rell.test.keypairs.dave.pub, staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));
    assert_equals(rell.test.keypairs.dave.pub, staking_get_current_delegate(test_account_alice.id));

    // Run forward more time
    rell.test.set_next_block_time_delta(chain_context.args.staking_withdrawal_delay_ms);
    rell.test.block().run();

    assert_equals(rell.test.keypairs.dave.pub, staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));

    // Flush out the withdrawals
    do_pay_everything_native();

    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.CHR));
    assert_equals(rell.test.keypairs.dave.pub, staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));
    assert_equals(rell.test.keypairs.dave.pub, staking_get_current_delegate(test_account_alice.id));

    // Run forward a long time
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();
    rell.test.block().run();

    // Both accounts should go up as EVM still staked on Alice
    // We need to include what was paid out
    val alice_rewards_3 = staking_rewards_for(test_account_alice.id);
    val bob_rewards_3 = staking_rewards_for(test_account_bob.id);
    assert_true(alice_rewards_2 < alice_rewards_3);
    assert_true(bob_rewards_2 < bob_rewards_3);

    // But Alice should fall behind Bob
    assert_true(alice_rewards_3 < bob_rewards_3);
    assert_true(too_small_to_care <= abs(alice_rewards_3 - bob_rewards_3));

    // If we request to withdraw everything and wait a little delegation should be null
    do_evm_withdrawal_request_bsc(test_account_alice);
    rell.test.set_next_block_time_delta(millis_per_month);
    rell.test.block().run();
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));
    assert_null(staking_get_current_delegate(test_account_alice.id));

    check_account_invariants(test_account_alice);
    check_account_invariants(test_account_bob);
}

function test_withdrawal() {
    rell.test.tx().op(init()).run();
    add_provider(rell.test.keypairs.bob.pub);

    val test_account_alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val test_account_bob = require(do_create_account(rell.test.keypairs.bob, auth_privkey));

    rell.test.tx()
        .op(mint_to(test_account_alice, 9999999))
    .run();

    // Need a deposit to withdraw it
    assert_equals(staking_get_balance(test_account_alice.id), 0);
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, staking_request_withdrawal())
    ).op(
        staking_request_withdrawal()
    ).run_must_fail("No staker state for %s".format(test_account_alice.id));

    do_staking_deposit_native(rell.test.keypairs.alice, 1); // Have something to withdraw

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, staking_request_withdrawal())
    ).op(
        staking_request_withdrawal()
    ).run();

    assert_events(
        ("icmf_message",(topic = economy_chain_staking_state_update, body = economy_chain_staking_state_update_message(
            test_account_alice.id,
            1,
            withdrawals = [
                economy_chain_staking_state_withdrawal(
                    amount = 1,
                    finish_at = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL*5 + chain_context.args.staking_withdrawal_delay_ms
                    )
            ],
        ).to_gtv()).to_gtv_pretty()),
    );

    // Simple withdraw
    rell.test.set_next_block_time_delta(chain_context.args.staking_withdrawals_payout_interval_ms);
    rell.test.block().run();
    rell.test.block().run();

    // Automatic withdrawal should have happened
    assert_equals(staking_get_balance(test_account_alice.id), 0);
    assert_equals(get_account_balance(get_deposit_account()), 0);

    // Ensure that the withdrawal request is cancelled on re-delegation
    do_staking_deposit_native(rell.test.keypairs.alice, 7777);
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, staking_request_withdrawal())
    )
    .op(staking_request_withdrawal())
    .run();
    assert_false(empty(staking_get_withdrawal_time(test_account_alice.id)));
    assert_equals(staking_get_balance(test_account_alice.id), 7777);
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.bob.pub);
    assert_true(empty(staking_get_withdrawal_time(test_account_alice.id)));

    // Only one withdrawal request at a time
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, staking_request_withdrawal())
    )
    .op(staking_request_withdrawal())
    .run();
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, staking_request_withdrawal())
    )
    .op(staking_request_withdrawal())
    .run_must_fail("Only one withdrawal request allowed at a time");

    // Run time toward and see that the withdrawal occurs
    rell.test.set_next_block_time_delta(chain_context.args.staking_withdrawals_payout_interval_ms);
    rell.test.block().run();
    rell.test.block().run();

    assert_true(empty(staking_get_withdrawal_time(test_account_alice.id)));
    assert_equals(staking_get_balance(test_account_alice.id), 0);
    assert_equals(get_account_balance(get_deposit_account()), 0);

    assert_events(
        ("icmf_message",(topic = economy_chain_staking_state_update, body = economy_chain_staking_state_update_message(
            test_account_alice.id,
            0,
            withdrawals = [],
        ).to_gtv()).to_gtv_pretty()),
    );
}

function test_withdrawal_request_cancelled_on_native_deposit() {
    rell.test.tx().op(init()).run();
    add_provider(rell.test.keypairs.bob.pub);

    val test_account_alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));

    rell.test.tx()
        .op(mint_to(test_account_alice, 9999999))
    .run();
    do_staking_deposit_native(rell.test.keypairs.alice, 7777);


    // Request withdrawal
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, staking_request_withdrawal())
    )
    .op(staking_request_withdrawal())
    .run();
    assert_false(empty(staking_get_withdrawal_time(test_account_alice.id)));
    assert_equals(staking_get_balance(test_account_alice.id), 7777);

    // Ensure it is cancelled on adding stake to mirror EVM
    do_staking_deposit_native(rell.test.keypairs.alice, 50);
    assert_true(empty(staking_get_withdrawal_time(test_account_alice.id)));

}

function test_staking_get_total_delegation_to() {
    rell.test.tx().op(init()).run();

    val test_account_alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val test_account_bob = require(do_create_account(rell.test.keypairs.bob, auth_privkey));

    // Create C with 9 CHR on BSC
    val charlie_evm_address = crypto.eth_pubkey_to_address(rell.test.keypairs.charlie.pub);
    do_evm_stake_update_bsc(charlie_evm_address, 19 * units_per_asset);
    val test_account_charlie = require(do_create_account_using_ras_staking(rell.test.keypairs.charlie));

    val test_account_dave = require(do_create_account(rell.test.keypairs.dave, auth_privkey));

    rell.test.tx()
        .op(mint_to(test_account_dave, 9999999 * units_per_asset))
    .run();

    add_provider(rell.test.keypairs.alice.pub);
    add_provider(rell.test.keypairs.bob.pub);

    // Have C delegate to A with 9
    do_staking_delegate(rell.test.keypairs.charlie, rell.test.keypairs.alice.pub);

    // Have D deposit 11 and delegate to B
    do_staking_deposit_native(rell.test.keypairs.dave, 11 * units_per_asset);
    do_staking_delegate(rell.test.keypairs.dave, rell.test.keypairs.bob.pub);

    // Check that A has 19 delegated to it
    // Check that B has 11 delegated to it
    assert_equals(staking_get_total_delegation_to(rell.test.keypairs.alice.pub), 19 * units_per_asset);
    assert_equals(staking_get_total_delegation_to(rell.test.keypairs.bob.pub), 11 * units_per_asset);

    // Have C deposit an additional 7
    do_staking_deposit_native(rell.test.keypairs.charlie, 7 * units_per_asset);

    // Check that A has 26 delegated to it (adding stake is immediate)
    assert_equals(staking_get_total_delegation_to(rell.test.keypairs.alice.pub), 26 * units_per_asset);

    // Have D change their their delegation to A
    do_staking_delegate(rell.test.keypairs.dave, rell.test.keypairs.alice.pub);

    // Check that A has 26 delegated to it (changing delegation takes time)
    assert_equals(staking_get_total_delegation_to(rell.test.keypairs.alice.pub), 26 * units_per_asset);

    // Wait a period
    rell.test.set_next_block_time_delta(staking_delegation_delay_ms);
    rell.test.block().run();

    // Check that A has 37 delegated to it
    // Check that B has 0 delegated to it
    assert_equals(staking_get_total_delegation_to(rell.test.keypairs.alice.pub), 37 * units_per_asset);
    assert_equals(staking_get_total_delegation_to(rell.test.keypairs.bob.pub), 0);

    // Have D undelegate
    do_staking_undelegate(rell.test.keypairs.dave);

    check_account_invariants(test_account_alice);
    check_account_invariants(test_account_bob);
    check_account_invariants(test_account_dave);

    // Wait a period
    rell.test.set_next_block_time_delta(staking_delegation_delay_ms);
    rell.test.block().run();

    // Check that A has 26 delegated to it
    assert_equals(staking_get_total_delegation_to(rell.test.keypairs.alice.pub), 26 * units_per_asset);
    assert_equals(staking_get_total_delegation_to(rell.test.keypairs.bob.pub), 0);

    check_account_invariants(test_account_alice);
    check_account_invariants(test_account_bob);
    check_account_invariants(test_account_dave);
}

function test_update_state_invariants() {

    val too_small_to_care = 0.001 * units_per_asset;

    rell.test.tx().op(init()).run();

    // Take two accounts both the same with EVM and native
    val alice_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);
    do_evm_stake_update_bsc(alice_evm_address, 50 * units_per_asset);
    val test_account_alice = require(do_create_account_using_ras_staking(rell.test.keypairs.alice));
    do_staking_deposit_native(rell.test.keypairs.alice, 50 * units_per_asset);
    assert_equals(staking_get_balance(test_account_alice.id), 100 * units_per_asset);

    val bob_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.bob.priv);
    do_evm_stake_update_bsc(bob_evm_address, 50 * units_per_asset);
    val test_account_bob = require(do_create_account_using_ras_staking(rell.test.keypairs.bob));
    do_staking_deposit_native(rell.test.keypairs.bob, 50 * units_per_asset);
    assert_equals(staking_get_balance(test_account_bob.id), 100 * units_per_asset);

    // Run forward time
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    // Bash one of them with update update_state
    var ss = staker_state @ { .account == test_account_alice and .network == network.BSC };
    do_staker_state_update(ss);

    // Run forward more time
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    // See that they're the same
    assert_true(too_small_to_care >= abs(staking_rewards_claimable_for(test_account_alice.id) - staking_rewards_claimable_for(test_account_bob.id)));

    // Run forward more time
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();

    // Bash both of them with update_all
    do_update_pending_token_time_all();

    // See that they're the same
    val alice_amount = staking_rewards_claimable_for(test_account_alice.id);
    val bob_amount = staking_rewards_claimable_for(test_account_bob.id);
    assert_true(too_small_to_care >= abs(alice_amount - bob_amount));

    // Trigger a payout
    rell.test.tx().op(staking_claim_rewards()).sign(admin_privkey).run();

    check_account_invariants(test_account_alice);
    check_account_invariants(test_account_bob);

    // Total it all back up
    assert_equals(alice_amount, staking_get_rewards_paid(test_account_alice.id));
    assert_equals(bob_amount, staking_get_rewards_paid(test_account_bob.id));

    // Next to nothing to claim
    assert_true(too_small_to_care >= staking_rewards_claimable_for(test_account_alice.id) + staking_rewards_claimable_for(test_account_bob.id));

    check_account_invariants(test_account_alice);
    check_account_invariants(test_account_bob);
}

function test_deposit_and_withdraw_via_evm() {
    rell.test.tx().op(init()).run();

    val alice_evm_address = crypto.eth_pubkey_to_address(rell.test.keypairs.alice.pub);
    do_evm_stake_update_bsc(alice_evm_address, 50 * units_per_asset);

    val test_account_alice = require(do_create_account_using_ras_staking(rell.test.keypairs.alice));

    do_evm_withdrawal_request_bsc(test_account_alice);
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));
    assert_null(staking_get_current_delegate(test_account_alice.id));

    assert_equals(staking_get_balance(test_account_alice.id), 50 * units_per_asset);

    // Can't withdraw on CHR as no balance *there*
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, staking_request_withdrawal())
    )
    .op(staking_request_withdrawal())
    .run_must_fail("No staker state for %s".format(test_account_alice.id));

    // Wait a period
    rell.test.set_next_block_time_delta(staking_delegation_delay_ms);
    rell.test.block().run();

    // Withdraw
    do_evm_stake_update_bsc(test_account_alice.id, 0);

    // Reload
    do_evm_stake_update_bsc(test_account_alice.id, 10);
    rell.test.tx().op(mint_to(test_account_alice, 9999999)).run();
    do_staking_deposit_native(rell.test.keypairs.alice, 10);

    // Request withdrawal on native once (which is fine)
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, staking_request_withdrawal())
    )
    .op(staking_request_withdrawal())
    .run();

    // Request withdrawal on native a second time (which is a dup)
    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, staking_request_withdrawal())
    )
    .op(staking_request_withdrawal())
        .run_must_fail("Only one withdrawal request allowed at a time");

    // Request withdrawal again on BSC (which is okay)
    do_evm_withdrawal_request_bsc(test_account_alice);
}

function test_evm_account_creation() {
    rell.test.tx().op(init()).run();

    val alice_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);

    do_evm_stake_update_bsc(alice_evm_address, 50 * units_per_asset);

    val test_account_alice = do_create_account_using_ras_staking(rell.test.keypairs.alice)!!;

    // See that FT4 account is created
    require(
        ft4.accounts.auth_descriptor_signer @? {.id == alice_evm_address} ( @omit @sort .rowid, .account_auth_descriptor.account ),
        "Cannot find EVM account."
    );
    require(
        require(eif.hbridge_core.find_ft4_account_for_address(alice_evm_address, 97)) == test_account_alice,
        "EIF Hbridge link is not established"
    );
    assert_equals(
        staking_get_balance(test_account_alice.id), 50 * units_per_asset
    );

    assert_equals(ft4.assets.get_asset_balance(test_account_alice, get_asset()), chain_context.args.amount_to_mint);
}

