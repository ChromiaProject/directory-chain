    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.CHR), rell.test.keypairs.bob.pub);
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));

    // And this should still be true in a year and future delegation has been applied
    rell.test.set_next_block_time_delta(millis_per_year);
    rell.test.block().run();
    assert_equals(staking_get_current_delegate(test_account_alice.id), rell.test.keypairs.charlie.pub);
    assert_equals(staking_get_current_delegate_on_network(test_account_alice.id, network.CHR), rell.test.keypairs.charlie.pub);
    assert_null(staking_get_current_delegate_on_network(test_account_alice.id, network.BSC));
}

function test_staking_distribute_rewards_error_handling() {
    // Initialise and top-up rewards pool
    rell.test.tx()
        .op(init())
        .op(mint_to_pool(888 * units_per_asset))
    .sign(admin_privkey).run();

    val alice_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);
    do_evm_stake_update_bsc(alice_evm_address, 10 * units_per_asset);
    val test_account_alice = require(do_create_account_using_ras_staking(rell.test.keypairs.alice));
    do_evm_stake_update_eth(alice_evm_address, 30 * units_per_asset);
    do_staking_deposit_native(rell.test.keypairs.alice, 50 * units_per_asset);

    val bob_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.bob.priv);
    do_evm_stake_update_bsc(bob_evm_address, 10 * units_per_asset);
    val test_account_bob = require(do_create_account_using_ras_staking(rell.test.keypairs.bob));
    do_evm_stake_update_eth(bob_evm_address, 30 * units_per_asset);
    do_staking_deposit_native(rell.test.keypairs.bob, 50 * units_per_asset);

    // Delegate and run forwards 1 year + 1 week
    add_provider(rell.test.keypairs.dave.pub);
    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.dave.pub);
    do_staking_delegate(rell.test.keypairs.bob, rell.test.keypairs.dave.pub);
    rell.test.set_next_block_time_delta(millis_per_year + staking_delegation_delay_ms);
    rell.test.block().run();

    // Check that we now have 9 rewards in total.
    assert_equals(staking_rewards_claimable_for(test_account_alice.id) / units_per_asset, 9);
    assert_equals(staking_rewards_claimable_for(test_account_bob.id) / units_per_asset, 9);

    // Make payment to Alice fail
    rell.test.tx()
        .op(ft4.test_utils.evm_auth_operation_for(rell.test.keypairs.alice.priv, enable_transfer_memo()))
        .op(enable_transfer_memo())
        .sign(rell.test.keypairs.alice)
        .run();

    // Payout out all
    rell.test.tx().op(staking_claim_rewards()).sign(admin_privkey).run();

    // Assert that Bob still get reward payed out
    assert_equals(staking_get_rewards_paid(test_account_alice.id), 0);
    assert_equals(staking_get_rewards_paid(test_account_bob.id) / units_per_asset, 9);
}

function test_stat_queries() {
    rell.test.tx().op(init()).run();

    val alice_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);
    val bob_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.bob.priv);
    val charlie_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.charlie.priv);
    val eve_evm_address = crypto.eth_privkey_to_address(rell.test.keypairs.eve.priv);

    add_provider(rell.test.keypairs.charlie.pub);
    add_provider(rell.test.keypairs.dave.pub);


    val test_account_alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    rell.test.tx()
        .op(mint_to(test_account_alice, 200 * units_per_asset))
    .sign(admin_privkey).run();

    val test_account_bob = require(do_create_account(rell.test.keypairs.bob, auth_privkey));
    rell.test.tx()
        .op(mint_to(test_account_bob, 200 * units_per_asset))
    .sign(admin_privkey).run();

    do_staking_deposit_native(rell.test.keypairs.alice, 150 * units_per_asset);
    do_staking_deposit_native(rell.test.keypairs.bob, 200 * units_per_asset);

    do_staking_delegate(rell.test.keypairs.alice, rell.test.keypairs.charlie.pub);
    do_staking_delegate(rell.test.keypairs.bob, rell.test.keypairs.dave.pub);

    do_evm_stake_update_bsc(charlie_evm_address, 300 * units_per_asset);
    do_evm_stake_update_eth(eve_evm_address, 400 * units_per_asset);

    val test_account_charlie = require(do_create_account_using_ras_staking(rell.test.keypairs.charlie));
    val test_account_eve = require(do_create_account_using_ras_staking(rell.test.keypairs.eve));

    assert_equals(staking_get_balance_on_network(test_account_alice.id, network.CHR), 150 * units_per_asset);
    assert_equals(staking_get_balance_on_network(test_account_bob.id, network.CHR), 200 * units_per_asset);
    assert_equals(staking_get_balance_on_network(test_account_charlie.id, network.BSC), 300 * units_per_asset);
    assert_equals(staking_get_balance_on_network(test_account_eve.id, network.ETH), 400 * units_per_asset);

    do_staking_delegate(rell.test.keypairs.charlie, rell.test.keypairs.dave.pub);

    assert_equals(staking_total_stake_on_network(network.BSC), 300 * units_per_asset);
    assert_equals(staking_total_stake_on_network(network.ETH), 400 * units_per_asset);
    assert_equals(staking_total_stake_on_network(network.CHR), 350 * units_per_asset);

    assert_equals(staking_total_delegated(), 650 * units_per_asset);
    assert_equals(staking_total_delegated(network.ETH), 0);
    assert_equals(staking_total_delegated(network.BSC), 300 * units_per_asset);
    assert_equals(staking_total_delegated(network.CHR), 350 * units_per_asset);

    assert_equals(staking_total_delegation_accounts(), 3);
    assert_equals(staking_total_delegation_accounts(network.ETH), 0);
    assert_equals(staking_total_delegation_accounts(network.BSC), 1);
    assert_equals(staking_total_delegation_accounts(network.CHR), 2);

    assert_equals(staking_total_accounts_on_network(network.ETH), 1);
    assert_equals(staking_total_accounts_on_network(network.BSC), 1);
    assert_equals(staking_total_accounts_on_network(network.CHR), 2);
}

function test_provisional_stake_queries() {
