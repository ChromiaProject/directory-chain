function test_stats() {
    rell.test.tx().op(init()).run();

    assert_equals(staking_total_stake(), 0);
    assert_equals(staking_total_accounts(), 0);

    val test_account_alice = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val test_account_bob = require(do_create_account(rell.test.keypairs.bob, auth_privkey));
    val test_account_charlie = require(do_create_account(rell.test.keypairs.charlie, auth_privkey));
    val test_account_dave = require(do_create_account(rell.test.keypairs.dave, auth_privkey));

    assert_equals(staking_total_accounts(), 0);
    assert_equals(staking_total_stake(), 0);

    rell.test.tx()
        .op(mint_to(test_account_charlie, 20))
        .op(mint_to(test_account_dave, 1))
        .run();

    do_staking_deposit_native(rell.test.keypairs.charlie, 10);
    do_staking_deposit_native(rell.test.keypairs.dave, 1);

    assert_equals(staking_total_stake(), 11);
    assert_equals(staking_total_accounts(), 2);

    val native_accounts = get_accounts_with_native_stake(10, null);
    assert_equals(native_accounts.data, [account_staking_balance(test_account_charlie.id,10).to_gtv(), account_staking_balance(test_account_dave.id,1).to_gtv()]);
}

function test_set_provider_staking_account_and_transfer_staking_states() {

    rell.test.tx().op(init()).run();

    val provider_keypair = rell.test.keypairs.alice;
    val new_provider_account_keypair = rell.test.keypairs.bob;
    val new_provider_account_id = ft4.accounts.get_account_id_from_signers([new_provider_account_keypair.pub]);

    add_provider(provider_keypair.pub);
    val initial_provider_account = provider_staking_account @ { .provider.pubkey == provider_keypair.pub } ( .staking_account );
    assert_equals(initial_provider_account.id, get_provider_staking_account(provider_keypair.pub));

    rell.test.tx()
        .op(mint_to(initial_provider_account, 9999999))
        .sign(admin_privkey).run();

    // Have A deposit and delegate to itself
    rell.test.tx().op(
        ft4.test_utils.ft_auth_operation_for(provider_keypair.pub)
    ).op(
        staking_deposit_native(9999999, provider_keypair.pub)
    ).sign(provider_keypair).run();
    assert_equals(staking_get_current_delegate(initial_provider_account.id), provider_keypair.pub);

    // Wait for delegation to take effect
    rell.test.set_next_block_time_delta(millis_per_month);
    rell.test.block().run();
    rell.test.block().run();
    assert_equals(staking_get_balance(initial_provider_account.id), 9999999);
    assert_true(staking_rewards_claimable_for(initial_provider_account.id) > 0);
    assert_true(exists(provider_staking_account @* {
        .provider.pubkey == provider_keypair.pub,
        .staking_account.id == initial_provider_account.id}));

    // Change provider staking account
    rell.test.tx().op(
            set_provider_staking_account(provider_keypair.pub, new_provider_account_keypair.pub)
        ).sign(provider_keypair, new_provider_account_keypair)
        .run();
    assert_equals(new_provider_account_id, get_provider_staking_account(provider_keypair.pub));
    assert_equals(staking_get_balance(initial_provider_account.id), 0);
    assert_equals(staking_get_balance(new_provider_account_id), 9999999);
    assert_null(staking_get_current_delegate(initial_provider_account.id));
    assert_equals(staking_get_current_delegate(new_provider_account_id), provider_keypair.pub);
    assert_true(exists(provider_staking_account @* {
        .provider.pubkey == provider_keypair.pub,
        .staking_account.id == new_provider_account_id}));
}

function test_set_provider_staking_account_and_transfer_staking_states_ft4() {
    rell.test.tx().op(init()).run();

    val provider_keypair = rell.test.keypairs.alice;
    val new_provider_account_keypair = rell.test.keypairs.bob;
    val new_provider_account_id = ft4.accounts.get_account_id_from_signers([new_provider_account_keypair.pub]);

    add_provider(provider_keypair.pub);
    val initial_provider_account = provider_staking_account @ { .provider.pubkey == provider_keypair.pub } ( .staking_account );

    rell.test.tx()
        .op(mint_to(initial_provider_account, 9999999))
        .sign(admin_privkey).run();

    // Have A deposit and delegate to itself
    rell.test.tx().op(
        ft4.test_utils.ft_auth_operation_for(provider_keypair.pub)
    ).op(
        staking_deposit_native(9999999, provider_keypair.pub)
    ).sign(provider_keypair).run();
    assert_equals(staking_get_current_delegate(initial_provider_account.id), provider_keypair.pub);

    // Wait for delegation to take effect
    rell.test.set_next_block_time_delta(millis_per_month);
    rell.test.block().run();
    rell.test.block().run();
    assert_equals(staking_get_balance(initial_provider_account.id), 9999999);
