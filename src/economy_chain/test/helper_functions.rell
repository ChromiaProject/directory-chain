function do_evm_withdrawal_request_bsc(ft4.accounts.account) {
    // Derive the EVM address of the FT4 account
    val evm_address = ft4.accounts.auth_descriptor_signer @ {.account_auth_descriptor.account == account} ( @omit @sort .rowid, .id );

    // Call the oracle
    rell.test.tx().op(
        staking_oracle_withdrawal_request(evm_address, 97)
    )
    .nop()
    .sign(chain_context.args.oracle_privkey)
    .run();
}

function do_evm_withdrawal_request_eth(ft4.accounts.account) {
    // Derive the EVM address of the FT4 account
    val evm_address = ft4.accounts.auth_descriptor_signer @ {.account_auth_descriptor.account == account} ( @omit @sort .rowid, .id );

    // Call the oracle
    rell.test.tx().op(
        staking_oracle_withdrawal_request(evm_address, network.ETH.value)
    )
    .nop()
    .sign(chain_context.args.oracle_privkey)
