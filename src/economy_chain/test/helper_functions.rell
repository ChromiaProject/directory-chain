    ).run();
}

function create_cluster_nodes(provider, system: boolean = true, dapp_nodes: integer = 3) {
    val nodes = list<node>();
    if (system) {
        val cluster_system = ensure_cluster(system_cluster_name, false, false, 1, 1024);
        val node_system = ensure_node(provider.pubkey, rell.test.keypairs.dave.pub, true, "SE", 1, 1024, false);
        nodes.add(node_system);
        rell.test.tx().op(
            create_cluster_node_op(cluster_system, node_system),
        ).run();
    }

    val node_keys = [rell.test.keypairs.eve, rell.test.keypairs.frank, rell.test.keypairs.grace, rell.test.keypairs.heidi];
    for (i in range(0, min(dapp_nodes, node_keys.size()))) {
        val dapp_key = node_keys[i];
        val cluster = ensure_cluster("cluster%s".format(i), false, false, 1, 1024);
        val node = ensure_node(provider.pubkey, dapp_key.pub, true, "SE", 1, 1024, false);
        nodes.add(node);
        rell.test.tx().op(
            create_cluster_node_op(cluster, node),
        ).run();
    }

    return nodes;
}

function do_receive_ticket_container_result_message(body: gtv) {
    rell.test.tx().op(
        receive_ticket_container_result_message_op(body)
    ).run();
}