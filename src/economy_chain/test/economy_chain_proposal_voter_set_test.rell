@test module;

import ^^.*;
import ^.helper_operations.*;
import common_proposal.voter_set_proposal.*;

val test_set = "test";
val test_set2 = "test-2";

function test_propose_update_voter_set_system_p() {

    rell.test.tx()
        .op(
            create_test_voter_set_with_member(voter_sets.system_p, rell.test.keypairs.alice.pub),
            propose_update_voter_set(voter_sets.system_p, null, [], [])
        )
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Cannot update system voter set. Update this by proposing system provider role");
}
