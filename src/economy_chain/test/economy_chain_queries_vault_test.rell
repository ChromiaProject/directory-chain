@test module;

import ^^.*;

function test_find_dapp_details() {
    val rowid = rowid(1);
    val dapp_details = find_dapp_details(rowid);

    val expected = (
        rowid = rowid,
        name = "Chromia Economy Chain",
        description = "Economy chain handles native CHR payments, container leases and provider rewards",
        launch_url = null,
        genre = "System Chain",
        chain_list = [dapp_details_blockchain(
            brid = chain_context.blockchain_rid,
            name = "Chromia Economy Chain",
            role = ""
        )],
        content = null
    ).to_gtv_pretty();

    assert_equals(dapp_details, expected);
}

function test_find_dapp_details_with_media() {
    val rowid = rowid(1);
    val dapp_details = find_dapp_details(rowid, [dapp_content_type.icon]);

    val expected = (
        rowid = rowid,
        name = "Chromia Economy Chain",
        description = "Economy chain handles native CHR payments, container leases and provider rewards",
        launch_url = null,
        genre = "System Chain",
        chain_list = [dapp_details_blockchain(
        brid = chain_context.blockchain_rid,
        name = "Chromia Economy Chain",
        role = ""
    )],
        content = [dapp_media(name = "", url = "https://assets.chromia.com/chr.png", dapp_content_type.icon)]
    ).to_gtv_pretty();

    assert_equals(dapp_details, expected);
}

function test_find_dapp_details_with_all_media() {
    val rowid = rowid(1);
    val dapp_details = find_dapp_details(rowid, [dapp_content_type.icon, dapp_content_type.landscape, dapp_content_type.portrait, dapp_content_type.promotional, dapp_content_type.video]);

    val expected = (
        rowid = rowid,
        name = "Chromia Economy Chain",
        description = "Economy chain handles native CHR payments, container leases and provider rewards",
        launch_url = null,
        genre = "System Chain",
        chain_list = [dapp_details_blockchain(
        brid = chain_context.blockchain_rid,
        name = "Chromia Economy Chain",
        role = ""
    )],
        content = [
            dapp_media(name = "", url = "https://assets.chromia.com/chr.png", dapp_content_type.icon),
            dapp_media(name = "", url = "https://assets.chromia.com/chr-1000.png", dapp_content_type.landscape),
            dapp_media(name = "", url = "https://assets.chromia.com/chr-1000.png", dapp_content_type.portrait),
        ]
    ).to_gtv_pretty();

    assert_equals(dapp_details, expected);
}

