@test module;

import ^^.*;
import ^.helper_functions.*;
import ^.helper_operations.*;

struct module_args {
    account_creator_privkey: byte_array;
    admin_privkey: byte_array;
    staking_delegation_delay_ms: integer;
    staking_withdrawal_delay_ms: integer;
    staking_rewards_payout_interval_ms: integer;
    staking_withdrawals_payout_interval_ms: integer;
    amount_to_mint: big_integer = 1000000000;
    staking_rewards_payout_batch_size: integer = 10;
}

val admin_privkey = chain_context.args.admin_privkey;
val auth_privkey = chain_context.args.account_creator_privkey;

function test_staking_get_previous_delegate_after_offboarding_current_provider() {
    rell.test.tx().op(init()).run();

    val staker_account = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val staker_keypair = rell.test.keypairs.alice;
    rell.test.tx()
        .op(mint_to(staker_account, 9999999))
        .sign(admin_privkey).run();

    val null_provider = provider @ { get_null_account() };
    val provider_pubkey1 = rell.test.keypairs.charlie.pub;
    val provider_pubkey2 = rell.test.keypairs.bob.pub;
    val provider_pubkey3 = rell.test.keypairs.eve.pub;
    val provider1 = add_provider(provider_pubkey1);
    val provider2 = add_provider(provider_pubkey2);
    val provider3 = add_provider(provider_pubkey3);

    //Assert no delegation
    assert_null(staking_get_previous_delegate(staker_account.id));

    //Initial staking delegation
    val first_staking_delegate_time = _staking_last_known_time();
    do_staking_deposit_native(staker_keypair, 9999999, provider_pubkey1);

    //Remove provider
    remove_provider(provider_pubkey1);

    assert_equals(staking_get_previous_delegate(staker_account.id), previous_delegate(provider_pubkey1, true));

    //Second staking delegation is instant since staking was undelegated
    val second_staking_delagate_time = _staking_last_known_time();
    do_staking_delegate(staker_keypair, provider_pubkey2);

    assert_equals(staking_get_previous_delegate(staker_account.id), previous_delegate(provider_pubkey1, true));

    //Third staking delegation
    do_staking_delegate(staker_keypair, provider_pubkey3);
    assert_equals(staking_get_previous_delegate(staker_account.id), previous_delegate(provider_pubkey1, true));

    //Wait for delegation to take effect
    rell.test.set_next_block_time_delta(chain_context.args.staking_delegation_delay_ms);
    rell.test.block().run();

    assert_equals(staking_get_previous_delegate(staker_account.id), previous_delegate(provider_pubkey2, false));

    //Remove provider
    remove_provider(provider_pubkey2);

    assert_equals(staking_get_previous_delegate(staker_account.id), previous_delegate(provider_pubkey2, true));
}

function test_staking_get_previous_delegate_offboarding_next_provider_as_current_provider() {
    rell.test.tx().op(init()).run();

    val staker_account = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val staker_keypair = rell.test.keypairs.alice;
    rell.test.tx()
        .op(mint_to(staker_account, 9999999))
        .sign(admin_privkey).run();

    val null_provider = provider @ { get_null_account() };
    val provider_pubkey1 = rell.test.keypairs.charlie.pub;
    val provider_pubkey2 = rell.test.keypairs.bob.pub;
    val provider_pubkey3 = rell.test.keypairs.eve.pub;
    val provider_pubkey4 = rell.test.keypairs.trudy.pub;
    val provider1 = add_provider(provider_pubkey1);
    val provider2 = add_provider(provider_pubkey2);
    val provider3 = add_provider(provider_pubkey3);
    val provider4 = add_provider(provider_pubkey4);

    //Initial staking delegation
    val first_staking_delegate_time = _staking_last_known_time();
    do_staking_deposit_native(staker_keypair, 9999999, provider_pubkey1);

    //Second staking delegation
    do_staking_delegate(staker_keypair, provider_pubkey2);

    //Wait for delegation to take effect
    rell.test.set_next_block_time_delta(chain_context.args.staking_delegation_delay_ms);
    rell.test.block().run();

    //Remove provider
    remove_provider(provider_pubkey2);

    assert_equals(staking_get_previous_delegate(staker_account.id), previous_delegate(provider_pubkey2, true));

    //Third staking delegation is instant since staking was undelegated
    do_staking_delegate(staker_keypair, provider_pubkey3);

    assert_equals(staking_get_previous_delegate(staker_account.id), previous_delegate(provider_pubkey2, true));

    //Fourth staking delegation
    do_staking_delegate(staker_keypair, provider_pubkey4);
    assert_equals(staking_get_previous_delegate(staker_account.id), previous_delegate(provider_pubkey2, true));

    //Wait for delegation to take effect
    rell.test.set_next_block_time_delta(millis_per_month);
    rell.test.block().run();
    assert_equals(staking_get_previous_delegate(staker_account.id), previous_delegate(provider_pubkey3, false));

    //Remove provider
    remove_provider(provider_pubkey4);

    assert_equals(staking_get_previous_delegate(staker_account.id), previous_delegate(provider_pubkey4, true));
}

function test_staking_get_next_delegation_change_after_offboarding_upcoming_delegation_provider() {
    rell.test.tx().op(init()).run();

    val staker_account = require(do_create_account(rell.test.keypairs.alice, auth_privkey));
    val staker_keypair = rell.test.keypairs.alice;
    rell.test.tx()
        .op(mint_to(staker_account, 9999999))
        .sign(admin_privkey).run();

    val null_provider = provider @ { get_null_account() };
    val provider_pubkey1 = rell.test.keypairs.charlie.pub;
    val provider_pubkey2 = rell.test.keypairs.bob.pub;
    val provider_pubkey3 = rell.test.keypairs.eve.pub;
    val provider_pubkey4 = rell.test.keypairs.trudy.pub;
    val provider1 = add_provider(provider_pubkey1);
    val provider2 = add_provider(provider_pubkey2);
    val provider3 = add_provider(provider_pubkey3);
    val provider4 = add_provider(provider_pubkey4);

    //Initial staking delegation
    val first_staking_delegate_time = _staking_last_known_time();
    do_staking_deposit_native(staker_keypair, 9999999, provider_pubkey1);

    //Second staking delegation sets the upcoming delegation
    val second_staking_delegate_time = _staking_last_known_time();
    do_staking_delegate(staker_keypair, provider_pubkey2);

    //Remove provider
    remove_provider(provider_pubkey2);

    assert_equals(staking_get_next_delegation_change(staker_account.id), next_delegation_change(pubkey = provider_pubkey2, time = second_staking_delegate_time + chain_context.args.staking_delegation_delay_ms, auto_canceled = true));

    //New delegation
    val third_staking_delegate_time = _staking_last_known_time();
    do_staking_delegate(staker_keypair, provider_pubkey3);

    assert_equals(staking_get_next_delegation_change(staker_account.id), next_delegation_change(pubkey = provider_pubkey3, time = third_staking_delegate_time + chain_context.args.staking_delegation_delay_ms, auto_canceled = false));

    //Remove provider
    remove_provider(provider_pubkey3);

    assert_equals(staking_get_next_delegation_change(staker_account.id), next_delegation_change(pubkey = provider_pubkey3,time = third_staking_delegate_time + chain_context.args.staking_delegation_delay_ms, auto_canceled = true));
}
