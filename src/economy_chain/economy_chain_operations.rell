/**
 * Request creation of a container with standard subnode image.
 *
 * If enough tokens are available on the users account an ICMF message will be sent to DC for creation of the container.
 * A lease is setup for the request amount of weeks and the cost is deducted from the users account.
 *
 * @param provider_pubkey  pubkey of provider
 * @param container_units  number of container_units
 */
operation create_container(provider_pubkey: pubkey, container_units: integer,
    duration_weeks: integer, extra_storage_gib: integer, cluster_name: text, auto_renew: boolean) {
    create_container_impl(provider_pubkey, container_units, duration_weeks, extra_storage_gib, cluster_name, auto_renew, "");
}

/**
 * Request creation of a container with custom subnode image.
 *
 * If enough tokens are available on the users account an ICMF message will be sent to DC for creation of the container.
 * A lease is setup for the request amount of weeks and the cost is deducted from the users account.
 *
 * @param provider_pubkey  pubkey of provider
 * @param container_units  number of container_units
 * @param subnode_image_name  subnode image to use, or "" to use default subnode image
 */
operation create_container_with_subnode_image(provider_pubkey: pubkey, container_units: integer,
    duration_weeks: integer, extra_storage_gib: integer, cluster_name: text, auto_renew: boolean, subnode_image_name: text) {
    create_container_impl(provider_pubkey, container_units, duration_weeks, extra_storage_gib, cluster_name, auto_renew, subnode_image_name);
}

/**
 * Request assign a custom subnode image to an existing container.
 *
 * An ICMF message will be sent to DC for updating of the container.
 *
 * @param container_name  container name
 * @param subnode_image_name  subnode image to use
 */
operation assign_subnode_image_to_container(container_name: text, subnode_image_name: text) {
    assign_subnode_image_to_container_impl(container_name, subnode_image_name);
}

/**
 * If possible upgrade the container to requested specifications.
 * 
 * @param container_name  container name
 */
operation upgrade_container(container_name: text, upgraded_container_units: integer,
    upgraded_extra_storage_gib: integer, upgraded_cluster_name: text) {
    upgrade_container_impl(container_name, upgraded_container_units, upgraded_extra_storage_gib, upgraded_cluster_name);
}

/**
 * Renew container lease.
 * 
 * @param container_name  container name
 * @param duration_weeks  lease duration in weeks
 */
operation renew_container(container_name: text, duration_weeks: integer) {
     renew_container_impl(container_name, duration_weeks);
}

/**
 * Turn on auto-renewal of lease for container.
 * 
 * @param container_name  container name
 */
operation auto_renew_container(container_name: text) {
    auto_renew_container_impl(container_name);
}

/**
 * Cancel auto-renewal of lease.
 * 
 * @param container_name  container name
 */
operation cancel_renew_container(container_name: text) {
    cancel_renew_container_impl(container_name);
}

/**
 * Transfer tokens to the common pool account.
 * 
 * @param amount  amount of tokens to transfer
 */
operation transfer_to_pool(amount: big_integer) {
    transfer_to_pool_impl(amount);
}

/**
 * Create bridge lease.
 * 
 * @param container_name  container name
 * @param blockchain_rid  blockchain RID
 * @param evm_network_id  the EVM network id
 * @param validator_contract  the validator contract address
 * @param bridge_contract  the bridge contract address
 * @param anomaly_detection  does bridge lease has an anomaly detector
 */
operation add_bridge_lease(container_name: text, blockchain_rid: byte_array, evm_network_id: integer, validator_contract: text, bridge_contract: text, anomaly_detection: boolean) {
    add_bridge_lease_impl(container_name, blockchain_rid, evm_network_id, validator_contract, bridge_contract, anomaly_detection);
}

/**
 * Update bridge lease.
 * 
 * @param blockchain_rid  blockchain RID
 * @param evm_network_id  the EVM network id
 * @param updated_validator_contract  bridge lease signers to be updated with
 * @param anomaly_detection  does bridge lease has an anomaly detector
 */
operation update_bridge_lease(blockchain_rid: byte_array, evm_network_id: integer, updated_validator_contract: text?, updated_bridge_contract: text?, anomaly_detection: boolean?) {
    update_bridge_lease_impl(blockchain_rid, evm_network_id, updated_validator_contract, updated_bridge_contract, anomaly_detection);
}

/**
 * Remove bridge lease.
 * 
 * @param blockchain_rid  blockchain RID
 * @param evm_network_id  the EVM network id
 */
operation remove_bridge_lease(blockchain_rid: byte_array, evm_network_id: integer) {
    remove_bridge_lease_impl(blockchain_rid, evm_network_id);
}

/**
 * Register a new dapp provider, will be proposed to be added to the container deployer voter set. Must be called by container lease owner.
 * 
 * @param container_name  container name
 * @param new_provider  pubkey of provider to register
 */
operation register_dapp_provider(container_name: text, new_provider: pubkey) {
    register_dapp_provider_impl(container_name, new_provider);
}

/**
 * Register a new dapp provider for a fee.
 * 
 * @param new_provider  pubkey of provider to register
 */
operation register_dapp_provider_with_payment(new_provider: pubkey) {
    register_dapp_provider_with_payment_impl(new_provider);
}

operation reset_provider_reward_debt(provider_pubkey: pubkey) {
    require(op_context.is_signer(provider_pubkey), "Operation must be signed by " + provider_pubkey);
    val provider = require_provider(provider_pubkey);
    reset_provider_reward_debt_impl(provider);
}

function create_system_p_proposal(common_proposal_type, provider, description: text): common_proposal {

    return create common_proposal(
        op_context.last_block_time,
        common_proposal_type,
        provider.pubkey,
        system_p_voter_set(),
        description);
}
