@extend(remove_provider_handler)
function(
    provider
) = _staking_offboard_provider(
        provider
        .pubkey
);

@extend(after_pay_reward)
function(pay_reward_result, has_delegation_share: boolean) {
    if(has_delegation_share) {
        if (not try_call(_staking_shared_rewards(pay_reward_result, *))) {
            log("Failed to distribute staking rewards for reward to %s".format(pay_reward_result.payed_to.id));
        }
    }
}

function __staking_begin_block(height: integer) {
    if (
        (_staking_last_known_time() - _staking_state.last_reward_distribution) > chain_context.args.staking_rewards_payout_interval_ms
        or
        // if all batches are not done, call payout
        (height - _staking_state.reward_first_distribution_block) < _staking_state.reward_distribution_batches
    ) {
        log("Scheduled staking reward distribution started.");
        if (not try_call(__staking_begin_block_reward_payouts(height, *))) log("Failed staking reward distribution.");
        log("Scheduled staking reward distribution ended.");
    }
    if (
        (_staking_last_known_time() - _staking_state.last_withdrawal_distribution) > chain_context.args.staking_withdrawals_payout_interval_ms
    ) {
        if (not try_call(__staking_begin_block_withdrawals(*))) log("Failed staking withdrawals distribution.");
    }
}

function __staking_begin_block_reward_payouts(height: integer): unit {
    var n_batch = height - _staking_state.reward_first_distribution_block;
    if (n_batch > _staking_state.reward_distribution_batches) {
        // if its the first batch, set the last reward distribution time
        _staking_state.last_reward_distribution = _staking_last_known_time();
        _staking_state.reward_first_distribution_block = height;

        var total_staker_states = staker_state @* { } ( @group account = .account ).size();
        _staking_state
            .reward_distribution_batches = (
            total_staker_states / chain_context
                .args
                .staking_rewards_payout_batch_size
        ) + 1;
        n_batch = 0;
    }
    _staking_distribute_rewards(true, n_batch == 0);
    log("Completed staking reward batch %s of %s".format(n_batch + 1, _staking_state.reward_distribution_batches));
}

function __staking_begin_block_withdrawals() : unit {
    _staking_distribute_withdrawals();
    _staking_state.last_withdrawal_distribution = _staking_last_known_time();
}

function __staking_init() {
    create provider ( get_null_account(), system = true, provider_tier.NODE_PROVIDER, active = true );
}