// Provider management

function _staking_offboard_provider(pubkey) {
    val null_provider = provider @ { get_null_account() };

    val updated_relationships = staker_state_to_provider @* { .provider.pubkey == pubkey } (
        struct<staker_state_to_provider> (
            timestamp = _staking_last_known_time(),
            staker_state = .staker_state,
            previous_provider = .provider,
            provider = null_provider
        )
    );

    create staker_state_to_provider ( updated_relationships );
}


// Deposits and balances

function _staking_deposit_native_impl(amount: integer, delegate_to: pubkey? = null) {
    require(amount > 0, "Can't deposit nothing (or less)!");

    val staker = ft4.auth.authenticate();

    // Pull in the CHR
    require(amount <= get_account_balance(staker), "Insufficient funds to deposit.");
    ft4.assets.Unsafe.transfer(staker, get_deposit_account(), get_asset(), amount);

    var ss = staker_state @? { .account == staker and .network == network.CHR };
    if (exists(ss)) {
        _update_pending_token_time(ss);
        ss.balance += amount;
        _staking_clear_upcoming_delegations(staker);
    } else {
        // Create a fresh staker state
        ss = create staker_state (
            staker,
            network.CHR,
            balance = amount,
            last_update = _staking_last_known_time(),
            pending_token_time = 0
        );

        // Find the current delegation at time of deposit and immediately apply it
        val current_delegation = staking_get_current_delegate(staker.id);

        // Create a new provider mapping to the current delegation
        // As we updating from a zero balance the previous delegation must be undelegated
        create staker_state_to_provider(
            timestamp = _staking_last_known_time(), // Immediate effect
            staker_state = ss,
            previous_provider = provider @ { get_null_account() },
            provider = provider @ { current_delegation  ?: get_null_account() }
        );
    }

    if (delegate_to != null) {
        // Down this path everything is updated anyway
        _staking_delegate(staker, delegate_to);
    }
}

function _change_staking_account(account: ft4.accounts.account, new_account: ft4.accounts.account) {
    val count = staker_state @? { account } ( @sum 1 ) ?: 0;
    update staker_state @* { account } ( .account = new_account );

    log("Changed staking account from %s to %s and migrated %s staker states".format(
        account.id, new_account.id, count));
}

// Legacy EVM events imports

function _staking_update_evm_state(staker: ft4.accounts.account, network, new_balance: integer) {
    var ss = staker_state @? { .account == staker and .network == network };
    if (exists(ss)) {
        _update_pending_token_time(ss);
    } else {
        // Find the latest staking state to provider for this user
        // NOTE: This could be a delegation that is not yet active
        val latest_staker_state_to_provider = get_latest_staker_state_to_provider(staker);

        // Create a fresh staker state
        ss = create staker_state (
            staker,
            network,
            balance = 0,
            last_update = _staking_last_known_time(),
            pending_token_time = 0
        );
    }

    if(ss.balance == 0 and new_balance > 0) {
        // Find the current delegation at time of deposit and immediately apply it
        val current_delegation = staking_get_current_delegate(staker.id);

        // Create a new provider mapping to the current delegation
        // As we updating from a zero balance the previous delegation must be undelegated
        create staker_state_to_provider(
            timestamp = _staking_last_known_time(), // Immediate effect
            staker_state = ss,
            previous_provider = provider @ { get_null_account() },
            provider = provider @ { current_delegation  ?: get_null_account() }
        );
    }

    // Handle the balance disappearing, eg. a withdrawal
    if (0 == new_balance) {
        update staker_withdrawal_request @* {
                .active
            and .staker_state.network == network
            and .staker_state == ss
        } (
            .active = false
        );
    }

    ss.balance = new_balance;
    _staking_clear_upcoming_delegations(staker);
}


// Withdrawals

function _staking_request_withdrawal(user: ft4.accounts.account, _network: network) {
    val ss = staker_state @? { .account == user and .network == _network };
    require(ss, "No staker state for %s".format(user.id));

    val active_withdraw_request = staker_withdrawal_request @? {
        ss,
        .active
    };

    if (_network == network.CHR) {
        require(not exists(active_withdraw_request), "Only one withdrawal request allowed at a time");
    }
    require(ss.balance > 0, "Balance must be over 0");

    // Clear future delegation states (not the current one)
    delete staker_state_to_provider @* { .staker_state == ss and .timestamp > _staking_last_known_time() };

    // Update appropriate staker states with null provider
    val null_provider = require(provider @? { get_null_account() }, "No provider for this public key.");
    val current_delegate = staking_get_current_delegate_on_network(user.id, _network);
    create staker_state_to_provider (
        timestamp = _staking_last_known_time() + chain_context.args.staking_delegation_delay_ms,
        staker_state = ss,
        provider = null_provider,
        previous_provider = provider @ { current_delegate ?: get_null_account() },
    );

    // Let's consolidate as we've touched the delegation state
    _update_pending_token_time(ss);

    // Make a new withdrawal request
    create staker_withdrawal_request (
        finish_at = _staking_last_known_time() + chain_context.args.staking_withdrawal_delay_ms,
        ss,
        true
    );
}

function _staking_distribute_withdrawals() {
    val open_withdrawals = staker_withdrawal_request @* {
        .active and .staker_state.network == network.CHR and .finish_at <= _staking_last_known_time()
    } ( account = .staker_state.account, balance = .staker_state.balance );

    log("Preparing to pay out %s withdrawals.".format(open_withdrawals.size()));

    for (withdrawal in open_withdrawals) {
        // Send the balance back to them through ft4
        ft4.assets.Unsafe.transfer(
                get_deposit_account(),
                withdrawal.account,
                get_asset(),
                withdrawal.balance
            );
        log("Withdrawal of amount %s sent back to %s.".format(withdrawal.balance, withdrawal.account));
    }

    var staker_states = staker_withdrawal_request @* {
        .active and .staker_state.network == network.CHR and .finish_at <= _staking_last_known_time( )
    } ( .staker_state );
    update staker_states ( .balance = 0 );
    update staker_withdrawal_request @* {
        .active and .staker_state.network == network.CHR and .finish_at <= _staking_last_known_time( )
    } ( .active = false);
    
}


// Delegation

function _staking_delegate(staker: ft4.accounts.account, provider_pubkey: pubkey, _network: network? = null) {

    val new_provider = require(provider @? { provider_pubkey }, "No provider for this public key.");

    // Get all staker states to change of user, and all related withdraw requests
    val staker_states = (s: staker_state, p: staker_state_to_provider) @* {
            p.staker_state == s
        and p.provider != new_provider
        and s.account == staker
        and s.balance != 0
        and ( s.network == _network or empty(_network) )
    };
    val withdraw_requests = staker_withdrawal_request @* { .active and .staker_state in staker_states @* {} (.s) };

    // deactivate chromia withdraw requests
    val withdraw_requests_chr = withdraw_requests @* { .staker_state.network == network.CHR };
    update withdraw_requests_chr ( .active = false );

    val staker_states_to_exclude = withdraw_requests @* { .staker_state.network != network.CHR } ( .staker_state );
 
    // Delegation from nothing happens without the delay
    val old_provider = staking_get_current_delegate(staker.id);
    val new_time_offset = if (empty(old_provider)) 0 else chain_context.args.staking_delegation_delay_ms;

    // Update appropriate staker states with new provider
    val fresh_staker_state_to_provider = staker_states @* { .s not in staker_states_to_exclude }
    (
        struct<staker_state_to_provider> (
            timestamp = _staking_last_known_time() + new_time_offset,
            staker_state = .s,
            previous_provider = .p.provider,
            provider = new_provider
        )
    );

    create staker_state_to_provider ( fresh_staker_state_to_provider );
}

function _staking_clear_upcoming_delegations(ft4.accounts.account) {
    delete staker_state_to_provider @* { .staker_state.account == account and .timestamp > _staking_last_known_time()};  
}


// Rewards

function _staking_distribute_rewards() {
    val rate = staking_get_current_rate() / millis_per_year;

    // Get a list of payouts
    _update_pending_token_time_all();
    val rewards = staker_state @* { } (
        @group account = .account,
        @sum amount = integer (
            (
            .pending_token_time
        ) * rate * units_per_asset
        )
    );

    val total_amount = rewards @ {} (@sum .amount);
    log("Preparing to distribute %s rewards worth %s".format(rewards.size(), total_amount));

    // Do not start what we cannot finish
    val pool = get_pool_account();
    var total_pool_balance = get_account_balance(pool);
    if (total_pool_balance < total_amount) {
        total_pool_balance = refill_pool_account_if_possible();
        if (total_pool_balance < total_amount) {       
            log("Cannot pay rewards. Insufficient funds.");
            return;
        }
    }
    update staker_state @* { } ( .pending_token_time = 0 );

    // Send payouts
    var payments = list<struct<staking_payment>>();
    for ( (account, amount) in rewards ) {

        /// @dev This can be removed once Rell supports a HAVING equivalent.
        if (integer(amount) == 0) {
            log("Skip zero payment.");
            continue;
        }

        ft4.assets.Unsafe.transfer(pool, account, get_asset(), integer(amount));
        log("Paid out %s to %s".format(amount, account.id));

        payments.add(struct<staking_payment>(timestamp = _staking_last_known_time(), amount = integer(amount), account));
    }

    create staking_payment ( payments );
    log("Stored payments on-chain.");
}


// Shared rewards (triggered by a hook in the rewards logic)

function _staking_shared_rewards(pay_reward_result) {

    // Do nothing if the start date has not passed
    if (_staking_last_known_time() < staking_get_rewards_start()) {
        return;
    }

    //Ignore rewards paid to Chromia foundation account
    if (pay_reward_result.payed_to == get_chromia_foundation_account()) return;
    
    // We ignore reward debt here as it will flow through the reward term after the pool is refreshed
    val total_shared_reward = chain_context.args.staking_rewards_share * pay_reward_result.payed_reward;

    // Find provider pubkey
    val provider_pubkey = provider_account @? { pay_reward_result.payed_to }.provider.pubkey;

    // In some edge cases during testing a public key may be absent
    if (empty(provider_pubkey)) {
        log("Not provider public key for id: %s".format(pay_reward_result.payed_to.id));
        return;
    }

    val staker_delegations = ( s1: staker_state_to_provider) @* {
        .provider.pubkey == provider_pubkey and not exists(
            (s2:staker_state_to_provider) @* { 
                s2.staker_state ==s1.staker_state,
                (s2.timestamp>s1.timestamp) or 
                (s2.timestamp==s1.timestamp and s2 < s1) 
            }
        )
    } (
        @group account = .staker_state.account,
        @sum balance = .staker_state.balance
    );

    // Get total and divide through
    val total_delegation = staker_delegations @ { } ( @sum .balance );

    // Zero delegation check (should not occur in normal useage.)
    if (total_delegation == 0) {
        return;
    }

    // Run through and payout by share of delegation
    for (staker in staker_delegations) {
        val share_amount = integer(total_shared_reward * (staker.balance / total_delegation));
        ft4.assets.Unsafe.transfer(get_pool_account(), staker.account, get_asset(), share_amount);
        log(
            "Paid reward share of %s to %s. Based on a delegation of %s CHR."
                .format(
                    share_amount,
                    staker
                        .account
                        .id,
                    staker
                        .balance
                )
        );
    }
}
