
object migration_completed {
    mutable provider_staking_account_entity: boolean = false;
    mutable provider_multi_key: boolean = false;
    mutable publish_staking_state: boolean = false;
    mutable register_evm_bridge: boolean = false;
}

function do_migrations() {

    if (not migration_completed.provider_staking_account_entity) {
        migration_completed.provider_staking_account_entity = true;
        migrate_provider_staking_accounts();
    }
    if (not migration_completed.provider_multi_key) {
        migration_completed.provider_multi_key = true;
        migrate_provider_keys();
        migrate_system_p_voter_set_type();
    }
    if (not migration_completed.publish_staking_state) {
        migrate_publish_staking_state();
    }
    if (not migration_completed.register_evm_bridge) {
        try_call(migrate_evm_bridge(*));
    }
}

/**
  * Called once to create a provider key entities to support multi key for provider authentication.
  */
function migrate_provider_keys() {

    log("Migrate and create provider multi key entities...");

    for (provider in provider @* {}) {

        log("Migrating provider %s to multi key".format(provider.pubkey));

        _add_provider_key(provider.pubkey, provider.pubkey, provider_key_role.main);
    }
}

/**
 * Change the type of system provider voter set to use provider keys instead of single keys.
 */
function migrate_system_p_voter_set_type() {
    var system_p_voter_set = common_voter_set @? { voter_sets.system_p };
    if (exists(system_p_voter_set)) {

        log("Migrating system_p voter set to PROVIDER_AUTH type");

        system_p_voter_set.member_key_type = common_proposal_vote_type.PROVIDER_AUTH;
    }
}

/**
  * Called once to create a provider_staking_account per provider with values copied from account and
  * last_approved_stake_requirements to separate them from the ordinary provider account.
  */
function migrate_provider_staking_accounts() {

    log("Migrate and create provider staking account entities...");

    for (pa in provider_account @* {}) {
        if (not(exists(provider_staking_account @? { pa.provider }))) {
            log("Created provider_staking_account for provider %s".format(pa.provider.pubkey));
            create provider_staking_account(pa.provider, pa.account, pa.last_approved_stake_requirements);
        }
    }
}

/**
 * Not really a migration per definition, but this will publish staking states for all staking accounts on
 * a ICMF topic to give consumers the full picture of all staking accounts. Sends 100 per block until it is done and
 * then empties the temporary table.
 */
function migrate_publish_staking_state() {

    val staking_account_subset = staker_state @* {
        .account not in migration_staking_account_state_published @* {} ( .account )
    } ( @group .account ) limit chain_context.args.migration_staking_account_state_send_limit;

    if (empty(staking_account_subset)) {
        migration_completed.publish_staking_state = true;
        delete migration_staking_account_state_published @* { };
    } else {

        log("Sending %s staking balance messages".format(staking_account_subset.size()));

        for (staking_account in staking_account_subset) {
            publish_staking_state(staking_account);
        }
        create migration_staking_account_state_published(staking_account_subset @* {}
            ( struct<migration_staking_account_state_published>($) )
        );
    }
}

function migrate_evm_bridge() {
    log("Migrate and register bridge entities...");

    val bsc_erc20_asset = eif.hbridge.erc20_asset @? {
        .network_id == chain_context.args.bsc_asset_network_id,
        .token_address == chain_context.args.bsc_asset_address
    };
    if (exists(bsc_erc20_asset)) {
        eif.hbridge.register_bridge_with_erc20_assets(
            chain_context.args.bsc_asset_network_id,
            chain_context.args.bsc_bridge_address,
            [bsc_erc20_asset]
        );
        log("Registered BSC bridge...");
    }
    val eth_erc20_asset = eif.hbridge.erc20_asset @? {
        .network_id == chain_context.args.eth_asset_network_id,
        .token_address == chain_context.args.eth_asset_address
    };
    if (exists(eth_erc20_asset)) {
        eif.hbridge.register_bridge_with_erc20_assets(
            chain_context.args.eth_asset_network_id,
            chain_context.args.eth_bridge_address,
            [eth_erc20_asset]
        );
        log("Registered ETH bridge...");
    }
    migration_completed.register_evm_bridge = true;
}

entity migration_staking_account_state_published {
    key ft4.accounts.account;
}
