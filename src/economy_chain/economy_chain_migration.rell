
object migration_completed {
    mutable bridge_lease_enable: boolean = false;

    // These are no longer in use but exists in table
    mutable provider_staking_account_entity: boolean = false;
    mutable provider_multi_key: boolean = false;
    mutable publish_staking_state: boolean = false;
    mutable register_evm_bridge: boolean = false;
}

function do_migrations() {
    if (not migration_completed.bridge_lease_enable) {
        migration_completed.bridge_lease_enable = true;
        update bridge_lease @* { not .enabled and .tx_cost_debt == 0 } (.enabled = true);
    }

    if (exists(provider @? { get_null_account(), .active or .system })) {
        log("Demoting and deactivating null provider");
        update provider @ { get_null_account() } (.active = false, .system = false);
    }
}
