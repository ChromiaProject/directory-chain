function validate_entity_name(name: text) {
    require(not name.empty(), "Entity name cannot be empty");
    // we cannot allow dashes since container names are used in Postgres schema names (which does not allow dashes)
    require(
        name.matches("^[a-zA-Z0-9_]{1,64}$"),
        "Entity name can only contain letters, numerals, and underscores. Maximum allowed length is 64 characters."
    );
}
