entity pending_minting {
    proposal: common_proposal;
    amount: integer;
    account_id: byte_array;
}

struct pending_minting_data {
    amount: integer;
    account_id: byte_array;
}

@extend(apply_common_voting_result_handlers) function() = [common_proposal_type.ec_mint.name: apply_ec_pending_minting(*)];
@extend(delete_common_proposal_handlers) function(): map<text, (common_proposal) -> unit> = [common_proposal_type.ec_mint.name: cleanup_ec_pending_minting(*)];

operation propose_minting(my_pubkey: byte_array, amount: integer, account_id: byte_array) {

    val voter_set = require_common_voter_set_with_signer_and_member(voter_sets.chromia_foundation, my_pubkey);

    val proposal = create common_proposal(
        op_context.last_block_time,
        common_proposal_type.ec_mint,
        my_pubkey,
        voter_set,
        "Minting %d assets to account id %s".format(amount, account_id));

    val minting_proposal = create pending_minting(
        proposal,
        amount,
        account_id
    );
    validate_ec_minting_proposal(minting_proposal);

    internal_common_vote(proposal.proposed_by, proposal, true);
}

query get_minting_proposal(proposal_id: rowid) {

    val proposal = require_common_proposal(proposal_id);
    val pending_minting = require(pending_minting @? { proposal }, "Proposal %s is not of type minting".format(proposal_id));

    return pending_minting_data(pending_minting.amount, pending_minting.account_id);
}

function apply_ec_pending_minting(proposal: common_proposal) {

    val pending_minting = pending_minting @ { proposal };
    val account = validate_ec_minting_proposal(pending_minting);

    log("Apply proposal %d. Minting %s to %s".format(pending_minting.rowid, pending_minting.amount, account.id));

    ft4.assets.Unsafe.mint(account, get_asset(), pending_minting.amount);
}

function cleanup_ec_pending_minting(proposal: common_proposal) {

    log("Cleaning up pending minting proposal");

    delete pending_minting @ { proposal };
}

function validate_ec_minting_proposal(proposal_details: pending_minting) {

    require(proposal_details.amount > 0, "Amount must be greater than 0");
    return ft4.accounts.Account(proposal_details.account_id);
}
