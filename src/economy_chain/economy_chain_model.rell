/**
* Please do not change this file without reading the README.
* 
**/

enum ticket_state {
    PENDING, SUCCESS, FAILURE
}

enum ticket_type {
    CREATE_CONTAINER, UPGRADE_CONTAINER, ASSIGN_SUBNODE_IMAGE_TO_CONTAINER, REMOVE_CONTAINER, ADD_SUBNODE_JAR_EXTENSIONS_TO_CONTAINER
}

enum cluster_creation_status {
    SUCCESS, FAILURE, PENDING_APPROVAL, PENDING_CREATION, UNKNOWN
}

enum lease_purchase_type {
    INITIAL, RENEWAL, UPGRADE
}

object state {
    mutable initialized: boolean = false;
}

object economy_constants {
    mutable min_lease_time_weeks: integer = 1;
    mutable max_lease_time_weeks: integer = 12;
    mutable chr_per_usd: decimal = 5;
    mutable total_cost_system_providers: integer = 828 * units_per_usd;
    mutable system_provider_fee_share: decimal = 0.1;
    mutable staking_reward_rate: decimal = 0.1;
    mutable chromia_foundation_fee_share: decimal = 0.1;
    mutable resource_pool_margin_fee_share: decimal = 0.1;
    mutable system_provider_risk_share: decimal = 0.1;
    mutable dapp_provider_risk_share: decimal = 0.2;

    // Staking requirements for payout
    mutable staking_requirements_enabled: boolean = false;

    /** The time providers can fail to meet the requirements before payouts are stopped */
    mutable staking_requirement_stop_payout_days: integer = 14;
    mutable staking_requirement_system_node_own_stake_chr: integer   = 60000 * units_per_asset;  // ~12k  USD 2024-11-12
    mutable staking_requirement_system_node_total_stake_chr: integer = 600000 * units_per_asset; // ~120k USD 2024-11-12
    mutable staking_requirement_dapp_node_own_stake_chr: integer     = 30000 * units_per_asset;  // ~6k   USD 2024-11-12
    mutable staking_requirement_dapp_node_total_stake_chr: integer   = 300000 * units_per_asset; // ~60k  USD 2024-11-12

    /** Amount required on account to add a bridge lease */
    mutable bridge_lease_add_min_balance_usd: decimal = 100;
}

entity sender_blockchain {
    rid: byte_array;
    name: text;
}

entity node_availability {
    index node: byte_array;
    availability: decimal;
    start_time: timestamp;
    index end_time: timestamp;
}

struct provider_availability {
    availability: decimal;
    start_time: timestamp;
    end_time: timestamp;
}

entity node_payed_reward {
    index node: byte_array;
    value: big_integer;
    index time: timestamp;
}

/** Keep deleted nodes pubkey as history for a complete availability report */
entity reward_provider_deleted_node {
    key provider,
    node: pubkey,
    cluster;
}

struct provider_payed_reward {
    time: timestamp;
    value: big_integer;
}

struct economy_constants_data {
    min_lease_time_weeks: integer;
    max_lease_time_weeks: integer;
    chr_per_usd: decimal;
    total_cost_system_providers: integer;
    system_provider_fee_share: decimal;
    staking_reward_rate: decimal;
    chromia_foundation_fee_share: decimal;
    resource_pool_margin_fee_share: decimal;
    system_provider_risk_share: decimal;
    dapp_provider_risk_share: decimal;
    staking_requirements_enabled: boolean;
    staking_requirement_stop_payout_days: integer;
    staking_requirement_system_node_own_stake_chr: integer;
    staking_requirement_system_node_total_stake_chr: integer;
    staking_requirement_dapp_node_own_stake_chr: integer;
    staking_requirement_dapp_node_total_stake_chr: integer;
    bridge_lease_add_min_balance_usd: decimal;
}

struct economy_metrics {
    /** Node availability based on the last daily report received. The report is for 24h but might begin up to
     * 48h ago. */
    average_availability_on_a_providers_nodes: decimal;
    total_number_of_nodes_per_provider: integer;

    /** The total number SCUs for lease */
    total_number_of_scus_per_provider: integer;

    /** The occupancy rate for all SCUs and how many that are leased.  */
    average_occupancy_rate_of_a_providers_scus: decimal;

    /** The sum of all nodes last reward payed out */
    amount_of_the_last_reward_payout: big_integer;
}

/** Economy metrics for a node */
struct economy_node_metrics {

    /** The nodes pubkey */
    node_pubkey: pubkey;

    /** Node availability based on the last daily report received. The report is for 24h but might begin up to
     * 48h ago. */
    availability: decimal;

    /** CHR in minor units of how much reward was payed out last time for this node */
    amount_of_the_last_reward_payout: big_integer;

    /** Clusters signed by this node */
    signing_clusters: list<text>;

    /** Clusters replicated by this node */
    replicating_clusters: list<text>;
}

struct provider_performance_metrics {
    availabilities: list<provider_availability>;
    payed_rewards: list<provider_payed_reward>;
}

entity lease {
    key container_name: text;
    index mutable ft4.accounts.account;
    container_units: integer;
    extra_storage_gib: integer;
    cluster;
    start_time: integer;
    mutable duration_millis: integer;
    mutable expired: boolean = false;
    mutable auto_renew: boolean = false;
    extra_compute_requests: integer = 0;
}

entity lease_subnode_image {
    key lease;
    subnode_image;
}

entity lease_subnode_jar_extension {
    key lease, subnode_jar_extension;
}

@log
entity lease_purchase {
    index ft4.accounts.account;
    duration_millis: integer;
    container_units: integer;
    extra_storage_gib: integer;
    price: integer;
    type: lease_purchase_type = lease_purchase_type.INITIAL;
    extra_compute_requests: integer = 0;
}

struct lease_purchase_data {
    account_id: byte_array;
    duration_millis: integer;
    container_units: integer;
    extra_storage_gib: integer;
    price: integer;
    type: lease_purchase_type;
    timestamp;
    tx_rid: byte_array;
    extra_compute_requests: integer? = null;
}

@log
entity lease_refund {
    index ft4.accounts.account;
    amount: integer;
}

struct lease_refund_data {
    account_id: byte_array;
    amount: integer;
}

entity lease_dapp_provider {
    lease;
    provider: pubkey;
}

entity container_lease_ownership_transfer_offer {
    key container_name: text;
    receiver_account: ft4.accounts.account;
}

struct container_lease_ownership_transfer_offer_data {
    container_name: text;
    receiver_account_id: byte_array;
}

entity ticket {
    index transaction = op_context.transaction;
    index type: ticket_type;
    index account: ft4.accounts.account;
    mutable state: ticket_state = ticket_state.PENDING;
    mutable error_message: text = "";
}

struct ticket_data {
    ticket_id: integer;
    type: ticket_type;
    state: ticket_state;
    error_message: text;
}

entity create_container_ticket {
    key ticket;
    container_units: integer;
    extra_storage_gib: integer;
    duration_millis: integer;
    cost: integer;
    auto_renew: boolean = false;
    mutable container_name: text = "";
    cluster_name: text;
    subnode_image_name: text = "";
    extra_compute_requests: integer = 0;
    subnode_jar_extension_names: text = "";
}

entity upgrade_container_ticket {
    key ticket;
    container_name: text;
    container_units: integer;
    extra_storage_gib: integer;
    cost: integer;
    cluster_name: text;
    duration_weeks: integer = 1;
    extra_compute_requests: integer = 0;
}

entity assign_subnode_image_to_container_ticket {
    key ticket;
    container_name: text;
    subnode_image_name: text;
}

entity add_subnode_jar_extensions_to_container_ticket {
    key ticket;
    container_name: text;
    subnode_jar_extension_names: text;
}

entity remove_container_ticket {
    key ticket;
    container_name: text;
}

struct container_ticket_data {
    ticket_id: integer;
    type: ticket_type;
    state: ticket_state;
    error_message: text;
    container_name: text;
}

struct lease_data {
    container_name: text;
    cluster_name: text;
    container_units: integer;
    extra_storage_gib: integer;
    expire_time_millis: integer;
    expired: boolean;
    auto_renew: boolean;
    subnode_image_name: text;
    subnode_jar_extension_names: list<text>;
    bridge_leases: list<bridge_lease_data>;
    lease_owner_account_id: byte_array? = null;
    extra_compute_requests: integer? = null;
}

struct cluster_data {
    name: text;
    tag_name: text;
    is_operational: boolean?;
    cluster_units: integer?;

    /** extra storage in MiB */
    extra_storage: integer?;
    subnode_images: list<text>?;
    number_of_nodes: integer?;
    subnode_jar_extensions: list<text>?;
}

struct subnode_image_data {
    name;
    url: text;
    digest: text;
    owner: pubkey;
    description: text;
}

struct subnode_jar_extension_data {
    name;
    owner: pubkey;
    description: text;
}

struct tag_data {
    name: text;
    scu_price: integer;             // Price per day
    extra_storage_price: integer;   // Price per day
}

entity provider_account {
    key provider, account: ft4.accounts.account;
    mutable last_reward_check: timestamp = 0;
    mutable reward_debt: big_integer = 0;

    /** @deprecated: to be removed, no longer in used since it is moved to provider_staking_account */
    mutable last_approved_stake_requirements: timestamp = 0;
}

/**
  * Provider account to be used for staking only. It will by default point to the provider_account but
  * can be changed to a different account when needed.
  */
entity provider_staking_account {
    key provider;
    key mutable staking_account: ft4.accounts.account;
    key provider, staking_account;

    /** Time of last valid amount of staking, what is required to receive rewards */
    mutable last_approved_stake_requirements: timestamp = 0;
}

object chromia_foundation {
    mutable reward_debt: big_integer = 0;
}

object pool_details {
    mutable last_refill_millis: integer = 0;
}

struct pay_reward_result {
    payed_reward: big_integer;
    reward_debt: big_integer;
    payed_to: ft4.accounts.account;
}

struct pending_cluster_change_tag_data {
    cluster: text;
    current_tag: text;
    new_tag: text;
}

struct pending_economy_constants_data {
    min_lease_time_weeks: integer?;
    max_lease_time_weeks: integer?;
    staking_reward_rate: decimal?;
    chromia_foundation_fee_share: decimal?;
    resource_pool_margin_fee_share: decimal?;
    dapp_provider_risk_share: decimal?;
}

entity tag {
    key name;
    mutable scu_price: integer;                         // Price per day in USD and minor units
    mutable extra_storage_price: integer;               // Price per day in USD and minor units
}

enum pending_cluster_status {
    PENDING_APPROVAL,
    PENDING_CREATION,
    FAILURE
}

struct pending_cluster_data {
    name: text;
    tag: text;
    proposer_pubkey: pubkey;
    governor_voter_set_name: text;
    voter_set_name: text;
    cluster_units: integer;

    /** extra storage in MiB */
    extra_storage: integer;
    container_unit_cpu: integer;
    container_unit_ram: integer;
    container_unit_io_read: integer;
    container_unit_io_write: integer;
    container_unit_storage: integer;
    system_container_units: integer;

    status: pending_cluster_status;
}

entity bridge_lease {
    key blockchain_rid: byte_array, evm_network_id: integer;
    index lease; // Must be connected to a container lease
    mutable validator_contract: text;
    mutable bridge_contract: text;
    mutable anomaly_detection: boolean = false;

    /** Keeps any CHR debt in case the ft4 account can't cover a transaction fee */
    mutable tx_cost_debt: big_integer = 0;
    mutable enabled: boolean = true;
}

struct container_and_bridge_lease_data {
    blockchain_rid: byte_array;
    evm_network_id: integer;
    container_name: text;
    expired: boolean;
    validator_contract: text;
    bridge_contract: text;
    enabled: boolean;
}

struct bridge_lease_data {
    blockchain_rid: byte_array;
    evm_network_id: integer;
    validator_contract: text;
    bridge_contract: text;
    enabled: boolean;
}

struct bridge_anomaly_detector_data {
    blockchain_rid: byte_array;
    evm_network_id: integer;
    bridge_contract: text;
}

struct provider_staking_status {
    staking_account_id: pubkey;
    own_staking_chr: integer;
    total_staking_chr: integer;
    required_own_staking_chr: integer;
    required_total_staking_chr: integer;
    approved: boolean;
    days_since_last_approved: integer?;
    days_until_reward_stops: integer?;
}

//////////////////////////////////
// directory-chain synced entities
object standard_cluster_unit {
    mutable container_units: integer = 16;
    system_container_units: integer = 4;
    mutable storage: integer = 16384; // MiB
}

enum provider_tier {
    DAPP_PROVIDER,
    NODE_PROVIDER
}

entity provider {
    key pubkey;
    mutable system: boolean = false;
    mutable tier: provider_tier;
    mutable active: boolean;
    mutable name: text = "";
    mutable url: text = "";
    mutable staking_rewards_share: decimal = chain_context.args.staking_default_rewards_share;
}

entity node {
    index provider;
    key pubkey;
    mutable active: boolean;
    mutable territory: text;
    mutable cluster_units: integer;

    /** extra storage in MiB */
    mutable extra_storage: integer;
}

val system_cluster_name = "system";

entity cluster {
    key name;
    mutable operational: boolean;
    mutable cluster_units: integer;

    /** extra storage in MiB */
    mutable extra_storage: integer;
    mutable anchoring_chain: byte_array;
    mutable tag;
    container_unit_storage: integer = 16384;
}

entity cluster_node {
    key cluster, node;
}

entity cluster_replica_node {
    key cluster, node;
}

enum subnode_image_type {
    COMMON, SPECIAL
}

entity subnode_image {
    key name;
    mutable url: text;
    mutable digest: text;
    subnode_image_type;
    owner: provider;
    description: text;
    mutable active: boolean;
}

enum subnode_jar_extension_type {
    COMMON, SPECIAL
}

entity subnode_jar_extension {
    key name;
    subnode_jar_extension_type;
    owner: provider;
    mutable description: text;
    mutable active: boolean;
}

entity cluster_subnode_image {
    key cluster, subnode_image;
}

entity cluster_subnode_jar_extension {
    key cluster, subnode_jar_extension;
}

//////////////////////////////////