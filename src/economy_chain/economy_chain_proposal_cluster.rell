entity pending_cluster {
    proposal: common_proposal;
    key name;
    tag: tag;
    proposer_pubkey: pubkey;
    governor_voter_set_name: text;
    voter_set_name: text;
    cluster_units: integer;

    /** extra storage in MiB */
    extra_storage: integer;

    // Default value can be removed once this is deployed on all networks
    container_unit_cpu: integer = 50;
    container_unit_ram: integer = 2048;
    container_unit_io_read: integer = 25;
    container_unit_io_write: integer = 20;
    container_unit_storage: integer = 16384;
    system_container_units: integer = 4;

    mutable status: pending_cluster_status;
}

@extend(apply_common_voting_result_handlers) function() = [common_proposal_type.ec_cluster_create.name: apply_cluster_create(*)];
@extend(delete_common_proposal_handlers) function(): map<text, (common_proposal) -> unit> = [common_proposal_type.ec_cluster_create.name: cleanup_pending_cluster_create(*)];

/**
 * @param extra_storage MiB
 */
operation create_cluster(
    my_pubkey: pubkey,
    name,
    governor_voter_set_name: text,
    voter_set_name: text,
    cluster_units: integer,
    extra_storage: integer,
    tag_name: text,
    container_unit_cpu: integer,
    container_unit_ram: integer,
    container_unit_io_read: integer,
    container_unit_io_write: integer,
    container_unit_storage: integer,
    system_container_units: integer,
) {
    val provider = require_is_system_provider_and_signer(my_pubkey);

    require(empty(cluster @* { .name == name }), "Cluster %s already exists".format(name));
    require(pending_cluster @? { name } == null, "There is already a pending request to create cluster with name %s".format(name));
    validate_entity_name(name);
    val tag = require_tag(tag_name);
    require(cluster_units > 0, "Cluster must have at least 1 cluster unit");
    require(extra_storage >= 0, "Extra storage must not be negative");
    require(system_container_units >= 0, "System container units must not be negative");
    require(container_unit_cpu > 0, "Container unit CPU must be at least 1");
    require(container_unit_ram > 0, "Container unit RAM must be at least 1");
    require(container_unit_io_read > 0, "Container unit I/O read must be at least 1");
    require(container_unit_io_write > 0, "Container unit I/O write must be at least 1");
    require(container_unit_storage >= 0, "Container unit storage must not be negative");

    val proposal = create_system_p_proposal(common_proposal_type.ec_cluster_create, provider, "Create economy chain cluster %s".format(name));

    create pending_cluster(
        proposal,
        name = name,
        tag,
        proposer_pubkey = provider.pubkey,
        governor_voter_set_name = governor_voter_set_name,
        voter_set_name = voter_set_name,
        cluster_units,
        extra_storage,
        container_unit_cpu,
        container_unit_ram,
        container_unit_io_read,
        container_unit_io_write,
        container_unit_storage,
        system_container_units,
        pending_cluster_status.PENDING_APPROVAL
    );

    internal_common_vote(provider.pubkey, proposal, true);
}

query get_cluster_create_proposal(proposal_id: rowid): pending_cluster_data {

    val proposal = require_common_proposal(proposal_id);
    val pending_cluster = pending_cluster @ { proposal };

    return pending_cluster_data(
        name = pending_cluster.name,
        tag = pending_cluster.tag.name,
        proposer_pubkey = pending_cluster.proposer_pubkey,
        governor_voter_set_name = pending_cluster.governor_voter_set_name,
        voter_set_name = pending_cluster.voter_set_name,
        cluster_units = pending_cluster.cluster_units,
        extra_storage = pending_cluster.extra_storage,
        container_unit_cpu = pending_cluster.container_unit_cpu,
        container_unit_ram = pending_cluster.container_unit_ram,
        container_unit_io_read = pending_cluster.container_unit_io_read,
        container_unit_io_write = pending_cluster.container_unit_io_write,
        container_unit_storage = pending_cluster.container_unit_storage,
        system_container_units = pending_cluster.system_container_units,
        status = pending_cluster.status
    );
}

function apply_cluster_create(proposal: common_proposal) {

    val pending_cluster = pending_cluster @? { proposal };

    if (pending_cluster == null) {
        log("Received accepted cluster creation proposal with no pending_cluster. Proposal: %s".format(proposal));
    } else {

        val create_cluster_message = create_cluster_v2_message(
            name = pending_cluster.name,
            governor_voter_set_name = pending_cluster.governor_voter_set_name,
            voter_set_name = pending_cluster.voter_set_name,
            cluster_units = pending_cluster.cluster_units,
            extra_storage = pending_cluster.extra_storage,
            container_unit_cpu = pending_cluster.container_unit_cpu,
            container_unit_ram = pending_cluster.container_unit_ram,
            container_unit_io_read = pending_cluster.container_unit_io_read,
            container_unit_io_write = pending_cluster.container_unit_io_write,
            container_unit_storage = pending_cluster.container_unit_storage,
            system_container_units = pending_cluster.system_container_units,
            proposer_pubkey = pending_cluster.proposer_pubkey);

        send_message(create_cluster_v2_topic, create_cluster_message.to_gtv());

        pending_cluster.status = pending_cluster_status.PENDING_CREATION;

        log("Message sent to create cluster %s".format(pending_cluster.name));
    }
}

function cleanup_pending_cluster_create(proposal: common_proposal) {

    val pending_cluster = pending_cluster @? { proposal };

    // Only cleanup if this was a revoke or a failed cluster creation
    if (pending_cluster != null and
    (pending_cluster.status == pending_cluster_status.PENDING_APPROVAL or
    pending_cluster.status == pending_cluster_status.FAILURE)
    ) {

        log("Revoked and removed pending cluster %s".format(pending_cluster.name));

        delete pending_cluster @ { proposal };
    }
}
