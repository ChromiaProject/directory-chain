val DAY_MS = 86400000; // 1000 * 60 * 60 * 24 - 1 day

function pay_evm_transaction_submitter_rewards(
    evm_transaction_submitter_cost: evm_transaction_submitter_cost,
    reward: big_integer
) {
    val node = node @? { .pubkey == evm_transaction_submitter_cost.processed_by};
    if (node == null) {
        log("Warning: Node %s does not exists in EC. Transaction %s will not be rewarded.".format(evm_transaction_submitter_cost.processed_by, evm_transaction_submitter_cost.id));
    } else {
        pay_out_node_rewards([node: reward], false);
    }
}

function pay_rewards(cluster: cluster, node_availability_report: node_availability_report) {

    val is_system_cluster = cluster.name == system_cluster_name;
    val node_reward = if (is_system_cluster)
            calculate_system_cluster_rewards(cluster, node_availability_report)
        else
            calculate_dapp_cluster_rewards(cluster, node_availability_report);

    pay_out_node_rewards(node_reward, true);

    if (is_system_cluster){
        pay_out_chromia_foundation_reward();
    }
}

function calculate_system_cluster_rewards(system_cluster: cluster, node_availability_report: node_availability_report): map<node, big_integer> {
    val system_cluster_nodes = cluster_node @* { .cluster == system_cluster} .node;

    val number_of_nodes_in_system_cluster = system_cluster_nodes.size();
    val sum_total_max_revenue_per_dapp_cluster = sum_total_max_revenue_per_dapp_cluster();

    val system_provider_cost_share_per_node = (sum_total_max_revenue_per_dapp_cluster * economy_constants.system_provider_fee_share) / number_of_nodes_in_system_cluster;
    val max_system_provider_reward_per_node = max((economy_constants.total_cost_system_providers / units_per_usd) * (1 - economy_constants.system_provider_risk_share) + system_provider_cost_share_per_node * economy_constants.system_provider_risk_share, system_provider_cost_share_per_node) * economy_constants.chr_per_usd * units_per_asset;

    val system_node_reward = map<node, big_integer>();
    for (system_cluster_node in system_cluster_nodes) {
        val reported_availability = get_aggregated_node_availability(node_availability_report.node_availability, system_cluster_node, system_cluster);
        val availability_factor = adjusted_availability_factor(reported_availability);
        val system_provider_reward_per_node = max_system_provider_reward_per_node * availability_factor;
        log("Reward calculated for node %s in system cluster based on number_of_nodes_in_system_cluster: %s, sum_total_max_revenue_per_dapp_cluster: %s USD, total_cost_system_providers: %s USD, max_system_provider_reward_per_node: %s CHR, system_provider_risk_share: %s, system_provider_cost_share_per_node: %s, availability_factor: %s, chr_per_usd: %s, units_per_asset: %s, system_provider_fee_share: %s, system_provider_reward_per_node: %s, units_per_usd: %s"
            .format(
            system_cluster_node.pubkey,
                number_of_nodes_in_system_cluster,
                sum_total_max_revenue_per_dapp_cluster,
                economy_constants.total_cost_system_providers / units_per_usd,
                max_system_provider_reward_per_node,
                economy_constants.system_provider_risk_share,
                system_provider_cost_share_per_node,
                availability_factor,
                economy_constants.chr_per_usd,
                units_per_asset,
                economy_constants.system_provider_fee_share,
                (system_provider_reward_per_node.to_big_integer() * 1.0 / units_per_asset),
                units_per_usd
        ));
        system_node_reward[system_cluster_node] = system_provider_reward_per_node.to_big_integer();
    }
    return system_node_reward;
}

function calculate_dapp_cluster_rewards(cluster: cluster, node_availability_report: node_availability_report): map<node, big_integer> {
    val cluster_nodes = cluster_node @* { cluster } .node;

    val occupancy_rate = occupancy_rate(cluster);
    val dapp_cluster_value = dapp_cluster_value(cluster);
    val number_of_nodes_per_dapp_cluster = cluster_nodes.size();

    val node_reward = map<node, big_integer>();
    if (number_of_nodes_per_dapp_cluster > 0) {

        val max_dapp_provider_reward_per_node = ((dapp_cluster_value * (1 - economy_constants.dapp_provider_risk_share) + dapp_cluster_value * occupancy_rate * economy_constants.dapp_provider_risk_share) / number_of_nodes_per_dapp_cluster) * economy_constants.chr_per_usd * units_per_asset;

        for (cluster_node in cluster_nodes) {
            // If availability report is completely empty then it could be that no chains are running in the cluster,
            // we choose to be nice and interpret this as 100% availability
            val reported_availability = if (node_availability_report.node_availability.empty())
                1 else get_aggregated_node_availability(node_availability_report.node_availability, cluster_node, cluster);
            val availability_factor = adjusted_availability_factor(reported_availability);
            val dapp_provider_reward_per_node = max_dapp_provider_reward_per_node * availability_factor;
            log("Reward calculated for node %s in cluster %s based on max_dapp_provider_reward_per_node: %s CHR, occupancy_rate: %s, dapp_cluster_value: %s, number_of_nodes_per_dapp_cluster: %s, dapp_provider_risk_share: %s, availability_factor: %s, chr_per_usd: %s, units_per_asset: %s, system_provider_fee_share: %s, staking_reward_fee_share: %s, chromia_foundation_fee_share: %s, resource_pool_margin_fee_share: %s, dapp_provider_reward_per_node: %s"
                .format(
                cluster_node.pubkey,
                    cluster.name,
                    max_dapp_provider_reward_per_node,
                    occupancy_rate,
                    dapp_cluster_value,
                    number_of_nodes_per_dapp_cluster,
                    economy_constants.dapp_provider_risk_share,
                    availability_factor,
                    economy_constants.chr_per_usd,
                    units_per_asset,
                    economy_constants.system_provider_fee_share,
                    economy_constants.staking_reward_fee_share,
                    economy_constants.chromia_foundation_fee_share,
                    economy_constants.resource_pool_margin_fee_share,
                    (dapp_provider_reward_per_node.to_big_integer() * 1.0 / units_per_asset)));
            node_reward[cluster_node] = dapp_provider_reward_per_node.to_big_integer();
        }
    }
    return node_reward;
}

function pay_out_chromia_foundation_reward() {
    val sum_total_max_revenue_per_dapp_cluster = sum_total_max_revenue_per_dapp_cluster();
    val chromia_foundation_reward = (sum_total_max_revenue_per_dapp_cluster * economy_constants.chromia_foundation_fee_share * economy_constants.chr_per_usd * units_per_asset).to_big_integer();
    log("Reward calculated for chromia foundation based on sum_total_max_revenue_per_dapp_cluster: %s, chromia_foundation_fee_share: %s, chr_per_usd: %s, units_per_asset: %s is chromia_foundation_reward: %s"
        .format(sum_total_max_revenue_per_dapp_cluster, economy_constants.chromia_foundation_fee_share, economy_constants.chr_per_usd, units_per_asset, chromia_foundation_reward));

    val pool = get_pool_account();
    val chromia_foundation_account = get_chromia_foundation_account();

    val pay_reward_result = pay_reward(pool, chromia_foundation_account, chromia_foundation.reward_debt, chromia_foundation_reward, "Chromia Foundation", 0.0);

    chromia_foundation.reward_debt = pay_reward_result.reward_debt;
}

function pay_out_node_rewards(node_reward: map<node, big_integer>, has_delegation_share: boolean) {

    val pool = get_pool_account();

    for ((node, reward) in node_reward) {
        val provider = node.provider;
        val pa = provider_account @ { provider };

        if (is_staking_approved(provider, reward)) {
            // Ensure pool funds cover additional delegation rewards in _staking_shared_rewards
            val delegation_share = if (has_delegation_share) provider.staking_rewards_share else 0;

            val pay_reward_result = pay_reward(pool, pa.account, pa.reward_debt, reward, "provider %s".format(pa.provider.pubkey), delegation_share);

            save_node_payed_reward(node.pubkey, pay_reward_result.payed_reward, op_context.last_block_time);
            pa.reward_debt = pay_reward_result.reward_debt;
        }
    }
}

function pay_reward(pool: ft4.accounts.account, account: ft4.accounts.account, reward_debt: big_integer,
        reward: big_integer, identity: text, delegation_share: decimal): pay_reward_result {
    var pool_balance = get_account_balance(pool);
    var total_reward_debt = reward + reward_debt;

    var amount_to_transfer = 0L;
    if (total_reward_debt > 0) {
        if (pool_balance < total_reward_debt + total_reward_debt * delegation_share) {
            pool_balance = refill_pool_account_if_possible();
        }
        if (pool_balance >= total_reward_debt + total_reward_debt * delegation_share) {
            amount_to_transfer = total_reward_debt;
        } else if (pool_balance <= 0) { // No funds to pay reward
            log("Reward pool is empty!");
            amount_to_transfer = 0;
        } else { // Missing funds to pay full reward
            log("Reward pool does not have enough funds to transfer full reward.");
            amount_to_transfer = (pool_balance / (delegation_share + 1)).to_big_integer(); //Ensure delegation share is covered in the pool
        }
        if (amount_to_transfer > 0) {
            log("Transfer reward %s to %s".format(amount_to_transfer, identity));
            if (transfer_reward(pool, account, amount_to_transfer)) {
                total_reward_debt -= amount_to_transfer;
                pool_balance -= amount_to_transfer;
            } else {
                log("Unable to transfer reward to %s".format(identity));
            }
        }
    }

    val pay_reward_result = pay_reward_result(payed_reward = amount_to_transfer, payed_to = account, reward_debt = total_reward_debt);

    log("Pay reward result for %s: payed_reward = %s, reward_debt = %s, payed_to = %s, pool_balance = %s".format(
        identity,
        pay_reward_result.payed_reward,
        pay_reward_result.reward_debt,
        pay_reward_result.payed_to.id,
        pool_balance
    ));

    after_pay_reward(pay_reward_result, delegation_share);
    return pay_reward_result;
}

@extendable function after_pay_reward(pay_reward_result: pay_reward_result, delegation_share: decimal) {}

function sum_total_max_revenue_per_dapp_cluster(): decimal {
    var sum_total_max_revenue_per_dapp_cluster = 0.0;
    val clusters = cluster @* { .name != system_cluster_name };
    for (cluster in clusters) {
        sum_total_max_revenue_per_dapp_cluster += total_max_revenue_per_dapp_cluster(cluster);
    }
    return sum_total_max_revenue_per_dapp_cluster;
}

function total_max_revenue_per_dapp_cluster(cluster: cluster): decimal {
    val scu_revenue_usd = (total_available_scus(cluster.cluster_units) - standard_cluster_unit.system_container_units) * (decimal(cluster.tag.scu_price) / units_per_usd);
    val extra_storage_revenue_usd = (cluster.extra_storage / 1024) * (decimal(cluster.tag.extra_storage_price) / units_per_usd);
    return scu_revenue_usd + extra_storage_revenue_usd;
}

function dapp_provider_fee_share(): decimal = 1 - economy_constants.chromia_foundation_fee_share - economy_constants.resource_pool_margin_fee_share - economy_constants.system_provider_fee_share;

function dapp_cluster_value(cluster: cluster): decimal = total_max_revenue_per_dapp_cluster(cluster) * dapp_provider_fee_share() / (1 + economy_constants.staking_reward_fee_share);

function occupied_scus(cluster: cluster): integer = lease @ { cluster, not .expired } ( @sum .container_units );

function total_available_scus(cluster_units: integer): integer = cluster_units * standard_cluster_unit.container_units;

function total_available_scus_exclude_system(cluster): integer = total_available_scus(cluster.cluster_units) - standard_cluster_unit.system_container_units;

function occupancy_rate(cluster): decimal {
    val scus = total_available_scus_exclude_system(cluster);
    return if (scus > 0) decimal(occupied_scus(cluster)) / scus else 0;
}

function adjusted_availability_factor(availability_factor: decimal): decimal = max(0, availability_factor - 0.9) * 10;

function transfer_reward(pool: ft4.accounts.account, account: ft4.accounts.account, amount: big_integer): boolean {
    return try_call(try_transfer_reward(pool, account, amount, *));
}

function try_transfer_reward(pool: ft4.accounts.account, account: ft4.accounts.account, amount: big_integer) {
    ft4.assets.Unsafe.transfer(get_pool_account(), account, get_asset(), amount);
}

@extend(ft4.auth.auth_handler)
function () = ft4.auth.add_auth_handler(
    scope = rell.meta(transfer_to_pool).mount_name,
    flags = ["T"],
    message = transfer_to_pool_auth_message(*)
);

function transfer_to_pool_auth_message(gtv): text {
    val args = struct<transfer_to_pool>.from_gtv(gtv);

    return "Please sign the message\nto transfer %s %s from account {account_id} \nto pool account.".format(
        ft4.assets.format_amount_with_decimals(args.amount, chain_context.args.asset_decimals),
        chain_context.args.asset_symbol);
}

/**
 * Transfer tokens to the common pool account.
 *
 * @param amount  amount of tokens to transfer
 */
operation transfer_to_pool(amount: big_integer) {
    require_initialized();

    val account = ft4.auth.authenticate();

    ft4.assets.Unsafe.transfer(account, get_pool_account(), get_asset(), amount);
}

function save_node_payed_reward(node: byte_array, value: big_integer, time: timestamp){
    create node_payed_reward(node, value, time);
}

function get_days_since(time: timestamp): integer {
    return (get_last_blocktime() - time) / DAY_MS;
}

function get_staking_requirement_payout_stop(provider_staking_account): (integer, integer, boolean) {
    val days_since_approved_staking = get_days_since(provider_staking_account.last_approved_stake_requirements);
    val days_until_stopped_payout = economy_constants.staking_requirement_stop_payout_days - days_since_approved_staking;
    return (
        days_since_approved_staking,
        days_until_stopped_payout,
        days_since_approved_staking < economy_constants.staking_requirement_stop_payout_days
    );
}

operation reset_provider_reward_debt(my_pubkey: pubkey) {
    val provider = require_provider_is_signer(my_pubkey);
    reset_provider_reward_debt_impl(provider);
}

function reset_provider_reward_debt_impl(provider) {
    val pa = provider_account @ { provider };
    pa.reward_debt = 0;
}

/**
 * Get the nodes availability and include deleted nodes availability in case the node was replaced since last reward
 * @param node_availability_report Map from dode availability report structure.
 * @param node Node currently active in the cluster.
 * @param cluster Cluster to collect availability for.
 */
function get_aggregated_node_availability(node_availability_report: map<byte_array, decimal>, node, cluster) {

    val node_keys = set<pubkey>([node.pubkey]);

    for (old_node in reward_provider_deleted_node @* { node.provider, cluster }) {
        node_keys.add(old_node.node);
    }

    var availability: decimal = 0;
    var node_availabilities = map<pubkey, decimal>();

    for (node_key in node_keys) {
        val node_availability = node_availability_report.get_or_default(node_key, 0);
        node_availabilities[node_key] = node_availability;
        availability += node_availability;
    }

    if (node_availabilities.size() > 1) {
        log("Availability for node %s is the sum from multiple nodes: %s".format(node.pubkey, node_availabilities));
    }

    if (availability > 1) {
        log("Availability calculation %s for node %s is incorrect and too high and will be set to 1"
            .format(availability, node.pubkey));
    }

    return min(availability, 1);
}
