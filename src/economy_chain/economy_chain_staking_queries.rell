// Rates

/** Current annualised reward rate
/*  @returns as a decimal fraction, eg. 0.1 is 10%
*/
query staking_get_current_rate(): decimal = economy_constants.staking_reward_rate;

/** Starting instant of rewards
/*  @returns As a Unix timestamp
*/
query staking_get_rewards_start(): timestamp = chain_context.args.staking_rewards_start_time;


// Delegations

/**
/* The current delegation of the user's stake on one of the three blockchain networks.
/* Ordinarily the user would be staked (or unstaked) identitically across the networks.
/*
/* @param account_id User account ID (bytes32)
/* @param network Network using the enum
/* @returns Public key of the delegated to provider, or null if currently undelegated
*/
query staking_get_current_delegate_on_network(account_id: byte_array, network): byte_array? {
    val _provider_pubkey = staker_state_to_provider @? {
        .staker_state.account.id == account_id and .staker_state.network == network and  
        _staking_last_known_time() >= .timestamp
    } ( @omit @sort_desc .timestamp, @omit @sort_desc .rowid, .provider.pubkey ) limit 1;
    return when {
        empty(_provider_pubkey) or _provider_pubkey == get_null_account() -> null;
        else -> _provider_pubkey;
    };
}

/**
/* Gets the user's most recent stake delegation across all network.
/* Delegation of all stakes should be identical. This will break-down if withdrawals are not applied consistently.
/*
/* @param account_id Given user
/* @returns Public key of the last delegated to provider, or null if last undelegated 
*/
query staking_get_current_delegate(account_id: byte_array) {
    val _provider_pubkey = staker_state_to_provider @? {
        .staker_state.account.id == account_id
        and _staking_last_known_time() >= .timestamp
    } ( @omit @sort_desc .timestamp, @omit @sort_desc .rowid, .provider.pubkey ) limit 1;
    return when {
        empty(_provider_pubkey) or _provider_pubkey == get_null_account() -> null;
        else -> _provider_pubkey;
    };
}

/**
/* Delegation changes do not take place immediately. This will return the next delegation change, or null if there is none.
/*
/* @param account_id Given user
/* @returns A tuple of the next to be delegated to provider and the timestamp the delegation will take effect. Or null if no re-delegation is scheduled.
*/
query staking_get_next_delegation_change(account_id: byte_array) : (pubkey: pubkey?, time: integer)? {
    val staker = ft4.accounts.Account(account_id);
    val upcoming_delegations = staker_state_to_provider @* {
        .staker_state.account == staker and .timestamp > _staking_last_known_time()
    } (
        @omit @sort_desc .timestamp,
        @omit @sort_desc .rowid,
        pubkey = .provider.pubkey,
        time = .timestamp
    ) limit 1;
    return if (exists(
        upcoming_delegations
    )) (
        pubkey = when(upcoming_delegations[0].pubkey) {
            get_null_account() -> null;
            else -> upcoming_delegations[0].pubkey
        },
        time = upcoming_delegations[0].time
    ) else null;
}

/**
/* Total staked CHR across all networks and all users that had been delegated to the provider with that public key.
/*
/* @param pubkey Public key of the given provider
/* @returns Total CHR staked to the given provider in  minor units
*/
query staking_get_total_delegation_to(pubkey, network? = null) {
    return ( s1: staker_state_to_provider) @ {
        .provider.pubkey == pubkey and (s1.timestamp <= _staking_last_known_time()) and 
            (not exists(network) or .staker_state.network == network) and 
            not exists((s2:staker_state_to_provider) @* { 
                s2.staker_state ==s1.staker_state,
                ((s2.timestamp <= _staking_last_known_time()) and (s2.timestamp>s1.timestamp)) 
                or (s2.timestamp==s1.timestamp and s2 < s1) 
            }
        )
    } ( @sum .staker_state.balance );
}

/**
/* Total stake the provider has delegated to themselves
/*
/* @param pubkey Public key of the given provider
/* @returns Total self staked CHR in  minor units
*/
query staking_get_provider_stake(pubkey) {
    val provider_id = provider_staking_account @ {pubkey == .provider.pubkey} (.staking_account.id);
    return if (pubkey == staking_get_current_delegate(provider_id) ?: get_null_account())
        staking_get_balance(provider_id)
        else 0;
}


// Withdrawals

/**
/* Timestamp of the next withdrawal.
/* 
/* The true expected time will be slightly longer than this as withdrawal payouts trigger periodically.
/* However the delay on a withdrawal payout should not be noticeable in a production configuration.
/*
/* @param account_id Given account's id
/* @param network The network of the next withdrawal of interest. Defaults to CHR native.
/* @returns Timestamp of the expected withdrawal time or null if not withdrawal has been requested
*/
query staking_get_withdrawal_time(account_id: byte_array, network = network.CHR): timestamp? {
    return staker_withdrawal_request @? {
        .staker_state.account.id == account_id and .active and .staker_state.network == network
    } (
        .finish_at
    );
}


// Rewards

/**
/* Reward that would be paid to the user if rewards were distributed now
/*
/* @param account_id Account ID
/* @returns Amount of CHR in minor units
/* @dev If this is changed so should `_update_pending_token_time` and the query `_update_pending_token_time_all`.
/* @dev Please pay attention to the bits marked with ***.
*/
query staking_rewards_claimable_for(account_id: byte_array) {
    val rate = staking_get_current_rate() / millis_per_year;
    val staker = ft4.accounts.Account(account_id);
    val ss = (
        // Take all the states
        s: staker_state,
        // And attach to them the provider record
        p: staker_state_to_provider @* {
                // That links to the staker state
                s == p.staker_state
                // Is old enough to be active
            and p.timestamp <= _staking_last_known_time()
            and empty(
                // And for which there is not also a state that meets that criteria...
                (pp: staker_state_to_provider) @* {
                        pp.staker_state == s
                    and pp.timestamp <= _staking_last_known_time()
                    // ... and is is newer
                    and (
                            pp.timestamp > p.timestamp
                        or  (pp.rowid > p.rowid and pp.timestamp == p.timestamp)
                    )
                }
            )
        }
    // For this staker
    ) @* { s.account == staker }; // *** We want all of them but only for 1 account ***
    var total_pending_token_time = 0;
    for (s in ss) {
        // @dev This needs to align with the logic in economy_chain_staking_model.rell .
        val elapsed_time =
        max(0, // No less than zero time
            // We would like to end at ... 
            when(s.p.provider.pubkey) {
                // ... if we are transitioning to undelegated, the earlier of the undelegation time and now
                get_null_account() -> min(_staking_last_known_time(), s.p.timestamp);
                // ... or just the current time
                else -> _staking_last_known_time();
            }
            // Start at the greatest of whole system start time or that for this stake
            - max(
                staking_get_rewards_start(),
                when(s.p.previous_provider.pubkey) {
                    // If we undelegating here, the more recent of the last updated or the undelegation time
                    get_null_account() -> max(s.p.timestamp, s.s.last_update);
                    // ... if we don't unstake then just the last update time
                    else -> s.s.last_update;
                },
            )
        );
        val balance_in_units = s.s.balance / units_per_asset;
        total_pending_token_time += s.s.pending_token_time + (balance_in_units * elapsed_time);
    }

    // Operand ordering to prevent overflow
    return integer((total_pending_token_time * rate) * units_per_asset);
}

/**
/* All staking rewards earned for an account, including both distributed and undistributed rewards.
/*
/* @param account_id Account ID
/* @returns Amount of CHR in minor units
*/
query staking_rewards_for(
    account_id: byte_array
) = staking_rewards_claimable_for(
    account_id
) + staking_get_rewards_paid(
    account_id
);

/**
/* Staking rewards that have already been distributed to the user
/*
/* @param account_id Account ID
/* @returns Amount of CHR in minor units
*/
query staking_get_rewards_paid(account_id: byte_array): integer {
    val account = ft4.accounts.Account(account_id);
    return staking_payment @* { .account == account } ( @sum .amount )[0];
}



// Balances

/**
/* Balance staked by the user
/*
/* @param account_id Account ID
/* @returns Total balance of CHR in minor units
*/
query staking_get_balance(
    account_id: byte_array
) = staker_state @ { 
    .account.id == account_id 
} ( 
    @sum .balance 
);

/**
/* Native Ft4 Chromia balance of CHR (in minor units) staked by the user
/*
/* @param account_id Account ID
/* @returns Total balance of CHR in minor units
*/
query staking_get_native_balance(account_id: byte_array) {
    val account = ft4.accounts.Account(account_id);
    return staker_state @? { .account == account and .network ==network.CHR } ( .balance ) ?: 0;
}


// Statistics

/**
/* Total staked by all users (including undelegated stakes)
/*
/* @returns Total staked of CHR in minor units
*/
query staking_total_stake() = staker_state @* { } ( @sum .balance )[0];

/**
/* Total staked by all users (including undelegated stakes)
/*
/* @returns User count
*/
query staking_total_accounts() = staker_state @* { } ( @sum 1 )[0];


// Date utilites

query staking_get_cannot_change_before(): timestamp = _staking_last_known_time() + chain_context
    .args
    .staking_delegation_delay_ms;

query get_provisional_stake_balance(address: byte_array, network): integer {
    return provisional_stake_balance @? { address, network }.staked_balance ?: 0;
}
