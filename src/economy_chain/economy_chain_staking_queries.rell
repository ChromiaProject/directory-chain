// Rates

/** Current annualised reward rate
 *  @return as a decimal fraction, eg. 0.1 is 10%
*/
query staking_get_current_rate(): decimal = economy_constants.staking_reward_rate;

/** Current annualised reward rate for EVM stakers
 *  @return as a decimal fraction, eg. 0.1 is 10%
*/
query staking_get_current_evm_rate(): decimal {
    val current_time = _staking_last_known_time();
    return if (current_time < 1764633600000) // Tue Dec 02 2025 00:00:00 GMT
        economy_constants.staking_reward_rate
    else if (current_time < 1770076800000) // Tue Feb 03 2026 00:00:00 GMT+0000
        0.02
    else if (current_time < 1775001600000) // Wed Apr 01 2026 00:00:00 GMT+0000
        0.01
    else 0;
}

/** Starting instant of rewards
 *  @return As a Unix timestamp
*/
query staking_get_rewards_start(): timestamp = chain_context.args.staking_rewards_start_time;


// Delegations

/**
 * The current delegation of the user's stake on one of the three blockchain networks.
 * Ordinarily the user would be staked (or unstaked) identitically across all networks.
 *
 * @param account_id User account ID (bytes32)
 * @param network Network using the enum
 * @return Public key of the delegated to provider, or null if currently undelegated
*/
query staking_get_current_delegate_on_network(account_id: byte_array, network): byte_array? {
    val d_state = delegation_state @? { .staker_state.account.id == account_id and .staker_state.network == network };
    return _get_current_provider_pubkey(d_state);
}

/**
 * Gets the user's most recent stake delegation across all network.
 * This can vary if a withdrawal has been made on a single chain.
 *
 * @param account_id Given user
 * @return Public key of the last delegated to provider, or null if last undelegated
*/
query staking_get_current_delegate(account_id: byte_array) {
    val last_time = _staking_last_known_time();
    val null_provider = provider @ { .pubkey == get_null_account() };
    
    val d_state = delegation_state @? { 
        .staker_state.account.id == account_id and (
            (.current_provider != null_provider and (.next_change_at == 0 or .next_change_at > last_time)) or
            (.next_provider != null_provider and .next_change_at <= last_time)
        )
    } ( @omit @sort_desc .next_change_at, @omit @sort_desc .rowid, $) limit 1;
    
    return _get_current_provider_pubkey(d_state);
}

/**
 *  This will return the next delegation change, or null if there is none.
 *  Delegation changes do not take place immediately.
 *
 * @param account_id Given user
 * @return Struct containing the next to be delegated provider, the timestamp the delegation will take effect and
 * a boolean indicating whether the next delegation change was automatically canceled due to the provider being off-boarded.
 * Or null if no re-delegation is scheduled.
 */
query staking_get_next_delegation_change(
    account_id: byte_array
): next_delegation_change? {
    val staker = ft4.accounts.Account(account_id);
    val upcoming_delegations = delegation_state @* {
        .staker_state.account == staker,
        .next_change_at > _staking_last_known_time()
    } (
        @omit @sort_desc .next_change_at,
        @omit @sort_desc .rowid,
        pubkey = .next_provider.pubkey,
        time = .next_change_at
    ) limit 1;
    var result = if (exists(
        upcoming_delegations
    )) next_delegation_change(
        pubkey = when (upcoming_delegations[0].pubkey) {
            get_null_account() -> null;
            else -> upcoming_delegations[0].pubkey
        },
        time = upcoming_delegations[0].time,
        auto_canceled = false
    ) else null;
    if (result == null) {
        val auto = auto_cancel_upcoming_delegation @* {
            .account == staker,
            .next_change_at > _staking_last_known_time()
        } (
            @omit @sort_desc .next_change_at,
            @omit @sort_desc .delegation_state.rowid,
            pubkey = .provider,
            time = .next_change_at
        ) limit 1;
        if (exists(auto)) {
            result = next_delegation_change(pubkey = auto[0].pubkey, time = auto[0].time, auto_canceled = true);
        }
    }
    return result;
}

struct next_delegation_change {
    pubkey?;
    time: timestamp;
    auto_canceled: boolean;
}

/**
 * Returns the previous provider delegate for a given staker account, along with information
 * about whether the un-delegation was automatic due to provider offboarding.
 *
 * @param account_id Given user
 * @return An object of type `previous_delegate` containing:
 *   - `pubkey`: The public key of the previous delegate provider. May be `null` if no previous provider exists.
 *   - `auto_undelegated`: A boolean indicating whether the un-delegation was performed automatically because the
 *                         provider was off-boarded, as opposed to a manual re-delegation by the user.
 */
query staking_get_previous_delegate(account_id: byte_array): previous_delegate? {
    val d_state = delegation_state @* { .staker_state.account.id == account_id } (
        @omit @sort_desc .rowid, $
    ) limit 1;
    if (exists(d_state)) {
        val previous_delegate = if (d_state[0].next_change_at > 0 and d_state[0].next_change_at <= _staking_last_known_time()) d_state[0].current_provider.pubkey else d_state[0].previous_provider.pubkey;
        var auto_undelegated = exists(auto_undelegation @? { .delegation_state == d_state[0], .provider == previous_delegate });
        return previous_delegate(previous_delegate, auto_undelegated);
    } else {
        return null;
    }
}

struct previous_delegate {
    pubkey: pubkey?;
    auto_undelegated: boolean;
}

/**
 * Total staked CHR across all networks and all users that had been delegated to the provider
 *
 * @param pubkey Public key of the given provider
 * @return Total CHR staked to the given provider in minor units
*/
query staking_get_total_delegation_to(pubkey, network? = null) {
    return delegation_state @ {
        (
            (.current_provider.pubkey == pubkey and (.next_change_at > _staking_last_known_time() or .next_change_at == 0)) or 
            (.next_provider.pubkey == pubkey and .next_change_at <= _staking_last_known_time())
        ) and (empty(network) or .staker_state.network == network)
    } ( @sum .staker_state.balance );
}

/**
 * Number of users delegating to a provider
 *
 * @param pubkey Public key of the given provider
 * @param network Chosen network
 * @return Count of users delegating to a provider
*/
query staking_get_number_of_delegates_to(pubkey, network? = null): integer {
    val ds = delegation_state @* {
        (
            (.current_provider.pubkey == pubkey and (.next_change_at > _staking_last_known_time() or .next_change_at == 0)) or 
            (.next_provider.pubkey == pubkey and .next_change_at <= _staking_last_known_time())
        ) and (empty(network) or .staker_state.network == network)
    } ( @group .staker_state.account );
    return ds.size();
}

/**
 * Total stake the provider has delegated to themselves
 *
 * @param pubkey Public key of the given provider
 * @return Total self staked CHR in  minor units
*/
query staking_get_provider_stake(pubkey) {
    val provider_id = provider_staking_account @ {pubkey == .provider.pubkey} (.staking_account.id);
    return if (pubkey == staking_get_current_delegate(provider_id) ?: get_null_account())
        staking_get_balance(provider_id)
        else 0;
}


// Withdrawals

/**
 * Timestamp of the next withdrawal.
 * 
 * The true expected time will be slightly longer than this as withdrawal payouts trigger periodically.
 * However the delay on a withdrawal payout should not be noticeable in a production configuration.
 *
 * @param account_id Given account's id
 * @param network The network of the next withdrawal of interest. Defaults to CHR native.
 * @return Timestamp of the expected withdrawal time or null if not withdrawal has been requested
*/
query staking_get_withdrawal_time(account_id: byte_array, network = network.CHR): timestamp? {
    return staker_withdrawal_request @? {
        .staker_state.account.id == account_id and .active and .staker_state.network == network
    } (
        .finish_at
    );
}


// Rewards

/**
 * Reward that would be paid to the user if rewards were distributed now
 *
 * @param account_id Account ID
 * @return Amount of CHR in minor units
 * @dev If this is changed so should `_update_pending_token_time` and the query `_update_pending_token_time_all`.
*/
query staking_rewards_claimable_for(account_id: byte_array) {
    val native_rate = staking_get_current_rate() / millis_per_year;
    val evm_rate = staking_get_current_evm_rate() / millis_per_year;
    val staker = ft4.accounts.Account(account_id);
    val last_known_time = _staking_last_known_time();
    val null_provider = provider @ { .pubkey == get_null_account() };
    
    // Get all staker states for this account
    val staker_states = staker_state @* { .account == staker };

    var total_amount = 0.0;
    
    for (ss in staker_states) {
        var current_provider = null_provider;
        var current_active_from = 0;
        var previous_provider = null_provider;

        // Find the delegation state for this staker state
        val ds = delegation_state @? { .staker_state == ss };
        if (exists(ds)) {
          if (ds.next_change_at > 0 and ds.next_change_at <= last_known_time) {
            current_provider = ds.next_provider;
            current_active_from = ds.next_change_at;
            previous_provider = ds.current_provider;
          } else {
            current_provider = ds.current_provider;
            current_active_from = ds.current_active_from;
            previous_provider = ds.previous_provider;
          }
        }

        // Calculate elapsed time based on delegation status
        val elapsed_time = max(0,
            // End time depends on whether we're delegated or not
            when(current_provider.pubkey) {
                get_null_account() -> min(last_known_time, current_active_from);
                else -> last_known_time;
            }
            // Start time is the max of rewards start time or last update
            - max(
                staking_get_rewards_start(),
                when(previous_provider.pubkey) {
                    get_null_account() -> max(current_active_from, ss.last_update);
                    else -> ss.last_update;
                }
            )
        );
        
        val balance_in_units = ss.balance / units_per_asset;
        total_amount += (ss.pending_token_time + (balance_in_units * elapsed_time)) * (if (ss.network == network.CHR) native_rate else evm_rate);
    }

    // Operand ordering to prevent overflow
    return integer(total_amount * units_per_asset);
}

/**
 * All staking rewards earned for an account, including both distributed and undistributed rewards.
 *
 * @param account_id Account ID
 * @return Amount of CHR in minor units
*/
query staking_rewards_for(
    account_id: byte_array
) = staking_rewards_claimable_for(
    account_id
) + staking_get_rewards_paid(
    account_id
);

/**
 * Staking rewards that have already been distributed to the user
/*
 * @param account_id Account ID
 * @return Amount of CHR in minor units
*/
query staking_get_rewards_paid(account_id: byte_array): integer {
    val account = ft4.accounts.Account(account_id);
    return staking_payment @ { .account == account } ( @sum .amount );
}

/**
 * Shared staking rewards that have already been distributed to the user
 *
 * @param account_id Account ID
 * @param provider_pubkey Optionally get rewards from a specific provider only
 * @param since Only get shared rewards after a specific timestamp
 * @return Amount of CHR in minor units
*/
query staking_get_shared_rewards_paid(
    account_id: byte_array,
    provider_pubkey: pubkey? = null,
    since: timestamp? = null
): integer {
    val account = ft4.accounts.Account(account_id);
    return staking_payment @ {
        .account == account,
        (empty(provider_pubkey) or .provider_pubkey == provider_pubkey),
        (empty(since) or .timestamp > since)
    } (
        @sum .shared_amount
    );
}

// Balances

/**
 * Balance staked by the user
 *
 * @param account_id Account ID
 * @return Total balance of CHR in minor units
*/
query staking_get_balance(
    account_id: byte_array
) = staker_state @ { 
    .account.id == account_id 
} ( 
    @sum .balance 
);

/**
 * Native FT4 Chromia balance of CHR (in minor units) staked by the user
 *
 * @param account_id Account ID
 * @return Total balance of CHR in minor units
*/
query staking_get_native_balance(account_id: byte_array) {
    val account = ft4.accounts.Account(account_id);
    return staker_state @? { .account == account and .network ==network.CHR } ( .balance ) ?: 0;
}

/**
 * Balance staked by the user on a specific network
 *
 * @param account_id Account ID
 * @param network Network
 * @return Total balance of CHR in minor units
*/
query staking_get_balance_on_network(account_id: byte_array, network: network) {
    val account = ft4.accounts.Account(account_id);
    return staker_state @? { .account == account and .network == network } ( .balance ) ?: 0;
}


/**
 * List of all accounts that has a native stake
 *
 * @param page_size amount of accounts to fetch
 * @param page_cursor cursor for additional page start
 * @return Paginated list of accounts and their balances
*/
query get_accounts_with_native_stake(page_size: integer, page_cursor: text?) {
    return ft4.utils.make_page(
        get_paginated_accounts_with_native_stake(page_size, page_cursor),
        page_size
    );
}

// Statistics

/**
 * Total staked by all users with a Chromia account (including undelegated stakes)
 *
 * @return Total staked of CHR in minor units
*/
query staking_total_stake() = staker_state @ { } ( @sum .balance );

/**
 * Total staked by all users with a Chromia account on network (including undelegated stakes)
 *
 * @param network Chosen network
 * @return Total staked of CHR in minor units
*/
query staking_total_stake_on_network(network)  = staker_state @ { network } ( @sum .balance );


/**
* All staking and shared rewards that have been distributed to users (shared rewards included from 2024-10-26)
*
* @param from Only get shared rewards after a specific timestamp
* @param to Only get shared rewards before a specific timestamp
* @return Amount of CHR in minor units
*/
query staking_get_all_rewards_paid(
    from: timestamp? = null,
    to: timestamp? = null
) {
    return staking_payment @ {
        (empty(from) or .timestamp > from),
        (empty(to) or .timestamp <= to)
    } (
        @sum staking_rewards = .amount,
        @sum shared_rewards = .shared_amount
    );
}

/**
 * Total delegated by all users
 * 
 * @param network Optionally specify network
 * @return Total staked of CHR in minor units
*/
query staking_total_delegated(network? = null) {
    val null_provider = provider @ { .pubkey == get_null_account() };
    val last_time = _staking_last_known_time();
    return delegation_state @ {
        (empty(network) or .staker_state.network == network) 
        and (
            // Current provider is active and either no change or future change
            (.current_provider != null_provider and (.next_change_at == 0 or .next_change_at > last_time))
            or 
            // OR next provider is active and change time has passed
            (.next_provider != null_provider and .next_change_at <= last_time)
        )
    } ( @sum .staker_state.balance );
}

/**
 * Total users that have delegated
 * 
 * @param network Optionally specify network
 * @return Total users
*/
query staking_total_delegation_accounts(network? = null) {
    val null_provider = provider @ { .pubkey == get_null_account() };
    val last_time = _staking_last_known_time();
    val ds = delegation_state @* {
         (empty(network) or .staker_state.network == network) 
        and (
            // Current provider is active and either no change or future change
            (.current_provider != null_provider and (.next_change_at == 0 or .next_change_at > last_time))
            or 
            // OR next provider is active and change time has passed
            (.next_provider != null_provider and .next_change_at <= last_time)
        )
    } ( @group .staker_state.account);
    return ds.size();
}

/**
 * Total number of users that have created an account and staked on any network
 *
 * @return User count
*/
query staking_total_accounts() = staker_state @ { } ( @sum 1 );

/**
 * Total number of users that have created an account and staked on a network
 *
 * @return User count
*/
query staking_total_accounts_on_network(network) = staker_state @ { network } ( @sum 1 );

query get_total_provisional_stake(network? = null) = provisional_stake_balance @ { (empty(network) or .network == network) } ( @sum .staked_balance );

query get_total_provisional_stake_accounts(network? = null) = provisional_stake_balance @ { (empty(network) or .network == network) } ( @sum 1 );

// Date utilities

query staking_get_cannot_change_before(): timestamp = _staking_last_known_time() + chain_context
    .args
    .staking_delegation_delay_ms;

query get_provisional_stake_balance(address: byte_array, network): integer {
    return provisional_stake_balance @? { address, network }.staked_balance ?: 0;
}

/**
 * Get the current staking rewards share for a node provider,
 * as a percentage between 0.0 and 1.0.
 *
 * @param provider_pubkey The provider's main public key
 */
query staking_provider_staking_rewards_share(provider_pubkey: pubkey): decimal {
    val provider = require_provider(provider_pubkey);
    require(provider.tier == provider_tier.NODE_PROVIDER, "Only node providers have staking rewards share");
    return provider.staking_rewards_share;
}
