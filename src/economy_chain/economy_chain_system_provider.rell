
/**
 * Return the provider entity from signers if any, or rejects if multiple providers are found.
 */
function require_system_provider_signer_entity(): provider {
    val provider_pubkey = get_provider_signer();
    require(provider_pubkey != null, "Expected system provider signature");
    return require(provider @? { .active == true, provider_pubkey!! }, "Expected system provider signature");
}

