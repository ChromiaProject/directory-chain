module;

import common.*;
import .voting.*;

// NEW TYPES MUST BE ADDED AT END!
enum proposal_type {
    configuration_at,
    configuration,
    bc,
    container_limits,
    cluster_limits,
    cluster_provider,
    cluster_remove,
    voter_set_update,
    provider_state,
    provider_is_system,
    provider_quota,
    provider_batch,
    blockchain_action,
    cluster_anchoring_configuration,
    container,
    container_remove,

    blockchain_import,
    configuration_import,
    finish_blockchain_import,

    foreign_blockchain_import,
    foreign_blockchain_blocks_import,

    blockchain_move_start,
    blockchain_move_cancel,
    blockchain_move_finish,
    force_configuration,
    blockchain_rename,

    subnode_image,
    subnode_image_state,
    add_cluster_subnode_image,
    remove_cluster_subnode_image,
    update_subnode_image,
    container_subnode_image,
    remove_forced_configuration,

    container_action,
    container_configuration,

    add_cluster_subnode_jar_extension,
    remove_cluster_subnode_jar_extension,
    update_subnode_jar_extension,
    container_subnode_jar_extension,
    subnode_jar_extension,
    subnode_jar_extension_state,
}

enum proposal_state {
    PENDING, APPROVED, REJECTED, REVOKED, DELAYED, FAILED
}

entity proposal {
    timestamp;
    mutable proposal_type;
    index timestamp, proposal_type;
    proposed_by: provider;
    index voter_set;
    description: text = "";
    transaction = op_context.transaction;
    mutable state: proposal_state = proposal_state.PENDING;
}

enum blockchain_configuration_update_state {
    PENDING, SUCCESSFUL, FAILED
}

entity blockchain_configuration_update_attempt {
    key proposal, config_hash: byte_array;
    blockchain_rid: byte_array = x"";
    mutable applied_at_height: integer = -1;
    mutable state: blockchain_configuration_update_state = blockchain_configuration_update_state.PENDING;
}

/**
 * Extend to return all proposal entity ids supporting delays. This is used to let other modules be aware of delayed
 * proposals such as blockchain pause.
 */
@extendable function proposal_delay_ids_handlers(): map<text, (blockchain) -> list<rowid>>;

/**
 * Revoke proposal.
 *
 * Permission: proposal owner
 *
 * Rate limit: actions
 *
 * @param my_pubkey pubkey of provider
 */
operation revoke_proposal(my_pubkey: pubkey, proposal_rowid: rowid) {
    val me = require_is_provider_with_rate_limit(my_pubkey);
    val prop = require_proposal(proposal_rowid);

    require(
        prop.state == proposal_state.PENDING or
        prop.state == proposal_state.DELAYED,
        "The proposal is already %s".format(prop.state));
    require(prop.proposed_by == me, "It is only allowed to revoke own proposals");
    prop.state = proposal_state.REVOKED;
    delete_proposal(prop);
}

function create_proposal(proposal_type, proposed_by: provider, deployer: voter_set, description: text = ""): proposal {
    validate_metadata_text("description", description);
    return create proposal(op_context.last_block_time, proposal_type, proposed_by, deployer, description);
}

function delete_proposal(prop: proposal) {
    remove_scheduled_callback(delay_type.PROPOSAL.value, prop.rowid.to_integer());
    delete_scheduled_event(delay_type.PROPOSAL, prop.rowid.to_integer());
    delete_proposal_handlers()[prop.proposal_type.name](prop);
}

@extendable function delete_proposal_handlers(): map<text, (proposal) -> unit>;

/**
 * Pause/unpause all delayed proposals for a specific chain.
 */
function set_blockchain_proposal_delay_states(blockchain, active: boolean) {

    for (proposal_id in get_blockchain_proposal_delay_ids(blockchain)) {
        set_scheduled_callback_active(delay_type.PROPOSAL.value, proposal_id.to_integer(), active);
    }
}

/**
 * Return all proposals that currently are delayed for a given chain.
 */
function get_blockchain_proposal_delay_ids(blockchain) {

    val handlers = proposal_delay_ids_handlers();
    val proposal_ids = set<rowid>();

    for (handler in handlers.values()) {
        val ids = handler(blockchain);
        proposal_ids.add_all(ids);
    }

    return proposal_ids;
}
