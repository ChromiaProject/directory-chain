// NB: check authority before calling this function
function internal_vote(provider, proposal, vote: boolean) {
    require(voter_set_member @? { proposal.voter_set, provider },
        "provider %s must be a member of the voter set".format(provider.pubkey));
    val vote_entity = create vote(proposal, provider, vote);
    create vote_transaction(vote_entity, op_context.transaction, op_context.op_index);
    log("vote '%s' added for proposal %s".format(if (vote) "Yes" else "No", proposal_str(proposal)));
    try_to_apply_proposal(proposal);
}

function try_to_apply_proposal(prop: proposal) {
    val prop_str = proposal_str(prop);
    val results = get_proposal_voting_results(prop.rowid);
    when (results.voting_result) {
        pending -> log("proposal is still under discussion:", prop_str);
        rejected -> {
            log("proposal rejected:", prop_str);
            prop.state = proposal_state.REJECTED;
            delete_proposal(prop);
        }
        approved -> {
            log("proposal approved:", prop_str);
            prop.state = proposal_state.APPROVED;
            apply_or_delay_proposal(prop);
        }
    }
}

function apply_iccf_proposal(proposal) {
    require(voter_set_member @* { proposal.voter_set } (.provider) == [ proposal.proposed_by ],
        "provider %s must be the only member of the voter set".format(proposal.proposed_by.pubkey));
    apply_or_delay_proposal(proposal);
}

// NB: check authority before calling this function
function apply_or_delay_proposal(prop: proposal) {
    val (blockchain, proposal_delay) = get_proposal_delay(prop);

    if (proposal_delay > 0) {
        log("Proposal %s is delayed and will be applied in %s ms".format(prop.rowid, proposal_delay));
        prop.state = proposal_state.DELAYED;
        create_scheduled_callback_after(delay_type.PROPOSAL.value, prop.rowid.to_integer(), proposal_delay);
        if (blockchain != null) {
            set_scheduled_callback_active(delay_type.PROPOSAL.value, prop.rowid.to_integer(), blockchain.state == blockchain_state.RUNNING);
        }
    } else {
        try_call_apply_voting_result_handlers(prop);
    }
}

/**
 * Callback for delayed or scheduled proposals to run the proposals apply function.
 */
@extend(proposal_delayed_apply)
function dc_proposal_delayed_apply(proposal_id: integer) {
    val prop = proposal @? { .rowid == rowid(proposal_id) };
    if (prop != null) {
        try_call_apply_voting_result_handlers(prop);
    }
}

function try_call_apply_voting_result_handlers(prop: proposal){
    if (try_call(apply_voting_result_handlers()[prop.proposal_type.name](prop, *))){
        prop.state = proposal_state.APPROVED;
    } else {
        prop.state = proposal_state.FAILED;
    }
    delete_proposal(prop);
}

/**
 * Call extended handler to get possible delay for the proposal type. This includes both delayed and scheduled proposals
 * and will return the longest delay if both are set.
 */
function get_proposal_delay(proposal): (blockchain: blockchain?, delay: integer) {

    var delay: (blockchain: blockchain?, delay: integer)? = null;
    val delay_handlers = proposal_delay_time_handlers();
    if (delay_handlers.contains(proposal.proposal_type.name)) {
        delay = delay_handlers[proposal.proposal_type.name](proposal);
    }

    var scheduled_at_delay: (blockchain: blockchain?, delay: integer)? = null;
    val scheduled_at_delay_handlers = scheduled_proposal_delay_time_handlers();
    if (scheduled_at_delay_handlers.contains(proposal.proposal_type.name)) {
        scheduled_at_delay = scheduled_at_delay_handlers[proposal.proposal_type.name](proposal);
    }

    if (delay != null and scheduled_at_delay != null) {
        return if (scheduled_at_delay.delay > delay.delay)
            scheduled_at_delay
        else
            delay;
    } else if (delay != null) {
        return delay;
    } else if (scheduled_at_delay != null) {
        return scheduled_at_delay;
    }

    return (blockchain = null, delay = 0);
}

@extendable function apply_voting_result_handlers(): map<text, (proposal) -> unit>;

@extendable function proposal_str(prop: proposal): text? = "%s:%d".format(prop.proposal_type, prop.rowid);

/**
 * Extend to set a handler to return the delay for a proposal type. This feature adds a delay in between
 * the proposal is approved and actually applied.
 *
 * @return The handler returns the blockchain and delay value.
 */
@extendable function proposal_delay_time_handlers(): map<text, (proposal) -> (blockchain: blockchain?, delay: integer)>;

/**
 * As `scheduled_proposal_delay_time_handlers` but is used to handle `scheduled at` delays.
 */
@extendable function scheduled_proposal_delay_time_handlers(): map<text, (proposal) -> (blockchain: blockchain?, delay: integer)>;
