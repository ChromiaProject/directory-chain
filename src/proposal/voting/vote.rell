enum voting_result {
    pending,
    approved,
    rejected
}


function positive_votes(proposal) = vote @? { proposal, .vote == true } (@sum 1) ?: 0;
function negative_votes(proposal) = vote @? { proposal, .vote == false } (@sum 1) ?: 0;
function max_votes(voter_set) = voter_set_member @ { voter_set } (@sum 1);
