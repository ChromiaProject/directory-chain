@test module;

import ^^.*;
import ^^^^.common.test.setup.*;
import ^^^^.common.test.ops.*;
import delay.test.helper_operations.*;
import proposal_blockchain.test.utils.*;
import proposal.voting.test.ops.*;

val provider_1 = rell.test.keypairs.alice;
val provider_2 = rell.test.keypairs.bob;

function test_get_proposal_delay__only_bc_delay() {

    val (blockchain, proposal_id, delay) = setup_proposal_with_delays(123000, null);

    assert_equals(delay.blockchain, blockchain);
    assert_equals(delay.delay, 123000);
    assert_equals(get_scheduled_callback_at_time(delay_type.PROPOSAL.value, proposal_id.to_integer()), get_last_blocktime() + 123000 - 1000);
}

function test_get_proposal_delay__only_scheduled_at() {

    val (blockchain, proposal_id, delay) = setup_proposal_with_delays(null, 789000);

    assert_equals(delay.blockchain, blockchain);
    assert_equals(delay.delay, 789000 - 2000);
    assert_equals(get_scheduled_callback_at_time(delay_type.PROPOSAL.value, proposal_id.to_integer()), get_last_blocktime() + 789000 - 2000);
}

function test_get_proposal_delay__scheduled_at_over_delay() {

    val (blockchain, _, delay) = setup_proposal_with_delays(5777, 10000000);

    assert_equals(delay.blockchain, blockchain);
    assert_equals(delay.delay, 10000000 - 2000);
}

function test_get_proposal_delay__delay_over_scheduled_at() {

    val (blockchain, proposal_id, delay) = setup_proposal_with_delays(5777000000, 10000000);

    assert_equals(delay.blockchain, blockchain);
    assert_equals(delay.delay, 5777000000);
    assert_equals(get_scheduled_callback_at_time(delay_type.PROPOSAL.value, proposal_id.to_integer()), get_last_blocktime() + 5777000000 - 1000);
}

function setup_proposal_with_delays(blockchain_delay: integer?, scheduled_at_delta: timestamp?) {

    setup_module();
    rell.test.tx().op(create_test_provider("bob", rell.test.pubkeys.bob)).run();

    val directory_chain = blockchain @ { blockchains.directory_chain };
    val bob = provider @ { rell.test.pubkeys.bob };
    rell.test.tx().op(add_test_member(system_p_voter_set(), bob)).run();

    val conf = apply_required_configuration_properties();
    val scheduled_at_time = if (scheduled_at_delta != null) get_last_blocktime() + scheduled_at_delta else null;

    rell.test.set_next_block_time_delta(1000);
    rell.test.tx().op(
        set_blockchain_config_delay_op(directory_chain, blockchain_delay ?: 0),
        propose_configuration(initial_provider.pub, directory_chain.rid, conf.to_gtv().to_bytes(), scheduled_at = scheduled_at_time)
    ).sign(initial_provider).run();
    val proposal_id = last_proposal().rowid;
    val proposal = get_proposal(proposal_id)!!;
    assert_equals(proposal.state, proposal_state.PENDING);
    if (scheduled_at_delta != null) {
        assert_not_null(proposal.scheduled_at);
        assert_equals(proposal.scheduled_at, scheduled_at_time);
        assert_true(get_scheduled_event_delay(delay_type.PROPOSAL, proposal_id.to_integer())!! > 0);
    } else {
        assert_null(proposal.scheduled_at);
    }

    rell.test.set_next_block_time_delta(1000);
    bob_votes();

    return (blockchain = directory_chain, proposal_id, delay = get_proposal_delay(proposal @ {}));
}
