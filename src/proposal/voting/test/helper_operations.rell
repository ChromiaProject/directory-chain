module;

import ^^.*;
import ^^^.*;

operation create_test_proposal(proposal_type, proposed_by: provider, deployer: voter_set) {
    create_proposal(proposal_type, proposed_by, deployer, "");
}

function get_latest_proposal_id(): rowid {
    return proposal @ { } (
        @sort_desc .rowid
    ) limit 1;
}
