module;

import ^^.*;

operation set_blockchain_proposal_delay_states_op(blockchain, active: boolean) {
    set_blockchain_proposal_delay_states(blockchain, active);
}

operation remove_vote_transaction_op(proposal_id: rowid, pubkey) {
    delete vote_transaction @ { .vote.proposal.rowid == proposal_id, .vote.provider.pubkey == pubkey };
}