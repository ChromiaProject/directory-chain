@test module;

import ^^.*;
import common.operations.*;
import common.test.ops.*;
import common.test.setup.*;
import common.test.util.*;
import proposal_blockchain.*;
import proposal_provider.*;
import proposal.voting.test.ops.*;
import direct_container.*;
import delay.test.helper_operations.*;
import common.test.helper_operations.*;

function test_revoke_not_considered_proposal() {
    setup();

    // Propose something
    val prop = propose_new_blockchain();

    // Asserting that we have a new proposal
    assert_equals(prop.state, proposal_state.PENDING);
    assert_not_null(pending_blockchain @? { prop });
    assert_not_null(vote @? { prop });

    // Alice revokes the proposal
    rell.test.tx().op(
        revoke_proposal(rell.test.pubkeys.alice, prop.rowid)
    ).sign(rell.test.keypairs.alice).run();

    // Asserting that proposal is REVOKED
    assert_equals(prop.state, proposal_state.REVOKED);
    assert_null(pending_blockchain @? {});
}

function test_revoke_proposal_under_consideration() {
    setup();

    // Propose something
    val prop = propose_new_blockchain();

    // Asserting that we have a new proposal
    assert_equals(prop.state, proposal_state.PENDING);
    assert_not_null(pending_blockchain @? { prop });
    assert_not_null(vote @? { prop });

    // Bob votes for the proposal
    vote_for_last_proposal(rell.test.keypairs.bob);
    assert_not_null(vote @? { prop, .provider.pubkey == rell.test.pubkeys.bob });

    // Alice revokes the proposal
    rell.test.tx().op(
        revoke_proposal(rell.test.pubkeys.alice, prop.rowid)
    ).sign(rell.test.keypairs.alice).run();

    // Asserting that proposal is REVOKED
    assert_equals(prop.state, proposal_state.REVOKED);
    assert_null(pending_blockchain @? {});
}

function test_revoke_applied_proposal() {
    setup();

    // Propose something
    val prop = propose_new_blockchain();

    // Asserting that we have a new proposal
    assert_equals(prop.state, proposal_state.PENDING);
    assert_not_null(pending_blockchain @? { prop });
    assert_not_null(vote @? { prop });

    // Bob votes for the proposal
    vote_for_last_proposal(rell.test.keypairs.bob);
    assert_not_null(vote @? { prop, .provider.pubkey == rell.test.pubkeys.bob });
    // Trudy votes for the proposal
    vote_for_last_proposal(rell.test.keypairs.trudy);
    assert_not_null(vote @? { prop, .provider.pubkey == rell.test.pubkeys.trudy });

    // Asserting that proposal APPROVED and applied
    assert_equals(prop.state, proposal_state.APPROVED);
    assert_null(pending_blockchain @? {});
    assert_not_null(blockchain @? { "foo_chain" });

    // Approved proposal can't be revoked
    rell.test.tx().op(
        revoke_proposal(rell.test.pubkeys.alice, prop.rowid)
    ).sign(rell.test.keypairs.alice).run_must_fail("The proposal is already APPROVED");
}

function test_revoke_applied_but_delayed_proposal() {

    setup();

    val cl = system_cluster();
    val container = "container";
    val alice = provider @ { rell.test.pubkeys.alice };
    val bob = provider @ { rell.test.pubkeys.bob };

    var conf = apply_required_configuration_properties(["name" : "chain".to_gtv()]);
    rell.test.tx().op(
        create_container(alice.pubkey, container, clusters.system, 0, [alice.pubkey, bob.pubkey]),
        propose_blockchain(alice.pubkey, conf.to_gtv().to_bytes(), "chain", container),
    ).sign(rell.test.keypairs.alice).run();
    vote_for_last_proposal(rell.test.keypairs.bob, true);
    val blockchain = blockchain @ { "chain" };

    rell.test.tx().op(
        set_blockchain_config_delay_op(blockchain, 100),
        propose_configuration(rell.test.pubkeys.alice, blockchain.rid, conf.to_gtv().to_bytes())
    ).sign(rell.test.keypairs.alice).run();

    val proposal_id = proposal @ {} ( @sort_desc .rowid ) limit 1;

    rell.test.tx().op(
        revoke_proposal(rell.test.pubkeys.alice, proposal_id)
    ).sign(rell.test.keypairs.alice).run();

    assert_equals(proposal @ { .rowid == proposal_id } ( .state ), proposal_state.REVOKED);
}

function test_revoke_rejected_proposal() {
    setup();

    // Propose something
    val prop = propose_new_blockchain();

    // Asserting that we have a new proposal
    assert_equals(prop.state, proposal_state.PENDING);
    assert_not_null(pending_blockchain @? { prop });
    assert_not_null(vote @? { prop });

    // Bob votes against the proposal
    vote_for_last_proposal(rell.test.keypairs.bob, false);
    assert_not_null(vote @? { prop, .provider.pubkey == rell.test.pubkeys.bob });

    // Asserting that proposal REJECTED and applied
    assert_equals(prop.state, proposal_state.REJECTED);
    assert_null(pending_blockchain @? {});
    assert_null(blockchain @? { "foo_chain" });

    // Rejected proposal can't be revoked
    rell.test.tx().op(
        revoke_proposal(rell.test.pubkeys.alice, prop.rowid)
    ).sign(rell.test.keypairs.alice).run_must_fail("The proposal is already REJECTED");
}

function test_when_bob_revokes_alice_proposal_and_fails() {
    setup();

    // Propose something
    propose_new_blockchain();

    // Asserting that we have a new proposal
    val prop = proposal @? { proposal_state.PENDING };
    assert_not_null(prop);
    assert_not_null(pending_blockchain @? { prop });
    assert_not_null(vote @? { prop });

    // Bob revokes Alice's proposal, cf. run_must_fail()
    rell.test.tx().op(
        revoke_proposal(rell.test.pubkeys.bob, prop.rowid)
    ).sign(rell.test.keypairs.bob).run_must_fail();
}

// -----------------------------------------------------------

function setup() {
    setup_module();

    // Adding two providers to system cluster
    add_provider_to_system_cluster(rell.test.pubkeys.bob, null);
    add_provider_to_system_cluster(rell.test.pubkeys.trudy, rell.test.keypairs.bob);
}


function add_provider_to_system_cluster(provider_pk: byte_array, approver: rell.test.keypair?) {
    val alice = rell.test.pubkeys.alice;
    val initial_providers = provider @* {} (@sort .pubkey);

    // Registering a new provider
    rell.test.tx().op(
        register_provider(alice, provider_pk, provider_tier.NODE_PROVIDER)
    ).sign(rell.test.keypairs.alice).run();

    // Asserting that provider added
    initial_providers.add(provider_pk);
    assert_equals(
        provider @* {} (@sort .pubkey),
        initial_providers.sorted()
    );

    // Proposing provider to be enabled.
    rell.test.tx().op(
        propose_provider_state(alice, provider_pk, true)
    ).sign(rell.test.keypairs.alice).run();

    if (approver != null) vote_for_last_proposal(approver);

    // Proposing provider to be a system provider.
    rell.test.tx().op(
        propose_provider_is_system(alice, provider_pk, true)
    ).sign(rell.test.keypairs.alice).run();

    if (approver != null) vote_for_last_proposal(approver);

    // Asserting that provider is enabled and system
    val prov = provider @ { provider_pk };
    assert_true(roles.has_system_access(prov));
}

function propose_new_blockchain(): proposal {
    val alice = rell.test.pubkeys.alice;
    rell.test.tx().op(
        create_container(alice, "container", clusters.system, 0, [alice, rell.test.pubkeys.bob, rell.test.pubkeys.trudy]),
        propose_blockchain(alice, apply_required_configuration_properties().to_gtv_pretty().to_bytes(), "foo_chain", "container")
    ).sign(rell.test.keypairs.alice).run();

    return last_proposal();
}