@test module;

import ^^.*;
import common.test.ops.*;
import common.test.setup.*;
import common.test.util.*;
import proposal_blockchain.*;
import proposal.voting.test.ops.*;
import direct_container.*;
import delay.test.helper_operations.*;
import ^.helper_operations.*;

function test_get_blockchain_proposal_delay_ids() {

    setup_module();
    rell.test.tx().op(create_test_provider("bob", rell.test.pubkeys.bob)).run();
    val bob = provider @ { rell.test.pubkeys.bob };
    rell.test.tx().op(add_test_member(system_p_voter_set(), bob)).run();

    val container = "container";
    val alice = provider @ { rell.test.pubkeys.alice };

    val conf = apply_required_configuration_properties(["name" : "chain".to_gtv()]);
    rell.test.tx().op(
        create_container(alice.pubkey, container, clusters.system, 0, [alice.pubkey, bob.pubkey]),
        propose_blockchain(alice.pubkey, conf.to_gtv().to_bytes(), "chain", container),
    ).sign(rell.test.keypairs.alice).run();
    vote_for_last_proposal(rell.test.keypairs.bob, true);
    val blockchain = blockchain @ { "chain" };

    rell.test.tx().op(
        set_blockchain_config_delay_op(blockchain, 1000000000),
        propose_configuration(initial_provider.pub, blockchain.rid, conf.to_gtv().to_bytes())
    ).sign(rell.test.keypairs.alice).run();
    vote_for_last_proposal(rell.test.keypairs.bob, true);

    rell.test.tx().op(
        set_blockchain_config_delay_op(blockchain, 1000000000),
        propose_configuration(rell.test.pubkeys.bob, blockchain.rid, conf.to_gtv().to_bytes())
    ).sign(rell.test.keypairs.bob).run();
    vote_for_last_proposal(rell.test.keypairs.alice, true);

    assert_equals(scheduled_callback @ { .active == true } ( @sum 1 ), 2);

    rell.test.tx().op(
        set_blockchain_proposal_delay_states_op(blockchain, false)
    ).sign(rell.test.keypairs.alice).run();

    assert_equals(scheduled_callback @ { .active == false } ( @sum 1 ), 2);
}
