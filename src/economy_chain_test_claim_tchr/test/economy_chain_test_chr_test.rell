@test module;

import ^^.*;
import economy_chain.test.helper_functions.*;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.assets;
    import lib.ft4.auth;
    import test_utils: lib.ft4.test.core;
}

struct module_args {
    account_creator_privkey: byte_array;
}

val account_creator_privkey = chain_context.args.account_creator_privkey;
val mint_amount = 1000000000;

function test_init() {
    faucet().run_must_fail("Economy chain is not initialized");

    init().run();

    val asset = get_chr_asset();
    assert_equals(asset.symbol, "tCHR");

    get_pool_account();

    rell.test.tx().op(
        init()
    ).nop().run_must_fail("Economy chain is already initialized");
}

function test_faucet_success() {
    init().run();
    val alice = require(do_create_account(rell.test.keypairs.alice, account_creator_privkey));
    val initial_balance = get_account_balance(alice);

    rell.test.set_next_block_time_delta(millis_per_week + 1);
    rell.test.block().run();

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.privkeys.alice, faucet())
    ).op(
        faucet()
    ).run();

    val new_balance = get_account_balance(alice);
    assert_gt(new_balance, initial_balance);
    assert_equals(new_balance - initial_balance, mint_amount);
    assert_equals(get_balance(alice.id), new_balance);
}

function test_faucet_rate_limits_on_account_creation() {
    init().run();
    val alice = require(do_create_account(rell.test.keypairs.alice, account_creator_privkey));

    rell.test.set_next_block_time_delta(millis_per_week - rell.test.DEFAULT_BLOCK_INTERVAL - 1);
    rell.test.block().run();

    rell.test.tx().op(
        ft4.test_utils.evm_auth_operation_for(rell.test.privkeys.alice, faucet())
    ).op(
        faucet()
    ).run_must_fail("seconds before claiming more");
}

function test_faucet_works_after_rate_limit_end() {
    init().run();

    val alice_evm_address = crypto.eth_privkey_to_address(rell.test.privkeys.alice);
    val first_timestamp = rell.test.last_block_time;

    create_account(alice_evm_address)
        .sign(account_creator_privkey)
        .run();

    val rl = faucet_user @ {};
    assert_equals(rl.last_refill_millis, first_timestamp);

    rell.test.set_next_block_time(first_timestamp + millis_per_week + 1);
    rell.test.block().run();

    rell.test.tx()
        .op(ft4.test_utils.evm_auth_operation_for(rell.test.privkeys.alice,faucet()))
        .op(faucet())
        .nop()
        .run();

    val second_timestamp = rell.test.last_block_time;

    assert_equals(rl.last_refill_millis, first_timestamp + millis_per_week + 1);

    rell.test.set_next_block_time(second_timestamp + millis_per_week + 1);
    rell.test.block().run();

    rell.test.tx()
        .op(ft4.test_utils.evm_auth_operation_for(rell.test.privkeys.alice, faucet()))
        .op(faucet())
        .nop()
        .run();

    assert_equals(rl.last_refill_millis, second_timestamp + millis_per_week + 1);
    assert_equals(
        ft4.assets.balance @ { .account.type == "FT4_USER" } (.amount), 3*mint_amount
    );
}

// Pure account creation tests

function test_create_account() {
    init().run();
    
    val id = rell.test.keypairs.alice.pub.hash();
    create_account(rell.test.keypairs.alice.pub)
        .sign(account_creator_privkey)
        .run();

    assert_equals((ft4.accounts.account @* { id }).size(), 1);
    assert_equals(
        ft4.accounts.account_auth_descriptor @ {} (.args),
        [ set(["A", "T"]).to_gtv(), rell.test.keypairs.alice.pub.to_gtv() ].to_gtv().to_bytes()
    );
}

function test_create_account_prevents_duplicates() {
    init().run();

    create_account(rell.test.keypairs.alice.pub)
        .sign(account_creator_privkey)
        .run();

    create_account(rell.test.keypairs.alice.pub)
        .sign(account_creator_privkey)
        .nop()
        .run_must_fail("duplicate key");
}

function test_create_account_fails_without_admin() {
    init().run();

    create_account(rell.test.keypairs.alice.pub)
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Please use the Faucet");
}

function test_create_account_links_evm() {
    init().run();

    create_account(rell.test.keypairs.alice.pub)
        .sign(account_creator_privkey)
        .run();

    assert_not_null(
        eif.hbridge_core.evm_eoa_account_link @? { .address==rell.test.keypairs.alice.pub, .account.id==rell.test.keypairs.alice.pub.hash() }
    );
}