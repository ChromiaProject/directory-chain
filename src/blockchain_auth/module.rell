module;

import model.*;
import common.*;

val iccf_description = "Proposed via ICCF";

/**
 * Make it possible to use an operation from another blockchain to authenticate this provider.
 * The provider needs to sign this transaction (but not subsequent operations which are authenticated by the other blockchain).
 *
 * @param my_pubkey   pubkey of provider
 * @param blockchain_rid   the other blockchain
 */
operation add_provider_blockchain_auth(my_pubkey: pubkey, blockchain_rid: byte_array) {
    val allowed_states = blockchain_state.values();
    allowed_states.remove(blockchain_state.REMOVED);
    val bc = require_blockchain(blockchain_rid, allowed_states);

    val provider = require_is_provider_with_rate_limit(my_pubkey);

    create provider_auth_blockchain(provider, bc);
}

/**
 * Make it no longer possible to use the operation from the blockchain to authenticate this provider.
 * The transaction needs to include ICCF proof of `tx_to_prove`.
 *
 * @param my_pubkey        pubkey of provider
 * @param tx_to_prove      the transaction from other chain to use for authentication
 * @param op_index         index of the relevant operation in tx_to_prove
 */
operation remove_provider_blockchain_auth_iccf(my_pubkey: pubkey, tx_to_prove: gtx_transaction, op_index: integer) {
    val provider = require_provider(my_pubkey);
    require_provider_iccf_auth_with_rate_limit(tx_to_prove, op_index,
        rell.meta(remove_provider_blockchain_auth_iccf).mount_name, 0,
        provider);

    delete provider_auth_blockchain @ { provider };
}
